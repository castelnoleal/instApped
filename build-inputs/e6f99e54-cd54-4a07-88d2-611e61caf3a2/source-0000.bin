<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#080a10">
<meta name="kodex-build" content="KODEX-7.8">
<meta name="color-scheme" content="dark">
<meta http-equiv="Content-Security-Policy" content="default-src 'self' data: blob:; media-src 'self' blob: mediastream:; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://cdn.jsdelivr.net; worker-src 'self' blob: https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src https: data: blob: 'self'; connect-src 'self' https://cdn.jsdelivr.net https://tessdata.projectnaptha.com https://db.ygoprodeck.com https://kodex.meiocg.org https://translate.meiocg.org https://api.mymemory.translated.net; object-src 'none'; frame-src https://kodex.meiocg.org about:; base-uri 'none'">
<link rel="icon" type="image/png" href="data:image/png;base64,">
<title>Duel Synapse: KodeX</title>
<style>
:root{--sat:env(safe-area-inset-top,0px);--sab:env(safe-area-inset-bottom,0px);--bg:#080a10;--panel:#111522;--panel2:#171b2a;--line:#272d40;--text:#eef2ff;--muted:#9aa4bd;--accent:#67a8ff;--soft:rgba(103,168,255,.16);--soft2:rgba(103,168,255,.1);--nav:64px;--mon:#e8b25a;--spl:#38c9a6;--trp:#d9729f}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html{font-size:16px;-webkit-text-size-adjust:100%;text-size-adjust:100%}
html,body{height:100%;margin:0;overflow:hidden}
body{background:radial-gradient(circle at top,#17213a 0,#080a10 48%) #080a10;color:var(--text);font-family:Inter,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;display:flex;flex-direction:column;padding:0 env(safe-area-inset-right) 0 env(safe-area-inset-left);-webkit-user-select:none;user-select:none;-webkit-touch-callout:none;line-height:1.4}
button{font:inherit;color:inherit;cursor:pointer;touch-action:manipulation}
.effect,.qb,.stats strong,h2{-webkit-user-select:text;user-select:text}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
[hidden]{display:none!important}
header,.search,main{width:100%;max-width:1000px;margin:0 auto;padding-left:16px;padding-right:16px}
header{display:flex;align-items:center;gap:12px;padding-top:12px;padding-bottom:4px}
.logo{width:46px;height:46px;display:grid;place-items:center;padding:0;flex:none;background:transparent;border:0;box-shadow:none}.logo img{width:100%;height:100%;object-fit:contain;display:block;filter:drop-shadow(0 0 4px var(--accent)) drop-shadow(0 0 10px var(--theme-glow));}
.brand{font-size:.66rem;letter-spacing:.18em;color:var(--accent);font-weight:800;text-transform:uppercase}
.title{font-size:19.2px!important;font-weight:850;line-height:1.2;flex:none}.logo,.logo img{width:46px;height:46px;flex:none}
.sub{color:var(--muted);font-size:.74rem}
.searchbox{display:flex;align-items:center;gap:6px;background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:3px 4px 3px 14px;box-shadow:0 10px 30px rgba(0,0,0,.35);transition:border-color .15s,box-shadow .15s}
.searchbox:focus-within{border-color:var(--accent);box-shadow:0 0 0 3px var(--soft)}
.searchbox>span{color:var(--muted);font-size:1.1rem}
.searchbox input{flex:1;min-width:0;height:46px;border:0;outline:0;background:transparent;color:var(--text);font-size:1rem;-webkit-user-select:text;user-select:text}
.searchbox button{border:0;background:transparent;color:var(--muted);font-size:1.5rem;width:44px;height:44px;border-radius:12px}
.status{display:flex;gap:8px;align-items:center;color:var(--muted);font-size:.76rem;margin:8px 4px 4px;min-height:20px}
.dot{width:8px;height:8px;border-radius:50%;background:#45d483;flex:none;box-shadow:0 0 0 3px rgba(69,212,131,.18)}.dot.off{background:#ffb454;box-shadow:0 0 0 3px rgba(255,180,84,.18)}
.active{display:flex;gap:6px;overflow-x:auto;padding:4px 2px 8px;scrollbar-width:none}.active::-webkit-scrollbar{display:none}
.ac{flex:none;border:1px solid var(--accent);background:var(--soft2);border-radius:99px;padding:6px 12px;font-size:.76rem;font-weight:700;min-height:34px}
main{flex:1;min-height:0;overflow-y:auto;overscroll-behavior:contain;-webkit-overflow-scrolling:touch;padding-top:6px;padding-bottom:calc(var(--nav) + 24px + var(--sab))}
#list{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:10px;align-content:start}
.card{display:flex;gap:12px;align-items:center;text-align:left;width:100%;background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:10px 10px 10px 10px;min-height:92px;transition:transform .1s,border-color .15s}
.card:active{transform:scale(.985);border-color:var(--accent)}
.card img{width:54px;height:78px;object-fit:cover;border-radius:6px;background:#05060a;flex:none;box-shadow:0 4px 12px rgba(0,0,0,.4)}
.ci{flex:1;min-width:0;display:block}.cn{display:block;font-size:.95rem;line-height:1.3;font-weight:750;overflow:hidden;text-overflow:ellipsis;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
.tags{display:flex;flex-wrap:wrap;gap:5px;margin:5px 0 3px}
.tg{font-style:normal;font-size:.68rem;font-weight:800;border-radius:99px;padding:2px 8px;border:1px solid var(--line);background:var(--panel2);color:var(--text)}
.tg.m{color:var(--mon);border-color:var(--mon)}.tg.s{color:var(--spl);border-color:var(--spl)}.tg.t{color:var(--trp);border-color:var(--trp)}
.meta{display:block;color:var(--muted);font-size:.74rem;line-height:1.4}
.chev{color:var(--muted);font-size:1.4rem;flex:none;padding-right:4px}
.empty{grid-column:1/-1;text-align:center;padding:56px 18px;color:var(--muted);font-size:.9rem;line-height:1.6}.empty b{display:block;font-size:2rem;margin-bottom:8px;color:var(--accent)}
.sk{height:92px;border-radius:16px;background:linear-gradient(90deg,var(--panel) 0,var(--panel2) 50%,var(--panel) 100%);background-size:200% 100%;animation:sh 1.3s infinite linear;border:1px solid var(--line)}
@keyframes sh{to{background-position:-200% 0}}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:16px;margin-top:12px}
.dbar{position:sticky;top:0;z-index:5;padding:6px 0 8px;background:var(--bg);box-shadow:0 10px 12px -10px rgba(0,0,0,.7)}
.back,.btn{border:1px solid var(--line);background:var(--panel2);padding:11px 16px;border-radius:13px;min-height:46px;font-weight:650}.dbar .back{display:flex;align-items:center;gap:9px;width:100%;text-align:left;background:linear-gradient(110deg,var(--soft),var(--panel));border-color:color-mix(in srgb,var(--accent) 55%,var(--line));box-shadow:inset 3px 0 0 var(--accent),0 6px 20px rgba(0,0,0,.18);font-weight:750;transition:transform .15s,border-color .15s}.dbar .back:active{transform:translateY(1px);border-color:var(--accent)}
.btn.p{background:var(--soft);border-color:var(--accent);font-weight:750}
.hero{display:flex;gap:16px;align-items:flex-start;margin-top:10px}
.thumb{width:128px;border-radius:9px;background:#05060a;flex:none;box-shadow:0 12px 30px rgba(0,0,0,.5)}
.hero h2{margin:0 0 6px;font-size:1.3rem;line-height:1.25}
.label{font-size:.7rem;color:var(--accent);font-weight:800;letter-spacing:.1em;margin:0 0 10px;text-transform:uppercase}
.stats{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:8px}
.stats div{background:var(--panel2);border:1px solid var(--line);border-radius:12px;padding:9px 11px}
.stats span{display:block;font-size:.66rem;color:var(--muted);text-transform:uppercase;letter-spacing:.05em}.stats strong{font-size:.92rem}
.effect{white-space:pre-wrap;line-height:1.65;font-size:.94rem;color:var(--text)}
.dg{display:flex;justify-content:space-between;gap:12px;padding:10px 0;border-top:1px solid var(--line);font-size:.86rem}.dg small{display:block;color:var(--muted);font-size:.76rem;margin-top:2px;word-break:break-word}.dg b{font-size:.74rem;letter-spacing:.04em;flex:none}.dg b.ok{color:#3ddc84}.dg b.warn{color:#f5b942}.dg b.fail{color:#ff6b6b}.dg-s{margin:6px 0 2px;font-weight:700}.dg-t{width:100%;min-height:120px;margin-top:10px;font:12px/1.4 monospace;background:var(--panel2);color:var(--text);border:1px solid var(--line);border-radius:10px;padding:8px}
.note{color:var(--muted);font-size:.8rem;line-height:1.55;margin:8px 0}
details.qa{background:var(--panel2);border:1px solid var(--line);border-radius:14px;margin-top:8px;overflow:hidden}
details.qa[open]{border-color:var(--accent)}
details.qa summary{padding:12px 14px;cursor:pointer;font-size:.88rem;line-height:1.45;font-weight:650;list-style:none;min-height:48px}
details.qa summary::-webkit-details-marker{display:none}
details.qa summary:before{content:"›";color:var(--accent);font-size:1.3rem;margin-right:8px;display:inline-block;transition:transform .15s}
details.qa[open] summary:before{transform:rotate(90deg)}
.qb{padding:0 14px 14px;border-top:1px solid var(--line);font-size:.9rem;line-height:1.65;color:var(--text)}
.qb p{margin:10px 0 0;white-space:pre-wrap}.qb b{color:var(--accent)}
.translate-btn{margin:12px 0 0;border:1px solid var(--accent);background:var(--soft2);border-radius:10px;padding:8px 12px;min-height:40px;font-size:.8rem;font-weight:700}
.translation-box{margin-top:10px;padding:10px 12px;border:1px solid var(--line);border-radius:12px;background:var(--panel)}
.translation-label{font-size:.68rem;color:var(--accent);font-weight:800;letter-spacing:.06em;text-transform:uppercase;margin-bottom:6px}
.translation-error{font-size:.78rem;color:#ffb4b4;margin-top:8px}
.nav{position:fixed;left:0;right:0;bottom:0;z-index:40;background:rgba(10,13,22,.96);border-top:1px solid var(--line);padding:0 env(safe-area-inset-right) var(--sab) env(safe-area-inset-left);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px)}
.nav>div{max-width:1000px;margin:0 auto;display:grid;grid-template-columns:repeat(4,1fr);height:var(--nav)}
.nav button{background:none;border:0;color:var(--muted);font-size:.7rem;font-weight:700;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;position:relative;min-height:48px}
.nav button i.ic{font-style:normal;font-size:1.2rem;line-height:1;padding:3px 18px;border-radius:99px;transition:background .15s}
.nav button.on{color:var(--text)}.nav button.on i.ic{background:var(--soft);color:var(--accent)}
.nav #fc{position:absolute;top:5px;left:calc(50% + 6px);background:var(--accent);color:#06101f;border-radius:99px;min-width:18px;padding:0 5px;text-align:center;font-size:.66rem;font-style:normal;font-weight:900}
.layer{position:fixed;top:0;right:0;bottom:0;left:0;background:rgba(0,0,0,.62);display:none;z-index:50}.layer.open{display:block}#Larena{background:var(--bg);z-index:70}#Larena.open{display:flex;flex-direction:column}.arbar{display:flex;align-items:center;gap:12px;padding:calc(8px + var(--sat)) 16px 8px;background:var(--panel);border-bottom:1px solid var(--line);flex:none}.arbar .logo,.arbar .logo img{width:40px;height:40px}.arti{flex:1;min-width:0;line-height:1.15}#arenaFrame{flex:1;min-height:0;width:100%;border:0;background:var(--bg);display:block}
.sheet{position:absolute;background:var(--panel);border:1px solid var(--line);display:flex;flex-direction:column;max-height:100%}
.side .sheet{top:0;right:0;bottom:0;width:min(400px,94vw);border-width:0 0 0 1px;padding-top:var(--sat)}
.bottom .sheet{left:0;right:0;bottom:0;max-height:calc(100% - var(--sat) - 12px);border-radius:22px 22px 0 0;max-width:720px;margin:0 auto}
.bottom .sheet:before{content:"";width:40px;height:4px;border-radius:9px;background:var(--line);margin:8px auto 0;flex:none}
.sh{display:flex;justify-content:space-between;align-items:center;padding:10px 16px;border-bottom:1px solid var(--line)}.sh h3{margin:0;font-size:1.05rem}
.sb{overflow-y:auto;padding:4px 16px calc(20px + var(--sab));flex:1;-webkit-overflow-scrolling:touch;overscroll-behavior:contain}
.sec{font-size:.7rem;font-weight:800;letter-spacing:.14em;color:var(--accent);margin:20px 4px 8px;text-transform:uppercase}
.grp{background:var(--panel2);border:1px solid var(--line);border-radius:16px;padding:0 14px}
.row{display:flex;justify-content:space-between;gap:14px;align-items:center;padding:12px 0;min-height:60px}.row+.row{border-top:1px solid var(--line)}
.row strong{font-size:.92rem}.row small{display:block;color:var(--muted);font-size:.75rem;margin-top:2px;line-height:1.4}
.sw{width:52px;height:30px;border-radius:99px;background:#30384e;border:0;position:relative;flex:none;transition:background .15s}
.sw:after{content:"";position:absolute;width:22px;height:22px;top:4px;left:4px;border-radius:50%;background:#fff;transition:left .15s}
.sw[aria-checked=true]{background:var(--accent)}.sw[aria-checked=true]:after{left:26px}
input[type=range]{accent-color:var(--accent)}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin:6px 0 4px}
.chip{border:1px solid var(--line);background:var(--panel2);border-radius:99px;padding:8px 14px;font-size:.84rem;min-height:40px}
.chip[aria-pressed=true]{background:var(--soft);border-color:var(--accent);color:var(--text);font-weight:750}
.rg{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px}
.rg label{font-size:.72rem;color:var(--muted)}
.rg input,select{width:100%;height:44px;border-radius:11px;border:1px solid var(--line);background:var(--panel2);color:var(--text);padding:0 10px;font-size:1rem}
.fo{display:flex;gap:10px;padding:12px 16px calc(12px + var(--sab));border-top:1px solid var(--line)}.fo .btn{flex:1}
.prog{height:8px;background:#252b3c;border-radius:99px;overflow:hidden;margin:10px 0}.prog i{display:block;height:100%;width:0;background:var(--accent);transition:width .15s}
.themes{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.themes button{border:1px solid var(--line);background:var(--panel2);border-radius:12px;min-height:50px;font-size:.8rem;display:flex;align-items:center;justify-content:center;gap:7px}
.themes button[aria-pressed=true]{border-color:var(--accent);box-shadow:0 0 0 1px var(--accent);background:var(--soft2)}
.themes i{width:16px;height:16px;border-radius:50%}
.lnk{display:block;padding:14px 0;border-top:1px solid var(--line);color:var(--text);text-decoration:none;font-size:.9rem;min-height:48px}
.grp .lnk:first-child{border-top:0}
.tl{display:block;width:100%;text-align:left;background:none;border:0;border-top:1px solid var(--line);padding:14px 0;color:var(--text);font-size:.92rem;min-height:48px}

.detail-actions{display:flex;gap:8px;flex-wrap:wrap}
.deck-card{background:var(--panel2);border:1px solid var(--line);border-radius:14px;padding:12px;margin:9px 0}
.deck-head{display:flex;align-items:center;justify-content:space-between;gap:10px}
.deck-head strong{font-size:.95rem}
.deck-list{display:grid;gap:7px;margin-top:10px}
.deck-item{display:flex;align-items:center;gap:10px;border-top:1px solid var(--line);padding:9px 0}
.deck-item img{width:34px;height:48px;object-fit:cover;border-radius:5px;flex:none}
.deck-item .deck-name{flex:1;min-width:0;font-size:.85rem}
.deck-item .deck-name small{display:block;color:var(--muted);font-size:.72rem}
.deck-actions{display:flex;flex-wrap:wrap;gap:7px;margin-top:10px}
.deck-actions .btn{min-height:40px;padding:8px 11px;font-size:.78rem}
.deck-field{width:100%;height:44px;border:1px solid var(--line);border-radius:11px;background:var(--panel);color:var(--text);padding:0 12px;margin:7px 0}
.deck-empty{padding:15px;border:1px dashed var(--line);border-radius:12px;color:var(--muted);font-size:.82rem;text-align:center}
.deck-view{position:relative;isolation:isolate;border:1px solid var(--line);border-radius:14px;overflow:hidden;padding:12px;background:var(--panel);background-size:cover;background-position:center;background-repeat:no-repeat}
.deck-view:before{content:"";position:absolute;inset:0;background:rgba(7,10,17,.48);z-index:-1;pointer-events:none}
.deck-section{margin:10px 0 14px;border:1px solid rgba(255,255,255,.2);border-radius:9px;overflow:hidden;background:rgba(5,8,15,.62);transition:border-color .15s,background .15s}.deck-section.drag-target{border:2px dashed var(--accent);background:rgba(70,110,180,.22);box-shadow:0 0 0 2px rgba(90,140,220,.12)}
.deck-section-head{display:flex;justify-content:space-between;align-items:center;padding:7px 10px;background:rgba(18,25,43,.82);font-weight:800;font-size:.86rem}
.deck-cards-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:5px;padding:7px}
.deck-card-thumb{position:relative;aspect-ratio:59/86;min-width:0;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.18);border-radius:4px;overflow:hidden;padding:0;display:block;width:100%;cursor:grab;touch-action:pan-y;user-select:none;-webkit-user-select:none;-webkit-user-drag:element}.deck-card-thumb:active{cursor:grabbing}.deck-card-thumb.drag-ready{outline:3px solid var(--accent);outline-offset:2px;}.deck-card-thumb.dragging{opacity:.42;transform:scale(.96);outline:3px solid var(--accent)}.qv-passcode{font-size:.72rem;opacity:.68;margin:.25rem 0}.deck-section-head:after{content:" · Drop cards here";font-size:.68rem;font-weight:500;opacity:.65}.deck-section.drag-target .deck-section-head{background:rgba(50,100,190,.45)}
.deck-card-thumb img{width:100%;height:100%;object-fit:cover;display:block}
.deck-card-thumb .missing-card{font-size:.65rem;display:grid;place-items:center;height:100%;text-align:center;padding:3px;color:var(--muted)}
.deck-card-thumb .qty{position:absolute;right:2px;top:2px;background:rgba(0,0,0,.78);color:white;border-radius:3px;padding:1px 4px;font-size:.62rem}
.deck-section-select{background:var(--panel2);color:var(--text);border:1px solid var(--line);border-radius:8px;padding:8px;max-width:105px;font-size:.78rem}


.about p{font-size:.85rem;line-height:1.65;color:var(--text)}
#wp,#ws{position:fixed;top:0;right:0;bottom:0;left:0;pointer-events:none;z-index:0;background-position:center;background-repeat:no-repeat;background-size:cover}
.top-ad-safe-area,header,.search,main{position:relative;z-index:1}
.top-ad-safe-area{flex:none;display:flex;justify-content:center;padding:calc(var(--sat) + 6px) 12px 0}
.top-ad-slot{width:min(100%,360px);height:50px;display:flex;align-items:center;justify-content:center;border-radius:10px;background:rgba(5,8,16,.34);color:rgba(190,201,222,.35);font-size:.6rem;letter-spacing:.12em;overflow:hidden}
@media(max-width:600px){#list{grid-template-columns:1fr;gap:8px}.hero{flex-direction:column;align-items:center;text-align:center}.hero .tags{justify-content:center}.thumb{width:150px}}
@media(min-width:900px){.nav>div{max-width:560px}}
@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}





/* Production deck UI refinement */
.deck-card[data-open-deck]{cursor:pointer;transition:border-color .15s,background .15s}.deck-card[data-open-deck]:hover{border-color:var(--accent);background:var(--soft2)}#Ltool .sheet{overflow:hidden}#Ltool .sh{position:relative;z-index:8;background:var(--panel);border-bottom:1px solid var(--line)}#Ltool .sb{padding:14px;overflow-y:auto;overscroll-behavior:contain;max-height:calc(88dvh - 70px)}




.deck-card{border:1px solid var(--line);border-radius:13px;padding:15px;margin:10px 0;background:linear-gradient(145deg,rgba(255,255,255,.035),rgba(255,255,255,.012))}
.deck-head{display:flex;align-items:center;gap:12px;margin-bottom:12px}.deck-head strong{font-size:1rem;font-weight:650}
.deck-card .deck-actions{display:flex;gap:7px;flex-wrap:wrap}.deck-card .deck-actions .btn{font-size:.82rem}.deck-actions .deck-field{min-width:0;flex:1 1 160px;min-height:42px;border-radius:9px}

.deck-section-head:after{content:none}.deck-section-head{letter-spacing:.015em}.deck-view{background-size:cover;background-position:center;background-attachment:local}
@media(max-width:480px){.deck-card{padding:12px}.deck-head{align-items:flex-start}}


/* v16 mobile quick-view layering and spacing */
#deckQuickView{position:relative;z-index:2147483000}


/* ===== production refinements ===== */
.i{display:block;flex:none}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:1px solid var(--line);background:var(--panel2);color:var(--text);border-radius:12px;padding:0 16px;min-height:44px;font-weight:650;font-size:.9rem;line-height:1.1;text-decoration:none;transition:background .15s,border-color .15s,transform .08s}
.btn:active{transform:scale(.97)}
.btn.p{background:var(--accent);border-color:var(--accent);color:#06101f;font-weight:750}
.btn.danger{color:#ff8f9c;border-color:#5a2a35;background:transparent}
.btn[disabled]{opacity:.45}
.back{display:inline-flex;align-items:center;gap:6px;padding:0 14px 0 8px;min-height:44px;border-radius:12px}
.ibtn{width:44px;height:44px;border-radius:12px;border:1px solid var(--line);background:var(--panel2);color:var(--text);display:inline-grid;place-items:center;flex:none;padding:0;cursor:pointer}
.ibtn:active{background:var(--soft)}
.btn.fav.fav-on{border-color:var(--accent);background:var(--soft2);color:var(--text)}.btn.fav.fav-on svg{fill:var(--accent);color:var(--accent)}
.detail-actions{display:flex;gap:8px;margin-top:14px}.detail-actions .btn{flex:1}
.fm{display:inline-flex;vertical-align:-2px;color:var(--accent)}.fm svg{fill:var(--accent)}
.nav button i.ic{display:grid;place-items:center}
.memb{display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin-top:10px}.memb:empty{display:none}
.memb .mb-l{font-size:.68rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);font-weight:800}
.memb em{font-style:normal;font-size:.74rem;font-weight:700;border:1px solid var(--accent);background:var(--soft2);border-radius:99px;padding:3px 10px}
.full .sheet{height:100%;max-height:100%;max-width:none;margin:0;border-radius:0;border-width:0}
.full .sheet:before{display:none}.full .sh{padding-top:calc(10px + var(--sat))}.full .sb{padding-top:0}
.dk-bar{position:sticky;top:0;z-index:4;display:flex;align-items:center;gap:10px;margin:0 -14px 14px;padding:10px 14px;background:var(--panel);border-bottom:1px solid var(--line)}
.dk-who{display:flex;align-items:center;gap:10px;flex:1;min-width:0}
.dk-ac{display:flex;gap:6px;flex:none}
@media(max-width:400px){.dk-bar{flex-wrap:wrap;row-gap:6px}.dk-bar #deckBack~.dk-who{flex:1 1 calc(100% - 60px)}.dk-bar #deckBack~.dk-ac{flex:1 1 100%;justify-content:flex-end}}
.dk-t{display:block;min-width:0;flex:1;text-align:left;overflow:hidden}.dk-t b{display:block;font-size:.95rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.dk-t small{display:block;color:var(--muted);font-size:.74rem;margin-top:1px}
.dk-ic{border-radius:14px;object-fit:cover;flex:none;background:var(--panel2);border:1px solid var(--line)}
.dk-ic.ph{display:inline-grid;place-items:center;font-weight:800;color:var(--accent);background:var(--soft2)}
.dk-grid{display:grid;gap:10px;grid-template-columns:minmax(0,1fr)}.dk-item,.dk-who{min-width:0;max-width:100%}.dk-item>*{min-width:0}
.dk-item{display:flex;align-items:center;gap:8px;background:var(--panel2);border:1px solid var(--line);border-radius:16px;padding:8px}
.dk-open{display:flex;align-items:center;gap:12px;flex:1;min-width:0;overflow:hidden;background:none;border:0;padding:4px;text-align:left;border-radius:12px;color:var(--text)}
.dk-open.sel{background:var(--soft2);outline:1px solid var(--accent)}
.dk-empty{display:grid;place-items:center;gap:8px;padding:44px 0;color:var(--muted)}
.dk-nm{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:.9rem}
.mdl{display:flex;align-items:center;justify-content:center;padding:calc(10px + var(--sat)) 12px calc(10px + var(--sab));z-index:70}.vwm{padding:0!important}.vwm .dlg.viewer{padding-bottom:var(--sab)}
.dlg{width:min(100%,440px);max-height:calc(100dvh - 20px - var(--sat) - var(--sab));overflow:auto;background:var(--panel);border:1px solid var(--line);border-radius:20px;padding:18px;box-shadow:0 24px 70px rgba(0,0,0,.6);display:flex;flex-direction:column;gap:12px}
.dlg.big{width:min(100%,520px)}.dlg.xl{height:calc(100dvh - 20px - var(--sat) - var(--sab))}
.dlg h3{margin:0;font-size:1.05rem}
.dk-hd{display:flex;align-items:center;justify-content:space-between;gap:10px}.dk-hd h3{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.dact{display:flex;gap:8px;justify-content:flex-end;flex-wrap:wrap}.dact .btn{flex:1}
.fld{width:100%;height:46px;border:1px solid var(--line);border-radius:12px;background:var(--panel2);color:var(--text);padding:0 14px;font-size:1rem}
.dk-form{display:flex;gap:12px;align-items:center}
.dk-pick{width:64px;height:64px;border-radius:18px;border:1px dashed var(--accent);background:var(--soft2);color:var(--accent);display:grid;place-items:center;flex:none;overflow:hidden;padding:0}.dk-pick img{width:100%;height:100%;object-fit:cover}
.crop{display:grid;place-items:center}.crop canvas{width:min(100%,280px);aspect-ratio:1;border-radius:18px;touch-action:none;background:#000;border:1px solid var(--line)}
.zoom{width:100%}
.seg-w{display:flex;gap:6px;background:var(--panel2);border:1px solid var(--line);border-radius:14px;padding:4px}
.seg{flex:1;border:0;background:none;border-radius:10px;min-height:40px;font-weight:650;color:var(--muted);display:flex;align-items:center;justify-content:center;gap:6px}
.seg.on{background:var(--accent);color:#06101f}.seg i{font-style:normal;font-size:.72rem;opacity:.8}
.dk-cl{overflow:auto;display:flex;flex-direction:column;min-height:120px}
.dk-r{display:flex;align-items:center;gap:6px;padding:6px 0;border-bottom:1px solid var(--line)}.dk-r:last-child{border:0}
.dk-pickl{display:flex;flex-direction:column;gap:6px;max-height:34dvh;overflow:auto}.dk-pickl .dk-open{background:var(--panel2);border:1px solid var(--line);padding:8px}
.pk-l{font-size:.68rem;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);font-weight:800;margin-bottom:-4px}.pk-card{margin:0;font-weight:700;font-size:.95rem}
.dk-opts{display:flex;flex-direction:column;gap:8px}.opt{display:flex;align-items:center;gap:12px;min-height:54px;padding:0 14px;background:var(--panel2);border:1px solid var(--line);border-radius:14px;color:var(--text);text-decoration:none;font-size:.95rem;text-align:left}
.lk{color:var(--accent);font-size:.82rem;text-align:center}
.qv-scroll{overflow:auto;display:flex;flex-direction:column;gap:12px;flex:1;min-height:0}
.qv{display:flex;gap:14px;align-items:flex-start}.qv img{width:112px;border-radius:7px;flex:none;box-shadow:0 8px 22px rgba(0,0,0,.5)}
.qvt{flex:1;min-width:0;font-size:.88rem;line-height:1.55;overflow-wrap:anywhere}.qvt p{margin:0 0 8px;white-space:pre-wrap}.qvt small{color:var(--muted)}
.qv-act{display:grid;grid-template-columns:1fr 1fr;gap:8px}.qv-act .fav{grid-column:1/-1}
.qv-act .btn.on{border-color:var(--accent);background:var(--soft2)}
.qv-rul{border-top:1px solid var(--line);padding-top:12px}
#toast{position:fixed;left:50%;bottom:calc(var(--nav) + 18px + var(--sab));transform:translate(-50%,20px);z-index:90;background:#e9eefc;color:#0a1020;font-weight:650;font-size:.86rem;padding:11px 18px;border-radius:99px;box-shadow:0 10px 30px rgba(0,0,0,.45);opacity:0;pointer-events:none;transition:opacity .2s,transform .2s;max-width:calc(100% - 32px);text-align:center}
#toast.on{opacity:1;transform:translate(-50%,0)}
.deck-view{margin-top:0}
.deck-card-thumb .qty{display:none}
@media(max-width:480px){.qv{flex-direction:column;align-items:center;text-align:left}.qv img{width:150px}}

.lnk{display:flex;align-items:center;gap:14px;width:100%;background:none;border:0;border-top:1px solid var(--line);color:var(--text);font:inherit;font-size:.92rem;text-align:left;text-decoration:none;padding:0;min-height:56px}
.grp .lnk:first-child{border-top:0}.lnk span{flex:1}.lnk svg:first-child{color:var(--accent)}.lnk svg:last-child{color:var(--muted)}
.about h4{margin:18px 0 6px;font-size:.7rem;letter-spacing:.12em;text-transform:uppercase;color:var(--accent)}.about h4:first-child{margin-top:4px}
.about p{margin:0;font-size:.88rem;line-height:1.65;color:var(--text)}.about .ver{margin-top:20px;color:var(--muted);font-size:.78rem}
.deck-card-thumb .qty{display:block;position:absolute;right:3px;bottom:3px;top:auto;background:rgba(0,0,0,.82);color:#fff;border-radius:6px;padding:1px 6px;font-size:.7rem;font-weight:800}
.dk-nm em{font-style:normal;color:var(--accent);font-weight:800;font-size:.8rem;margin-left:4px}
.qv-steps{display:flex;flex-direction:column;gap:6px}.stp{display:flex;align-items:center;gap:10px;background:var(--panel2);border:1px solid var(--line);border-radius:14px;padding:6px 8px 6px 14px}.stp span{flex:1;font-weight:650}.stp b{min-width:22px;text-align:center}.stp .ibtn[disabled]{opacity:.35}.stp-t{color:var(--muted);font-size:.76rem;text-align:right}
.dlg.viewer{width:100%;height:100%;max-width:none;max-height:none;border-radius:0;border:0;padding:0;gap:0;background:var(--bg)}
.vw-bar{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:calc(8px + var(--sat)) 12px 8px;border-bottom:1px solid var(--line);background:var(--panel);flex:none}.vw-bar b{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0}.vw-bar span{display:flex;gap:6px;flex:none}
.sv-n{color:var(--muted)}.sv-img{max-width:100%;max-height:50dvh;object-fit:contain;border-radius:10px;background:#05080f;align-self:center}.vw-body{flex:1;overflow:auto;background:#05080f;-webkit-overflow-scrolling:touch;touch-action:pan-x pan-y pinch-zoom}.vw-svg{width:100%}.vw-svg svg{display:block;width:100%;height:auto}
.side .sheet,.full .sh{box-sizing:border-box}
</style>
</head>
<body>
<div id="wp" aria-hidden="true"></div><div id="ws" aria-hidden="true"></div>
<div id="topAdSafeArea" class="top-ad-safe-area" aria-label="Sponsor"><div id="topAdSlot" class="top-ad-slot"><span>ADVERTISEMENT</span></div></div>
<header>
  <div class="logo"><img src="data:image/png;base64," alt="KodeX logo"></div><div><div class="brand">Meta Insider OCG</div><div class="title">Duel Synapse: KodeX</div><div class="sub">Card &amp; Rulings Information Database</div></div>
</header>
<div class="search">
  <div class="searchbox"><span aria-hidden="true" style="display:grid"><svg class="i" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.2-4.2"/></svg></span><input id="q" type="search" enterkeyhint="search" autocomplete="off" autocapitalize="off" spellcheck="false" aria-label="Search cards" placeholder="Search cards"><button id="bClr" aria-label="Clear search" hidden>×</button><button id="bScan" class="scanbtn" aria-label="Scan a card with the camera" title="Scan a card"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8V6a2 2 0 0 1 2-2h2M16 4h2a2 2 0 0 1 2 2v2M20 16v2a2 2 0 0 1-2 2h-2M8 20H6a2 2 0 0 1-2-2v-2"/><rect x="8.5" y="7" width="7" height="10" rx="1.2"/></svg></button></div>
  <div class="status" role="status" aria-live="polite"><i id="dot" class="dot"></i><span id="st">Starting…</span></div>
  <div id="af" class="active" hidden aria-label="Active filters"></div>
</div>
<main id="main"><section id="list"></section><section id="detail" hidden></section></main>
<nav class="nav" aria-label="Main"><div>
  <button id="nSearch" class="on" aria-label="Search"><i class="ic"><svg class="i" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.2-4.2"/></svg></i>Search</button>
  <button id="bFil" aria-haspopup="dialog"><i class="ic"><svg class="i" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4"/></svg></i>Filters<i id="fc" hidden>0</i></button>
  <button id="nDeck"><i class="ic"><svg class="i" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l9 5-9 5-9-5z"/><path d="M3 13l9 5 9-5"/></svg></i>Decks</button>
  <button id="bSet" aria-haspopup="dialog"><i class="ic"><svg class="i" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h10M18 7h2M4 17h2M10 17h10"/><circle cx="16" cy="7" r="2"/><circle cx="8" cy="17" r="2"/></svg></i>Settings</button>
</div></nav>

<div id="Lfil" class="layer bottom"><section class="sheet" role="dialog" aria-modal="true" aria-label="Card filters"><div class="sh"><h3>Card Filters</h3><button class="ibtn" data-close aria-label="Close filters"><svg class="i" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button></div><div id="fBody" class="sb"></div><div class="fo"><button id="fRst" class="btn">Clear</button><button id="fOk" class="btn p">Apply</button></div></section></div>

<div id="Lset" class="layer side"><section class="sheet" role="dialog" aria-modal="true" aria-label="Settings"><div class="sh"><h3>Settings</h3><button class="ibtn" data-close aria-label="Close settings"><svg class="i" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button></div><div class="sb">
  <div class="sec">Display</div><div class="grp">
  <div class="row"><div><strong>Top spacing</strong><small id="satv">Auto</small></div><span style="display:flex;gap:8px;align-items:center"><input id="sat" type="range" min="0" max="72" step="2" style="width:100px" aria-label="Top spacing"><button class="btn" id="satAuto" style="min-height:38px;padding:0 12px">Auto</button></span></div>
  <div class="row"><div><strong>Duel Arena</strong><small>Playtest and online duels</small></div><button class="btn" id="arenaOpen" style="min-height:38px;padding:0 14px">Open</button></div>
  <div class="row"><div><strong>Arena offline</strong><small>Save your decks for offline play</small></div><button class="btn" id="arenaPrep" style="min-height:38px;padding:0 14px">Save</button></div>
  <div class="row"><div><strong>Self-check</strong><small>Tests this app on this device</small></div><button class="btn" id="diagRun" style="min-height:38px;padding:0 14px">Run</button></div>
  <div class="row"><div><strong>Image cache</strong><small id="icv">Empty</small></div><button class="btn" id="icClr" style="min-height:38px;padding:0 14px">Clear</button></div>
  <div class="row"><div><strong>Bottom spacing</strong><small id="sabv">Auto</small></div><span style="display:flex;gap:8px;align-items:center"><input id="sab" type="range" min="0" max="72" step="2" style="width:100px" aria-label="Bottom spacing"><button class="btn" id="sabAuto" style="min-height:38px;padding:0 12px">Auto</button></span></div>
  <div class="row"><div><strong>Text Size</strong><small id="tsv">100%</small></div><input id="ts" type="range" min="80" max="125" step="5" value="100" style="width:130px" aria-label="Text size"></div>
  <div class="row"><div><strong>Search Pictures</strong></div><button class="sw" role="switch" data-t="sp" aria-label="Search pictures"></button></div>
  <div class="row"><div><strong>Card Picture</strong></div><button class="sw" role="switch" data-t="cp" aria-label="Card picture"></button></div>
  <div class="row"><div><strong>Latest cards on home</strong></div><button class="sw" role="switch" data-t="lh" aria-label="Latest cards on home"></button></div></div>
  <div class="sec">Color Theme</div><div id="themes" class="themes"></div><div class="grp" style="margin-top:10px"><div class="row"><div><strong>Theme Intensity</strong><small id="tiVal">60%</small></div><input id="ti" type="range" min="0" max="100" step="5" value="60" style="width:130px" aria-label="Theme intensity"></div></div>
  <div class="sec">Wallpaper</div><div class="grp">
  <div class="row"><div><strong>Image</strong></div><label class="btn" style="margin:0">Choose<input id="wpIn" type="file" accept="image/*" hidden></label></div>
  <div class="row"><div><strong>Dimming</strong><small id="wov">35%</small></div><input id="wo" type="range" min="0" max="90" style="width:130px" aria-label="Wallpaper dimming"></div>
  <div class="row"><div><strong>Fit</strong></div><select id="wf" style="width:130px" aria-label="Wallpaper fit"><option value="cover">Cover</option><option value="contain">Contain</option><option value="100% 100%">Stretch</option></select></div>
  <div class="row"><div><strong>Remove wallpaper</strong></div><button class="btn" id="wrm">Remove</button></div></div>
  <div class="sec">Offline Rulings</div><div class="grp" style="padding:12px 14px">
    <button id="bDl" class="btn p" style="width:100%">Download all rulings</button><div class="prog"><i id="pg"></i></div><div id="dlst" class="note" style="margin-bottom:0">Not downloaded yet.</div></div>
  <div class="sec">Tools</div><div class="grp">
  <div class="row"><div><strong>Deck Manager</strong></div><button class="btn" id="bDecks">Open</button></div>
  <div class="row"><div><strong>Search History</strong></div><button class="btn" id="bHis">Open</button></div>
  <div class="row"><div><strong>Advanced Ruling Search</strong></div><button class="btn" id="bAdv">Open</button></div>
  <div class="row"><div><strong>System Check</strong></div><button class="btn" id="bChk">Run</button></div></div>
  <div class="sec">MEIOCG</div><div class="grp">
  <a class="lnk" href="mailto:metainsiderocg@gmail.com?subject=KodeX%20Support"><svg class="i" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg><span>Email Us</span><svg class="i" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></a>
  <a class="lnk" href="https://facebook.com/meiocgOfficial" target="_blank" rel="noopener noreferrer"><svg class="i" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8z"/></svg><span>Follow us on Facebook</span><svg class="i" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></a>
  <a class="lnk" href="https://youtube.com/@meiocg" target="_blank" rel="noopener noreferrer"><svg class="i" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="5.5" width="19" height="13" rx="4"/><path d="M10 9.5v5l4.5-2.5z"/></svg><span>Subscribe to our YouTube Channel</span><svg class="i" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></a>
  <button class="lnk" id="bAbout"><svg class="i" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/></svg><span>Legal &amp; Privacy</span><svg class="i" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button></div>
</div></div></section></div>

<div id="Ltool" class="layer bottom"><section class="sheet" role="dialog" aria-modal="true" aria-labelledby="tt"><div class="sh"><h3 id="tt">Tools</h3><button class="ibtn" data-close aria-label="Close"><svg class="i" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button></div><div id="tb" class="sb"></div></section></div>
<div id="Larena" class="layer" role="dialog" aria-modal="true" aria-label="Project: Duel Synapse"><div class="arbar"><span class="logo"><img id="arLogo" alt=""></span><div class="arti"><div class="brand">MEIOCG</div><div class="title">Project: Duel Synapse</div></div><button class="ibtn" data-close aria-label="Close"><svg class="i" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button></div><iframe id="arenaFrame" title="Project: Duel Synapse" allow="clipboard-write"></iframe></div>

<script>
'use strict';
const P='https://kodex.meiocg.org',IDX=P+'/indexes/search.json',NAMEIX=P+'/data/rulings/card-name-index.json',RUL=P+'/data/rulings/cards/',TTL=6*36e5;
const $=i=>document.getElementById(i);
const esc=s=>String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
const DEFAULT_IMG_PROXY='';/* optional override of the art host */
const IMG_BASE='https://kodex.meiocg.org';
const S={g(k,d){try{const v=localStorage.getItem('kx_'+k);if(v===null)return d;const j=JSON.parse(v);return(j===null||(d!==null&&typeof j!==typeof d)||Array.isArray(j)!==Array.isArray(d))?d:j}catch(e){return d}},s(k,v){try{localStorage.setItem('kx_'+k,JSON.stringify(v))}catch(e){}}};
let dbp;const db=()=>dbp||(dbp=new Promise((ok,no)=>{const r=indexedDB.open('kodex',1);r.onupgradeneeded=()=>r.result.createObjectStore('kv');r.onsuccess=()=>ok(r.result);r.onerror=()=>no(r.error)}));
const kv=async(m,k,v)=>{try{const d=await db();return await new Promise((ok,no)=>{const t=d.transaction('kv',m==='get'?'readonly':'readwrite'),o=t.objectStore('kv'),r=m==='get'?o.get(k):o.put(v,k);t.oncomplete=()=>ok(m==='get'?r.result:true);t.onerror=()=>no(t.error)})}catch(e){return undefined}};
const fj=async(u,ms=25000)=>{const c=new AbortController(),t=setTimeout(()=>c.abort(),ms);try{const r=await fetch(u,{signal:c.signal});if(!r.ok)throw Error('HTTP '+r.status);return await r.json()}finally{clearTimeout(t)}};
const nt=s=>String(s||'').toLowerCase().normalize('NFKD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z0-9]+/g,' ').trim();
const nz=s=>String(s||'').toLowerCase().replace(/[^a-z]/g,'');

let cards=[],M=new Map(),K=[],KN=new Map(),src='Local',cur=null,ccache=null;
const q=$('q'),list=$('list'),detail=$('detail');
const set=(t,off)=>{$('st').textContent=t;$('dot').className='dot'+(off?' off':'')};
const norm=x=>({id:x.id,name:x.name||'',kid:x.konami_id||x.konamiId||null,type:x.type||'',desc:x.desc||x.description||'',race:x.race||'',attr:x.attribute||'',lv:x.level,rk:x.rank,atk:x.atk??x.attack??null,def:x.def??x.defense??null,sc:x.scale??x.pendulum_scale??null,lk:x.linkval??x.linkValue??null,arch:x.archetype||'',img:x.image||x.image_url||x.card_images?.[0]?.image_url||'',sm:x.image_small||x.image_url_small||x.card_images?.[0]?.image_url_small||'',date:(String(x.ocg_date||x.release_date||x.releaseDate||x.misc_info?.[0]?.ocg_date||'').match(/\d{4}-\d{2}-\d{2}/)||[''])[0]});
function index(){M=new Map();KN=new Map();K=cards.map(c=>{M.set(String(c.id),c);if(c.kid)KN.set(String(c.kid),c.name);const n=nt(c.name),a=nt(c.arch),d=nt(c.desc);return{c,n,a,d,i:String(c.id),k:String(c.kid??''),all:n+' '+a+' '+d+' '+c.id+' '+(c.kid??'')}})}
function score(k,s,w){if(k.n===s)return 1e5;if(k.i===s||k.k===s)return 98e3;if(k.n.startsWith(s))return 9e4;if(k.n.includes(s))return 8e4;if(k.a&&k.a.includes(s))return 65e3;if(k.d.includes(s))return 5e4;return w.every(x=>k.all.includes(x))?3e4:0}

async function boot(){
  const c=await kv('get','cards');
  if(c&&Array.isArray(c.data)&&c.data.length){cards=c.data;index();set(`Offline data • ${cards.length.toLocaleString()} cards`,true);home()}
  else{set('Loading card database…');list.innerHTML='<div class="sk"></div>'.repeat(6)}
  if(!navigator.onLine&&!cards.length){set('No connection and no saved data yet. Connect once to load the database.',true);list.innerHTML='<div class="empty">Connect to the internet once to load the card database.</div>';return}
  try{
    const j=await fj(IDX,40000),a=Array.isArray(j)?j:(j.data||j.cards||[]);
    if(!a.length)throw Error('empty');
    cards=a.map(norm);index();kv('put','cards',{t:Date.now(),data:cards});src='MEIOCG';
    set(`${src} • ${cards.length.toLocaleString()} cards`);
  }catch(e){
    set(cards.length?`Offline mode • ${cards.length.toLocaleString()} cards saved on this device`:'Card database unavailable. Check your connection and reopen the app.',true);
    if(!cards.length){list.innerHTML='<div class="empty">Could not load the card database.<br><br><button class="btn p" id="rt">Try again</button></div>';$('rt').onclick=boot;return}
  }
  run();
}

/* ---------- search + filters ---------- */
const FG=[['types','Card Type',['Monster','Spell','Trap']],['attrs','Attribute',['DARK','LIGHT','EARTH','WATER','FIRE','WIND','DIVINE'],'Monster'],['races','Monster Type',['Aqua','Beast','Beast-Warrior','Cyberse','Dinosaur','Divine-Beast','Dragon','Fairy','Fiend','Fish','Insect','Machine','Plant','Psychic','Pyro','Reptile','Rock','Sea Serpent','Spellcaster','Thunder','Warrior','Winged Beast','Wyrm','Zombie'],'Monster'],['msub','Monster Details',['Normal','Effect','Fusion','Synchro','Xyz','Link','Ritual','Pendulum','Flip','Tuner','Gemini','Spirit','Toon','Union'],'Monster'],['ssub','Spell Type',['Normal','Continuous','Equip','Field','Quick-Play','Ritual'],'Spell'],['tsub','Trap Type',['Normal','Continuous','Counter'],'Trap']];
const RG=[['atk','ATK'],['def','DEF'],['lv','Level'],['rk','Rank'],['lk','Link Rating'],['sc','Pendulum Scale']];
const fresh=()=>{const f={};FG.forEach(g=>f[g[0]]=[]);RG.forEach(r=>f[r[0]]=['','']);return f};
let F=Object.assign(fresh(),S.g('filters',{}));
const nActive=()=>FG.reduce((n,g)=>n+F[g[0]].length,0)+RG.reduce((n,r)=>n+(F[r[0]][0]!==''||F[r[0]][1]!==''?1:0),0);
function renderActive(){const a=[];FG.forEach(g=>F[g[0]].forEach(v=>a.push([g[0],v,v])));RG.forEach(r=>{const [x,y]=F[r[0]];if(x!==''||y!=='')a.push([r[0],'',`${r[1]} ${x||'0'}–${y||'∞'}`])});$('af').hidden=!a.length;$('af').innerHTML=a.map(([g,v,l])=>`<button class="ac" data-g="${esc(g)}" data-v="${esc(v)}">${esc(l)} ×</button>`).join('')}
$('af').addEventListener('click',e=>{const b=e.target.closest('.ac');if(!b)return;const g=b.dataset.g;if(RG.some(r=>r[0]===g))F[g]=['','']; else F[g]=F[g].filter(x=>x!==b.dataset.v);S.s('filters',F);run()});
const hasM=()=>F.attrs.length||F.races.length||F.msub.length||RG.some(r=>F[r[0]][0]!==''||F[r[0]][1]!=='');
const cat=c=>{const t=c.type.toLowerCase();return t.includes('spell')?'Spell':t.includes('trap')?'Trap':'Monster'};
function match(c){
  const ct=cat(c),al=F.types.length?F.types:[...(hasM()?['Monster']:[]),...(F.ssub.length?['Spell']:[]),...(F.tsub.length?['Trap']:[])];
  if(al.length&&!al.includes(ct))return false;
  if(ct==='Monster'){
    const t=c.type.toLowerCase();
    if(F.attrs.length&&!F.attrs.some(a=>nz(a)===nz(c.attr)))return false;
    if(F.races.length&&!F.races.some(a=>nz(a)===nz(c.race)))return false;
    if(F.msub.length&&!F.msub.some(s=>s==='Normal'?t.includes('normal')&&!t.includes('effect'):t.includes(s.toLowerCase())))return false;
    for(const [k] of RG){const [a,b]=F[k];if(a===''&&b==='')continue;const v=c[k];if(v==null||v===''||isNaN(v))return false;if(a!==''&&+v<+a)return false;if(b!==''&&+v>+b)return false}
  }else if(ct==='Spell'){if(F.ssub.length&&!F.ssub.some(s=>nz(s)===nz(c.race)))return false}
  else if(F.tsub.length&&!F.tsub.some(s=>nz(s)===nz(c.race)))return false;
  return true;
}
function row(c){
  const im=S.g('sp',true)&&(c.sm||c.img)?`<img data-id="${esc(c.id)}" src="${esc(c.sm||c.img)}" alt="" loading="lazy" decoding="async">`:'';
  const ct=cat(c),l=c.lk?'Link '+c.lk:c.rk?'Rank '+c.rk:c.lv?'Level '+c.lv:'',st=[c.atk!=null&&c.atk!==''?'ATK '+c.atk:'',c.lk==null&&c.def!=null&&c.def!==''?'DEF '+c.def:''].filter(Boolean).join(' • ');
  return `<button class="card" data-id="${esc(c.id)}">${im}<span class="ci"><b class="cn">${esc(c.name)}${isFav(c)?` <span class="fm" aria-label="Favorite">${ic('star',13)}</span>`:''}</b><span class="tags"><em class="tg ${ct[0].toLowerCase()}">${esc(c.type||'Card')}</em>${c.attr?`<em class="tg">${esc(c.attr)}</em>`:''}</span><span class="meta">${[c.race,l].filter(Boolean).map(esc).join(' • ')}</span>${st?`<span class="meta">${esc(st)}</span>`:''}</span><span class="chev" aria-hidden="true">›</span></button>`;
}
function show(items,msg){list.innerHTML=items.length?items.map(row).join(''):`<div class="empty"><b>⌕</b>${msg}</div>`}
function home(){
  const f=nActive()>0;
  if(!cards.length){return}
  if(f)show(cards.filter(match).slice(0,300),'No cards match these filters.');
  else if(S.g('lh',true))show(cards.filter(c=>c.date).sort((a,b)=>b.date.localeCompare(a.date)||Number(b.id)-Number(a.id)).slice(0,50),'Search for a card');
  else show([],'Search for a card');
  $('fc').hidden=!f;$('fc').textContent=nActive();renderActive();
}
function run(){
  const s=nt(q.value);$('bClr').hidden=!q.value;
  if(!s){home();return}
  const w=s.split(' ').filter(Boolean),out=[];
  for(const k of K){const sc=score(k,s,w);if(sc&&match(k.c))out.push([sc,k.c])}
  out.sort((a,b)=>b[0]-a[0]||a[1].name.localeCompare(b[1].name));
  show(out.slice(0,80).map(x=>x[1]),'No cards found');
  set(`${src} • ${out.length} result${out.length===1?'':'s'}${nActive()?' • filters active':''}`,!navigator.onLine);
  $('fc').hidden=!nActive();$('fc').textContent=nActive();renderActive();
}
let tm;q.addEventListener('input',()=>{clearTimeout(tm);tm=setTimeout(run,150)});
q.addEventListener('change',()=>{const t=q.value.trim();if(t){const h=S.g('hist',[]).filter(x=>x!==t);h.unshift(t);S.s('hist',h.slice(0,30))}});
$('bClr').onclick=()=>{q.value='';run();q.focus()};
list.addEventListener('click',e=>{const b=e.target.closest('.card');if(b)openCard(b.dataset.id)});
document.addEventListener('error',e=>{const i=e.target;if(i.tagName!=='IMG'||i.dataset.f)return;i.dataset.f=1;const c=M.get(i.dataset.id);if(c&&c.img&&i.src!==c.img)i.src=c.img;else{i.style.visibility='hidden';const o=i.src;if(/^https:/.test(o))icGet(o).then(v=>{if(v){i.src=v;i.style.visibility=''}})}},true);

/* ---------- layers + Android back button ---------- */
const L=[];
const view0=(n,on)=>{if(n==='dv'||n==='noop'||!n)return;if(n.startsWith('m:')){if(!on){const e=document.getElementById(n.slice(2));if(e)e.remove()}return}if(on&&n!=='detail')setTimeout(()=>{const b=$('L'+n).querySelector('[data-close]');if(b)b.focus()},60);if(n==='detail'){detail.hidden=!on;list.hidden=on;if(on)$('main').scrollTop=0}else $('L'+n).classList.toggle('open',on)};
let arenaHash='';function arenaSet(on){const f=$('arenaFrame');if(on){const l=document.querySelector('header .logo img');if(l)$('arLogo').src=l.src;f.src=IMG_BASE+'/duel/?app=1&embed=1&th='+encodeURIComponent(S.g('theme','Midnight'))+(arenaHash?'#'+arenaHash:'')}else f.src='about:blank'}
const view=(n,on)=>{view0(n,on);if(n==='arena')arenaSet(on)};
const push=n=>{L.push(n);history.pushState(1,'');view(n,true);navSync()};
let skip=0;
function navSync(){const t=L[L.length-1]||'';[['nSearch',t===''||t==='detail'],['bFil',t==='fil'],['nDeck',t==='tool'&&$('tt').textContent==='Decks'],['bSet',t==='set']].forEach(([i,on])=>$(i).classList.toggle('on',on))}

const hideAll=()=>L.forEach((x,i)=>{view(x,false);L[i]='noop'});
function settle(){let k=0;while(L.length&&L[L.length-1]==='noop'){L.pop();k++}if(k){skip=1;history.go(-k)}}
addEventListener('popstate',()=>{if(skip){skip=0;navSync();return}const n=L.pop();if(n==='dv'){if(L.includes('tool'))openDeckPanel()}else if(n)view(n,false);settle();navSync()});
document.addEventListener('click',e=>{if(!L.length)return;const x=e.target.closest('[data-close]');if(x||e.target.classList.contains('layer')){if(L[L.length-1]==='dv'&&((x&&x.closest('#Ltool'))||e.target.id==='Ltool')){L.pop();history.go(-2);return}history.back()}});

/* ---------- card detail + rulings ---------- */
const fav=()=>S.g('fav',[]);
async function openCard(id){
  const c=M.get(String(id));if(!c)return;cur=c;
  const M2=cat(c)==='Monster',st=[['Card Type',c.type],[M2?'Monster Type':'Spell/Trap Type',c.race],['Attribute',M2?c.attr:''],['ATK',M2?c.atk:null],['DEF',M2&&c.lk==null?c.def:null],['Level',M2&&!c.rk&&!c.lk?c.lv:null],['Rank',M2?c.rk:null],['Link Rating',M2?c.lk:null],['Pendulum Scale',M2?c.sc:null],['Archetype',c.arch]].filter(x=>x[1]!==''&&x[1]!=null);
  const isF=fav().some(x=>String(x.id)===String(c.id));
  detail.innerHTML=`<div class="dbar"><button class="back" data-close><svg class="i" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>Back</button></div>
  <div class="hero">${S.g('cp',true)&&(c.img||c.sm)?`<img class="thumb" data-id="${esc(c.id)}" src="${esc(c.img||c.sm)}" alt="${esc(c.name)}">`:''}<div><h2>${esc(c.name)}</h2><div class="tags"><em class="tg ${cat(c)[0].toLowerCase()}">${esc(c.type)}</em>${M2&&c.attr?`<em class="tg">${esc(c.attr)}</em>`:''}</div></div></div>
  <div class="detail-actions"><button class="btn fav${isF?' fav-on':''}" id="bF" aria-pressed="${isF}">${favHTML(isF)}</button><button class="btn p" id="bAddDeck">${ic('plus',18)}Add to deck</button></div><div class="memb" data-membid="${esc(c.id)}"></div>
  <div class="panel"><div class="label">Details</div><div class="stats">${st.map(x=>`<div><span>${esc(x[0])}</span><strong>${esc(x[1])}</strong></div>`).join('')}</div></div>
  <div class="panel"><div class="label">Text</div><div class="effect">${esc(c.desc||'No card text available.')}</div></div>
  <div class="panel"><div class="label">Rulings</div><div id="rul" class="note">Loading rulings…</div></div>`;
  if(L[L.length-1]==='detail')view('detail',true);else{hideAll();push('detail')}
  $('bF').onclick=()=>{const on=toggleFav(c);setFavBtn($('bF'),on);toast(on?'Added to favorites':'Removed from favorites')};refreshMemb();
  $('bAddDeck').onclick=()=>addCardToDeck(c);
  rulings(c);
}
let nix;
function nameIx(){return nix||(nix=(async()=>{
  let m=await kv('get','nameix');if(m&&m.byName)return m.byName;
  const raw=await fj(NAMEIX,40000),by={};
  const walk=n=>{if(!n||typeof n!=='object')return;if(Array.isArray(n)){n.forEach(walk);return}for(const [name,v] of Object.entries(n)){for(const it of (Array.isArray(v)?v:[v])){const d=(typeof it==='number'||/^\d+$/.test(it))?it:it&&typeof it==='object'?(it.id??it.card_id??it.cardId??it.konami_id??it.konamiId):null;if(d!=null&&!/^\d+$/.test(name))by[nt(name)]=String(d)}if(v&&typeof v==='object')walk(v)}};
  walk(raw);kv('put','nameix',{byName:by});return by})().catch(e=>{nix=null;throw e}))}
async function getRul(id,force){
  const c=await kv('get','r:'+id);
  if(c&&c.data&&!force&&Date.now()-c.t<TTL)return c;
  try{const d=await fj(RUL+encodeURIComponent(id)+'.json',15000);if(!d||!Array.isArray(d.records))throw Error('bad');const r={t:Date.now(),data:d};await kv('put','r:'+id,r);return r}
  catch(e){if(c&&c.data)return Object.assign({stale:1},c);throw e}
}
const clean=t=>{const x=String(t??'').replace(/<\s*br\s*\/?>/gi,'\n').replace(/<\/(p|div|li)>/gi,'\n').replace(/<<\s*(\d{3,})\s*>>/g,(m,i)=>KN.get(i)||m).replace(/<<\s*([^<>]+?)\s*>>/g,'$1').replace(/<[^>]*>/g,''),a=document.createElement('textarea');a.innerHTML=x;return a.value.replace(/\n{3,}/g,'\n\n').trim()};
function entries(d){return d.records.map((r,i)=>{const h=r.history||{},en=r.api?.qaData?.en||{},ja=r.api?.qaData?.ja||{};return{id:String(en.id||r.id||h.fid||i+1),t:clean(en.title||h.title||ja.title),q:clean(en.question||h.question||ja.question),a:clean(en.answer||h.answer||ja.answer),en:!!(en.question||en.answer)}}).filter(x=>x.t||x.q||x.a)}
async function rulings(c,targetId='rul'){
  const box=$(targetId);if(!box)return;let id=c.kid;
  try{if(!id)id=(await nameIx())[nt(c.name)]}catch(e){}
  if(!id){box.textContent='Rulings are not available for this card yet.';return}
  try{
    const r=await getRul(id),es=entries(r.data);
    if(cur!==c||!box.isConnected)return;
    if(!es.length){box.textContent='No Q&A rulings are recorded for this card.';return}
    box.className='';
    box.innerHTML=`<div class="note"><strong>${es.length} Q&amp;A record${es.length===1?'':'s'}</strong> • ${r.stale||!navigator.onLine?'Saved on this device':'Up to date'}</div>`+es.map((x,i)=>`<details class="qa"><summary>${esc(x.t||x.q.slice(0,200)||'Q&A')}<span class="meta"> #${esc(x.id)}${x.en?'':' • original language'}</span></summary><div class="qb">${x.q?`<p><b>Q:</b> ${esc(x.q)}</p>`:''}${x.a?`<p><b>A:</b> ${esc(x.a)}</p>`:'<p>No answer stored.</p>'}${x.en?'':`<button type="button" class="translate-btn" data-translate-index="${i}">Translate to English</button><div class="translation-slot"></div>`}</div></details>`).join('');
    box.querySelectorAll('[data-translate-index]').forEach(btn=>{const x=es[Number(btn.dataset.translateIndex)];btn.onclick=()=>translateRulingToEnglish(x,btn,btn.parentElement.querySelector('.translation-slot'))});
  }catch(e){
    if(cur!==c)return;
    box.innerHTML=/404/.test(e.message)?'No Q&amp;A rulings are recorded for this card.':`Couldn’t load rulings. Check your connection. <button class="btn" id="rr">Retry</button>`;
    const b=box.querySelector('#rr');if(b)b.onclick=()=>{box.textContent='Loading rulings…';rulings(c,targetId)};
  }
}

/* ---------- machine translation (restored for Android WebView) ---------- */
function hasCJK(s){return /[\u3040-\u30ff\u3400-\u9fff\uac00-\ud7af]/.test(String(s||''))}
function translationSource(s){if(/[\u3040-\u30ff]/.test(s))return 'ja';if(/[\uac00-\ud7af]/.test(s))return 'ko';if(/[\u3400-\u9fff]/.test(s))return 'zh';return 'auto'}
function splitTranslation(s,max=300){const out=[];let rest=String(s||'');while(rest.length>max){let cut=rest.lastIndexOf(' ',max);if(cut<Math.floor(max*.55))cut=max;out.push(rest.slice(0,cut));rest=rest.slice(cut).trimStart()}if(rest)out.push(rest);return out}
function decodeTranslation(s){const t=document.createElement('textarea');t.innerHTML=String(s||'');return t.value}
async function translateOne(text,source){
 const chunks=splitTranslation(text,300),out=[];
 for(const chunk of chunks){
  let result='';
  try{
   const r=await fetch('https://translate.meiocg.org/translate',{method:'POST',mode:'cors',cache:'no-store',headers:{'Content-Type':'text/plain;charset=UTF-8','Accept':'application/json'},body:JSON.stringify({q:chunk,source:source||'auto',target:'en'})});
   if(!r.ok)throw Error('Translation proxy HTTP '+r.status);
   const j=await r.json();if(typeof j.translatedText!=='string'||!j.translatedText.trim())throw Error('Empty translation');result=decodeTranslation(j.translatedText);
  }catch(proxyError){
   const pair=(source||'auto')+'|en';
   const r=await fetch('https://api.mymemory.translated.net/get?mt=1&q='+encodeURIComponent(chunk)+'&langpair='+encodeURIComponent(pair),{mode:'cors',cache:'no-store'});
   if(!r.ok)throw Error('Translation service HTTP '+r.status);
   const j=await r.json();if(typeof j?.responseData?.translatedText!=='string'||!j.responseData.translatedText.trim())throw Error('Translation service returned no text');result=decodeTranslation(j.responseData.translatedText);
  }
  out.push(result);
 }
 return out.join('\n');
}
async function translateRulingToEnglish(x,button,slot){
 const key='translation:en:'+String(x.id||x.t||x.q).slice(0,180);
 button.disabled=true;button.textContent='Translating…';slot.innerHTML='<div class="note">Connecting to translation service…</div>';
 try{
  const cached=await kv('get',key);
  if(cached&&cached.q){renderTranslation(slot,cached.q,cached.a,true);button.textContent='English translation';return}
  const source=translationSource((x.q||'')+' '+(x.a||''));
  const q=x.q?await translateOne(x.q,source):'';const a=x.a?await translateOne(x.a,source):'';
  if(!q&&!a)throw Error('No translatable text was returned');
  await kv('put',key,{q:q||x.q,a:a||x.a,t:Date.now()});renderTranslation(slot,q||x.q,a||x.a,false);button.textContent='English translation';
 }catch(e){slot.innerHTML=`<div class="translation-error">Translation failed: ${esc(e.message||'Please check your connection and retry.')}</div>`;button.textContent='Retry translation'}
 finally{button.disabled=false}
}
function renderTranslation(slot,q,a,cached){slot.innerHTML=`<div class="translation-box"><div class="translation-label">English machine translation${cached?' • saved on this device':''}</div><div>${esc(q||'').replace(/\n/g,'<br>')}${a?`<div style="margin-top:8px"><b>A:</b> ${esc(a).replace(/\n/g,'<br>')}</div>`:''}</div></div>`}

/* ---------- filters UI ---------- */
function visF(){const t=[...document.querySelectorAll('#fBody [data-g=types] [aria-pressed=true]')].map(x=>x.dataset.v);document.querySelectorAll('#fBody [data-for]').forEach(e=>e.hidden=!t.includes(e.dataset.for));$('fHint').hidden=t.length>0}
function buildFilters(){
  const gs=FG.map(g=>`<div${g[3]?` data-for="${g[3]}"`:''}><div class="sec">${g[1]}</div><div class="chips" data-g="${g[0]}">${g[2].map(v=>`<button class="chip" aria-pressed="${F[g[0]].includes(v)}" data-v="${esc(v)}">${esc(v)}</button>`).join('')}</div></div>`);
  $('fBody').innerHTML=gs[0]+'<p id="fHint" class="note">Select Monster, Spell or Trap to see more filters.</p>'+gs.slice(1).join('')+`<div data-for="Monster"><div class="sec">Monster Stats</div><div class="rg">${RG.map(r=>`<div><label for="f_${r[0]}0">${r[1]} min</label><input id="f_${r[0]}0" type="number" inputmode="numeric" min="0" value="${esc(F[r[0]][0])}"></div><div><label for="f_${r[0]}1">${r[1]} max</label><input id="f_${r[0]}1" type="number" inputmode="numeric" min="0" value="${esc(F[r[0]][1])}"></div>`).join('')}</div></div>`;
  visF();
}
$('fBody').addEventListener('click',e=>{const b=e.target.closest('.chip');if(!b)return;b.setAttribute('aria-pressed',b.getAttribute('aria-pressed')!=='true');if(b.parentNode.dataset.g==='types')visF()});
$('bFil').onclick=()=>{buildFilters();push('fil')};
$('fOk').onclick=()=>{const f=fresh();document.querySelectorAll('#fBody .chips').forEach(g=>{if(!g.closest('[hidden]'))f[g.dataset.g]=[...g.querySelectorAll('[aria-pressed=true]')].map(x=>x.dataset.v)});RG.forEach(r=>{const a=$('f_'+r[0]+'0');if(!a.closest('[hidden]'))f[r[0]]=[a.value.trim(),$('f_'+r[0]+'1').value.trim()]});F=f;S.s('filters',F);history.back();run()};
$('fRst').onclick=()=>{F=fresh();S.s('filters',F);buildFilters();run()};

/* ---------- settings ---------- */
const TH={
  Midnight:{accent:'#67a8ff',bg:'#080a10',glow:'#17213a',panel:'#111522',panel2:'#171b2a',line:'#272d40',text:'#eef2ff',muted:'#9aa4bd'},
  Ocean:{accent:'#20d6c7',bg:'#061014',glow:'#10313b',panel:'#0d1d24',panel2:'#142a33',line:'#25434c',text:'#e7fbff',muted:'#91b8c2'},
  Emerald:{accent:'#4ade80',bg:'#07110c',glow:'#143522',panel:'#101e16',panel2:'#192b20',line:'#2b4935',text:'#edfff2',muted:'#9bb8a4'},
  Violet:{accent:'#a78bfa',bg:'#0c0914',glow:'#292044',panel:'#171326',panel2:'#211b32',line:'#39304f',text:'#f5f0ff',muted:'#b3a7cc'},
  Crimson:{accent:'#ff5c7c',bg:'#13080d',glow:'#3a1724',panel:'#21121a',panel2:'#301923',line:'#4b2935',text:'#fff0f3',muted:'#c9a0ab'},
  Amber:{accent:'#fbbf24',bg:'#120e06',glow:'#38290e',panel:'#201a0e',panel2:'#302716',line:'#4b3d22',text:'#fff8e8',muted:'#c5b58e'}
};
function applyUI(){
  const s=Math.max(80,Math.min(125,Number(S.g('ts',100))||100));
  document.documentElement.style.fontSize=(16*s/100)+'px';$('ts').value=s;$('tsv').textContent=s+'%';
  const name=S.g('theme','Midnight'),theme=TH[name]||TH.Midnight,root=document.documentElement.style,intensity=Math.max(0,Math.min(100,Number(S.g('ti',60))));$('ti').value=intensity;$('tiVal').textContent=intensity+'%';
  for(const k of ['bg','panel','panel2','line','text','muted','accent'])root.setProperty('--'+k,theme[k]);
  const hex=theme.glow.replace('#',''),gr=parseInt(hex.slice(0,2),16),gg=parseInt(hex.slice(2,4),16),gb=parseInt(hex.slice(4,6),16),ga=(intensity/100*.72).toFixed(3);document.body.style.background=`radial-gradient(circle at top,rgba(${gr},${gg},${gb},${ga}) 0,${theme.bg} 58%) ${theme.bg}`;
  root.setProperty('--theme-glow',theme.glow);{const h=theme.accent,r=parseInt(h.slice(1,3),16),g=parseInt(h.slice(3,5),16),b=parseInt(h.slice(5,7),16);root.setProperty('--soft',`rgba(${r},${g},${b},${(.03+intensity/100*.20).toFixed(3)})`);root.setProperty('--soft2',`rgba(${r},${g},${b},${(.02+intensity/100*.13).toFixed(3)})`);document.querySelector('meta[name=theme-color]').setAttribute('content',theme.bg)}
  document.querySelectorAll('.sw').forEach(b=>b.setAttribute('aria-checked',S.g(b.dataset.t,true)));
  $('themes').innerHTML=Object.entries(TH).map(([n,c])=>`<button aria-pressed="${name===n}" data-th="${n}"><i style="background:${c.accent}"></i>${n}</button>`).join('');
}
$('ts').oninput=e=>{S.s('ts',+e.target.value);applyUI()};
$('ti').oninput=e=>{S.s('ti',+e.target.value);applyUI()};
document.querySelectorAll('.sw').forEach(b=>b.onclick=()=>{S.s(b.dataset.t,!S.g(b.dataset.t,true));applyUI();if(!detail.hidden&&b.dataset.t==='cp'&&cur)openCard(cur.id);else run()});
$('themes').addEventListener('click',e=>{const b=e.target.closest('[data-th]');if(b){S.s('theme',b.dataset.th);applyUI()}});
$('bSet').onclick=()=>{push('set');savedCount()};
function tool(t,h){$('Ltool').classList.remove('full');$('tt').textContent=t;$('tb').innerHTML=h;L.includes('tool')?0:push('tool')}
/* ---------- icons, dialogs, toast ---------- */
const IC={play:'<path d="M8 5v14l11-7z"/>',plus:'<path d="M12 5v14M5 12h14"/>',back:'<path d="M15 18l-6-6 6-6"/>',list:'<path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/>',image:'<rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/>',down:'<path d="M12 4v11M7 11l5 5 5-5M5 20h14"/>',file:'<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/>',edit:'<path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/>',trash:'<path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13"/>',x:'<path d="M6 6l12 12M18 6L6 18"/>',cam:'<path d="M4 8h3l2-3h6l2 3h3v11H4z"/><circle cx="12" cy="13" r="3.5"/>',up:'<path d="M12 20V9M7 13l5-5 5 5M5 4h14"/>',star:'<path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z"/>',search:'<circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.2-4.2"/>',deck:'<path d="M12 3l9 5-9 5-9-5z"/><path d="M3 13l9 5 9-5"/>'};
const ic=(n,s=20)=>`<svg class="i" width="${s}" height="${s}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${IC[n]}</svg>`;
const favLbl=on=>`${ic('star',18)}${on?'Saved':'Save'}`;
let mseq=0;
function openModal(html,cls='',key=''){const id='mdl'+(++mseq),el=document.createElement('div');el.id=id;el.className='layer open mdl'+(cls.indexOf('viewer')>-1?' vwm':'');if(key)el.dataset.k=key;el.innerHTML=`<div class="dlg ${cls}" role="dialog" aria-modal="true">${html}</div>`;document.body.appendChild(el);L.push('m:'+id);history.pushState(1,'');navSync();return el}
const topIsModal=()=>(L[L.length-1]||'').startsWith('m:');
const closeModal=()=>{if((L[L.length-1]||'').startsWith('m:'))history.back()};
function toast(t){let e=$('toast');if(!e){e=document.createElement('div');e.id='toast';e.setAttribute('role','status');document.body.appendChild(e)}e.textContent=t;e.className='on';clearTimeout(toast.t);toast.t=setTimeout(()=>{e.className=''},2600)}
function confirmBox(title,yes,fn){const m=openModal(`<h3>${esc(title)}</h3><div class="dact"><button class="btn" data-close>Cancel</button><button class="btn danger" id="cfy">${esc(yes)}</button></div>`);m.querySelector('#cfy').onclick=()=>{closeModal();setTimeout(fn,90)}}
function openLink(url,label){openModal(`<h3>${esc(label)}</h3><div class="dact"><button class="btn" data-close>Close</button><a class="btn p" href="${esc(url)}" target="_blank" rel="noopener">Open</a></div>`)}

/* ---------- deck data ---------- */
function normalizeDeck(d){const raw=Array.isArray(d.cards)?d.cards:[],tot=new Map(),out=[];for(const c of raw){const id=String(c.id),sec=['main','extra','side'].includes(c.section)?c.section:'main',used=tot.get(id)||0;let q=Math.max(1,Math.min(3,parseInt(c.qty)||1));q=Math.min(q,3-used);if(q<=0)continue;tot.set(id,used+q);const ex=out.find(x=>x.id===id&&x.section===sec);if(ex)ex.qty+=q;else out.push({id,name:c.name||'Unknown card',kid:c.kid||null,section:sec,qty:q})}d.cards=out;d.icon=d.icon||'';return d}
const deckStore=()=>S.g('decks',[]).map(normalizeDeck);
const CAP={main:60,extra:15,side:15};
const deckTotal=d=>d.cards.reduce((n,c)=>n+(c.qty||1),0);
const copiesOf=(d,c)=>d.cards.filter(x=>String(x.id)===String(c.id)).reduce((n,x)=>n+x.qty,0);
const copies=(d,k)=>d.cards.filter(c=>c.section===k).flatMap(c=>Array.from({length:c.qty||1},()=>c));
function allowedSec(c,sec){const live=resolveDeckCard(c);if(!live)return true;return sec==='side'||(extraType(live)?sec==='extra':sec==='main')}
function addCopy(d,c,sec){if(copiesOf(d,c)>=3)return 'Maximum 3 copies';if(!allowedSec(c,sec))return 'Not allowed in '+SEC[sec];if(cnt(d,sec)>=CAP[sec])return SEC[sec]+' deck is full';const e=d.cards.find(x=>String(x.id)===String(c.id)&&x.section===sec);if(e)e.qty++;else d.cards.push({id:String(c.id),name:c.name,kid:c.kid||null,section:sec,qty:1});return 'ok'}
function dropCopy(d,id,sec){const e=d.cards.find(x=>String(x.id)===String(id)&&x.section===sec);if(!e)return false;if(--e.qty<=0)d.cards=d.cards.filter(x=>x!==e);return true}
function moveCopy(deckId,id,from,to){const a=deckStore(),d=a.find(x=>String(x.id)===String(deckId));if(!d||!from||from===to)return;const e=d.cards.find(x=>String(x.id)===String(id)&&x.section===from);if(!e)return;const c={id:e.id,name:e.name,kid:e.kid};if(!allowedSec(c,to)){toast('Not allowed in '+SEC[to]);return}if(cnt(d,to)>=CAP[to]){toast(SEC[to]+' deck is full');return}dropCopy(d,id,from);addCopy(d,c,to);saveDecks(a);showDeck(d.id)}
const saveDecks=a=>S.s('decks',a);
const deckById=id=>deckStore().find(d=>String(d.id)===String(id));
const cardInDeck=(d,c)=>d.cards.some(x=>String(x.id)===String(c.id));
const _oldNorm=d=>{d.cards=Array.isArray(d.cards)?d.cards.map(c=>({id:String(c.id),name:c.name||'Unknown card',kid:c.kid||null,section:['main','extra','side'].includes(c.section)?c.section:'main'})):[];return d};
function createDeck(name,icon){name=String(name||'').trim();if(!name)return null;const a=deckStore(),d={id:'d'+Date.now().toString(36)+Math.random().toString(36).slice(2,6),name:name.slice(0,60),cards:[],created:Date.now(),icon:icon||''};a.push(d);saveDecks(a);return d}
const cnt=(d,k)=>d.cards.filter(c=>c.section===k).reduce((n,c)=>n+(c.qty||1),0);
const deckIcon=(d,s=48)=>d.icon?`<img class="dk-ic" style="width:${s}px;height:${s}px" src="${esc(d.icon)}" alt="">`:`<span class="dk-ic ph" style="width:${s}px;height:${s}px;font-size:${Math.round(s*.42)}px">${esc((d.name||'?').trim().charAt(0).toUpperCase())}</span>`;
/* ---------- deck form + icon crop ---------- */
function cropIcon(file,done){
  const img=new Image(),url=URL.createObjectURL(file);
  img.onerror=()=>{URL.revokeObjectURL(url);toast('Image could not be opened')};
  img.onload=()=>{
    const V=280,m=openModal(`<h3>Adjust icon</h3><div class="crop"><canvas id="cv" width="${V}" height="${V}"></canvas></div><input id="cz" class="zoom" type="range" min="1" max="4" step="0.01" value="1" aria-label="Zoom"><div class="dact"><button class="btn" data-close>Cancel</button><button class="btn p" id="cok">Use icon</button></div>`),
      cv=m.querySelector('#cv'),cx=cv.getContext('2d'),w=img.naturalWidth,h=img.naturalHeight,s0=Math.max(V/w,V/h);
    let z=1,ox=(V-w*s0)/2,oy=(V-h*s0)/2,p=null;
    const draw=()=>{const dw=w*s0*z,dh=h*s0*z;ox=Math.min(0,Math.max(V-dw,ox));oy=Math.min(0,Math.max(V-dh,oy));cx.fillStyle='#000';cx.fillRect(0,0,V,V);cx.drawImage(img,ox,oy,dw,dh)};
    draw();
    m.querySelector('#cz').oninput=e=>{const nz=+e.target.value,a=(V/2-ox)/(s0*z),b=(V/2-oy)/(s0*z);z=nz;ox=V/2-a*s0*z;oy=V/2-b*s0*z;draw()};
    cv.onpointerdown=e=>{p={x:e.clientX,y:e.clientY,ox,oy};cv.setPointerCapture(e.pointerId)};
    cv.onpointermove=e=>{if(!p)return;const k=V/cv.getBoundingClientRect().width;ox=p.ox+(e.clientX-p.x)*k;oy=p.oy+(e.clientY-p.y)*k;draw()};
    cv.onpointerup=cv.onpointercancel=()=>{p=null};
    m.querySelector('#cok').onclick=()=>{const o=document.createElement('canvas');o.width=o.height=192;const k=192/V;o.getContext('2d').drawImage(img,ox*k,oy*k,w*s0*z*k,h*s0*z*k);const u=o.toDataURL('image/jpeg',.88);URL.revokeObjectURL(url);closeModal();setTimeout(()=>done(u),90)};
  };
  img.src=url;
}
function deckForm(d,after){
  let icon=d?d.icon||'':'';
  const m=openModal(`<h3>${d?'Edit deck':'New deck'}</h3><div class="dk-form"><button type="button" class="dk-pick" id="dfIcon" aria-label="Choose icon"></button><input id="dfName" class="fld" maxlength="60" placeholder="Deck name" value="${esc(d?d.name:'')}"></div><input id="dfFile" type="file" accept="image/*" hidden><div class="dact">${d&&d.icon?'<button class="btn" id="dfClr">Remove icon</button>':''}<button class="btn" data-close>Cancel</button><button class="btn p" id="dfOk">${d?'Save':'Create'}</button></div>`);
  const paint=()=>{m.querySelector('#dfIcon').innerHTML=icon?`<img src="${icon}" alt="">`:ic('cam',26)};paint();
  m.querySelector('#dfIcon').onclick=()=>m.querySelector('#dfFile').click();
  m.querySelector('#dfFile').onchange=e=>{const f=e.target.files[0];e.target.value='';if(f)cropIcon(f,u=>{icon=u;paint()})};
  const clr=m.querySelector('#dfClr');if(clr)clr.onclick=()=>{icon='';paint();clr.remove()};
  m.querySelector('#dfOk').onclick=()=>{const n=m.querySelector('#dfName').value.trim();if(!n){toast('Enter a deck name');return}closeModal();setTimeout(()=>after(n,icon),90)};
  setTimeout(()=>{const f=m.querySelector('#dfName');if(f)f.focus()},120);
}

/* ---------- decks screens ---------- */
function openDeckPanel(){
  const ds=deckStore().map(normalizeDeck),fs=fav();window.activeDeckId=null;
  tool('Decks',`<div class="dk-bar"><button class="btn p" data-dknew>${ic('plus',18)}New deck</button><button class="btn" data-arena>${ic('play',18)}Arena</button><label class="btn">${ic('up',18)}Import<input id="ydkImport" type="file" accept="*/*" hidden></label></div>${ds.length?`<div class="dk-grid">${ds.map(d=>`<div class="dk-item"><button class="dk-open" data-viewdeck="${esc(d.id)}">${deckIcon(d,52)}<span class="dk-t"><b>${esc(d.name)}</b><small>${deckTotal(d)} cards · ${cnt(d,'main')} / ${cnt(d,'extra')} / ${cnt(d,'side')}</small></span></button><button class="ibtn" data-editdeck="${esc(d.id)}" aria-label="Edit ${esc(d.name)}">${ic('edit')}</button><button class="ibtn" data-deletedeck="${esc(d.id)}" aria-label="Delete ${esc(d.name)}">${ic('trash')}</button></div>`).join('')}</div>`:`<div class="dk-empty">${ic('deck',36)}<b>No decks yet</b></div>`}${fs.length?`<div class="sec">Favorites</div><div class="grp">${fs.map(c=>`<div class="row"><strong class="dk-nm">${esc(c.name)}</strong><span class="dk-ac"><button class="ibtn" data-favview="${esc(c.id)}" aria-label="View ${esc(c.name)}">${ic('search')}</button><button class="ibtn" data-favadd="${esc(c.id)}" aria-label="Add ${esc(c.name)} to a deck">${ic('plus')}</button></span></div>`).join('')}</div>`:''}`);
  $('Ltool').classList.add('full');
}
const LIVE=new Map(),LIVEBAD=new Set();
async function liveCard(code){code=String(code||'');if(!/^\d{3,10}$/.test(code))return null;if(LIVE.has(code))return LIVE.get(code);if(LIVEBAD.has(code))return null;
  let c=await kv('get','lc:'+code);
  if(!c)for(const q of ['id','konami_id']){try{const ctl=new AbortController(),t=setTimeout(()=>ctl.abort(),8000);const r=await fetch('https://db.ygoprodeck.com/api/v7/cardinfo.php?'+q+'='+encodeURIComponent(code),{signal:ctl.signal});clearTimeout(t);if(!r.ok)continue;const j=await r.json(),x=j&&j.data&&j.data[0];if(x){c={id:x.id,kid:(x.misc_info&&x.misc_info[0]&&x.misc_info[0].konami_id)||null,name:x.name,type:x.type,desc:x.desc,atk:x.atk,def:x.def,level:x.level,race:x.race,attribute:x.attribute,img:'https://images.ygoprodeck.com/images/cards/'+x.id+'.jpg'};kv('put','lc:'+code,c);break}}catch(e){}}
  if(c){LIVE.set(code,c);return c}LIVEBAD.add(code);return null}
async function fillUnknown(d){const miss=[...new Set(d.cards.filter(e=>!resolveDeckCard(e)).map(e=>String(e.kid||e.id)))].filter(k=>!LIVEBAD.has(k));if(!miss.length)return;let n=0;
  for(const k of miss){const x=await liveCard(k);if(x)n++}
  if(!n)return;const a=deckStore(),t=a.find(v=>String(v.id)===String(d.id));if(!t)return;
  for(const e of t.cards){const x=LIVE.get(String(e.kid||e.id))||LIVE.get(String(e.id));if(x&&(!e.name||/^Unknown card/i.test(e.name))){e.name=x.name;e.kid=e.kid||x.kid||e.id}}
  saveDecks(a);if(String(window.activeDeckId)===String(d.id)&&L.includes('tool')&&!document.querySelector('.mdl'))showDeck(d.id)}
function resolveDeckCard(c){return M.get(String(c.id))||M.get(String(c.kid||''))||cards.find(x=>String(x.id)===String(c.id)||String(x.kid)===String(c.kid||c.id)||String(x.konami_id||'')===String(c.kid||c.id))||LIVE.get(String(c.kid||''))||LIVE.get(String(c.id))||null}
function deckCardImageUrl(c){const live=resolveDeckCard(c)||c||{};const vals=[live.img,live.sm,live.image,live.image_url,live.image_small,live.image_url_small,live.card_images?.[0]?.image_url,live.card_images?.[0]?.image_url_small,c?.img,c?.image,c?.image_url];for(const v of vals){if(typeof v==='string'&&v.trim()&&(/^(https?:|data:image\/|blob:|\.\.?\/)/i.test(v.trim())))return v.trim()}const code=String(live.id||c?.id||'');if(/^\d{3,}$/.test(code))return 'https://images.ygoprodeck.com/images/cards/'+encodeURIComponent(code)+'.jpg';return ''}
function deckThumb(c){const img=deckCardImageUrl(c),q=c.qty>1?`<span class="qty">×${c.qty}</span>`:'',at=`draggable="true" class="deck-card-thumb" data-dragcard="${esc(c.id)}" data-quickview="${esc(c.id)}" data-fromsec="${esc(c.section)}" aria-label="${esc(c.name)}${c.qty>1?' ×'+c.qty:''}"`;return img?`<button type="button" ${at}><img loading="lazy" data-u="${esc(img)}" alt="" draggable="false" onerror="kxImgErr(this)">${q}</button>`:`<button type="button" ${at}><span class="missing-card">${esc(c.name||'')}</span>${q}</button>`}
function showDeck(deckId){
  const d=deckById(deckId);if(!d)return;
  const same=String(window.activeDeckId)===String(d.id)&&L.includes('tool'),sc=same?$('tb').scrollTop:0;
  window.activeDeckId=d.id;normalizeDeck(d);
  const secs=[['main','Main'],['extra','Extra'],['side','Side']],bg=posterBackground?`background-image:linear-gradient(rgba(5,8,15,.42),rgba(5,8,15,.42)),url("${posterBackground}")`:'';
  tool('Decks',`<div class="dk-bar"><button class="ibtn" id="deckBack" aria-label="All decks">${ic('back')}</button><span class="dk-who">${deckIcon(d,36)}<span class="dk-t"><b>${esc(d.name)}</b><small>${deckTotal(d)} cards</small></span></span><span class="dk-ac"><button class="ibtn" data-cardlist aria-label="Card list">${ic('list')}</button><label class="ibtn" aria-label="Background">${ic('image')}<input id="posterBg" type="file" accept="image/*" hidden></label><button class="ibtn" data-playtest="${esc(d.id)}" aria-label="Playtest">${ic('play')}</button><button class="ibtn" data-exportmenu="${esc(d.id)}" aria-label="Export">${ic('down')}</button><button class="ibtn" data-editdeck="${esc(d.id)}" aria-label="Edit deck">${ic('edit')}</button></span></div><div class="deck-view" id="deckView" style='${bg}'>${secs.map(([k,l])=>{const list=d.cards.filter(c=>c.section===k);return `<section class="deck-section" data-dropsection="${k}" data-dropdeck="${esc(d.id)}"><div class="deck-section-head"><span>${l}</span><span>${cnt(d,k)}</span></div><div class="deck-cards-grid">${list.length?list.map(deckThumb).join(''):'<div class="deck-empty" style="grid-column:1/-1">Empty</div>'}</div></section>`}).join('')}</div>`);
  $('Ltool').classList.add('full');$('tb').scrollTop=sc;
  if(!L.includes('dv'))push('dv');
  try{icWarm(d.cards.map(c=>deckCardImageUrl(c)).filter(Boolean))}catch(e){}
  fillUnknown(d);
}
function refreshCardList(){const o=document.querySelector('.mdl[data-k=cl]');if(o)cardListModal(o.dataset.sec||'main')}
function cardListModal(sec='main'){
  const d=deckById(window.activeDeckId);if(!d)return;normalizeDeck(d);
  const tabs=['main','extra','side'].map(k=>`<button class="seg${k===sec?' on':''}" data-cltab="${k}">${k[0].toUpperCase()+k.slice(1)}<i>${cnt(d,k)}</i></button>`).join(''),list=d.cards.filter(c=>c.section===sec);
  const body=`<div class="dk-hd"><h3>Card list</h3><button class="ibtn" data-close aria-label="Close">${ic('x')}</button></div><div class="seg-w">${tabs}</div><div class="dk-cl">${list.length?list.map(c=>`<div class="dk-r"><span class="dk-nm">${esc(c.name)}${c.qty>1?` <em>×${c.qty}</em>`:''}</span><button class="ibtn" data-quickview="${esc(c.id)}" aria-label="Details ${esc(c.name)}">${ic('search')}</button><button class="ibtn" data-removefromdeck="${esc(d.id)}" data-cardid="${esc(c.id)}" data-sec="${esc(c.section)}" aria-label="Remove one ${esc(c.name)}">${ic('trash')}</button></div>`).join(''):'<div class="deck-empty">Empty</div>'}</div>`;
  const o=document.querySelector('.mdl[data-k=cl]');
  if(o){o.firstChild.innerHTML=body;o.dataset.sec=sec}else{const m=openModal(body,'big','cl');m.dataset.sec=sec}
}
/* ---------- favorites, membership, add-to-deck options ---------- */
const isFav=c=>fav().some(x=>String(x.id)===String(c.id));
function toggleFav(c){const a=fav(),i=a.findIndex(x=>String(x.id)===String(c.id));if(i>=0)a.splice(i,1);else a.unshift({id:c.id,name:c.name});S.s('fav',a.slice(0,500));return i<0}
const favHTML=on=>`${ic('star',18)}${on?'Favorited':'Add to favorites'}`;
function setFavBtn(b,on){b.innerHTML=favHTML(on);b.classList.toggle('fav-on',on);b.setAttribute('aria-pressed',on)}
const extraType=c=>/\b(fusion|synchro|xyz|link)\b/i.test(c.type||'');
const secsFor=c=>extraType(c)?['extra','side']:['main','side'];
const SEC={main:'Main',extra:'Extra',side:'Side'};
const membership=c=>deckStore().map(d=>{const xs=d.cards.filter(v=>String(v.id)===String(c.id));return xs.length?`${d.name} · ${xs.map(x=>SEC[x.section]+(x.qty>1?' ×'+x.qty:'')).join(', ')}`:null}).filter(Boolean);
function refreshMemb(){document.querySelectorAll('.memb').forEach(el=>{const c=M.get(String(el.dataset.membid));if(!c)return;const a=membership(c);el.innerHTML=a.length?`<span class="mb-l">In decks</span>${a.map(x=>`<em>${esc(x)}</em>`).join('')}`:''})}
function refreshDecksOpen(){if(L.includes('tool')&&$('tt').textContent==='Decks'){window.activeDeckId?showDeck(window.activeDeckId):openDeckPanel()}}
function addCardToDeck(c){
  if(!deckStore().length){deckForm(null,(n,i)=>{const d=createDeck(n,i);if(d)addPicker(c,d.id)});return}
  addPicker(c);
}
function addPicker(c,pre){
  const secs=secsFor(c),first=deckStore().find(d=>copiesOf(d,c)<3)||deckStore()[0];
  let dk=pre||first.id,sc=secs[0];
  const m=openModal('','big','pk');
  const draw=()=>{
    const ds=deckStore(),d=ds.find(x=>x.id===dk)||ds[0],n=d?copiesOf(d,c):0,full=d&&cnt(d,sc)>=CAP[sc],blocked=n>=3||full;
    m.firstChild.innerHTML=`<div class="dk-hd"><h3>Add to deck</h3><button class="ibtn" data-close aria-label="Close">${ic('x')}</button></div><p class="pk-card">${esc(c.name)}</p><div class="pk-l">Deck</div><div class="dk-pickl">${ds.map(x=>{const k=copiesOf(x,c);return `<button class="dk-open${x.id===dk?' sel':''}" data-pkdeck="${esc(x.id)}">${deckIcon(x,40)}<span class="dk-t"><b>${esc(x.name)}</b><small>${deckTotal(x)} cards${k?' · ×'+k+' of this card':''}</small></span></button>`}).join('')}</div><div class="pk-l">Section</div><div class="seg-w">${secs.map(k=>`<button class="seg${k===sc?' on':''}" data-pksec="${k}">${SEC[k]}</button>`).join('')}</div><div class="dact"><button class="btn" data-pknew>${ic('plus',18)}New deck</button><button class="btn p" data-pkgo${blocked?' disabled':''}>${n>=3?'Maximum 3 copies':full?SEC[sc]+' deck is full':'Add to '+SEC[sc]}</button></div>`;
  };
  draw();
  m.addEventListener('click',ev=>{
    const b=ev.target.closest('button');if(!b)return;
    if(b.dataset.pkdeck){dk=b.dataset.pkdeck;draw()}
    else if(b.dataset.pksec){sc=b.dataset.pksec;draw()}
    else if(b.hasAttribute('data-pknew')){deckForm(null,(n,i)=>{const d=createDeck(n,i);if(d){dk=d.id;draw()}})}
    else if(b.hasAttribute('data-pkgo')){const a=deckStore(),d=a.find(x=>x.id===dk);if(!d)return;const r=addCopy(d,c,sc);if(r!=='ok'){toast(r);return}saveDecks(a);closeModal();toast(`Added · ${d.name} · ${SEC[sc]}`);setTimeout(()=>{refreshMemb();refreshDecksOpen()},140)}
  });
}
function quickView(id){
  const dcd=deckById(window.activeDeckId),dc=dcd&&dcd.cards.find(x=>String(x.id)===String(id)),c=(dc&&resolveDeckCard(dc))||M.get(String(id))||cards.find(x=>String(x.kid)===String(id));
  if(!c){openModal(`<div class="dk-hd"><h3>${esc(dc?dc.name:'Card')}</h3><button class="ibtn" data-close aria-label="Close">${ic('x')}</button></div><p class="note">Details unavailable${dc?' · Passcode '+esc(dc.id):''}</p>`);return}
  const img=deckCardImageUrl(c),sec=dc?dc.section:'';
  const m=openModal(`<div class="dk-hd"><h3>${esc(c.name)}</h3><button class="ibtn" data-close aria-label="Close">${ic('x')}</button></div><div class="qv-scroll"><div class="qv">${img?`<img src="${esc(img)}" alt="">`:''}<div class="qvt"><p class="meta">${esc(c.type||'')}${c.atk!=null?' · ATK '+esc(c.atk)+(c.def!=null?' / DEF '+esc(c.def):''):''}</p><p>${esc(c.desc||'Details unavailable')}</p><small>Passcode ${esc(c.id)}</small></div></div><div class="qv-act"><button class="btn fav" data-qvfav></button><button class="btn" data-qvadd>${ic('plus',18)}Add to deck</button><button class="btn" data-qvrul>${ic('list',18)}Rulings</button></div><div class="memb" data-membid="${esc(c.id)}"></div>${dcd?`<div class="pk-l">Copies in deck</div><div class="qv-steps" id="qvsteps"></div>`:''}<div class="qv-rul" id="qvrul" hidden></div></div>`,'big','qv');
  const fb=m.querySelector('[data-qvfav]');setFavBtn(fb,isFav(c));refreshMemb();
  const steps=()=>{const box=m.querySelector('#qvsteps');if(!box)return;const d=deckById(window.activeDeckId);if(!d)return;const ks=[...new Set([...secsFor(c),...d.cards.filter(x=>String(x.id)===String(c.id)).map(x=>x.section)])],tot=copiesOf(d,c);box.innerHTML=ks.map(k=>{const e=d.cards.find(x=>String(x.id)===String(c.id)&&x.section===k),q=e?e.qty:0;return `<div class="stp"><span>${SEC[k]}</span><button class="ibtn" data-qvstep="${k}:-1" aria-label="Remove one from ${SEC[k]}"${q?'':' disabled'}>−</button><b>${q}</b><button class="ibtn" data-qvstep="${k}:1" aria-label="Add one to ${SEC[k]}"${tot>=3||cnt(d,k)>=CAP[k]?' disabled':''}>+</button></div>`}).join('')+`<small class="stp-t">${tot} of 3 copies</small>`};steps();
  m.addEventListener('click',ev=>{
    const b=ev.target.closest('button');if(!b)return;
    if(b.hasAttribute('data-qvfav')){const on=toggleFav(c);setFavBtn(b,on);toast(on?'Added to favorites':'Removed from favorites');refreshDecksOpen&&!window.activeDeckId&&refreshDecksOpen()}
    else if(b.dataset.qvstep){const [k,dl]=b.dataset.qvstep.split(':'),a=deckStore(),d=a.find(x=>String(x.id)===String(window.activeDeckId));if(!d)return;if(+dl>0){const r=addCopy(d,c,k);if(r!=='ok'){toast(r);return}}else dropCopy(d,c.id,k);saveDecks(a);showDeck(d.id);steps();refreshCardList();refreshMemb()}
    else if(b.hasAttribute('data-qvadd'))addCardToDeck(c);
    else if(b.hasAttribute('data-qvrul')){
      const box=m.querySelector('#qvrul'),dlg=m.firstChild;
      if(box.hidden){box.hidden=false;dlg.classList.add('xl');b.classList.add('on');box.innerHTML='<p class="note">Loading rulings…</p>';cur=c;rulings(c,'qvrul').then(()=>{if(box.isConnected)box.scrollIntoView({block:'start',behavior:'smooth'})})}
      else{box.hidden=true;dlg.classList.remove('xl');b.classList.remove('on')}
    }
  });
}

function exportMenu(id){openModal(`<div class="dk-hd"><h3>Export</h3><button class="ibtn" data-close aria-label="Close">${ic('x')}</button></div><div class="dk-opts"><button class="opt" data-poster="${esc(id)}">${ic('image')}<b>Deck image</b></button><button class="opt" data-pdfdeck="${esc(id)}">${ic('file')}<b>PDF deck list</b></button><button class="opt" data-exportydk="${esc(id)}">${ic('down')}<b>.ydk file</b></button><button class="opt" data-copyydk="${esc(id)}">${ic('list')}<b>Copy .ydk</b></button><a class="opt" href="https://www.yugioh-card.com/en/downloads/forms/KDE_DeckList.pdf" target="_blank" rel="noopener">${ic('file')}<b>Konami form</b></a></div>`)}

/* ---------- exports ---------- */
function buildDeckPdf(d,player,cardId,event){
 const sections=[['MAIN DECK',copies(d,'main')],['EXTRA DECK',copies(d,'extra')],['SIDE DECK',copies(d,'side')]]; 
 const clean=v=>String(v??'').normalize('NFKD').replace(/[^\x20-\x7E]/g,'').replace(/\\/g,'\\\\').replace(/\(/g,'\\(').replace(/\)/g,'\\)'); 
 const lines=['KONAMI TOURNAMENT DECK LIST - KODEX EXPORT',`Deck: ${d.name}`,`Duelist: ${player||'________________________'}`,`CARD GAME ID: ${cardId||'________________'}`,`Event: ${event||'________________________'}`,`Date: ${new Date().toLocaleDateString()}`,`Total: ${deckTotal(d)} cards`,'']; 
 for(const [label,arr] of sections){lines.push(`${label} (${arr.length} cards)`);const counts=new Map();arr.forEach(c=>counts.set(c.name,(counts.get(c.name)||0)+1));if(!counts.size)lines.push('  -');for(const [name,qty] of counts)lines.push(`${qty} x  ${name}`);lines.push('')} 
 lines.push('KodeX-generated list; transfer to the official Konami form if the event requires that exact form.'); 
 const pages=[];for(let i=0;i<lines.length;i+=48)pages.push(lines.slice(i,i+48)); 
 const objs=[],add=o=>(objs.push(o),objs.length),catalogId=add(''),pagesId=add(''),fontId=add('<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>'),pageIds=[],streamIds=[]; 
 for(const page of pages){let content='BT\n/F1 10 Tf\n48 790 Td\n14 TL\n';page.forEach((line,j)=>{if(j)content+='T*\n';content+=`(${clean(line).slice(0,115)}) Tj\n`});content+='ET';const streamId=add(`<< /Length ${content.length} >>\nstream\n${content}\nendstream`);streamIds.push(streamId);pageIds.push(add(''))} 
 objs[catalogId-1]=`<< /Type /Catalog /Pages ${pagesId} 0 R >>`;objs[pagesId-1]=`<< /Type /Pages /Kids [${pageIds.map(id=>id+' 0 R').join(' ')}] /Count ${pageIds.length} >>`; 
 pageIds.forEach((id,i)=>objs[id-1]=`<< /Type /Page /Parent ${pagesId} 0 R /MediaBox [0 0 595 842] /Resources << /Font << /F1 ${fontId} 0 R >> >> /Contents ${streamIds[i]} 0 R >>`); 
 let pdf='%PDF-1.4\n%KODEX\n',offsets=[0];for(let i=0;i<objs.length;i++){offsets.push(pdf.length);pdf+=`${i+1} 0 obj\n${objs[i]}\nendobj\n`}const xref=pdf.length;pdf+=`xref\n0 ${objs.length+1}\n0000000000 65535 f \n`;for(let i=1;i<offsets.length;i++)pdf+=String(offsets[i]).padStart(10,'0')+' 00000 n \n';pdf+=`trailer\n<< /Size ${objs.length+1} /Root ${catalogId} 0 R >>\nstartxref\n${xref}\n%%EOF`; 
 
 return new Blob([pdf],{type:'application/pdf'});
}
const isWV=()=>/; wv\)/.test(navigator.userAgent);
const blobB64=b=>new Promise((res,rej)=>{const r=new FileReader();r.onload=()=>res(String(r.result).split(',')[1]||'');r.onerror=rej;r.readAsDataURL(b)});
async function saveFile(blob,name,mime){
  const f=new File([blob],name,{type:mime});
  try{const B=window.KodexBridge||window.AndroidBridge;if(B&&typeof B.saveBase64==='function'){B.saveBase64(name,mime,await blobB64(blob));toast('Saved '+name);return}}catch(e){}
  const anchor=href=>{const a=document.createElement('a');a.href=href;a.download=name;a.rel='noopener';a.style.display='none';document.body.appendChild(a);a.click();setTimeout(()=>a.remove(),1500)};
  if(!isWV()){const url=URL.createObjectURL(blob);anchor(url);setTimeout(()=>URL.revokeObjectURL(url),60000);toast('Saving '+name);return}
  try{const du=await new Promise((ok,no)=>{const r=new FileReader();r.onload=()=>ok(r.result);r.onerror=no;r.readAsDataURL(blob)});anchor(du);toast('Saving '+name);return}catch(e){}
  try{if(navigator.canShare&&navigator.canShare({files:[f]})){await navigator.share({files:[f],title:name});return}}catch(e){if(e&&e.name==='AbortError')return}
  saveFallback(blob,name,mime)
}
function saveFallback(blob,name,mime){
  const img=/^image\//.test(mime),txt=/^text\//.test(mime)||/ydk/.test(name);
  const url=img?URL.createObjectURL(blob):'';
  const m=openModal(`<h3>${esc(name)}</h3>${img?`<img class="sv-img" src="${url}" alt="">`:''}<div class="dact"><button class="btn" data-close>Close</button>${img||txt?`<button class="btn p" id="svCp">${img?'Copy image':'Copy text'}</button>`:''}</div>${img||txt?'':'<small class="sv-n">File saving is not enabled in this app build.</small>'}`);
  const cp=m.querySelector('#svCp');if(cp)cp.onclick=async()=>{try{if(img)await navigator.clipboard.write([new ClipboardItem({[blob.type]:blob})]);else await navigator.clipboard.writeText(await blob.text());toast('Copied')}catch(e){toast('Copy not available')}}
}
async function svgToPng(svg,scale,mime){
  window.__pngMiss=0;mime=mime||'image/png';
  const doc=new DOMParser().parseFromString(svg,'image/svg+xml'),imgs=[...doc.querySelectorAll('image')];
  const cache={};
  await Promise.all(imgs.map(async n=>{const u=n.getAttribute('href')||n.getAttribute('xlink:href');if(!u||u.startsWith('data:'))return;try{if(!cache[u])cache[u]=icLoad(u);const d=await cache[u];n.setAttribute('href',d);n.removeAttribute('xlink:href')}catch(e){window.__pngMiss++;const x=+n.getAttribute('x'),y=+n.getAttribute('y'),w=+n.getAttribute('width'),h=+n.getAttribute('height'),t=(n.querySelector('title')?.textContent||'').trim(),ns='http://www.w3.org/2000/svg',g=doc.createElementNS(ns,'g'),r=doc.createElementNS(ns,'rect');r.setAttribute('x',x);r.setAttribute('y',y);r.setAttribute('width',w);r.setAttribute('height',h);r.setAttribute('fill','#18213a');r.setAttribute('stroke','#3a4a73');g.appendChild(r);let ln=[],cur='';for(const wd of t.split(/\s+/)){const q=cur?cur+' '+wd:wd;if(q.length>11&&cur){ln.push(cur);cur=wd}else cur=q}if(cur)ln.push(cur);ln.slice(0,7).forEach((l,i)=>{const tx=doc.createElementNS(ns,'text');tx.setAttribute('x',x+4);tx.setAttribute('y',y+16+i*13);tx.setAttribute('font-size','10.5');tx.setAttribute('font-family','Arial,sans-serif');tx.setAttribute('fill','#dbe4ff');tx.textContent=l.slice(0,13);g.appendChild(tx)});n.replaceWith(g)}}));
  const out=new XMLSerializer().serializeToString(doc.documentElement),W=+doc.documentElement.getAttribute('width')||1200,H=+doc.documentElement.getAttribute('height')||800;
  const im=new Image();await new Promise((ok,no)=>{im.onload=ok;im.onerror=no;im.src='data:image/svg+xml;charset=utf-8,'+encodeURIComponent(out)});
  const c=document.createElement('canvas');c.width=W*scale;c.height=H*scale;const x=c.getContext('2d');x.scale(scale,scale);x.drawImage(im,0,0,W,H);
  return await new Promise((ok,no)=>c.toBlob(b=>b?ok(b):no(new Error('png')),mime,mime==='image/jpeg'?.93:undefined))
}
