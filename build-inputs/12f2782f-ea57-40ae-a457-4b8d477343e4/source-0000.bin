<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#080a10">
<meta name="kodex-build" content="KODEX-9.0.1">
<meta name="kodex-edition" content="premium">
<meta name="copyright" content="© 2023-2026 Meta Insider OCG (MEIOCG). All rights reserved. Permission required: metainsiderocg@gmail.com">
<link rel="license" href="https://kodex.meiocg.org/license">
<meta name="color-scheme" content="dark">
<meta http-equiv="Content-Security-Policy" content="default-src 'self' data: blob:; media-src 'self' blob: mediastream:; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://cdn.jsdelivr.net; worker-src 'self' blob: https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src https: data: blob: 'self'; connect-src 'self' https://raw.githubusercontent.com https://cdn.jsdelivr.net https://tessdata.projectnaptha.com https://db.ygoprodeck.com https://kodex.meiocg.org https://translate.meiocg.org https://api.mymemory.translated.net; object-src 'none'; frame-src 'self' https://kodex.meiocg.org about:; base-uri 'none'">
<link rel="icon" type="image/png" href="data:image/png;base64,">
<title>Duel Synapse: KodeX Premium</title>
<style>
:root{--sat:env(safe-area-inset-top,0px);--sab:env(safe-area-inset-bottom,0px);--bg:#080a10;--panel:#111522;--panel2:#171b2a;--line:#272d40;--text:#eef2ff;--muted:#9aa4bd;--accent:#67a8ff;--soft:rgba(103,168,255,.16);--soft2:rgba(103,168,255,.1);--nav:64px;--mon:#e8b25a;--spl:#38c9a6;--trp:#d9729f}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html{font-size:16px;-webkit-text-size-adjust:100%;text-size-adjust:100%}
html,body{height:100%;margin:0;overflow:hidden}
body{background:radial-gradient(circle at top,#17213a 0,#080a10 48%) #080a10;color:var(--text);font-family:Inter,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;display:flex;flex-direction:column;padding:0 env(safe-area-inset-right) 0 env(safe-area-inset-left);-webkit-user-select:none;user-select:none;-webkit-touch-callout:none;line-height:1.4}
button{font:inherit;color:inherit;cursor:pointer;touch-action:manipulation}
.effect,.qb,.stats strong,h2{-webkit-user-select:text;user-select:text}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
[hidden]{display:none!important}
header,.search,main{width:100%;max-width:1000px;margin:0 auto;padding-left:16px;padding-right:16px}
header{display:flex;align-items:center;gap:12px;padding-top:12px;padding-bottom:4px}
.logo{width:46px;height:46px;display:grid;place-items:center;padding:0;flex:none;background:transparent;border:0;box-shadow:none}.logo img{width:100%;height:100%;object-fit:contain;display:block;filter:drop-shadow(0 0 4px var(--accent)) drop-shadow(0 0 10px var(--theme-glow));}
.brand{font-size:.66rem;letter-spacing:.18em;color:var(--accent);font-weight:800;text-transform:uppercase}
.title{font-size:19.2px!important;font-weight:850;line-height:1.2;flex:none}.logo,.logo img{width:46px;height:46px;flex:none}
.sub{color:var(--muted);font-size:.74rem}
.searchbox{display:flex;align-items:center;gap:6px;background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:3px 4px 3px 14px;box-shadow:0 10px 30px rgba(0,0,0,.35);transition:border-color .15s,box-shadow .15s}
.searchbox:focus-within{border-color:var(--accent);box-shadow:0 0 0 3px var(--soft)}
.searchbox>span{color:var(--muted);font-size:1.1rem}
.searchbox input{flex:1;min-width:0;height:46px;border:0;outline:0;background:transparent;color:var(--text);font-size:1rem;-webkit-user-select:text;user-select:text}
.searchbox button{border:0;background:transparent;color:var(--muted);font-size:1.5rem;width:44px;height:44px;border-radius:12px}
.status{display:flex;gap:8px;align-items:center;color:var(--muted);font-size:.76rem;margin:8px 4px 4px;min-height:20px}
.dot{width:8px;height:8px;border-radius:50%;background:#45d483;flex:none;box-shadow:0 0 0 3px rgba(69,212,131,.18)}.dot.off{background:#ffb454;box-shadow:0 0 0 3px rgba(255,180,84,.18)}
.active{display:flex;gap:6px;overflow-x:auto;padding:4px 2px 8px;scrollbar-width:none}.active::-webkit-scrollbar{display:none}
.ac{flex:none;border:1px solid var(--accent);background:var(--soft2);border-radius:99px;padding:6px 12px;font-size:.76rem;font-weight:700;min-height:34px}
main{flex:1;min-height:0;overflow-y:auto;overscroll-behavior:contain;-webkit-overflow-scrolling:touch;padding-top:6px;padding-bottom:calc(var(--nav) + 24px + var(--sab))}
#list{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:10px;align-content:start}
.card{display:flex;gap:12px;align-items:center;text-align:left;width:100%;background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:10px 10px 10px 10px;min-height:92px;transition:transform .1s,border-color .15s}
.card:active{transform:scale(.985);border-color:var(--accent)}
.card img{width:54px;height:78px;object-fit:cover;border-radius:6px;background:#05060a;flex:none;box-shadow:0 4px 12px rgba(0,0,0,.4)}
.ci{flex:1;min-width:0;display:block}.cn{display:block;font-size:.95rem;line-height:1.3;font-weight:750;overflow:hidden;text-overflow:ellipsis;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
.tags{display:flex;flex-wrap:wrap;gap:5px;margin:5px 0 3px}
.tg{font-style:normal;font-size:.68rem;font-weight:800;border-radius:99px;padding:2px 8px;border:1px solid var(--line);background:var(--panel2);color:var(--text)}
.tg.m{color:var(--mon);border-color:var(--mon)}.tg.s{color:var(--spl);border-color:var(--spl)}.tg.t{color:var(--trp);border-color:var(--trp)}
.meta{display:block;color:var(--muted);font-size:.74rem;line-height:1.4}
.chev{color:var(--muted);font-size:1.4rem;flex:none;padding-right:4px}
.empty{grid-column:1/-1;text-align:center;padding:56px 18px;color:var(--muted);font-size:.9rem;line-height:1.6}.empty b{display:block;font-size:2rem;margin-bottom:8px;color:var(--accent)}
.sk{height:92px;border-radius:16px;background:linear-gradient(90deg,var(--panel) 0,var(--panel2) 50%,var(--panel) 100%);background-size:200% 100%;animation:sh 1.3s infinite linear;border:1px solid var(--line)}
@keyframes sh{to{background-position:-200% 0}}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:16px;margin-top:12px}
.dbar{position:sticky;top:0;z-index:5;padding:6px 0 8px;background:var(--bg);box-shadow:0 10px 12px -10px rgba(0,0,0,.7)}
.back,.btn{border:1px solid var(--line);background:var(--panel2);padding:11px 16px;border-radius:13px;min-height:46px;font-weight:650}.dbar .back{display:flex;align-items:center;gap:9px;width:100%;text-align:left;background:linear-gradient(110deg,var(--soft),var(--panel));border-color:color-mix(in srgb,var(--accent) 55%,var(--line));box-shadow:inset 3px 0 0 var(--accent),0 6px 20px rgba(0,0,0,.18);font-weight:750;transition:transform .15s,border-color .15s}.dbar .back:active{transform:translateY(1px);border-color:var(--accent)}
.btn.p{background:var(--soft);border-color:var(--accent);font-weight:750}
.hero{display:flex;gap:16px;align-items:flex-start;margin-top:10px}
.thumb{width:128px;border-radius:9px;background:#05060a;flex:none;box-shadow:0 12px 30px rgba(0,0,0,.5)}
.hero h2{margin:0 0 6px;font-size:1.3rem;line-height:1.25}
.label{font-size:.7rem;color:var(--accent);font-weight:800;letter-spacing:.1em;margin:0 0 10px;text-transform:uppercase}
.stats{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:8px}
.stats div{background:var(--panel2);border:1px solid var(--line);border-radius:12px;padding:9px 11px}
.stats span{display:block;font-size:.66rem;color:var(--muted);text-transform:uppercase;letter-spacing:.05em}.stats strong{font-size:.92rem}
.effect{white-space:pre-wrap;line-height:1.65;font-size:.94rem;color:var(--text)}
.dg{display:flex;justify-content:space-between;gap:12px;padding:10px 0;border-top:1px solid var(--line);font-size:.86rem}.dg small{display:block;color:var(--muted);font-size:.76rem;margin-top:2px;word-break:break-word}.dg b{font-size:.74rem;letter-spacing:.04em;flex:none}.dg b.ok{color:#3ddc84}.dg b.warn{color:#f5b942}.dg b.fail{color:#ff6b6b}.dg-s{margin:6px 0 2px;font-weight:700}.dg-t{width:100%;min-height:120px;margin-top:10px;font:12px/1.4 monospace;background:var(--panel2);color:var(--text);border:1px solid var(--line);border-radius:10px;padding:8px}
.note{color:var(--muted);font-size:.8rem;line-height:1.55;margin:8px 0}
details.qa{background:var(--panel2);border:1px solid var(--line);border-radius:14px;margin-top:8px;overflow:hidden}
details.qa[open]{border-color:var(--accent)}
details.qa summary{padding:12px 14px;cursor:pointer;font-size:.88rem;line-height:1.45;font-weight:650;list-style:none;min-height:48px}
details.qa summary::-webkit-details-marker{display:none}
details.qa summary:before{content:"›";color:var(--accent);font-size:1.3rem;margin-right:8px;display:inline-block;transition:transform .15s}
details.qa[open] summary:before{transform:rotate(90deg)}
.qb{padding:0 14px 14px;border-top:1px solid var(--line);font-size:.9rem;line-height:1.65;color:var(--text)}
.qb p{margin:10px 0 0;white-space:pre-wrap}.qb b{color:var(--accent)}
.translate-btn{margin:12px 0 0;border:1px solid var(--accent);background:var(--soft2);border-radius:10px;padding:8px 12px;min-height:40px;font-size:.8rem;font-weight:700}
.translation-box{margin-top:10px;padding:10px 12px;border:1px solid var(--line);border-radius:12px;background:var(--panel)}
.translation-label{font-size:.68rem;color:var(--accent);font-weight:800;letter-spacing:.06em;text-transform:uppercase;margin-bottom:6px}
.translation-error{font-size:.78rem;color:#ffb4b4;margin-top:8px}
.nav{position:fixed;left:0;right:0;bottom:0;z-index:40;background:rgba(10,13,22,.96);border-top:1px solid var(--line);padding:0 env(safe-area-inset-right) var(--sab) env(safe-area-inset-left);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px)}
.nav>div{max-width:1000px;margin:0 auto;display:grid;grid-template-columns:repeat(4,1fr);height:var(--nav)}
.nav button{background:none;border:0;color:var(--muted);font-size:.7rem;font-weight:700;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;position:relative;min-height:48px}
.nav button i.ic{font-style:normal;font-size:1.2rem;line-height:1;padding:3px 18px;border-radius:99px;transition:background .15s}
.nav button.on{color:var(--text)}.nav button.on i.ic{background:var(--soft);color:var(--accent)}
.fab{position:fixed;right:14px;bottom:calc(var(--nav) + var(--sab) + 14px);z-index:45;width:50px;height:50px;border-radius:50%;border:1px solid var(--line);background:var(--panel);color:var(--accent);display:grid;place-items:center;padding:0;box-shadow:0 8px 24px rgba(0,0,0,.5)}.fab:active{transform:scale(.94)}body.lay .fab{display:none}
.fab #fc{position:absolute;top:-5px;right:-5px;background:var(--accent);color:#06101f;border-radius:99px;min-width:18px;padding:0 5px;text-align:center;font-size:.66rem;font-style:normal;font-weight:900}
.layer{position:fixed;top:var(--adh,0px);right:0;bottom:0;left:0;--sat:0px;background:rgba(0,0,0,.62);display:none;z-index:50}.layer.open{display:block}#Larena{background:var(--bg);z-index:70}#Larena.open{display:flex;flex-direction:column}.arbar{display:flex;align-items:center;gap:12px;padding:calc(8px + var(--sat)) 16px 8px;background:var(--panel);border-bottom:1px solid var(--line);flex:none}.arbar .logo,.arbar .logo img{width:40px;height:40px}.arti{flex:1;min-width:0;line-height:1.15}#arenaFrame{flex:1;min-height:0;width:100%;border:0;background:var(--bg);display:block}#Larena .arbar{position:absolute;top:calc(6px + var(--sat));right:8px;padding:0;background:none;border:0;z-index:3;gap:0}#Larena .arbar .logo,#Larena .arti{display:none}#Larena .arbar .ibtn{width:40px;height:40px;min-height:40px;border-radius:50%;background:rgba(11,15,23,.78);border:1px solid rgba(255,255,255,.22);box-shadow:0 4px 14px rgba(0,0,0,.45);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);display:grid;place-items:center;padding:0}
.sheet{position:absolute;background:var(--panel);border:1px solid var(--line);display:flex;flex-direction:column;max-height:100%}
.side .sheet{top:0;right:0;bottom:0;width:min(400px,94vw);border-width:0 0 0 1px;padding-top:var(--sat)}
.bottom .sheet{left:0;right:0;bottom:0;max-height:calc(100% - var(--sat) - 12px);border-radius:22px 22px 0 0;max-width:720px;margin:0 auto}
.bottom .sheet:before{content:"";width:40px;height:4px;border-radius:9px;background:var(--line);margin:8px auto 0;flex:none}
.sh{display:flex;justify-content:space-between;align-items:center;padding:10px 16px;border-bottom:1px solid var(--line)}.sh h3{margin:0;font-size:1.05rem}
.sb{overflow-y:auto;padding:4px 16px calc(20px + var(--sab));flex:1;-webkit-overflow-scrolling:touch;overscroll-behavior:contain}
.sec{font-size:.7rem;font-weight:800;letter-spacing:.14em;color:var(--accent);margin:20px 4px 8px;text-transform:uppercase}
.grp{background:var(--panel2);border:1px solid var(--line);border-radius:16px;padding:0 14px}
.row{display:flex;justify-content:space-between;gap:14px;align-items:center;padding:12px 0;min-height:60px}.row+.row{border-top:1px solid var(--line)}
.row strong{font-size:.92rem}.row small{display:block;color:var(--muted);font-size:.75rem;margin-top:2px;line-height:1.4}
.sw{width:52px;height:30px;border-radius:99px;background:#30384e;border:0;position:relative;flex:none;transition:background .15s}
.sw:after{content:"";position:absolute;width:22px;height:22px;top:4px;left:4px;border-radius:50%;background:#fff;transition:left .15s}
.sw[aria-checked=true]{background:var(--accent)}.sw[aria-checked=true]:after{left:26px}
input[type=range]{accent-color:var(--accent)}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin:6px 0 4px}
.chip{border:1px solid var(--line);background:var(--panel2);border-radius:99px;padding:8px 14px;font-size:.84rem;min-height:40px}
.chip[aria-pressed=true]{background:var(--soft);border-color:var(--accent);color:var(--text);font-weight:750}
.rg{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px}
.rg label{font-size:.72rem;color:var(--muted)}
.rg input,select{width:100%;height:44px;border-radius:11px;border:1px solid var(--line);background:var(--panel2);color:var(--text);padding:0 10px;font-size:1rem}
.fo{display:flex;gap:10px;padding:12px 16px calc(12px + var(--sab));border-top:1px solid var(--line)}.fo .btn{flex:1}
.prog{height:8px;background:#252b3c;border-radius:99px;overflow:hidden;margin:10px 0}.prog i{display:block;height:100%;width:0;background:var(--accent);transition:width .15s}
.themes{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.themes button{border:1px solid var(--line);background:var(--panel2);border-radius:12px;min-height:50px;font-size:.8rem;display:flex;align-items:center;justify-content:center;gap:7px}
.themes button[aria-pressed=true]{border-color:var(--accent);box-shadow:0 0 0 1px var(--accent);background:var(--soft2)}
.themes i{width:16px;height:16px;border-radius:50%}
.lnk{display:block;padding:14px 0;border-top:1px solid var(--line);color:var(--text);text-decoration:none;font-size:.9rem;min-height:48px}
.grp .lnk:first-child{border-top:0}
.tl{display:block;width:100%;text-align:left;background:none;border:0;border-top:1px solid var(--line);padding:14px 0;color:var(--text);font-size:.92rem;min-height:48px}

.detail-actions{display:flex;gap:8px;flex-wrap:wrap}
.deck-card{background:var(--panel2);border:1px solid var(--line);border-radius:14px;padding:12px;margin:9px 0}
.deck-head{display:flex;align-items:center;justify-content:space-between;gap:10px}
.deck-head strong{font-size:.95rem}
.deck-list{display:grid;gap:7px;margin-top:10px}
.deck-item{display:flex;align-items:center;gap:10px;border-top:1px solid var(--line);padding:9px 0}
.deck-item img{width:34px;height:48px;object-fit:cover;border-radius:5px;flex:none}
.deck-item .deck-name{flex:1;min-width:0;font-size:.85rem}
.deck-item .deck-name small{display:block;color:var(--muted);font-size:.72rem}
.deck-actions{display:flex;flex-wrap:wrap;gap:7px;margin-top:10px}
.deck-actions .btn{min-height:40px;padding:8px 11px;font-size:.78rem}
.deck-field{width:100%;height:44px;border:1px solid var(--line);border-radius:11px;background:var(--panel);color:var(--text);padding:0 12px;margin:7px 0}
.deck-empty{padding:15px;border:1px dashed var(--line);border-radius:12px;color:var(--muted);font-size:.82rem;text-align:center}
.deck-view{position:relative;isolation:isolate;border:1px solid var(--line);border-radius:14px;overflow:hidden;padding:12px;background:var(--panel);background-size:cover;background-position:center;background-repeat:no-repeat}
.deck-view:before{content:"";position:absolute;inset:0;background:rgba(7,10,17,.48);z-index:-1;pointer-events:none}
.deck-section{margin:10px 0 14px;border:1px solid rgba(255,255,255,.2);border-radius:9px;overflow:hidden;background:rgba(5,8,15,.62);transition:border-color .15s,background .15s}.deck-section.drag-target{border:2px dashed var(--accent);background:rgba(70,110,180,.22);box-shadow:0 0 0 2px rgba(90,140,220,.12)}
.deck-section.skinned{background-size:cover;background-position:center}.skins .sec{margin-top:14px}.skg{display:grid;grid-template-columns:repeat(auto-fill,minmax(96px,1fr));gap:10px}.skt{position:relative;aspect-ratio:16/10;border-radius:12px;border:1px solid var(--line);background:var(--panel2) center/cover no-repeat;color:var(--muted);font:inherit;font-size:.8rem;font-weight:700;display:grid;place-items:center;padding:0;cursor:pointer}.skg.slv .skt{aspect-ratio:59/86}.skg.fld{grid-template-columns:repeat(auto-fill,minmax(150px,1fr))}.skg.fld .skt{aspect-ratio:7/2.6}.fprev{position:relative;aspect-ratio:7/2.6;border-radius:0 0 16px 16px;border:1px solid var(--line);background:#0b0f17 no-repeat;display:grid;grid-template-columns:repeat(7,1fr);gap:4%;padding:3% 2%;margin-bottom:6px}.fprev i{border:1px solid rgba(255,255,255,.18);border-radius:6px;background:rgba(255,255,255,.04);aspect-ratio:59/86;align-self:center}.skt.on{outline:3px solid var(--accent);outline-offset:1px;border-color:transparent}.skt.add{font-size:1.6rem;color:var(--accent);border-style:dashed}.skt i{position:absolute;top:4px;right:4px;width:24px;height:24px;border-radius:50%;background:rgba(0,0,0,.7);color:#fff;font-style:normal;display:grid;place-items:center;font-size:.9rem}
.deck-section-head{display:flex;justify-content:space-between;align-items:center;padding:7px 10px;background:rgba(18,25,43,.82);font-weight:800;font-size:.86rem}
.deck-cards-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:5px;padding:7px}
.deck-card-thumb{position:relative;aspect-ratio:59/86;min-width:0;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.18);border-radius:4px;overflow:hidden;padding:0;display:block;width:100%;cursor:grab;touch-action:pan-y;user-select:none;-webkit-user-select:none;-webkit-user-drag:element}.deck-card-thumb:active{cursor:grabbing}.deck-card-thumb.drag-ready{outline:3px solid var(--accent);outline-offset:2px;}.deck-card-thumb.dragging{opacity:.42;transform:scale(.96);outline:3px solid var(--accent)}.qv-passcode{font-size:.72rem;opacity:.68;margin:.25rem 0}.deck-section-head:after{content:" · Drop cards here";font-size:.68rem;font-weight:500;opacity:.65}.deck-section.drag-target .deck-section-head{background:rgba(50,100,190,.45)}
.deck-card-thumb img{width:100%;height:100%;object-fit:cover;display:block}
.deck-card-thumb .missing-card{font-size:.65rem;display:grid;place-items:center;height:100%;text-align:center;padding:3px;color:var(--muted)}
.deck-card-thumb .qty{position:absolute;right:2px;top:2px;background:rgba(0,0,0,.78);color:white;border-radius:3px;padding:1px 4px;font-size:.62rem}
.deck-section-select{background:var(--panel2);color:var(--text);border:1px solid var(--line);border-radius:8px;padding:8px;max-width:105px;font-size:.78rem}


.about p{font-size:.85rem;line-height:1.65;color:var(--text)}
#wp,#ws{position:fixed;top:0;right:0;bottom:0;left:0;pointer-events:none;z-index:0;background-position:center;background-repeat:no-repeat;background-size:cover}
.top-ad-safe-area,header,.search,main{position:relative;z-index:1}
.top-ad-safe-area{flex:none;display:flex;justify-content:center;padding:calc(var(--sat) + 6px) 12px 6px;position:relative;z-index:200}
.top-ad-slot{width:min(100%,360px);height:50px;display:flex;align-items:center;justify-content:center;border-radius:10px;background:rgba(5,8,16,.34);color:rgba(190,201,222,.35);font-size:.6rem;letter-spacing:.12em;overflow:hidden}
@media(max-width:600px){#list{grid-template-columns:1fr;gap:8px}.hero{flex-direction:column;align-items:center;text-align:center}.hero .tags{justify-content:center}.thumb{width:150px}}
@media(min-width:900px){.nav>div{max-width:560px}}
@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}





/* Production deck UI refinement */
.deck-card[data-open-deck]{cursor:pointer;transition:border-color .15s,background .15s}.deck-card[data-open-deck]:hover{border-color:var(--accent);background:var(--soft2)}#Ltool .sheet{overflow:hidden}#Ltool .sh{position:relative;z-index:8;background:var(--panel);border-bottom:1px solid var(--line)}#Ltool .sb{padding:14px;overflow-y:auto;overscroll-behavior:contain;max-height:calc(88dvh - 70px)}




.deck-card{border:1px solid var(--line);border-radius:13px;padding:15px;margin:10px 0;background:linear-gradient(145deg,rgba(255,255,255,.035),rgba(255,255,255,.012))}
.deck-head{display:flex;align-items:center;gap:12px;margin-bottom:12px}.deck-head strong{font-size:1rem;font-weight:650}
.deck-card .deck-actions{display:flex;gap:7px;flex-wrap:wrap}.deck-card .deck-actions .btn{font-size:.82rem}.deck-actions .deck-field{min-width:0;flex:1 1 160px;min-height:42px;border-radius:9px}

.deck-section-head:after{content:none}.deck-section-head{letter-spacing:.015em}.deck-view{background-size:cover;background-position:center;background-attachment:local}
@media(max-width:480px){.deck-card{padding:12px}.deck-head{align-items:flex-start}}


/* v16 mobile quick-view layering and spacing */
#deckQuickView{position:relative;z-index:2147483000}


/* ===== production refinements ===== */
.i{display:block;flex:none}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:1px solid var(--line);background:var(--panel2);color:var(--text);border-radius:12px;padding:0 16px;min-height:44px;font-weight:650;font-size:.9rem;line-height:1.1;text-decoration:none;transition:background .15s,border-color .15s,transform .08s}
.btn:active{transform:scale(.97)}
.btn.p{background:var(--accent);border-color:var(--accent);color:#06101f;font-weight:750}
.btn.danger{color:#ff8f9c;border-color:#5a2a35;background:transparent}
.btn[disabled]{opacity:.45}
.back{display:inline-flex;align-items:center;gap:6px;padding:0 14px 0 8px;min-height:44px;border-radius:12px}
.ibtn{width:44px;height:44px;border-radius:12px;border:1px solid var(--line);background:var(--panel2);color:var(--text);display:inline-grid;place-items:center;flex:none;padding:0;cursor:pointer}
.ibtn:active{background:var(--soft)}
.btn.fav.fav-on{border-color:var(--accent);background:var(--soft2);color:var(--text)}.btn.fav.fav-on svg{fill:var(--accent);color:var(--accent)}
.detail-actions{display:flex;gap:8px;margin-top:14px}.detail-actions .btn{flex:1}
.fm{display:inline-flex;vertical-align:-2px;color:var(--accent)}.fm svg{fill:var(--accent)}
.nav button i.ic{display:grid;place-items:center}
.memb{display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin-top:10px}.memb:empty{display:none}
.memb .mb-l{font-size:.68rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);font-weight:800}
.memb em{font-style:normal;font-size:.74rem;font-weight:700;border:1px solid var(--accent);background:var(--soft2);border-radius:99px;padding:3px 10px}
.full .sheet{height:100%;max-height:100%;max-width:none;margin:0;border-radius:0;border-width:0}
.full .sheet:before{display:none}.full .sh{padding-top:calc(10px + var(--sat))}.full .sb{padding-top:0}
.dk-bar{position:sticky;top:0;z-index:4;display:flex;align-items:center;gap:10px;margin:0 -14px 14px;padding:10px 14px;background:var(--panel);border-bottom:1px solid var(--line)}
.dk-who{display:flex;align-items:center;gap:10px;flex:1;min-width:0}
.dk-ac{display:flex;gap:6px;flex:none}
@media(max-width:400px){.dk-bar{flex-wrap:wrap;row-gap:6px}.dk-bar #deckBack~.dk-who{flex:1 1 calc(100% - 60px)}.dk-bar #deckBack~.dk-ac{flex:1 1 100%;justify-content:flex-end}}
.dk-t{display:block;min-width:0;flex:1;text-align:left;overflow:hidden}.dk-t b{display:block;font-size:.95rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.dk-t small{display:block;color:var(--muted);font-size:.74rem;margin-top:1px}
.dk-ic{border-radius:14px;object-fit:cover;flex:none;background:var(--panel2);border:1px solid var(--line)}
.dk-ic.ph{display:inline-grid;place-items:center;font-weight:800;color:var(--accent);background:var(--soft2)}
.dk-grid{display:grid;gap:10px;grid-template-columns:minmax(0,1fr)}.dk-item,.dk-who{min-width:0;max-width:100%}.dk-item>*{min-width:0}
.dk-item{display:flex;align-items:center;gap:8px;background:var(--panel2);border:1px solid var(--line);border-radius:16px;padding:8px}
.dk-open{display:flex;align-items:center;gap:12px;flex:1;min-width:0;overflow:hidden;background:none;border:0;padding:4px;text-align:left;border-radius:12px;color:var(--text)}
.dk-open.sel{background:var(--soft2);outline:1px solid var(--accent)}
.dk-empty{display:grid;place-items:center;gap:8px;padding:44px 0;color:var(--muted)}
.dk-nm{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:.9rem}
.mdl{display:flex;align-items:center;justify-content:center;padding:calc(10px + var(--sat)) 12px calc(10px + var(--sab));z-index:70}.vwm{padding:0!important}.vwm .dlg.viewer{padding-bottom:var(--sab)}
.dlg{width:min(100%,440px);max-height:calc(100dvh - 20px - var(--sat) - var(--sab));overflow:auto;background:var(--panel);border:1px solid var(--line);border-radius:20px;padding:18px;box-shadow:0 24px 70px rgba(0,0,0,.6);display:flex;flex-direction:column;gap:12px}
.dlg.big{width:min(100%,520px)}.dlg.xl{height:calc(100dvh - 20px - var(--sat) - var(--sab))}
.dlg h3{margin:0;font-size:1.05rem}
.soon{font-size:.66rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--accent);background:var(--soft);border-radius:99px;padding:5px 10px;white-space:nowrap}.sk-sec{margin:4px 0 18px}.fin-t{position:relative;overflow:hidden}.fin-t svg{width:40px;height:40px;display:block;overflow:visible}.fin-shatter{color:#ffd88a}.fin-meteor{color:#ff8a3a}.fin-thunder{color:#9fd0ff}.fin-vortex{color:#b08cff}.fin-slash{color:#e8f6ff}.fin-t i{display:none!important}.fin-t.on svg,.fin-t:hover svg{filter:drop-shadow(0 0 6px currentColor)}.fin-t.on.fin-shatter path{animation:ksh 1.6s ease-in-out infinite}.fin-t.on.fin-shatter .p2{animation-delay:.1s}.fin-t.on.fin-shatter .p4{animation-delay:.2s}.fin-t.on.fin-shatter .p6{animation-delay:.3s}@keyframes ksh{50%{transform:translate(var(--dx,2px),var(--dy,-2px)) rotate(4deg)}}.fin-shatter .p1{--dx:-3px;--dy:-3px}.fin-shatter .p3{--dx:3px;--dy:-3px}.fin-shatter .p5{--dx:1px;--dy:3px}.fin-shatter .p7{--dx:-3px;--dy:1px}.fin-shatter path{transform-box:fill-box;transform-origin:center}.fin-t.on.fin-meteor svg{animation:kmet 1.2s cubic-bezier(.5,0,1,1) infinite}@keyframes kmet{0%{transform:translate(14px,-14px);opacity:0}30%{opacity:1}80%{transform:none;opacity:1}100%{transform:scale(1.15);opacity:0}}.fin-t.on.fin-thunder .bolt{animation:kth 1.1s steps(1) infinite}@keyframes kth{0%,40%,60%{opacity:1}50%,70%{opacity:.25}}.fin-t.on.fin-vortex svg{animation:kvx 1.4s linear infinite}@keyframes kvx{to{transform:rotate(360deg)}}.fin-t.on.fin-slash .s1,.fin-t.on.fin-slash .s2{stroke-dasharray:46;animation:ksl 1.3s ease-in-out infinite}.fin-t.on.fin-slash .s2{animation-delay:.25s}@keyframes ksl{0%{stroke-dashoffset:46}40%,80%{stroke-dashoffset:0}100%{stroke-dashoffset:-46}}@media (prefers-reduced-motion:reduce){.fin-t svg,.fin-t svg *{animation:none!important}}.fin-pv{margin-top:8px;width:100%;min-height:38px}.pv-wrap{width:min(560px,94vw);aspect-ratio:6/5;max-height:72vh;border:0;border-radius:16px;background:#0c0f1f;display:block}.pcard{padding:14px;border-radius:18px;background:linear-gradient(160deg,rgba(51,71,240,.22),rgba(122,79,214,.16) 55%,rgba(240,180,41,.12));border:1px solid rgba(240,180,41,.35)}.pcard h4{margin:0;font-size:1.05rem}.pcard .lead{color:var(--muted);font-size:.85rem;margin:2px 0 10px}.pf{list-style:none;margin:0 0 12px;padding:0;display:grid;gap:8px}.pf li{display:flex;gap:10px;align-items:flex-start}.pf li>i{flex:none;width:30px;height:30px;border-radius:9px;display:grid;place-items:center;background:rgba(0,0,0,.25);color:#f0b429;font-style:normal}.pf li>i svg{width:18px;height:18px}.pf strong{display:block;font-size:.9rem}.pf small{color:var(--muted);font-size:.78rem;line-height:1.4}.pcard .fin-row{margin:4px 0 12px}.fin-row{gap:6px}.fin-t{min-width:44px;padding:10px 2px}.fin-t span{font-size:.72rem;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.pcard .acts{display:grid;gap:8px}.pcard .acts .btn{width:100%}.scan-left{font-size:.78rem;color:var(--muted);text-align:center;margin-top:6px}#kxfx{display:none}html.kx-fx #kxfx{display:block;position:fixed;inset:0;z-index:0;pointer-events:none;overflow:hidden}#kxfx>i{position:absolute;border-radius:50%;will-change:transform;background-image:radial-gradient(circle,currentColor 0,transparent 68%)!important;background-color:transparent!important}#kxfx .b1{width:560px;height:560px;color:#3f52ff;opacity:.3;left:50%;top:-10%;animation:kxd1 20s ease-in-out infinite alternate}#kxfx .b2{width:460px;height:460px;color:#f0b429;opacity:.14;left:70%;top:55%;animation:kxd2 24s ease-in-out infinite alternate}#kxfx .b3{width:520px;height:520px;color:#7a4fd6;opacity:.26;left:-12%;top:40%;animation:kxd3 28s ease-in-out infinite alternate}@keyframes kxd1{to{transform:translate(-140px,120px) scale(1.15)}}@keyframes kxd2{to{transform:translate(-200px,-160px) scale(.9)}}@keyframes kxd3{to{transform:translate(170px,-90px) scale(1.1)}}#kxfx .g{position:absolute;inset:-60px;opacity:.4;background-image:linear-gradient(rgba(255,255,255,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.05) 1px,transparent 1px);background-size:58px 84px;animation:kxg 40s linear infinite;-webkit-mask:radial-gradient(ellipse 80% 60% at 50% 30%,#000 15%,transparent 75%);mask:radial-gradient(ellipse 80% 60% at 50% 30%,#000 15%,transparent 75%)}@keyframes kxg{to{transform:translate(58px,84px)}}#kxfx .fl i{position:absolute;bottom:-120px;width:42px;aspect-ratio:59/86;border-radius:5px;opacity:0;background:var(--kxlogo,none) center/58% no-repeat,linear-gradient(150deg,#2b3790,#141a3d 60%,#2a1a52);border:1px solid rgba(255,255,255,.14);box-shadow:0 10px 30px rgba(0,0,0,.5);animation:kxup 19s linear infinite;will-change:transform}#kxfx .fl i:nth-child(1){left:5%}#kxfx .fl i:nth-child(2){left:20%;animation-delay:-7s;width:32px;animation-duration:23s}#kxfx .fl i:nth-child(3){left:36%;animation-delay:-13s}#kxfx .fl i:nth-child(4){left:52%;animation-delay:-3s;width:30px;animation-duration:25s}#kxfx .fl i:nth-child(5){left:68%;animation-delay:-10s}#kxfx .fl i:nth-child(6){left:83%;animation-delay:-16s;width:36px;animation-duration:21s}#kxfx .fl i:nth-child(7){left:95%;animation-delay:-5s;width:28px}@keyframes kxup{0%{transform:translateY(0) rotate(-12deg);opacity:0}10%{opacity:.4}85%{opacity:.3}100%{transform:translateY(-120vh) rotate(18deg);opacity:0}}html.kx-fx.kx-paused #kxfx *,html.kx-fx.kx-arena #kxfx *,html.kx-fx:has(.layer.open) #kxfx *{animation-play-state:paused}html.kx-fx header .title{background:linear-gradient(100deg,#fff 0%,#a9b2ff 30%,#b08cff 55%,#f0b429 80%,#fff 100%);background-size:220% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:kxsheen 7s ease-in-out infinite alternate}@keyframes kxsheen{from{background-position:0 50%}to{background-position:100% 50%}}html.kx-fx header .logo img{animation:kxbob 5s ease-in-out infinite;filter:drop-shadow(0 0 8px rgba(51,71,240,.7))}@keyframes kxbob{50%{transform:translateY(-4px)}}html.kx-fx #list>.card{position:relative;overflow:hidden}html.kx-fx #list.deal>.card{animation:kxdeal .45s cubic-bezier(.2,.7,.2,1) both}html.kx-fx #list.deal>.card:nth-child(1){animation-delay:0ms}html.kx-fx #list.deal>.card:nth-child(2){animation-delay:35ms}html.kx-fx #list.deal>.card:nth-child(3){animation-delay:70ms}html.kx-fx #list.deal>.card:nth-child(4){animation-delay:105ms}html.kx-fx #list.deal>.card:nth-child(5){animation-delay:140ms}html.kx-fx #list.deal>.card:nth-child(6){animation-delay:175ms}html.kx-fx #list.deal>.card:nth-child(7){animation-delay:210ms}html.kx-fx #list.deal>.card:nth-child(8){animation-delay:245ms}html.kx-fx #list.deal>.card:nth-child(9){animation-delay:280ms}html.kx-fx #list.deal>.card:nth-child(10){animation-delay:315ms}html.kx-fx #list.deal>.card:nth-child(11){animation-delay:350ms}html.kx-fx #list.deal>.card:nth-child(12){animation-delay:385ms}html.kx-fx #list.deal>.card:nth-child(13){animation-delay:420ms}html.kx-fx #list.deal>.card:nth-child(14){animation-delay:455ms}html.kx-fx #list.deal>.card:nth-child(15){animation-delay:490ms}html.kx-fx #list.deal>.card:nth-child(16){animation-delay:525ms}html.kx-fx #list.deal>.card:nth-child(17){animation-delay:560ms}html.kx-fx #list.deal>.card:nth-child(18){animation-delay:595ms}html.kx-fx #list.deal>.card:nth-child(19){animation-delay:630ms}html.kx-fx #list.deal>.card:nth-child(20){animation-delay:665ms}html.kx-fx #list>.card::after{content:'';position:absolute;inset:0;pointer-events:none;opacity:0;background:linear-gradient(115deg,transparent 30%,rgba(255,255,255,.18) 48%,rgba(240,180,41,.14) 52%,transparent 70%);background-size:250% 100%;transition:opacity .2s}@media (hover:hover) and (pointer:fine){html.kx-fx #list>.card{transition:transform .2s cubic-bezier(.2,.7,.2,1),border-color .2s,box-shadow .2s}html.kx-fx #list>.card:hover{transform:translateY(-3px);border-color:#6f7dff;box-shadow:0 12px 26px -14px #3347f0}}@media (hover:hover) and (pointer:fine){html.kx-fx #list>.card:hover::after{opacity:1;animation:kxfoil 1.1s ease-out}}@keyframes kxdeal{from{opacity:0;transform:translateY(14px) scale(.97)}}@keyframes kxfoil{from{background-position:100% 0}to{background-position:-50% 0}}html.kx-fx .btn.p{background-image:linear-gradient(100deg,transparent 35%,rgba(255,255,255,.16) 50%,transparent 65%);background-size:300% 100%;background-repeat:no-repeat;animation:kxshine 4s ease-in-out infinite}@keyframes kxshine{0%{background-position:150% 0}60%,100%{background-position:-50% 0}}@media (prefers-reduced-motion:reduce){#kxfx{display:none!important}}.fin-row{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px}.fin-t{display:grid;justify-items:center;gap:6px;padding:10px 4px;border-radius:14px;border:1px solid var(--line);background:var(--panel2);color:var(--text);font-size:.78rem;font-weight:650}.fin-t i{width:40px;height:40px;border-radius:50%;display:block;background:radial-gradient(circle,#fff3c4,#f0b429 35%,#ff5a1a 60%,transparent 70%)}.fin-meteor i{background:radial-gradient(circle at 35% 35%,#fff,#ffd36b 30%,#ff6a1a 60%,transparent 70%)}.fin-thunder i{background:radial-gradient(circle,#fff,#9fd0ff 40%,transparent 70%)}.fin-vortex i{background:conic-gradient(#000,#3347f0,#7a4fd6,#000,#f0b429,#000);-webkit-mask:radial-gradient(circle,transparent 25%,#000 28%);mask:radial-gradient(circle,transparent 25%,#000 28%)}.fin-slash i{border-radius:4px;height:6px;margin:17px 0;background:#fff;box-shadow:0 0 14px 4px #9fd0ff;transform:rotate(-25deg)}.fin-t.on{border-color:var(--accent);box-shadow:0 0 0 2px var(--accent) inset}html.kx-fx .fin-t.on i{animation:kxbob 1.6s ease-in-out infinite}.sig-chip select{background:rgba(0,0,0,.25);color:var(--text);border:1px solid var(--line);border-radius:999px;padding:3px 6px;font-size:.75rem;max-width:120px}.fx-tog{display:flex;align-items:center;gap:12px;padding:10px 12px;border:1px solid var(--line);border-radius:12px;background:var(--panel2)}.fx-tog>span{flex:1;display:grid}.fx-tog small{color:var(--muted);font-size:.75rem}.fx-tog input{width:22px;height:22px}.snd-list{display:grid;gap:8px}.snd-row{display:flex;align-items:center;gap:8px;padding:8px 10px;border:1px solid var(--line);border-radius:12px;background:var(--panel2)}.snd-row>span{flex:1;min-width:0;display:grid}.snd-row small{color:var(--muted);font-size:.75rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.snd-row .btn{min-height:38px;padding:7px 12px;cursor:pointer}.sig-q{width:100%;min-height:44px;padding:10px 12px;border-radius:12px;border:1px solid var(--line);background:var(--panel2);color:var(--text)}.sig-res{display:grid;gap:4px;margin:6px 0}.sig-hit{text-align:left;padding:10px 12px;border-radius:10px;border:1px solid var(--line);background:var(--panel);color:var(--text)}.sig-list{display:flex;flex-wrap:wrap;gap:6px;margin-top:6px}.sig-chip{display:inline-flex;align-items:center;gap:6px;padding:6px 6px 6px 12px;border-radius:999px;background:var(--soft);border:1px solid var(--line);font-size:.85rem}.sig-chip button{width:26px;height:26px;border-radius:50%;border:0;background:rgba(0,0,0,.3);color:var(--text)}.sk-hd{display:flex;align-items:center;justify-content:space-between;gap:10px;margin:0 2px 8px}.sk-hd h4{margin:0;font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;color:var(--accent)}.sk-hd .btn{min-height:34px;padding:0 12px}.sk-row{display:flex;gap:10px;overflow-x:auto;padding:4px 2px 8px;scroll-snap-type:x proximity;-webkit-overflow-scrolling:touch}.sk-t{position:relative;flex:none;width:86px;aspect-ratio:59/86;border-radius:10px;border:1px solid var(--line);background:var(--panel2) center/cover no-repeat;color:var(--muted);font:inherit;font-size:.78rem;font-weight:700;display:grid;place-items:center;padding:0;cursor:pointer;scroll-snap-align:start;overflow:hidden}.sk-field .sk-t{width:210px;aspect-ratio:7/2.6}.sk-t.on{border:2px solid var(--accent);box-shadow:0 0 0 3px var(--soft)}.sk-t em{position:absolute;left:6px;top:6px;width:22px;height:22px;border-radius:50%;background:var(--accent);color:#06101f;display:grid;place-items:center}.sk-t i{position:absolute;top:5px;right:5px;width:24px;height:24px;border-radius:50%;background:rgba(0,0,0,.72);color:#fff;font-style:normal;display:grid;place-items:center;font-size:.95rem}.sk-add{border-style:dashed;color:var(--accent);font-size:1.6rem}.skins-p .note{margin-top:4px}
.popts{display:flex;flex-direction:column;gap:10px}.popt{display:flex;align-items:center;justify-content:space-between;gap:12px;width:100%;text-align:left;background:var(--panel2);border:1px solid var(--line);border-radius:16px;padding:16px;color:var(--text);font:inherit;min-height:64px}.popt strong{display:block;font-size:1rem}.popt small{display:block;color:var(--muted);font-size:.78rem;margin-top:3px}.popt em{font-style:normal;font-size:.68rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--accent);background:var(--soft);border-radius:99px;padding:5px 10px;white-space:nowrap}
.dk-lrow{display:flex;gap:8px;margin:-6px 0 12px;align-items:stretch}.dk-mlb{flex:none;white-space:nowrap;gap:6px}
.dk-legal{display:flex;flex-wrap:wrap;align-items:center;gap:2px 6px;flex:1;min-width:0;padding:9px 12px;border:1px solid var(--line);border-radius:12px;background:var(--panel2);font-size:.82rem;width:100%;text-align:left;color:var(--text)}
.dk-legal b{font-weight:800}.dk-legal.ok{border-color:rgba(64,200,120,.55)}.dk-legal.ok b{color:#5ad38f}.dk-legal.bad{border-color:rgba(240,90,90,.6)}.dk-legal.bad b{color:#ff7b7b}
.dk-legal small{color:var(--muted)}
.deck-card-thumb .ban{position:absolute;left:2px;top:2px;width:15px;height:15px;border-radius:50%;display:grid;place-items:center;font-size:.6rem;font-weight:900;color:#fff;box-shadow:0 0 0 1.5px #000}
.ban.b0{background:#d4262b}.ban.b1{background:#e2851b}.ban.b2{background:#d8b21c;color:#1a1300}
.lg-list{display:flex;flex-direction:column;gap:6px;margin:4px 0}.lg-list li{list-style:none;padding:8px 10px;border-radius:10px;background:var(--panel2);font-size:.86rem}
.dk-paste{width:100%;min-height:180px;border:1px solid var(--line);border-radius:12px;background:var(--panel2);color:var(--text);padding:10px;font:inherit;font-size:.85rem;resize:vertical}
.ml-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px}.ml-stat{background:var(--panel2);border:1px solid var(--line);border-radius:12px;padding:8px;text-align:center}.ml-stat b{display:block;font-size:1.05rem}.ml-stat small{white-space:nowrap;color:var(--muted);font-size:.6rem;text-transform:uppercase;letter-spacing:.06em}
.ml-sec{font-size:.68rem;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);font-weight:800;margin:12px 0 6px}
.ml-form{display:flex;flex-direction:column;gap:8px}.ml-row{display:flex;justify-content:space-between;gap:8px;padding:7px 0;border-bottom:1px solid var(--line);font-size:.84rem}.ml-row:last-child{border:0}
.ml-r{font-weight:900;width:22px;display:inline-block}.ml-r.W{color:#5ad38f}.ml-r.L{color:#ff7b7b}.ml-r.D{color:var(--muted)}
.ml-scroll{overflow:auto;max-height:46vh}
.dk-hd{display:flex;align-items:center;justify-content:space-between;gap:10px}.dk-hd h3{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.dact{display:flex;gap:8px;justify-content:flex-end;flex-wrap:wrap}.dact .btn{flex:1}
.fld{width:100%;height:46px;border:1px solid var(--line);border-radius:12px;background:var(--panel2);color:var(--text);padding:0 14px;font-size:1rem}
.dk-form{display:flex;gap:12px;align-items:center}
.dk-pick{width:64px;height:64px;border-radius:18px;border:1px dashed var(--accent);background:var(--soft2);color:var(--accent);display:grid;place-items:center;flex:none;overflow:hidden;padding:0}.dk-pick img{width:100%;height:100%;object-fit:cover}
.crop{display:grid;place-items:center}.crop canvas{width:min(100%,280px);aspect-ratio:1;border-radius:18px;touch-action:none;background:#000;border:1px solid var(--line)}
.zoom{width:100%}
.seg-w{display:flex;gap:6px;background:var(--panel2);border:1px solid var(--line);border-radius:14px;padding:4px}
.seg{flex:1;border:0;background:none;border-radius:10px;min-height:40px;font-weight:650;color:var(--muted);display:flex;align-items:center;justify-content:center;gap:6px}
.seg.on{background:var(--accent);color:#06101f}.seg i{font-style:normal;font-size:.72rem;opacity:.8}
.dk-cl{overflow:auto;display:flex;flex-direction:column;min-height:120px}
.dk-r{display:flex;align-items:center;gap:6px;padding:6px 0;border-bottom:1px solid var(--line)}.dk-r:last-child{border:0}
.dk-pickl{display:flex;flex-direction:column;gap:6px;max-height:34dvh;overflow:auto}.dk-pickl .dk-open{background:var(--panel2);border:1px solid var(--line);padding:8px}
.pk-l{font-size:.68rem;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);font-weight:800;margin-bottom:-4px}.pk-card{margin:0;font-weight:700;font-size:.95rem}
.dk-opts{display:flex;flex-direction:column;gap:8px}.opt{display:flex;align-items:center;gap:12px;min-height:54px;padding:0 14px;background:var(--panel2);border:1px solid var(--line);border-radius:14px;color:var(--text);text-decoration:none;font-size:.95rem;text-align:left}
.lk{color:var(--accent);font-size:.82rem;text-align:center}
.qv-scroll{overflow:auto;display:flex;flex-direction:column;gap:12px;flex:1;min-height:0}
.qv{display:flex;gap:14px;align-items:flex-start}.qv img{width:112px;border-radius:7px;flex:none;box-shadow:0 8px 22px rgba(0,0,0,.5)}
.qvt{flex:1;min-width:0;font-size:.88rem;line-height:1.55;overflow-wrap:anywhere}.qvt p{margin:0 0 8px;white-space:pre-wrap}.qvt small{color:var(--muted)}
.qv-act{display:grid;grid-template-columns:1fr 1fr;gap:8px}.qv-act .fav{grid-column:1/-1}
.qv-act .btn.on{border-color:var(--accent);background:var(--soft2)}
.qv-rul{border-top:1px solid var(--line);padding-top:12px}
#toast{position:fixed;left:50%;bottom:calc(var(--nav) + 18px + var(--sab));transform:translate(-50%,20px);z-index:90;background:#e9eefc;color:#0a1020;font-weight:650;font-size:.86rem;padding:11px 18px;border-radius:99px;box-shadow:0 10px 30px rgba(0,0,0,.45);opacity:0;pointer-events:none;transition:opacity .2s,transform .2s;max-width:calc(100% - 32px);text-align:center}
#toast.on{opacity:1;transform:translate(-50%,0)}
.deck-view{margin-top:0}
.deck-card-thumb .qty{display:none}
@media(max-width:480px){.qv{flex-direction:column;align-items:center;text-align:left}.qv img{width:150px}}

.lnk{display:flex;align-items:center;gap:14px;width:100%;background:none;border:0;border-top:1px solid var(--line);color:var(--text);font:inherit;font-size:.92rem;text-align:left;text-decoration:none;padding:0;min-height:56px}
.grp .lnk:first-child{border-top:0}.lnk span{flex:1}.lnk svg:first-child{color:var(--accent)}.lnk svg:last-child{color:var(--muted)}
.about h4{margin:18px 0 6px;font-size:.7rem;letter-spacing:.12em;text-transform:uppercase;color:var(--accent)}.about h4:first-child{margin-top:4px}
.about p{margin:0;font-size:.88rem;line-height:1.65;color:var(--text)}.about .ver{margin-top:20px;color:var(--muted);font-size:.78rem}
.deck-card-thumb .qty{display:block;position:absolute;right:3px;bottom:3px;top:auto;background:rgba(0,0,0,.82);color:#fff;border-radius:6px;padding:1px 6px;font-size:.7rem;font-weight:800}
.dk-nm em{font-style:normal;color:var(--accent);font-weight:800;font-size:.8rem;margin-left:4px}
.qv-steps{display:flex;flex-direction:column;gap:6px}.stp{display:flex;align-items:center;gap:10px;background:var(--panel2);border:1px solid var(--line);border-radius:14px;padding:6px 8px 6px 14px}.stp span{flex:1;font-weight:650}.stp b{min-width:22px;text-align:center}.stp .ibtn[disabled]{opacity:.35}.stp-t{color:var(--muted);font-size:.76rem;text-align:right}
.dlg.viewer{width:100%;height:100%;max-width:none;max-height:none;border-radius:0;border:0;padding:0;gap:0;background:var(--bg)}
.vw-bar{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:calc(8px + var(--sat)) 12px 8px;border-bottom:1px solid var(--line);background:var(--panel);flex:none}.vw-bar b{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0}.vw-bar span{display:flex;gap:6px;flex:none}
.sv-n{color:var(--muted)}.sv-img{max-width:100%;max-height:50dvh;object-fit:contain;border-radius:10px;background:#05080f;align-self:center}.vw-body{flex:1;overflow:auto;background:#05080f;-webkit-overflow-scrolling:touch;touch-action:pan-x pan-y pinch-zoom}.vw-svg{width:100%}.vw-svg svg{display:block;width:100%;height:auto}
.side .sheet,.full .sh{box-sizing:border-box}
</style>
<style id="kx-premium-noads">/* KodeX Premium has no ads: the sponsor strip keeps only the status-bar space */#topAdSlot{display:none!important}.top-ad-safe-area{padding:var(--sat) 0 0!important}</style>
</head>
<body>
<div id="wp" aria-hidden="true"></div><div id="ws" aria-hidden="true"></div><div id="kxfx" aria-hidden="true"><i class="b1"></i><i class="b2"></i><i class="b3"></i><span class="g"></span><span class="fl"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span></div>
<div id="topAdSafeArea" class="top-ad-safe-area" aria-label="Sponsor"><div id="topAdSlot" class="top-ad-slot"><span>ADVERTISEMENT</span></div></div>
<header>
  <div class="logo"><img src="data:image/png;base64," alt="KodeX logo"></div><div><div class="brand">Meta Insider OCG</div><div class="title">Duel Synapse: KodeX</div><div class="sub">Card &amp; Rulings Information Database</div></div>
</header>
<div class="search">
  <div class="searchbox"><span aria-hidden="true" style="display:grid"><svg class="i" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.2-4.2"/></svg></span><input id="q" type="search" enterkeyhint="search" autocomplete="off" autocapitalize="off" spellcheck="false" aria-label="Search cards" placeholder="Search cards"><button id="bClr" aria-label="Clear search" hidden>×</button><button id="bScan" class="scanbtn" aria-label="Scan a card with the camera" title="Scan a card"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8V6a2 2 0 0 1 2-2h2M16 4h2a2 2 0 0 1 2 2v2M20 16v2a2 2 0 0 1-2 2h-2M8 20H6a2 2 0 0 1-2-2v-2"/><rect x="8.5" y="7" width="7" height="10" rx="1.2"/></svg></button></div>
  <div class="status" role="status" aria-live="polite"><i id="dot" class="dot"></i><span id="st">Starting…</span></div>
  <div id="af" class="active" hidden aria-label="Active filters"></div>
</div>
<main id="main"><section id="list"></section><section id="detail" hidden></section></main>
<button id="bFil" class="fab" aria-haspopup="dialog" aria-label="Filters"><svg class="i" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4"/></svg><i id="fc" hidden>0</i></button>
<nav class="nav" aria-label="Main"><div>
  <button id="nSearch" class="on" aria-label="Search"><i class="ic"><svg class="i" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.2-4.2"/></svg></i>Search</button>
  <button id="nTest" aria-label="Test"><i class="ic"><svg class="i" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 3h6M10 3v6l-5.2 9a2 2 0 0 0 1.7 3h11a2 2 0 0 0 1.7-3L14 9V3"/><path d="M7.5 15h9"/></svg></i>Test</button>
  <button id="nDeck"><i class="ic"><svg class="i" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l9 5-9 5-9-5z"/><path d="M3 13l9 5 9-5"/></svg></i>Decks</button>
  <button id="bSet" aria-haspopup="dialog"><i class="ic"><svg class="i" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h10M18 7h2M4 17h2M10 17h10"/><circle cx="16" cy="7" r="2"/><circle cx="8" cy="17" r="2"/></svg></i>Settings</button>
</div></nav>

<div id="Lfil" class="layer bottom"><section class="sheet" role="dialog" aria-modal="true" aria-label="Card filters"><div class="sh"><h3>Card Filters</h3><button class="ibtn" data-close aria-label="Close filters"><svg class="i" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button></div><div id="fBody" class="sb"></div><div class="fo"><button id="fRst" class="btn">Clear</button><button id="fOk" class="btn p">Apply</button></div></section></div>

<div id="Lset" class="layer side"><section class="sheet" role="dialog" aria-modal="true" aria-label="Settings"><div class="sh"><h3>Settings</h3><button class="ibtn" data-close aria-label="Close settings"><svg class="i" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button></div><div class="sb">
  <div class="sec">Premium</div><div class="grp">
  <button class="lnk" id="bPrem"><svg class="i" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l2.6 5.6 6.1.7-4.5 4.2 1.2 6L12 16.5 6.6 19.5l1.2-6L3.3 9.3l6.1-.7z"/></svg><span>Remove ads or go Premium</span><svg class="i" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button></div>
  <div class="sec">Display</div><div class="grp">
  <div class="row"><div><strong>Top spacing</strong><small id="satv">Auto</small></div><span style="display:flex;gap:8px;align-items:center"><input id="sat" type="range" min="0" max="72" step="2" style="width:100px" aria-label="Top spacing"><button class="btn" id="satAuto" style="min-height:38px;padding:0 12px">Auto</button></span></div>
  <div class="row"><div><strong>Duel Arena</strong><small>Playtest and online duels</small></div><button class="btn" id="arenaOpen" style="min-height:38px;padding:0 14px">Open</button></div>
  <div class="row"><div><strong>Arena offline</strong><small>Save your decks for offline play</small></div><button class="btn" id="arenaPrep" style="min-height:38px;padding:0 14px">Save</button></div>
  <div class="row"><div><strong>Self-check</strong><small>Tests this app on this device</small></div><button class="btn" id="diagRun" style="min-height:38px;padding:0 14px">Run</button></div>
  <div class="row"><div><strong>Image cache</strong><small id="icv">Empty</small></div><button class="btn" id="icClr" style="min-height:38px;padding:0 14px">Clear</button></div>
  <div class="row"><div><strong>Bottom spacing</strong><small id="sabv">Auto</small></div><span style="display:flex;gap:8px;align-items:center"><input id="sab" type="range" min="0" max="72" step="2" style="width:100px" aria-label="Bottom spacing"><button class="btn" id="sabAuto" style="min-height:38px;padding:0 12px">Auto</button></span></div>
  <div class="row"><div><strong>Text Size</strong><small id="tsv">100%</small></div><input id="ts" type="range" min="80" max="125" step="5" value="100" style="width:130px" aria-label="Text size"></div>
  <div class="row"><div><strong>Search Pictures</strong></div><button class="sw" role="switch" data-t="sp" aria-label="Search pictures"></button></div>
  <div class="row"><div><strong>Card Picture</strong></div><button class="sw" role="switch" data-t="cp" aria-label="Card picture"></button></div>
  <div class="row"><div><strong>Latest cards on home</strong></div><button class="sw" role="switch" data-t="lh" aria-label="Latest cards on home"></button></div></div>
  <div class="sec">Color Theme</div><div id="themes" class="themes"></div><div class="grp" style="margin-top:10px"><div class="row"><div><strong>Theme Intensity</strong><small id="tiVal">60%</small></div><input id="ti" type="range" min="0" max="100" step="5" value="60" style="width:130px" aria-label="Theme intensity"></div></div>
  <div class="sec">Wallpaper</div><div class="grp">
  <div class="row"><div><strong>Image</strong></div><label class="btn" style="margin:0">Choose<input id="wpIn" type="file" accept="image/*" hidden></label></div>
  <div class="row"><div><strong>Dimming</strong><small id="wov">35%</small></div><input id="wo" type="range" min="0" max="90" style="width:130px" aria-label="Wallpaper dimming"></div>
  <div class="row"><div><strong>Fit</strong></div><select id="wf" style="width:130px" aria-label="Wallpaper fit"><option value="cover">Cover</option><option value="contain">Contain</option><option value="100% 100%">Stretch</option></select></div>
  <div class="row"><div><strong>Remove wallpaper</strong></div><button class="btn" id="wrm">Remove</button></div></div>
  <div class="sec">Offline Rulings</div><div class="grp" style="padding:12px 14px">
    <button id="bDl" class="btn p" style="width:100%">Download all rulings</button><div class="prog"><i id="pg"></i></div><div id="dlst" class="note" style="margin-bottom:0">Not downloaded yet.</div></div>
  <div class="sec">Tools</div><div class="grp">
  <div class="row"><div><strong>Deck Manager</strong></div><button class="btn" id="bDecks">Open</button></div>
  <div class="row"><div><strong>Search History</strong></div><button class="btn" id="bHis">Open</button></div>
  <div class="row"><div><strong>Advanced Ruling Search</strong></div><button class="btn" id="bAdv">Open</button></div>
  <div class="row"><div><strong>System Check</strong></div><button class="btn" id="bChk">Run</button></div></div>
  <div class="sec">MEIOCG</div><div class="grp">
  <a class="lnk" href="mailto:metainsiderocg@gmail.com?subject=KodeX%20Support"><svg class="i" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg><span>Email Us</span><svg class="i" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></a>
  <a class="lnk" href="https://facebook.com/meiocgOfficial" target="_blank" rel="noopener noreferrer"><svg class="i" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8z"/></svg><span>Follow us on Facebook</span><svg class="i" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></a>
  <a class="lnk" href="https://youtube.com/@meiocg" target="_blank" rel="noopener noreferrer"><svg class="i" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="5.5" width="19" height="13" rx="4"/><path d="M10 9.5v5l4.5-2.5z"/></svg><span>Subscribe to our YouTube Channel</span><svg class="i" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></a>
  <button class="lnk" id="bAbout"><svg class="i" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/></svg><span>Legal &amp; Privacy</span><svg class="i" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button></div>
</div></div></section></div>

<div id="Ltool" class="layer bottom"><section class="sheet" role="dialog" aria-modal="true" aria-labelledby="tt"><div class="sh"><h3 id="tt">Tools</h3><button class="ibtn" data-close aria-label="Close"><svg class="i" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button></div><div id="tb" class="sb"></div></section></div>
<div id="Larena" class="layer" role="dialog" aria-modal="true" aria-label="Project: Duel Synapse"><div class="arbar"><span class="logo"><img id="arLogo" alt=""></span><div class="arti"><div class="brand">MEIOCG</div><div class="title">Project: Duel Synapse</div></div><button class="ibtn" data-close aria-label="Close"><svg class="i" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button></div><iframe id="arenaFrame" title="Project: Duel Synapse" allow="clipboard-write"></iframe></div>

<script id="kx-v55-js">
/* ---------- KodeX 8.8: entrances, attacks and emotes (Premium), deck image, Synapse Deck Analyzer ---------- */
const ENT_T=[['rise','Rise'],['portal','Portal'],['storm','Storm'],['inferno','Inferno'],['nova','Nova'],['glitch','Glitch']];
const ATK_T=[['lunge','Lunge'],['beam','Beam'],['comet','Comet'],['claw','Claw'],['phantom','Phantom']];
const MV_ICON={
 rise:'<svg viewBox="0 0 48 48" aria-hidden="true"><path class="beam" d="M18 4h12l-2 30h-8z" fill="currentColor" opacity=".35"/><rect class="cd" x="15" y="20" width="18" height="24" rx="3" fill="none" stroke="currentColor" stroke-width="2.6"/></svg>',
 portal:'<svg viewBox="0 0 48 48" aria-hidden="true"><g class="spin" fill="none" stroke="currentColor" stroke-width="2.6"><circle cx="24" cy="24" r="17" stroke-dasharray="8 5"/><circle cx="24" cy="24" r="9"/></g></svg>',
 storm:'<svg viewBox="0 0 48 48" aria-hidden="true"><path class="bolt" d="M26 3 12 25h10l-4 20 18-26H26z" fill="currentColor"/></svg>',
 inferno:'<svg viewBox="0 0 48 48" aria-hidden="true"><path class="fl" d="M24 44c-9 0-14-6-14-13 0-8 7-11 8-20 5 4 6 9 5 12 3-2 4-6 4-9 6 5 11 11 11 18 0 7-6 12-14 12z" fill="currentColor"/></svg>',
 nova:'<svg viewBox="0 0 48 48" aria-hidden="true"><g class="spin" fill="currentColor"><path d="M24 2l4 16 16 6-16 6-4 16-4-16-16-6 16-6z"/></g></svg>',
 glitch:'<svg viewBox="0 0 48 48" aria-hidden="true"><g class="gl" fill="currentColor"><rect x="10" y="8" width="26" height="6"/><rect x="14" y="17" width="26" height="6"/><rect x="8" y="26" width="26" height="6"/><rect x="12" y="35" width="26" height="6"/></g></svg>',
 lunge:'<svg viewBox="0 0 48 48" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round"><path class="ar" d="M8 40 36 12M24 12h12v12"/></g><circle cx="38" cy="10" r="5" fill="none" stroke="#ff6a7a" stroke-width="2"/></svg>',
 beam:'<svg viewBox="0 0 48 48" aria-hidden="true"><rect class="bm" x="4" y="20" width="40" height="8" rx="4" fill="currentColor"/></svg>',
 comet:'<svg viewBox="0 0 48 48" aria-hidden="true"><path d="M6 42 30 18" stroke="currentColor" stroke-width="6" stroke-linecap="round" opacity=".4"/><circle class="rock" cx="33" cy="15" r="8" fill="currentColor"/></svg>',
 claw:'<svg viewBox="0 0 48 48" aria-hidden="true"><g class="cl" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M14 8 8 40M26 6 20 42M38 8 32 40"/></g></svg>',
 phantom:'<svg viewBox="0 0 48 48" aria-hidden="true"><g fill="currentColor"><rect x="6" y="14" width="14" height="20" rx="2" opacity=".25"/><rect x="14" y="14" width="14" height="20" rx="2" opacity=".5"/><rect class="ph" x="24" y="14" width="14" height="20" rx="2"/></g></svg>'};
const entStyle=()=>{const v=S.g('ent_style','rise');return ENT_T.some(x=>x[0]===v)?v:'rise'};
const atkStyle=()=>{const v=S.g('atk_style','lunge');return ATK_T.some(x=>x[0]===v)?v:'lunge'};
function perCardFx(key,T){const o=S.g(key,{}),out={};if(o&&typeof o==='object')for(const k of sigCards())if(T.some(x=>x[0]===o[k]))out[k]=o[k];return out}
function mvTiles(kind,sel){const T=kind==='ent'?ENT_T:ATK_T;return `<div class="fin-row mv-row" role="radiogroup" aria-label="${kind==='ent'?'Entrance':'Attack'}">${T.map(([k,l])=>`<button type="button" class="fin-t mv-t mv-${k}${sel===k?' on':''}" role="radio" aria-checked="${sel===k}" data-mv="${kind}" data-mvk="${k}">${MV_ICON[k]}<span>${l}</span></button>`).join('')}</div>`}
function previewMove(kind,k){const T=kind==='ent'?ENT_T:ATK_T,l=(T.find(x=>x[0]===k)||['',''])[1];openModal(`<div class="dk-hd"><h3>${esc(l)} · ${kind==='ent'?'entrance':'attack'}</h3><button class="ibtn" data-close aria-label="Close">${ic('x')}</button></div><iframe class="pv-wrap" title="Preview" src="${ARENA_URL}preview.html#${kind==='ent'?'entrance':'attack'}:${k}"></iframe><p class="note">${kind==='ent'?'How your monsters arrive on the field.':'How your monsters attack. The target is always marked so both players see what is attacked.'}${PREMIUM?'':' Free edition: Rise and Lunge. The others come with KodeX Premium.'}</p>`,'','pv')}
function emotesOwn(){const a=S.g('emotes',[]);return Array.isArray(a)?a.filter(x=>x&&typeof x.src==='string'&&/^data:image\/(png|jpe?g|webp|gif);base64,/.test(x.src)).slice(0,8):[]}
function emotesSection(){const a=emotesOwn();return `<section class="sk-sec"><div class="sk-hd"><h4>Emotes</h4></div><p class="note">Up to 8 of your own pictures to send during a duel, at any time. Animated GIFs keep moving (GIFs up to 150 KB).</p><div class="em-row">${a.map(x=>`<span class="em-t"><img src="${x.src}" alt="${esc(x.name)}"><i data-emdel="${esc(x.id)}" role="button" aria-label="Delete">×</i></span>`).join('')}${a.length<8?`<label class="em-t em-add" aria-label="Add an emote"><span>+</span><input type="file" accept="image/*" data-emadd hidden></label>`:''}</div></section>`}
function readDataUrl(f){return new Promise((ok,no)=>{const r=new FileReader();r.onload=()=>ok(r.result);r.onerror=no;r.readAsDataURL(f)})}
function shrinkPng(file,max){return new Promise((ok,no)=>{const u=URL.createObjectURL(file),im=new Image();im.onload=()=>{const k=Math.min(1,max/Math.max(im.naturalWidth,im.naturalHeight)),c=document.createElement('canvas');c.width=Math.round(im.naturalWidth*k);c.height=Math.round(im.naturalHeight*k);c.getContext('2d').drawImage(im,0,0,c.width,c.height);URL.revokeObjectURL(u);let d=c.toDataURL('image/png');if(d.length>190000)d=c.toDataURL('image/webp',.85);ok(d)};im.onerror=()=>{URL.revokeObjectURL(u);no(new Error('image'))};im.src=u})}
function movesPanel(tb){
 tb.querySelectorAll('[data-mv]').forEach(b=>b.onclick=()=>{const kind=b.dataset.mv;S.s(kind==='ent'?'ent_style':'atk_style',b.dataset.mvk);tb.querySelectorAll(`[data-mv="${kind}"]`).forEach(x=>{x.classList.toggle('on',x===b);x.setAttribute('aria-checked',String(x===b))});const pv=tb.querySelector(`[data-mvpv="${kind}"]`);if(pv)pv.textContent='Preview '+b.textContent.trim();skinsToArena()});
 tb.querySelectorAll('[data-mvpv]').forEach(b=>b.onclick=()=>previewMove(b.dataset.mvpv,b.dataset.mvpv==='ent'?entStyle():atkStyle()));
 tb.querySelectorAll('[data-emdel]').forEach(b=>b.onclick=e=>{e.stopPropagation();S.s('emotes',emotesOwn().filter(x=>x.id!==b.dataset.emdel));skinsToArena();openSkins()});
 const ea=tb.querySelector('[data-emadd]');if(ea)ea.onchange=async()=>{const f=ea.files&&ea.files[0];if(!f)return;try{let src;if(/gif$/i.test(f.type)){if(f.size>150000){toast('That GIF is too large (up to 150 KB)');return}src=await readDataUrl(f)}else src=await shrinkPng(f,160);if(src.length>200000){toast('That picture is too large');return}const a=emotesOwn();a.push({id:'e'+Date.now().toString(36),name:f.name.replace(/\.\w+$/,'').slice(0,24)||'Emote',src});S.s('emotes',a);skinsToArena();openSkins()}catch(e){toast('That picture could not be used')}};
}

/* ---------- testing data from the Arena (for the Synapse Deck Analyzer) ---------- */
function deckMainCodes(d){return copies(d,'main').map(c=>Number(pcOf(c))).filter(Boolean)}
function recordStats(m){
 if(!m||!m.result||!m.deck||!Array.isArray(m.deck.main))return;
 const want=m.deck.main.map(Number).sort((a,b)=>a-b),all=deckStore();let best=null,bs=0;
 for(const d of all){const have=deckMainCodes(d).sort((a,b)=>a-b);if(!have.length)continue;const set=new Map();for(const c of have)set.set(c,(set.get(c)||0)+1);let hit=0;for(const c of want){const n=set.get(c)||0;if(n){hit++;set.set(c,n-1)}}let sc=hit/Math.max(have.length,want.length);if(d.name===m.deck.name)sc+=.25;if(sc>bs){bs=sc;best=d}}
 if(!best||bs<.6)return;
 const st=S.g('dstats',{}),r=m.result,clean={at:+r.at||Date.now(),win:!!r.win,draw:!!r.draw,turns:+r.turns||0,dead:!!r.dead,otk:!!r.otk,first:!!r.first,vs:r.vs==='online'?'online':'ai',used:{},drawn:{}};
 for(const k of ['used','drawn'])if(r[k]&&typeof r[k]==='object')for(const [c,n] of Object.entries(r[k]).slice(0,120))if(/^\d{3,10}$/.test(c))clean[k][c]=Math.min(99,+n||0);
 const e=st[best.id]||{games:[]};e.games.push(clean);e.games=e.games.slice(-150);st[best.id]=e;
 const ks=Object.keys(st);if(ks.length>60)delete st[ks[0]];S.s('dstats',st);
}

/* ---------- Synapse Deck Analyzer ---------- */
const AZ_RX={
 search:/add[^.]*from your (deck|gy|graveyard)[^.]*to your hand|add[^.]*from your deck/i,
 deckSS:/special summon[^.]*from your deck/i,
 selfSS:/(you can )?special summon this card(?! from)|special summon this card from your (hand|gy|graveyard)/i,
 extender:/special summon[^.]*from your (hand|gy|graveyard)/i,
 draw:/\bdraw (\d|one|two|three|1|2|3) cards?\b|\bdraw 1 card\b/i,
 remove:/destroy|banish|return[^.]*(to the hand|to the deck)|send[^.]*(your opponent controls|on the field) to the (gy|graveyard)|take control/i,
 mass:/(destroy|banish|return|send) all|each (card|monster) your opponent controls/i,
 negate:/\bnegate\b/i,
 quick:/\(quick effect\)|quick-play|counter trap|\btrap\b/i,
 handtrap:/discard this card[^.]*;|\(quick effect\)[^.]*(from your hand|discard this card)/i,
 protect:/cannot be destroyed|unaffected by|cannot be targeted|cannot be (banished|tributed)/i,
 floodgate:/your opponent cannot|neither player can|monsters your opponent controls cannot|cannot (special summon|activate)/i,
 recur:/from your (gy|graveyard)[^.]*(add|special summon|to your hand)|(add|special summon)[^.]*from your (gy|graveyard)|shuffle[^.]*(gy|graveyard)[^.]*into the deck/i,
 grave:/if this card is sent to the (gy|graveyard)|if this card is (destroyed|banished)|while this card is in your (gy|graveyard)/i,
 burn:/inflict[^.]*damage/i,
 lifegain:/gain[^.]*life ?points|gain \d+ lp/i,
 swarm:/special summon (up to )?(\d|two|three|as many)/i,
 lock:/(cannot|can't) special summon[^.]*except/i,
 boost:/gains? \d+ atk|atk becomes|double[^.]*atk/i,
 piercing:/piercing|attack (twice|all monsters)|direct(ly)? attack/i,
};
function azCard(c){const live=resolveDeckCard(c)||{},t=String(live.type||'').toLowerCase(),x=String(live.desc||'');const f={};for(const k in AZ_RX)f[k]=AZ_RX[k].test(x);f.mon=/monster/.test(t);f.spell=/spell/.test(t);f.trap=/trap/.test(t);f.ex=/fusion|synchro|xyz|link/.test(t);f.atk=+live.atk||0;f.def=+live.def||0;f.lv=+(live.lv||live.rk||live.lk)||0;f.name=c.name||live.name||'';f.id=String(c.id);f.code=pcOf(c);f.len=x.length;f.qp=/quick-play/.test(t);f.cont=/continuous/.test(t);f.field=/field/.test(t);f.equip=/equip/.test(t);f.normal=/normal monster/.test(t);f.link=/link/.test(t);f.starter=(f.search||f.deckSS)&&!f.handtrap&&!f.trap;f.text=x;return f}
function hyper(N,K,n,k){const C=(a,b)=>{if(b<0||b>a)return 0;let r=1;for(let i=1;i<=b;i++)r=r*(a-b+i)/i;return r};let p=0;for(let i=k;i<=Math.min(K,n);i++)p+=C(K,i)*C(N-K,n-i)/C(N,n);return Math.max(0,Math.min(1,p))}
const clamp100=v=>Math.max(0,Math.min(100,Math.round(v)));
function analyzeDeckV1(d){
 normalizeDeck(d);const main=copies(d,'main').map(azCard),extra=copies(d,'extra').map(azCard),all=[...main,...extra],N=main.length||1;
 const cntF=(arr,k)=>arr.filter(x=>x[k]).length,uniq=a=>[...new Map(a.map(x=>[x.id,x])).values()];
 const m={};for(const k of Object.keys(AZ_RX).concat(['mon','spell','trap','starter','qp']))m[k]=cntF(main,k);
 const ex={};for(const k of Object.keys(AZ_RX))ex[k]=cntF(extra,k);
 const mons=all.filter(x=>x.mon),atks=mons.map(x=>x.atk).sort((a,b)=>b-a),top3=atks.slice(0,3),avgTop=top3.length?top3.reduce((a,b)=>a+b,0)/top3.length:0,big=atks.filter(a=>a>=2500).length;
 const pStart=hyper(N,m.starter,5,1),pStart2=hyper(N,m.starter+m.extender,5,2),pHT=hyper(N,m.handtrap,5,1),pBrick=1-hyper(N,N-Math.max(0,N-m.starter-m.extender-m.handtrap-m.quick),5,1);
 const sizePen=Math.max(0,N-40)*1.6;
 const stat=[];
 const add=(k,label,v,why)=>stat.push({k,label,v:clamp100(v),why});
 add('atk','Attack',avgTop/40+big*5+(m.boost+m.piercing)*3+(m.burn)*2,[`Top 3 ATK average ${Math.round(avgTop)} → ${Math.round(avgTop/40)}`,`${big} monsters with 2500+ ATK × 5`,`${m.boost+m.piercing} ATK boost / piercing cards × 3, ${m.burn} burn cards × 2`]);
 add('ctl','Control',(m.remove+ex.remove)*4+(m.negate+ex.negate)*4+m.floodgate*5+m.handtrap*4,[`Removal ${m.remove+ex.remove} × 4`,`Negation ${m.negate+ex.negate} × 4`,`Locks on the opponent ${m.floodgate} × 5`,`Hand traps ${m.handtrap} × 4`]);
 add('con','Consistency',pStart*80+pStart2*25-sizePen+(m.draw)*1.5,[`Chance to open a starter (searcher / summons from Deck, ${m.starter} copies) in 5 cards: ${(pStart*100).toFixed(1)}% × 0.8`,`Chance to open 2+ starters or extenders (${m.starter+m.extender}): ${(pStart2*100).toFixed(1)}% × 0.25`,`Deck size ${N}: −${sizePen.toFixed(1)} (above 40)`,`Draw cards ${m.draw} × 1.5`]);
 add('brk','Board Breaking',m.mass*12+(m.remove)*3+m.handtrap*3+m.qp*2+(m.negate)*2,[`Mass removal ${m.mass} × 12`,`Removal ${m.remove} × 3`,`Hand traps ${m.handtrap} × 3, Quick-Play ${m.qp} × 2, negation ${m.negate} × 2`]);
 const kinds=new Set(all.map(x=>x.mon?(x.ex?(x.link?'L':'E'):'M'):x.spell?(x.qp?'Q':x.cont?'C':x.field?'F':x.equip?'Q2':'S'):'T')).size;
 add('ver','Versatility',kinds*8+Math.min(15,extra.length)*1.6+(m.quick)*1.2,[`${kinds} kinds of cards × 8`,`Extra Deck ${extra.length} (up to 15) × 1.6`,`Cards usable on the opponent's turn ${m.quick} × 1.2`]);
 add('res','Resilience',(m.protect+ex.protect)*5+(m.grave+ex.grave)*3+(m.negate+ex.negate)*2+m.floodgate*2,[`Protection ${m.protect+ex.protect} × 5`,`Effects from the GY / when destroyed ${m.grave+ex.grave} × 3`,`Negation ${m.negate+ex.negate} × 2, locks ${m.floodgate} × 2`]);
 add('rec','Recovery',(m.recur+ex.recur)*5+m.draw*5+m.search*1.5+m.lifegain*2,[`Cards back from the GY ${m.recur+ex.recur} × 5`,`Draw ${m.draw} × 5`,`Searches ${m.search} × 1.5, life gain ${m.lifegain} × 2`]);
 const star=(v,max)=>Math.max(1,Math.min(5,Math.round(v/max*5)));
 const stars=[['Draw power',star(m.draw*2+m.search,14),`${m.draw} draw + ${m.search} search cards`],['Control',star(stat[1].v,100),`Control score ${stat[1].v}`],['Search',star(m.search+m.deckSS,14),`${m.search} searchers, ${m.deckSS} summon from the Deck`],['Layered end board',star((ex.negate+ex.protect)*2+m.quick+m.floodgate*2,24),`${ex.negate} Extra Deck negators, ${m.quick} cards for the opponent's turn`],['Beatdown',star(stat[0].v,100),`Attack score ${stat[0].v}`],['Stamina',star(stat[6].v+stat[5].v/2,110),`Recovery ${stat[6].v} + half of Resilience`],['Comeback',star(m.mass*4+m.recur*2+m.handtrap*2,30),`${m.mass} board wipes, ${m.recur} recursion, ${m.handtrap} hand traps`],['Swarm',star(m.swarm*3+m.extender*2+m.deckSS*2+extra.length,40),`${m.extender} extenders, ${m.deckSS} Deck summons, ${extra.length} Extra Deck`]];
 const effectShare=all.filter(x=>x.len>120).length/Math.max(1,all.length),avgLen=all.reduce((a,x)=>a+x.len,0)/Math.max(1,all.length);
 const diffV=clamp100(effectShare*45+avgLen/12+extra.length*1.5+(m.quick)*1+m.lock*4);
 const difficulty=diffV>=75?'Expert':diffV>=55?'Hard':diffV>=35?'Medium':'Easy';
 const staminaV=clamp100(stat[6].v*.6+stat[5].v*.4);
 const stamina=staminaV>=60?'Long game':staminaV>=35?'Balanced':'Short game';
 // testing data
 const games=((S.g('dstats',{})||{})[d.id]||{games:[]}).games||[];
 const T={n:games.length};
 if(games.length){T.wins=games.filter(g=>g.win).length;T.rate=T.wins/games.length;T.dead=games.filter(g=>g.dead).length;T.otk=games.filter(g=>g.otk).length;T.turns=games.reduce((a,g)=>a+g.turns,0)/games.length;const f=games.filter(g=>g.first),s2=games.filter(g=>!g.first);T.first=f.length?f.filter(g=>g.win).length/f.length:null;T.second=s2.length?s2.filter(g=>g.win).length/s2.length:null;
  const used={},drawn={};for(const g of games){for(const [c,n] of Object.entries(g.used||{}))used[c]=(used[c]||0)+n;for(const [c,n] of Object.entries(g.drawn||{}))drawn[c]=(drawn[c]||0)+n}
  const nm=c=>{const x=all.find(v=>String(v.code)===String(c)||v.id===String(c));return x?x.name:(M.get(String(c))||{}).name||('#'+c)};
  const inDeck=uniq(all);T.most=Object.entries(used).sort((a,b)=>b[1]-a[1]).slice(0,5).map(([c,n])=>[nm(c),n]);
  T.least=inDeck.map(x=>[x.name,used[x.code]||0,drawn[x.code]||0]).sort((a,b)=>a[1]-b[1]||b[2]-a[2]).slice(0,5)}
 const base=stat.reduce((a,x)=>a+x.v,0)/stat.length;
 const final=clamp100(T.n>=5?base*.7+T.rate*100*.3:base);
 const rank=final>=90?'S+':final>=80?'S':final>=70?'A':final>=58?'B':final>=45?'C':'D';
 const order=[...stat].sort((a,b)=>b.v-a.v),topK=order.slice(0,2).map(x=>x.k);
 const rec=[];if(topK.includes('con')&&stat[2].v>=60)rec.push('Competitive play');if(topK.includes('ctl'))rec.push('Control players');if(topK.includes('atk')||topK.includes('brk'))rec.push('Aggressive players (OTK)');if(topK.includes('rec')||topK.includes('res'))rec.push('Grind-game lovers');if(difficulty==='Easy'||difficulty==='Medium')rec.push('New duelists');if(difficulty==='Expert')rec.push('Experienced combo players');if(!rec.length)rec.push('Casual duels');
 // key cards
 const U=uniq(all),score=x=>(x.starter?30:0)+(x.negate?18:0)+(x.mass?20:0)+(x.protect?10:0)+(x.handtrap?14:0)+x.atk/150+(x.recur?8:0)+(x.ex&&x.atk>=3000?10:0)+all.filter(v=>v.text.includes(x.name)&&v.id!==x.id).length*12;
 const key={beaters:U.filter(x=>x.mon).sort((a,b)=>b.atk-a.atk).slice(0,3),keys:[...U].sort((a,b)=>score(b)-score(a)).slice(0,4),defenders:U.filter(x=>x.mon&&(x.protect||x.negate||x.def>=2500)).sort((a,b)=>(b.protect+b.negate)*1000+b.def-((a.protect+a.negate)*1000+a.def)).slice(0,3),starters:U.filter(x=>x.starter).slice(0,4)};
 key.best=[...U].sort((a,b)=>score(b)-score(a))[0]||null;
 const comp=[['Monsters',m.mon,'#e8b25a'],['Spells',m.spell,'#38c9a6'],['Traps',m.trap,'#d9729f']];
 return {d,N,extra:extra.length,stat,stars,difficulty,diffV,stamina,staminaV,final,rank,rec,key,T,comp,odds:{pStart,pStart2,pHT,pBrick},m,ex};
}
function azRadar(stat){const cx=150,cy=140,R=104,n=stat.length,pt=(i,r)=>{const a=-Math.PI/2+i*2*Math.PI/n;return [cx+Math.cos(a)*r,cy+Math.sin(a)*r]};
 let g='';for(const f of [.25,.5,.75,1])g+=`<polygon points="${stat.map((_,i)=>pt(i,R*f).join(',')).join(' ')}" fill="none" stroke="#ffffff" stroke-opacity="${f===1?.25:.1}"/>`;
 stat.forEach((_,i)=>{const [x,y]=pt(i,R);g+=`<line x1="${cx}" y1="${cy}" x2="${x}" y2="${y}" stroke="#ffffff" stroke-opacity=".1"/>`});
 const poly=stat.map((s,i)=>pt(i,R*s.v/100).join(',')).join(' ');
 g+=`<polygon class="az-poly" points="${poly}" fill="url(#azg)" fill-opacity=".45" stroke="#8d99ff" stroke-width="2.5" stroke-linejoin="round"/>`;
 stat.forEach((s,i)=>{const [x,y]=pt(i,R*s.v/100),[lx,ly]=pt(i,R+22);g+=`<circle cx="${x}" cy="${y}" r="4" fill="#f0b429"/><text x="${lx}" y="${ly}" text-anchor="middle" dominant-baseline="middle" font-size="11" fill="#c9d0f2">${s.label}</text><text x="${lx}" y="${ly+13}" text-anchor="middle" font-size="11" font-weight="700" fill="#f0b429">${s.v}</text>`});
 return `<svg class="az-radar" viewBox="0 0 300 290" role="img" aria-label="Main stats radar chart"><defs><linearGradient id="azg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#3347f0"/><stop offset="1" stop-color="#7a4fd6"/></linearGradient></defs>${g}</svg>`}
function azDonut(parts){const tot=parts.reduce((a,p)=>a+p[1],0)||1;let a0=-Math.PI/2,out='';for(const [l,v,c] of parts){if(!v)continue;const a1=a0+v/tot*2*Math.PI,lg=a1-a0>Math.PI?1:0,R=52,r=34,p=(a,rr)=>[60+Math.cos(a)*rr,60+Math.sin(a)*rr];const [x0,y0]=p(a0,R),[x1,y1]=p(a1-.0001,R),[x2,y2]=p(a1-.0001,r),[x3,y3]=p(a0,r);out+=`<path d="M${x0} ${y0}A${R} ${R} 0 ${lg} 1 ${x1} ${y1}L${x2} ${y2}A${r} ${r} 0 ${lg} 0 ${x3} ${y3}Z" fill="${c}"><title>${l}: ${v}</title></path>`;a0=a1}
 return `<svg viewBox="0 0 120 120" class="az-donut" role="img" aria-label="Card types">${out}<text x="60" y="58" text-anchor="middle" font-size="20" font-weight="800" fill="#fff">${tot}</text><text x="60" y="74" text-anchor="middle" font-size="9" fill="#9aa4bd">MAIN</text></svg>`}
function azRing(v,label,col){const C=2*Math.PI*42,o=C*(1-Math.max(0,Math.min(1,v)));return `<svg viewBox="0 0 100 100" class="az-ring" role="img" aria-label="${label}"><circle cx="50" cy="50" r="42" fill="none" stroke="#ffffff" stroke-opacity=".08" stroke-width="10"/><circle cx="50" cy="50" r="42" fill="none" stroke="${col}" stroke-width="10" stroke-linecap="round" stroke-dasharray="${C.toFixed(1)}" stroke-dashoffset="${o.toFixed(1)}" transform="rotate(-90 50 50)"/><text x="50" y="55" text-anchor="middle" font-size="18" font-weight="800" fill="#fff">${Math.round(v*100)}%</text></svg>`}
function azCurve(N,K){const pts=[];for(let n=1;n<=10;n++)pts.push([n,hyper(N,K,n,1)]);const X=n=>20+(n-1)*28,Y=p=>100-p*84;return `<svg viewBox="0 0 290 120" class="az-curve" role="img" aria-label="Chance to see a starter by cards seen"><path d="M${pts.map(([n,p])=>X(n)+' '+Y(p)).join('L')}" fill="none" stroke="#8d99ff" stroke-width="2.5"/>${pts.map(([n,p])=>`<circle cx="${X(n)}" cy="${Y(p)}" r="${n===5||n===6?4.5:3}" fill="${n===5||n===6?'#f0b429':'#8d99ff'}"><title>${n} cards: ${(p*100).toFixed(1)}%</title></circle><text x="${X(n)}" y="116" text-anchor="middle" font-size="9" fill="#9aa4bd">${n}</text>`).join('')}<text x="20" y="12" font-size="9" fill="#9aa4bd">chance to see a starter · cards seen →</text></svg>`}
function openAnalyzer(id){
 const d=deckById(id);if(!d)return;if(!d.cards.length){toast('Add cards to the deck first');return}
 const A=analyzeDeck(d),stars=n=>'<span class="az-st" aria-label="'+n+' of 5">'+'★'.repeat(n)+'<i>'+'★'.repeat(5-n)+'</i></span>';
 const kc=(t,arr)=>arr&&arr.length?`<div class="az-kc"><h5>${t}</h5><div class="az-kr">${arr.map(x=>{const u=deckCardImageUrl({id:x.id});return `<button type="button" class="az-k" data-quickview="${esc(x.id)}"><img src="${esc(u||'')}" alt="" loading="lazy" onerror="this.style.visibility='hidden'"><span>${esc(x.name)}</span></button>`}).join('')}</div></div>`:'';
 const T=A.T,pct=v=>v==null?'–':Math.round(v*100)+'%';
 const html=`<div class="dk-hd"><h3>Synapse Deck Analyzer</h3><button class="ibtn" data-close aria-label="Close">${ic('x')}</button></div>
<div class="az">
<div class="az-hero"><div class="az-rank r-${A.rank.replace('+','p')}"><b>${A.rank}</b><small>${A.final}/100</small></div><div class="az-ht"><small>FINAL SCORE</small><h4>${esc(d.name)}</h4><p>${A.N} Main · ${A.extra} Extra · ${A.difficulty} · ${A.stamina}</p></div></div>
<label class="az-calc"><input type="checkbox" data-azcalc><span>Show the calculations</span></label>
<section class="az-sec"><h5>Main stats</h5><div class="az-main">${azRadar(A.stat)}<div class="az-bars">${A.stat.map(s=>`<div class="az-bar"><span>${s.label}</span><i><b style="width:${s.v}%"></b></i><em>${s.v}</em><ul class="az-why">${s.why.map(w=>`<li>${esc(w)}</li>`).join('')}<li>Capped at 100</li></ul></div>`).join('')}</div></div></section>
<section class="az-sec"><h5>More stats</h5><div class="az-stars">${A.stars.map(([l,n,w])=>`<div class="az-sr"><span>${l}</span>${stars(n)}<small class="az-why">${esc(w)}</small></div>`).join('')}</div></section>
<section class="az-sec az-3"><div class="az-box"><h5>Deck difficulty</h5><b class="az-big">${A.difficulty}</b><i class="az-meter"><b style="width:${A.diffV}%"></b></i><small class="az-why">Long effect texts ${Math.round(A.diffV)} pts: share of cards with long texts, average text length, Extra Deck size, cards for the opponent's turn and summon locks.</small></div><div class="az-box"><h5>Deck stamina</h5><b class="az-big">${A.stamina}</b><i class="az-meter"><b style="width:${A.staminaV}%"></b></i><small class="az-why">Recovery × 0.6 + Resilience × 0.4 = ${A.staminaV}</small></div><div class="az-box"><h5>Card types</h5>${azDonut(A.comp)}<small>${A.comp.map(c=>`<span style="color:${c[2]}">●</span> ${c[0]} ${c[1]}`).join(' · ')}</small></div></section>
<section class="az-sec"><h5>Opening hand</h5><div class="az-odds"><div>${azCurve(A.N,A.m.starter)}</div><ul><li><b>${(A.odds.pStart*100).toFixed(1)}%</b> open a starter in 5 cards</li><li><b>${(A.odds.pStart2*100).toFixed(1)}%</b> open 2+ starters or extenders</li><li><b>${(A.odds.pHT*100).toFixed(1)}%</b> open a hand trap</li></ul></div><small class="az-why">Hypergeometric odds: ${A.N} cards, ${A.m.starter} starters, ${A.m.extender} extenders, ${A.m.handtrap} hand traps, 5 cards drawn.</small></section>
<section class="az-sec"><h5>Recommended for</h5><div class="az-chips">${A.rec.map(r=>`<span>${esc(r)}</span>`).join('')}</div></section>
<section class="az-sec"><h5>Key cards</h5>${A.key.best?`<div class="az-best"><button type="button" class="az-k big" data-quickview="${esc(A.key.best.id)}"><img src="${esc(deckCardImageUrl({id:A.key.best.id})||'')}" alt="" onerror="this.style.visibility='hidden'"></button><div><small>BEST CARD</small><b>${esc(A.key.best.name)}</b><p class="az-why">Most impact: starts plays, stops the opponent, is named by other cards or hits hard.</p></div></div>`:''}${kc('Starters',A.key.starters)}${kc('Main beaters',A.key.beaters)}${kc('Key cards',A.key.keys)}${kc('Defenders',A.key.defenders)}</section>
<section class="az-sec"><h5>Testing data</h5>${T.n?`<div class="az-test"><div class="az-tr">${azRing(T.rate,'Win ratio','#38c9a6')}<small>Win ratio · ${T.wins} of ${T.n}</small></div><div class="az-tg"><div><b>${T.n}</b><small>duels</small></div><div><b>${T.otk}</b><small>OTKs</small></div><div><b>${pct(T.dead/T.n)}</b><small>dead hands</small></div><div><b>${T.turns.toFixed(1)}</b><small>avg. turns</small></div><div><b>${pct(T.first)}</b><small>win going first</small></div><div><b>${pct(T.second)}</b><small>win going second</small></div></div></div><div class="az-2"><div><h6>Most used</h6><ol>${T.most.map(([n,c])=>`<li>${esc(n)} <em>${c}×</em></li>`).join('')||'<li>–</li>'}</ol></div><div><h6>Least used</h6><ol>${T.least.map(([n,c,dr])=>`<li>${esc(n)} <em>${c}× used · ${dr}× drawn</em></li>`).join('')}</ol></div></div>${T.n>=5?'<small class="az-why">With 5+ duels the final score is 70% card stats + 30% win ratio.</small>':''}`:`<p class="note">No duels with this deck yet. Playtest it in the Duel Arena: every duel adds its win, OTKs, dead hands and the cards you used.</p><button class="btn" data-playtest="${esc(d.id)}">${ic('play',18)}Playtest now</button>`}</section>
<p class="note az-foot">Card stats come from the card texts and are a guide, not a rule. A dead hand is a first turn with no summon and no activation.</p>
</div>`;
 const m=openModal(html,'big','az');const box=m.querySelector('.az'),cb=m.querySelector('[data-azcalc]');cb.checked=!!S.g('az_calc',false);box.classList.toggle('calc',cb.checked);cb.onchange=()=>{S.s('az_calc',cb.checked);box.classList.toggle('calc',cb.checked)};
}

</script>
<script id="kx-v56-js">
/* ---------- KodeX 8.9: winning-attack finale, Ace cards, card voices, sound emotes, HD GIF emotes ---------- */
const FINALE_T=[['menacing','Menacing'],['rush','Rush'],['timestop','Time Stop'],['freeze','Freeze Frame'],['domain','Domain Expansion'],['allout','All-Out Attack'],['impact','Impact Frame'],['destiny','Destiny Draw'],['finalblow','Final Blow'],['powerup','Power Up'],['beam','Energy Blast'],['spotlight','Spotlight'],['radiant','Radiant']];
const ACE_T=FINALE_T;
const SHOW_ICON={domain:'<svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="19" fill="none" stroke="currentColor" stroke-width="2.6"/><circle cx="24" cy="24" r="12" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="4 3"/><circle cx="24" cy="24" r="4" fill="currentColor"/></svg>',allout:'<svg viewBox="0 0 48 48" aria-hidden="true"><path d="M24 5l5 12 13 1-10 8 3 13-11-7-11 7 3-13L6 18l13-1z" fill="currentColor" opacity=".9"/><path d="M6 41 42 7" stroke="#0c0f1f" stroke-width="4"/><path d="M6 41 42 7" stroke="#e0102a" stroke-width="2"/></svg>',impact:'<svg viewBox="0 0 48 48" aria-hidden="true"><path d="M24 3l4 12 11-6-5 11 12 4-12 4 5 11-11-6-4 12-4-12-11 6 5-11-12-4 12-4-5-11 11 6z" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/></svg>',destiny:'<svg viewBox="0 0 48 48" aria-hidden="true"><rect x="13" y="10" width="20" height="29" rx="3" fill="none" stroke="currentColor" stroke-width="2.6" transform="rotate(-10 23 24)"/><path d="M37 5l2 5 5 2-5 2-2 5-2-5-5-2 5-2z" fill="currentColor"/></svg>',finalblow:'<svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="20" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="3 4"/><text x="24" y="30" text-anchor="middle" font-size="16" font-weight="900" font-style="italic" fill="currentColor">K.O.</text></svg>',powerup:'<svg viewBox="0 0 48 48" aria-hidden="true"><path d="M24 4c3 8 12 12 12 24a12 12 0 0 1-24 0c0-6 3-9 5-12 1 4 3 6 5 6-2-6 0-12 2-18z" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linejoin="round"/></svg>',beam:'<svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="12" cy="24" r="8" fill="currentColor"/><path d="M18 18h26M18 30h26" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/><path d="M21 24h23" stroke="currentColor" stroke-width="5" stroke-linecap="round" opacity=".55"/></svg>',random:'<svg viewBox="0 0 48 48" aria-hidden="true"><rect x="8" y="8" width="32" height="32" rx="7" fill="none" stroke="currentColor" stroke-width="2.6"/><g fill="currentColor"><circle cx="17" cy="17" r="3"/><circle cx="31" cy="17" r="3"/><circle cx="24" cy="24" r="3"/><circle cx="17" cy="31" r="3"/><circle cx="31" cy="31" r="3"/></g></svg>',
 menacing:'<svg viewBox="0 0 48 48" aria-hidden="true"><text class="gg" x="4" y="22" font-size="15" font-weight="900" fill="currentColor">ゴゴ</text><text class="gg g2" x="18" y="42" font-size="15" font-weight="900" fill="currentColor">ゴゴ</text></svg>',
 rush:'<svg viewBox="0 0 48 48" aria-hidden="true"><g class="rs" fill="currentColor"><circle cx="14" cy="16" r="6"/><circle cx="32" cy="14" r="5"/><circle cx="24" cy="30" r="7"/><circle cx="38" cy="32" r="5"/></g></svg>',
 timestop:'<svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="18" fill="none" stroke="currentColor" stroke-width="3"/><path class="hand" d="M24 24V11M24 24l8 6" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>',
 freeze:'<svg viewBox="0 0 48 48" aria-hidden="true"><path class="tbc" d="M4 18h30l10 6-10 6H4z" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/></svg>',
 spotlight:'<svg viewBox="0 0 48 48" aria-hidden="true"><path class="sp" d="M24 4 10 44h28z" fill="currentColor" opacity=".35"/><rect x="17" y="18" width="14" height="20" rx="2" fill="none" stroke="currentColor" stroke-width="2.6"/></svg>',
 radiant:'<svg viewBox="0 0 48 48" aria-hidden="true"><g class="rad" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M24 3v8M24 37v8M3 24h8M37 24h8M9 9l6 6M33 33l6 6M9 39l6-6M33 15l6-6"/></g><circle cx="24" cy="24" r="7" fill="currentColor"/></svg>'};
const finaleStyle=()=>{const v=S.g('finale_style','menacing');return v==='random'||FINALE_T.some(x=>x[0]===v)?v:'menacing'};
const aceStyle=()=>{const v=S.g('ace_style','spotlight');return v==='random'||ACE_T.some(x=>x[0]===v)?v:'spotlight'};
const aceCards=()=>{const a=S.g('ace_cards',[]);const sig=new Set(sigCards());return Array.isArray(a)?a.filter(x=>sig.has(String(x))).slice(0,12):[]};
function showTiles(kind,sel){const T=kind==='finale'?FINALE_T:ACE_T;return `<div class="fin-row mv-row show-row" role="radiogroup" aria-label="${kind==='finale'?'Winning attack':'Ace showcase'}">${T.map(([k,l],i)=>`<button type="button" class="fin-t mv-t sh-${k}${sel===k?' on':''}${!PREMIUM&&kind==='finale'&&i?' prem':''}" role="radio" aria-checked="${sel===k}" data-show="${kind}" data-showk="${k}">${SHOW_ICON[k]}<span>${l}</span></button>`).join('')}</div>`}
function previewShow(kind,k){const T=kind==='finale'?FINALE_T:ACE_T,l=(T.find(x=>x[0]===k)||['',''])[1];openModal(`<div class="dk-hd"><h3>${esc(l)} · ${kind==='finale'?'winning attack':'Ace card'}</h3><button class="ibtn" data-close aria-label="Close">${ic('x')}</button></div><iframe class="pv-wrap" title="Preview" src="${ARENA_URL}preview.html#${kind}:${k}"></iframe><p class="note">${kind==='finale'?'Plays for 3 seconds before an attack that wins the duel. Everyone in the duel sees it.':'Your Ace cards are shown on the big screen before their effect resolves.'}${PREMIUM?'':kind==='finale'?' Free edition: Menacing. The others come with KodeX Premium.':' Ace cards come with KodeX Premium.'}</p>`,'','pv')}
// Premium media: kept in the device's database (HD GIFs are too large for settings storage)
const MEDIA={emotes:[],sounds:[],voices:{},ready:false};
async function mediaLoad(){try{let e=await kv('get','m56_emotes');if(!Array.isArray(e)){const old=S.g('emotes',[]);e=Array.isArray(old)?old.filter(x=>x&&typeof x.src==='string').map(x=>({id:x.id,name:x.name,src:x.src,snd:''})):[];await kv('put','m56_emotes',e)}MEDIA.emotes=e.slice(0,8);const so=await kv('get','m56_sounds');MEDIA.sounds=Array.isArray(so)?so.slice(0,8):[];const v=await kv('get','m56_voices');MEDIA.voices=v&&typeof v==='object'?v:{}}catch(x){}MEDIA.ready=true}
async function mediaSave(){await kv('put','m56_emotes',MEDIA.emotes);await kv('put','m56_sounds',MEDIA.sounds);await kv('put','m56_voices',MEDIA.voices)}
const IMG_MAX=3.3e6,SND_MAX=650000;
function fileToDataUrl(f){return new Promise((ok,no)=>{const r=new FileReader();r.onload=()=>ok(r.result);r.onerror=no;r.readAsDataURL(f)})}
async function pickAudio(file){if(!file)return null;if(!/^audio\//.test(file.type)&&!/\.(mp3|m4a|aac|ogg|oga|wav|opus|webm)$/i.test(file.name)){toast('Choose an audio file');return null}if(file.size>SND_MAX){toast('Sounds must be 650 KB or less (about 30 s of voice)');return null}let u=await fileToDataUrl(file);if(!/^data:audio\//.test(u))u=u.replace(/^data:[^;,]*/,'data:audio/mpeg');return {name:file.name.replace(/\.\w+$/,'').slice(0,24)||'Sound',snd:u}}
/** Records a short sound with the microphone (up to `max` seconds). Resolves with a data: URL or null. */
function recordSound(max=6){return new Promise(async done=>{if(!navigator.mediaDevices||!navigator.mediaDevices.getUserMedia||typeof MediaRecorder==='undefined'){toast('Recording is not available here: choose an audio file instead');done(null);return}let stream;try{stream=await navigator.mediaDevices.getUserMedia({audio:true})}catch(e){toast('KodeX needs microphone access to record');done(null);return}
 const m=openModal(`<div class="dk-hd"><h3>Record a sound</h3><button class="ibtn" data-close aria-label="Close">${ic('x')}</button></div><div class="rec-box"><button type="button" class="rec-btn" data-rec aria-label="Start recording"><i></i></button><b data-rect>Tap to record · up to ${max} s</b><audio data-recpv controls hidden></audio><div class="rec-acts" hidden><button class="btn" data-recagain>Record again</button><button class="btn p" data-recuse>Use this</button></div></div>`,'','rec');
 let rec=null,chunks=[],url=null,timer=0,t0=0;const btn=m.querySelector('[data-rec]'),lbl=m.querySelector('[data-rect]'),pv=m.querySelector('[data-recpv]'),acts=m.querySelector('.rec-acts');
 const stopAll=()=>{try{stream.getTracks().forEach(t=>t.stop())}catch(e){}};
 const start=()=>{chunks=[];url=null;pv.hidden=true;acts.hidden=true;try{rec=new MediaRecorder(stream)}catch(e){toast('Recording failed');return}rec.ondataavailable=e=>{if(e.data&&e.data.size)chunks.push(e.data)};rec.onstop=async()=>{clearInterval(timer);btn.classList.remove('on');const blob=new Blob(chunks,{type:rec.mimeType||'audio/webm'});if(blob.size>SND_MAX){toast('Too long: keep it under a few seconds');lbl.textContent='Tap to record again';return}url=await fileToDataUrl(blob);pv.src=url;pv.hidden=false;acts.hidden=false;lbl.textContent='Listen, then use it or record again'};rec.start();t0=Date.now();btn.classList.add('on');timer=setInterval(()=>{const s=(Date.now()-t0)/1000;lbl.textContent=`Recording… ${s.toFixed(1)} s · tap to stop`;if(s>=max&&rec.state==='recording')rec.stop()},100)};
 btn.onclick=()=>{if(rec&&rec.state==='recording')rec.stop();else start()};
 m.querySelector('[data-recagain]').onclick=()=>start();
 let used=false;m.querySelector('[data-recuse]').onclick=()=>{used=true;stopAll();closeModal();done(url)};
 const obs=new MutationObserver(()=>{if(!m.isConnected){obs.disconnect();stopAll();if(!used)done(null)}});obs.observe(document.body,{childList:true,subtree:true});
})}
function emotesOwn(){return MEDIA.emotes}
function finaleSection(){return `<section class="sk-sec"><div class="sk-hd"><h4>Winning attack</h4></div><p class="note">A 3-second showdown before an attack that wins the duel. Everyone in the duel sees it.</p>${showTiles('finale',finaleStyle())}<button type="button" class="btn fin-pv" data-showpv="finale">Preview ${FINALE_T.find(x=>x[0]===finaleStyle())[1]}</button></section><section class="sk-sec"><div class="sk-hd"><h4>Ace cards</h4></div><p class="note">Mark up to 12 of your signature cards as Ace cards (★ below). When one is summoned or activated it fills the screen before its effect resolves.</p>${showTiles('ace',aceStyle())}<button type="button" class="btn fin-pv" data-showpv="ace">Preview ${ACE_T.find(x=>x[0]===aceStyle())[1]}</button></section>`}
function emotesSection(){const a=MEDIA.emotes;return `<section class="sk-sec"><div class="sk-hd"><h4>Emotes</h4></div><p class="note">Up to 8 of your own pictures to send at any time in a duel. HD animated GIFs welcome (up to 3.3 MB). Give one a sound with 🔊.</p><div class="em-row">${a.map(x=>`<span class="em-t"><img src="${x.src}" alt="${esc(x.name)}"><i data-emdel="${esc(x.id)}" role="button" aria-label="Delete">×</i><b class="em-snd${x.snd?' on':''}" data-emsnd="${esc(x.id)}" role="button" aria-label="${x.snd?'Change the sound':'Add a sound'}">🔊</b></span>`).join('')}${a.length<8?`<label class="em-t em-add" aria-label="Add an emote"><span>+</span><input type="file" accept="image/*" data-emadd hidden></label>`:''}</div></section>`}
function soundsSection(){const a=MEDIA.sounds;return `<section class="sk-sec"><div class="sk-hd"><h4>Sound emotes</h4></div><p class="note">Up to 8 sounds of your own (a file or a recording) next to the built-in ones. Everyone in the duel hears them, unless they mute you.</p><div class="snd-list">${a.map(x=>`<span class="sig-chip"><button type="button" data-sndplay="${esc(x.id)}" aria-label="Play">▶</button>${esc(x.name)}<button type="button" data-snddel2="${esc(x.id)}" aria-label="Delete">×</button></span>`).join('')}</div>${a.length<8?`<div class="snd-add"><label class="btn">${ic('plus',16)}Audio file<input type="file" accept="audio/*" data-sndfile hidden></label><button type="button" class="btn" data-sndrec>🎙 Record</button></div>`:''}</section>`}
function playData(u){try{const a=new Audio(u);a.play().catch(()=>{})}catch(e){}}

</script>
<script>
'use strict';
const P='https://kodex.meiocg.org',IDX=P+'/indexes/search.json',NAMEIX=P+'/data/rulings/card-name-index.json',RUL=P+'/data/rulings/cards/',TTL=6*36e5;
const $=i=>document.getElementById(i);
const esc=s=>String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
const DEFAULT_IMG_PROXY='';/* optional override of the art host */
const IMG_BASE='https://kodex.meiocg.org';
const S={g(k,d){try{const v=localStorage.getItem('kx_'+k);if(v===null)return d;const j=JSON.parse(v);return(j===null||(d!==null&&typeof j!==typeof d)||Array.isArray(j)!==Array.isArray(d))?d:j}catch(e){return d}},s(k,v){try{localStorage.setItem('kx_'+k,JSON.stringify(v))}catch(e){}}};
let dbp;const db=()=>dbp||(dbp=new Promise((ok,no)=>{const r=indexedDB.open('kodex',1);r.onupgradeneeded=()=>r.result.createObjectStore('kv');r.onsuccess=()=>ok(r.result);r.onerror=()=>no(r.error)}));
const kv=async(m,k,v)=>{try{const d=await db();return await new Promise((ok,no)=>{const t=d.transaction('kv',m==='get'?'readonly':'readwrite'),o=t.objectStore('kv'),r=m==='get'?o.get(k):o.put(v,k);t.oncomplete=()=>ok(m==='get'?r.result:true);t.onerror=()=>no(t.error)})}catch(e){return undefined}};
const fj=async(u,ms=25000)=>{const c=new AbortController(),t=setTimeout(()=>c.abort(),ms);try{const r=await fetch(u,{signal:c.signal});if(!r.ok)throw Error('HTTP '+r.status);return await r.json()}finally{clearTimeout(t)}};
const nt=s=>String(s||'').toLowerCase().normalize('NFKD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z0-9]+/g,' ').trim();
const nz=s=>String(s||'').toLowerCase().replace(/[^a-z]/g,'');

