const KDE_OBJ=14;
const KDE_B64="";
const KDE_HW=[278,278,355,556,556,889,667,191,333,333,389,584,278,333,278,278,556,556,556,556,556,556,556,556,556,556,278,278,584,584,584,556,1015,667,667,722,722,667,611,778,722,278,500,667,556,833,722,778,667,778,722,667,611,722,667,944,667,667,611,278,278,278,469,556,333,556,556,500,556,556,278,556,556,222,222,500,222,833,556,556,556,556,333,500,278,556,500,722,500,500,500,334,260,334,584];
function kdeTxt(s){const M={'\u2018':"'",'\u2019':"'",'\u201c':'"','\u201d':'"','\u2013':'-','\u2014':'-','\u2026':'...','\u00d7':'x','\u2605':'*','\u2606':'*','\u2022':'.'};let o='';for(const ch of String(s||'')){const c=ch.charCodeAt(0);if(M[ch])o+=M[ch];else if(c>=32&&c<=126||c>=161&&c<=255)o+=ch;else if(c===160)o+=' ';else o+='?'}return o}
const kdeW=(s,fs)=>{let w=0;for(const ch of s){const c=ch.charCodeAt(0);w+=(c>=32&&c<=126?KDE_HW[c-32]:556)}return w*fs/1000};
const kdeEsc=s=>s.replace(/[\\()]/g,m=>'\\'+m).replace(/[\u00a1-\u00ff]/g,m=>'\\'+m.charCodeAt(0).toString(8).padStart(3,'0'));
function kdeBuildContent(d,info){
  const out=[];const rect=r=>({x:r[0],y:r[1],w:r[2]-r[0],h:r[3]-r[1]});
  const put=(font,fs,x,y,t,tz)=>{out.push(`BT 0 g /${font} ${fs.toFixed(2)} Tf ${tz&&tz<100?tz.toFixed(1):'100'} Tz 1 0 0 1 ${x.toFixed(2)} ${y.toFixed(2)} Tm (${kdeEsc(t)}) Tj ET`)};
  const base=(r,fs)=>r.y+(r.h-fs)/2+fs*.22;
  const left=(r4,t,max,pad)=>{t=kdeTxt(t);if(!t)return;const r=rect(r4),av=r.w-(pad||4)*2;let fs=max||10.5;while(fs>7&&kdeW(t,fs)>av)fs-=.5;let tz=100;const w=kdeW(t,fs);if(w>av)tz=Math.max(55,av/w*100);put('KxH',fs,r.x+(pad||4),base(r,fs),t,tz)};
  const center=(r4,t,font,fs)=>{t=String(t);if(!t)return;const r=rect(r4),w=font==='KxC'?t.length*fs*.6:kdeW(t,fs);put(font,fs,r.x+(r.w-w)/2,base(r,fs),t)};
  const boxes=(r4,str,n,font,fs)=>{const r=rect(r4),bw=r.w/n;[...str].slice(0,n).forEach((c,i)=>{const w=font==='KxC'?fs*.6:kdeW(c,fs);put(font,fs,r.x+i*bw+(bw-w)/2,base(r,fs),c)})};
  const f=KDE_R.f,last=kdeTxt(info.last).trim(),first=kdeTxt(info.first).trim();
  left(f.first,first,11);left(f.last,last,11);left(f.cty,kdeTxt(info.country),11);left(f.ev,kdeTxt(info.event),11);
  const id=String(info.cgid||'').replace(/\D/g,'').slice(0,10);boxes(f.cgid,id,10,'KxC',12);
  const dt=/^(\d{4})-(\d{2})-(\d{2})$/.exec(info.date||'');if(dt){boxes(f.mm,dt[2],2,'KxC',12);boxes(f.dd,dt[3],2,'KxC',12);boxes(f.yy,dt[1],4,'KxC',12)}
  if(last)center(f.init,last[0].toUpperCase(),'KxH',22);
  const cat=c=>{const t=String((resolveDeckCard(c)||c).type||(resolveDeckCard(c)||c).card_type||'');return/spell/i.test(t)?'S':/trap/i.test(t)?'T':'M'};
  const groups={M:[],S:[],T:[],D:[],X:[]},tot={M:0,S:0,T:0,D:0,X:0};let over=0,mainTotal=0;
  const add=(sec,c,q)=>{const k=sec==='main'?cat(c):sec==='side'?'D':'X';tot[k]+=q;if(sec==='main')mainTotal+=q;const g=groups[k];const hit=g.find(x=>x.id===c.id);if(hit)hit.q+=q;else g.push({id:c.id,name:c.name,q})};
  for(const sec of ['main','extra','side'])for(const c of d.cards||[])if(c.section===sec)add(sec,c,Math.max(1,c.qty||1));
  for(const k of ['M','S','T','D','X']){groups[k].forEach((g,i)=>{const row=KDE_R[k][i];if(!row){over++;return}left(row[0],g.name,10);center(row[1],String(g.q),'KxC',11)});center(KDE_R.tot[k],String(tot[k]),'KxC',11)}
  center(f.main,String(mainTotal),'KxH',20);
  return{text:'q\n'+out.join('\n')+'\nQ',over};
}
function buildKdePdf(d,info){
  const bin=Uint8Array.from(atob(KDE_B64),c=>c.charCodeAt(0));let tail='';for(let i=Math.max(0,bin.length-400);i<bin.length;i++)tail+=String.fromCharCode(bin[i]);
  const prev=+/startxref\s+(\d+)/.exec(tail)[1],size=+/\/Size (\d+)/.exec(tail)[1],root=/\/Root (\d+) 0 R/.exec(tail)[1],inf=/\/Info (\d+) 0 R/.exec(tail),idm=/\/ID \[(<[0-9a-f]+><[0-9a-f]+>)\]/.exec(tail);
  const c=kdeBuildContent(d,info),body=`${KDE_OBJ} 0 obj\n<< /Length ${c.text.length} >>\nstream\n${c.text}\nendstream\nendobj\n`;
  const start=bin.length+1,xrefAt=start+body.length;
  const xref=`xref\n${KDE_OBJ} 1\n${String(start).padStart(10,'0')} 00000 n \ntrailer\n<< /Size ${size} /Root ${root} 0 R${inf?` /Info ${inf[1]} 0 R`:''} /Prev ${prev}${idm?` /ID [${idm[1]}]`:''} >>\nstartxref\n${xrefAt}\n%%EOF\n`;
  const add=new Uint8Array(1+body.length+xref.length);add[0]=10;const s=body+xref;for(let i=0;i<s.length;i++)add[1+i]=s.charCodeAt(i)&255;
  const all=new Uint8Array(bin.length+add.length);all.set(bin);all.set(add,bin.length);
  return{blob:new Blob([all],{type:'application/pdf'}),over:c.over};
}
function pdfForm(id){
  const d=deckById(id);if(!d)return;const v=S.g('kde',{});
  const fl=(i,p,val,x)=>`<input class="fld" id="${i}" placeholder="${p}" value="${esc(val||'')}" maxlength="60" autocomplete="off" ${x||''}>`;
  const m=openModal(`<h3>Deck list</h3>${fl('kdF','First & middle name(s)',v.first)}${fl('kdL','Last name(s)',v.last)}${fl('kdC','Country of residency',v.country)}${fl('kdI','Card Game ID',v.cgid,'inputmode="numeric" maxlength="10"')}${fl('kdE','Event name',v.event)}<input class="fld" id="kdD" type="date" aria-label="Event date" value="${esc(v.date||'')}"><div class="dact"><button class="btn" data-close>Cancel</button><button class="btn p" id="pfGo">Create</button></div>`,'big');
  m.querySelector('#pfGo').onclick=()=>{const g=i=>m.querySelector(i).value.trim(),info={first:g('#kdF'),last:g('#kdL'),country:g('#kdC'),cgid:g('#kdI').replace(/\D/g,'').slice(0,10),event:g('#kdE'),date:g('#kdD')};S.s('kde',{...info,date:''});
    const r=buildKdePdf(d,info),nm=((d.name.replace(/[^\w -]/g,'').trim()||'deck')+' Deck List.pdf');closeModal();setTimeout(()=>{saveFile(r.blob,nm,'application/pdf');if(r.over)toast('Some cards did not fit on the form')},120)};
}
const DECK_PAGE='https://kodex.meiocg.org/deck.html';
const deckPageUrl=()=>DECK_PAGE;
const pcOf=c=>{const live=resolveDeckCard(c)||{};for(const v of [live.id,c&&c.id]){if(/^\d{3,10}$/.test(String(v??'')))return String(v)}return ''};
function deckPayload(d){const ent=sec=>{const m=new Map();for(const c of d.cards||[]){if(c.section!==sec)continue;const live=resolveDeckCard(c)||{},raw=pcOf(c),url=deckCardImageUrl(c),key=/^\d{3,10}$/.test(String(raw??''))&&(!url||/images\.ygoprodeck\.com/.test(url))?String(raw):url||'';const id=key+'|'+c.name;const q=Math.max(1,c.qty||1);if(m.has(id))m.get(id)[2]+=q;else m.set(id,[key,String(c.name||'').slice(0,40),q])}return[...m.values()]};return{n:d.name,m:ent('main'),e:ent('extra'),s:ent('side')}}
const inApp=()=>isWV()||!!(window.KodexBridge||window.AndroidBridge);
function openOut(u){if(inApp()){toast('Opening…');setTimeout(()=>{location.href=u},120);return}let w=null;try{w=window.open(u,'_blank','noopener')}catch(e){}if(!w){const a=document.createElement('a');a.href=u;a.target='_blank';a.rel='noopener';a.style.display='none';document.body.appendChild(a);a.click();setTimeout(()=>a.remove(),1000)}}
const b64u=o=>btoa(unescape(encodeURIComponent(JSON.stringify(o)))).replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,'');
const arenaUrl=h=>IMG_BASE+'/duel/'+(inApp()?'?app=1':'')+(h?'#'+h:'');
function openArena(h){if(!ARENA_LOCAL&&!navigator.onLine&&!S.g('arenaSeen',false)){toast('The Arena needs a connection the first time it opens');return}if(navigator.onLine)S.s('arenaSeen',true);if(L.includes('arena'))return;arenaHash=h||'';push('arena')}
function openPlaytest(d){normalizeDeck(d);if(!deckTotal(d)){toast('This deck has no cards');return}openArena('deck='+b64u(deckPayload(d)))}
function saveArenaOffline(){const ds=deckStore().map(normalizeDeck).filter(d=>deckTotal(d)>0).slice(0,30);if(!ds.length){toast('No decks to save');return}if(!navigator.onLine){toast('Connect to the internet to save decks for offline play');return}openArena('prepare='+b64u({d:ds.map(deckPayload)}))}
async function openDeckImage(d){
  if(inApp())return false;
  const base=deckPageUrl();if(!d)return false;let host='';try{host=new URL(base).host}catch(e){return false}
  if(/^(kodex|translate)\.meiocg\.org$/.test(host)){const probe=async mode=>{const ct=new AbortController(),t=setTimeout(()=>ct.abort(),3500);try{return await fetch(base,{method:'GET',mode,signal:ct.signal,cache:'no-store'})}finally{clearTimeout(t)}};try{const r=await probe('cors');if(!r.ok)return false}catch(e){try{await probe('no-cors')}catch(x){return false}}}
  const j=unescape(encodeURIComponent(JSON.stringify(deckPayload(d)))),h=btoa(j).replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,''),u=base+'#'+h;let w=null;try{w=window.open(u,'_blank','noopener')}catch(e){}
  if(!w){const a=document.createElement('a');a.href=u;a.target='_blank';a.rel='noopener';a.style.display='none';document.body.appendChild(a);a.click();setTimeout(()=>a.remove(),1000)}return true}
function deckViewer(svg,name,deck){
  const m=openModal(`<div class="vw-bar"><b>${esc(name)}</b><span><button class="ibtn" data-vz="-1" aria-label="Zoom out">−</button><button class="ibtn" data-vz="1" aria-label="Zoom in">+</button><button class="btn p" data-vsave>${ic('down',18)}PNG</button><button class="btn" data-vsave="jpg">${ic('down',18)}JPG</button><button class="ibtn" data-close aria-label="Close">${ic('x')}</button></span></div><div class="vw-body"><div class="vw-svg">${svg}</div></div>`,'viewer');
  let z=1;m.addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;if(b.dataset.vz){z=Math.max(1,Math.min(4,z+(+b.dataset.vz)*.5));m.querySelector('.vw-svg').style.width=(z*100)+'%'}else if(b.hasAttribute('data-vsave')){const fmt=b.dataset.vsave==='jpg'?'jpg':'png';b.disabled=true;(fmt==='png'?openDeckImage(deck):Promise.resolve(false)).then(ok=>{b.disabled=false;if(ok)return;
    const B=window.KodexBridge||window.AndroidBridge;if(fmt==='png'&&B&&typeof B.captureRect==='function'){const body=m.querySelector('.vw-body'),box=m.querySelector('.vw-svg'),sv=box.querySelector('svg'),vb=(sv.getAttribute('viewBox')||'0 0 1200 1200').split(/\s+/).map(Number),pw=Math.min(body.clientWidth,body.clientHeight*vb[2]/vb[3]);box.style.width=pw+'px';body.scrollTo(0,0);setTimeout(()=>{const r=sv.getBoundingClientRect();try{B.captureRect(r.left,r.top,r.width,r.height,name+'.png');toast('Saving '+name+'.png')}catch(e){toast('Save failed')}setTimeout(()=>{box.style.width=(z*100)+'%'},700)},300);return}b.disabled=true;toast('Preparing image…');const mt=fmt==='jpg'?'image/jpeg':'image/png';svgToPng(svg,1.5,mt).then(async p=>{await saveFile(p,name+'.'+fmt,mt);if(window.__pngMiss)setTimeout(()=>toast(window.__pngMiss+' card pictures could not load and show names. Save again to retry.'),2600)},()=>saveFile(new Blob([svg],{type:'image/svg+xml'}),name+'.svg','image/svg+xml')).finally(()=>{b.disabled=false})})}});
}
function exportYdk(deckId){const d=deckById(deckId);if(!d)return;normalizeDeck(d);const codeOf=c=>pcOf(c);const lines=['#created by Duel Synapse: KodeX','#main',...copies(d,'main').map(codeOf).filter(Boolean),'#extra',...copies(d,'extra').map(codeOf).filter(Boolean),'!side',...copies(d,'side').map(codeOf).filter(Boolean)];const omitted=deckTotal(d)-lines.filter(x=>/^\d+$/.test(x)).length;if(!lines.some(x=>/^\d+$/.test(x))){toast('No valid numeric card passcodes are available to export.');return}if(window.__ydkCopy){window.__ydkCopy=false;(navigator.clipboard?navigator.clipboard.writeText(lines.join('\n')+'\n'):Promise.reject()).then(()=>toast('Copied .ydk'),()=>toast('Copy not available'));return}downloadBlob(lines.join('\n')+'\n',d.name.replace(/[^\w -]/g,'').trim()||'deck','ydk','application/octet-stream');if(omitted>0)showExportNotice('Deck exported',`${omitted} card entr${omitted===1?'y was':'ies were'} omitted because no valid numeric card passcode was available. Check those cards before using this deck elsewhere.`)}
function downloadBlob(content,name,ext,type){const blob=new Blob([content],{type});return saveFile(blob,name+'.'+ext,type.split(';')[0])}
async function importYdk(file){if(file.size>2e6)throw new Error('File too large');const text=await file.text();if(/ydke:\/\//.test(text)||!/(^|\n)\s*(#main|#extra|!side|\d{4,10})\s*(\r?\n|$)/i.test(text))return importDeckText(text,file.name.replace(/\.(ydk|txt)$/i,''));return importYdkText(file.name.replace(/\.ydk$/i,''),text)}
async function importYdkText(deckName,text){if(!/(^|\n)\s*(#main|#extra|!side|\d{4,10})\s*(\r?\n|$)/i.test(text))throw new Error('Not a deck list');const d=createDeck(deckName||'Imported Deck');if(!d)return;const a=deckStore(),target=a.find(x=>x.id===d.id);let section='main',missing=0,total=0,hasSections=/(^|\n)\s*(#main|#extra|!side)\s*(\r?\n|$)/i.test(text);const entries=[];for(const line of text.split(/\r?\n/)){const x=line.trim().toLowerCase();if(x==='#main'){section='main';continue}if(x==='#extra'){section='extra';continue}if(x==='!side'){section='side';continue}const raw=line.trim();if(!/^\d+$/.test(raw))continue;entries.push({code:raw,section})}if(!entries.length){saveDecks(a.filter(x=>x.id!==d.id));toast('No card passcodes were found in this .ydk file.');return}for(const ent of entries){const code=ent.code;let c=M.get(String(code))||cards.find(v=>String(v.kid)===code),art='';if(!c&&altMain(code)){const m=altMain(code);c=M.get(m)||cards.find(v=>String(v.kid)===m);if(c)art=code}let sec=ent.section;if(!hasSections&&c){const type=String(c.type||'').toLowerCase();if(/\b(fusion|synchro|xyz|link)\b/.test(type))sec='extra';else sec='main'}if(c)target.cards.push(Object.assign({id:String(c.id),name:c.name,kid:c.kid||code,section:sec},art?{art}:{}));else{target.cards.push({id:String(code),name:'Unknown card ('+code+')',kid:code,section:sec});missing++}total++}saveDecks(a);showDeck(target.id);if(missing)toast(`Imported ${total} cards and automatically organized them into Main, Extra, and Side Deck using the .ydk section markers. ${missing} cards could not be matched to the loaded database; their passcodes and sections were preserved.`)}

/* ---------- v58: deck links, text lists, OCG legality, match log ---------- */
function showExportNotice(t,msg){openModal(`<div class="dk-hd"><h3>${esc(t)}</h3><button class="ibtn" data-close aria-label="Close">${ic('x')}</button></div><p>${msg}</p><div class="dact"><button class="btn p" data-close>OK</button></div>`)}
const BANMAX={'Forbidden':0,'Limited':1,'Semi-Limited':2};
const banOf=c=>{const live=resolveDeckCard(c)||{};return live.ban||''};
function ydkeEncode(d){normalizeDeck(d);const enc=sec=>{const ids=copies(d,sec).map(pcOf).filter(Boolean).map(Number);const u=new Uint8Array(ids.length*4),v=new DataView(u.buffer);ids.forEach((n,i)=>v.setUint32(i*4,n>>>0,true));let b='';u.forEach(x=>b+=String.fromCharCode(x));return btoa(b)};return 'ydke://'+enc('main')+'!'+enc('extra')+'!'+enc('side')+'!'}
function ydkeDecode(s){const m=String(s||'').trim().match(/^ydke:\/\/([A-Za-z0-9+/=]*)!([A-Za-z0-9+/=]*)!([A-Za-z0-9+/=]*)!?\s*$/);if(!m)return null;const dec=b=>{const bin=atob(b||''),out=[];if(bin.length%4)throw new Error('Broken deck link');for(let i=0;i<bin.length;i+=4)out.push(String((bin.charCodeAt(i)|bin.charCodeAt(i+1)<<8|bin.charCodeAt(i+2)<<16|bin.charCodeAt(i+3)<<24)>>>0));return out};return{main:dec(m[1]),extra:dec(m[2]),side:dec(m[3])}}
function ydkText(p){return ['#main',...p.main,'#extra',...p.extra,'!side',...p.side].join('\n')+'\n'}
function textListOf(d){normalizeDeck(d);const out=[];for(const [k,l] of [['main','Main Deck'],['extra','Extra Deck'],['side','Side Deck']]){const m=new Map();for(const c of d.cards){if(c.section!==k)continue;const n=(resolveDeckCard(c)||c).name||c.name;m.set(n,(m.get(n)||0)+(c.qty||1))}if(!m.size)continue;out.push(`${l} (${cnt(d,k)})`);for(const [n,q] of m)out.push(`${q} ${n}`);out.push('')}return out.join('\n').trim()+'\n'}
function cardByName(n){const s=nt(n);if(!s)return null;const k=K.find(x=>x.n===s);return k?k.c:null}
function parseTextList(text){const p={main:[],extra:[],side:[]},miss=[];let sec=null,any=false;for(let line of String(text).split(/\r?\n/)){line=line.replace(/ /g,' ').trim();if(!line||/^\/\/|^#created/i.test(line))continue;const h=line.toLowerCase().replace(/[:\-–=*#\[\]()0-9]/g,' ').trim();if(/^(main( deck)?|monsters?|spells?|traps?|monster cards?|spell cards?|trap cards?)$/.test(h)){sec='main';continue}if(/^(extra( deck)?)$/.test(h)){sec='extra';continue}if(/^(side( deck)?)$/.test(h)){sec='side';continue}let q=1,name=line;let m=line.match(/^(\d{1,2})\s*[x×]?\s+(.+)$/i)||line.match(/^[x×](\d{1,2})\s+(.+)$/i);if(m){q=+m[1];name=m[2]}else if((m=line.match(/^(.+?)\s+[x×]\s*(\d{1,2})$/i))){name=m[1];q=+m[2]}name=name.replace(/^[-•*]\s*/,'').trim();if(!name||q<1||q>3)continue;const c=cardByName(name);if(!c){miss.push(name);continue}any=true;const target=sec==='side'?'side':(extraType(c)?'extra':'main');for(let i=0;i<q;i++)p[target].push(String(c.id))}return any?{p,miss}:null}
function pasteDeckModal(){const m=openModal(`<div class="dk-hd"><h3>Paste a deck</h3><button class="ibtn" data-close aria-label="Close">${ic('x')}</button></div><p class="lk" style="text-align:left;color:var(--muted)">Paste a deck link (ydke://…), a .ydk list or a text list such as <b>3 Ash Blossom &amp; Joyous Spring</b>. Main, Extra and Side headings are kept.</p><input id="dpName" class="fld" maxlength="60" placeholder="Deck name"><textarea id="dpText" class="dk-paste" placeholder="ydke://…  or  3 Card Name"></textarea><div class="dact"><button class="btn" id="dpClip">Paste from clipboard</button><button class="btn p" id="dpOk">Import</button></div>`,'big');
  m.querySelector('#dpClip').onclick=async()=>{try{m.querySelector('#dpText').value=await navigator.clipboard.readText()}catch(e){toast('Clipboard not available. Long-press the box and paste.')}};
  m.querySelector('#dpOk').onclick=async()=>{const t=m.querySelector('#dpText').value,n=m.querySelector('#dpName').value.trim();if(!t.trim()){toast('Paste a deck first');return}closeModal();setTimeout(()=>importDeckText(t,n).catch(e=>toast('Import failed: '+e.message)),120)};
  setTimeout(()=>{const f=m.querySelector('#dpText');if(f)f.focus()},120)}
async function importDeckText(t,name){t=String(t||'').trim();const y=t.match(/ydke:\/\/\S+/);if(y){const p=ydkeDecode(y[0]);if(!p)throw new Error('Not a valid deck link');if(!p.main.length&&!p.extra.length&&!p.side.length)throw new Error('The deck link is empty');await importYdkText(name||'Imported Deck',ydkText(p));return true}if(/(^|\n)\s*(#main|#extra|!side)\s*(\r?\n|$)/i.test(t)||/^\s*\d{4,10}\s*(\r?\n\s*\d{4,10}\s*)+$/.test(t)){await importYdkText(name||'Imported Deck',t);return true}const r=parseTextList(t);if(!r)throw new Error('No card names were recognised');await importYdkText(name||'Imported Deck',ydkText(r.p));if(r.miss.length)setTimeout(()=>showExportNotice('Some lines were skipped',`${r.miss.length} line${r.miss.length===1?'':'s'} did not match a card name: ${r.miss.slice(0,8).map(esc).join(', ')}${r.miss.length>8?'…':''}. Check the spelling and add them by search.`),400);return true}
function copyText(t,ok){(navigator.clipboard?navigator.clipboard.writeText(t):Promise.reject()).then(()=>toast(ok),()=>{const m=openModal(`<div class="dk-hd"><h3>Copy</h3><button class="ibtn" data-close aria-label="Close">${ic('x')}</button></div><textarea class="dk-paste" readonly>${esc(t)}</textarea>`,'big');const a=m.querySelector('textarea');a.focus();a.select()})}
function deckLegality(d){normalizeDeck(d);const issues=[],per=new Map();for(const c of d.cards){const live=resolveDeckCard(c)||{},key=String(live.id||c.id);const e=per.get(key)||{name:live.name||c.name,ban:live.ban||'',n:0};e.n+=c.qty||1;per.set(key,e)}for(const e of per.values()){const max=e.ban in BANMAX?BANMAX[e.ban]:3;if(e.n>max)issues.push(e.ban?`${e.name}: ${e.ban} in the OCG (${max} allowed, ${e.n} in deck)`:`${e.name}: ${e.n} copies (3 allowed)`)}const mn=cnt(d,'main'),ex=cnt(d,'extra'),sd=cnt(d,'side');if(mn<40)issues.push(`Main Deck has ${mn} cards (40–60 needed)`);if(mn>60)issues.push(`Main Deck has ${mn} cards (60 at most)`);if(ex>15)issues.push(`Extra Deck has ${ex} cards (15 at most)`);if(sd>15)issues.push(`Side Deck has ${sd} cards (15 at most)`);const lim=[...per.values()].filter(e=>e.ban&&e.n<=BANMAX[e.ban]).length;return{ok:!issues.length,issues,lim}}
function legalityBar(d){const ml=`<button type="button" class="btn dk-mlb" data-matchlog="${esc(d.id)}">${ic('chart',16)}Match log</button>`;if(!deckTotal(d))return `<div class="dk-lrow">${ml}</div>`;const r=deckLegality(d);return `<div class="dk-lrow"><button type="button" class="dk-legal ${r.ok?'ok':'bad'}" data-legal="${esc(d.id)}">${r.ok?`<b>✓ OCG legal</b><small>Current OCG Forbidden &amp; Limited list${r.lim?` · ${r.lim} limited card${r.lim===1?'':'s'}`:''}</small>`:`<b>✕ Not OCG legal</b><small>${r.issues.length} problem${r.issues.length===1?'':'s'} · tap to see</small>`}</button>${ml}</div>`}
function legalityModal(id){const d=deckById(id);if(!d)return;const r=deckLegality(d);openModal(`<div class="dk-hd"><h3>OCG legality</h3><button class="ibtn" data-close aria-label="Close">${ic('x')}</button></div>${r.ok?'<p>This deck follows the current OCG Forbidden &amp; Limited list and deck size rules.</p>':`<ul class="lg-list">${r.issues.map(x=>`<li>${esc(x)}</li>`).join('')}</ul>`}<p class="lk" style="color:var(--muted)">Checked against the OCG list in KodeX's card database, which updates with each card data refresh. Always confirm with the official list before an event.</p>`)}
const banBadge=c=>{const b=banOf(c);return b in BANMAX?`<span class="ban b${BANMAX[b]}" title="${esc(b)}">${BANMAX[b]}</span>`:''};
/* match log: real-life and online games outside the Arena (Arena duels already feed the Deck Analyzer) */
const mlAll=()=>S.g('mlog',[]);const mlSave=a=>S.s('mlog',a.slice(-2000));
function mlStats(rows){const n=rows.length,w=rows.filter(x=>x.r==='W').length,l=rows.filter(x=>x.r==='L').length,dr=n-w-l,pct=a=>{const g=a.filter(x=>x.r!=='D').length;return g?Math.round(100*a.filter(x=>x.r==='W').length/g)+'%':'–'};return{n,w,l,dr,all:pct(rows),first:pct(rows.filter(x=>x.f===1)),second:pct(rows.filter(x=>x.f===0))}}
function matchLogModal(id,keep){const d=deckById(id);if(!d)return;const rows=mlAll().filter(x=>x.d===String(d.id)),st=mlStats(rows),opp=new Map();for(const x of rows){const k=(x.o||'Unknown').trim()||'Unknown';const a=opp.get(k)||[];a.push(x);opp.set(k,a)}const st0=keep||{};
  const body=`<div class="dk-hd"><h3>Match log · ${esc(d.name)}</h3><button class="ibtn" data-close aria-label="Close">${ic('x')}</button></div>
<div class="ml-stats"><div class="ml-stat"><b>${st.w}-${st.l}${st.dr?'-'+st.dr:''}</b><small>Record</small></div><div class="ml-stat"><b>${st.all}</b><small>Win rate</small></div><div class="ml-stat"><b>${st.first}</b><small>Going 1st</small></div><div class="ml-stat"><b>${st.second}</b><small>Going 2nd</small></div></div>
<div class="ml-sec">Add a game</div><div class="ml-form"><div class="seg-w">${['W','L','D'].map(r=>`<button class="seg${(st0.r||'W')===r?' on':''}" data-mlr="${r}">${{W:'Win',L:'Loss',D:'Draw'}[r]}</button>`).join('')}</div><div class="seg-w">${[[1,'Went 1st'],[0,'Went 2nd']].map(([v,l])=>`<button class="seg${(st0.f??1)===v?' on':''}" data-mlf="${v}">${l}</button>`).join('')}</div><input id="mlOpp" class="fld" list="mlOpps" maxlength="60" placeholder="Opponent's deck" value="${esc(st0.o||'')}"><datalist id="mlOpps">${[...opp.keys()].map(k=>`<option value="${esc(k)}">`).join('')}</datalist><input id="mlKey" class="fld" maxlength="60" placeholder="Deciding card (optional)"><input id="mlNote" class="fld" maxlength="140" placeholder="Event or note (optional)"><div class="dact"><button class="btn p" id="mlAdd">Save game</button></div></div>
${opp.size?`<div class="ml-sec">By matchup</div><div>${[...opp].sort((a,b)=>b[1].length-a[1].length).slice(0,12).map(([k,a])=>{const s=mlStats(a);return `<div class="ml-row"><span>${esc(k)}</span><span>${s.w}-${s.l}${s.dr?'-'+s.dr:''} · <b>${s.all}</b></span></div>`}).join('')}</div>`:''}
${rows.length?`<div class="ml-sec">Recent games</div><div class="ml-scroll">${rows.slice().reverse().slice(0,60).map(x=>`<div class="ml-row"><span><span class="ml-r ${x.r}">${x.r}</span>${esc(x.o||'Unknown')} · ${x.f?'1st':'2nd'}${x.k?` · ${esc(x.k)}`:''}${x.n?`<br><small style="color:var(--muted)">${esc(x.n)}</small>`:''}</span><span><small style="color:var(--muted)">${new Date(x.t).toLocaleDateString()}</small> <button class="ibtn" data-mldel="${x.t}" aria-label="Delete game">${ic('trash')}</button></span></div>`).join('')}</div>`:'<p class="lk" style="color:var(--muted)">Log games you play at locals, tournaments or on other platforms. Arena duels are already counted in the Deck Analyzer.</p>'}`;
  const o=document.querySelector('.mdl[data-k=ml]');let m;if(o){o.firstChild.innerHTML=body;m=o}else m=openModal(body,'big','ml');
  const cur={r:st0.r||'W',f:st0.f??1};
  m.querySelectorAll('[data-mlr]').forEach(b=>b.onclick=()=>{cur.r=b.dataset.mlr;m.querySelectorAll('[data-mlr]').forEach(x=>x.classList.toggle('on',x===b))});
  m.querySelectorAll('[data-mlf]').forEach(b=>b.onclick=()=>{cur.f=+b.dataset.mlf;m.querySelectorAll('[data-mlf]').forEach(x=>x.classList.toggle('on',x===b))});
  m.querySelector('#mlAdd').onclick=()=>{const o=m.querySelector('#mlOpp').value.trim(),k=m.querySelector('#mlKey').value.trim(),n=m.querySelector('#mlNote').value.trim();const a=mlAll();a.push({d:String(d.id),t:Date.now(),r:cur.r,f:cur.f,o,k,n});mlSave(a);toast('Game saved');matchLogModal(id,{r:cur.r,f:cur.f,o})};
  m.querySelectorAll('[data-mldel]').forEach(b=>b.onclick=e=>{e.stopPropagation();mlSave(mlAll().filter(x=>String(x.t)!==b.dataset.mldel||x.d!==String(d.id)));matchLogModal(id,cur)});
}

let posterBackground=null;
async function loadPosterBackground(file){if(!file)return;if(!file.type.startsWith('image/')){toast('Choose an image file.');return}posterBackground=await new Promise((resolve,reject)=>{const r=new FileReader();r.onload=()=>resolve(r.result);r.onerror=reject;r.readAsDataURL(file)});const d=deckStore().find(x=>x.id===window.activeDeckId);if(d)showDeck(d.id)}

function buildDeckPosterSvg(d,W,H,bg){
 const escXml=v=>String(v??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&apos;');
 const sections=[['MAIN DECK',copies(d,'main')],['EXTRA DECK',copies(d,'extra')],['SIDE DECK',copies(d,'side')]],cols=13,cw=72,ch=105,gap=8,head=42;
 let out=[`<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="${W}" height="${H}" viewBox="0 0 ${W} ${H}">`,`<rect width="100%" height="100%" fill="#080a10"/>`];
 if(bg)out.push(`<image href="${escXml(bg)}" xlink:href="${escXml(bg)}" x="0" y="0" width="${W}" height="${H}" preserveAspectRatio="xMidYMid slice" opacity=".48"/>`);
 out.push(`<rect width="100%" height="100%" fill="#080a10" opacity=".42"/>`,`<rect x="12" y="12" width="${W-24}" height="${H-24}" fill="none" stroke="#9c252b" stroke-width="8"/>`,`<g fill="#fff" font-family="Arial,sans-serif"><text x="42" y="55" font-size="23" font-weight="bold">DUEL SYNAPSE • KODEX</text><text x="42" y="105" font-size="42" font-weight="bold">${escXml(d.name.slice(0,36))}</text><text x="42" y="139" font-size="20">${deckTotal(d)} cards</text></g>`);
 let y=166;
 for(const [label,arr] of sections){
  out.push(`<rect x="30" y="${y}" width="${W-60}" height="${head}" fill="#0a101f" fill-opacity=".82"/><g fill="#fff" font-family="Arial,sans-serif"><text x="44" y="${y+28}" font-size="22" font-weight="bold">${label}</text><text x="${W-150}" y="${y+27}" font-size="18">${arr.length} cards</text></g>`);y+=head+8;
  arr.forEach((c,i)=>{const x=34+(i%cols)*(cw+gap),cy=y+Math.floor(i/cols)*(ch+gap),url=deckCardImageUrl(c);out.push(`<rect x="${x-2}" y="${cy-2}" width="${cw+4}" height="${ch+4}" fill="#05080f"/>`);if(url){let absolute=url;try{absolute=new URL(url,document.baseURI).href}catch{}out.push(`<image href="${escXml(absolute)}" xlink:href="${escXml(absolute)}" x="${x}" y="${cy}" width="${cw}" height="${ch}" preserveAspectRatio="none"><title>${escXml(c.name)}</title></image>`)}else{const words=String(c.name||'Card artwork unavailable').split(/\s+/);let lines=[],line='';for(const word of words){const test=line?line+' '+word:word;if(test.length>13){if(line)lines.push(line);line=word}else line=test}if(line)lines.push(line);out.push(`<rect x="${x}" y="${cy}" width="${cw}" height="${ch}" fill="#303746"/><text x="${x+4}" y="${cy+16}" fill="#fff" font-family="Arial,sans-serif" font-size="9">${lines.slice(0,7).map((l,j)=>`<tspan x="${x+4}" dy="${j?12:0}">${escXml(l)}</tspan>`).join('')}</text>`)}});
  y+=Math.max(1,Math.ceil(arr.length/cols))*(ch+gap)+18;
 }
 out.push(`<text x="42" y="${H-26}" fill="#fff" font-family="Arial,sans-serif" font-size="16">Created with Duel Synapse: KodeX</text></svg>`);return out.join('')
}

function exportDeckPoster(deckId){
  const d=deckById(deckId);if(!d)return;
  const W=1200,cols=13,cardH=105,gap=8,headH=42,sectionGap=18,sections=[copies(d,'main'),copies(d,'extra'),copies(d,'side')],rows=a=>Math.max(1,Math.ceil(a.length/cols)),sh=a=>headH+rows(a)*(cardH+gap)+18,H=190+sh(sections[0])+sectionGap+sh(sections[1])+sectionGap+sh(sections[2])+55;
  const name=d.name.replace(/[^\w -]/g,'').trim()||'deck';let svg=buildDeckPosterSvg(d,W,H,posterBackground);
  if(topIsModal())closeModal();
  (async()=>{const urls=[...new Set([...svg.matchAll(/<image href="(https:[^"]+)"/g)].map(m=>m[1].replace(/&amp;/g,'&')))];const got=await Promise.all(urls.map(u=>icGet(u).then(v=>[u,v],()=>[u,null])));for(const [u,v] of got){const e=u.replace(/&/g,'&amp;');svg=svg.split(`href="${e}"`).join(`href="${v||artSrc(u).replace(/&/g,'&amp;')}"`)}setTimeout(()=>deckViewer(svg,name,d),60);icWarm(urls)})();
}

/* ---------- deck events ---------- */
$('bDecks').onclick=openDeckPanel;
let _dkSup=()=>suppressDeckClick;
document.addEventListener('click',e=>{
  const b=e.target.closest('button');if(!b)return;
  if(_dkSup()&&b.hasAttribute('data-dragcard')){e.preventDefault();e.stopPropagation();return}
  const D=b.dataset,top=()=>(L[L.length-1]||'').startsWith('m:');
  if(D.quickview!==undefined){quickView(D.quickview);return}
  if(D.cltab){cardListModal(D.cltab);return}
  if(D.cardlist!==undefined){cardListModal('main');return}
  if(b.hasAttribute('data-arena')){openArena('');return}
  if(D.analyze){openAnalyzer(D.analyze);return}   if(D.playtest){if(topIsModal())closeModal();const d=deckById(D.playtest);if(d)setTimeout(()=>openPlaytest(d),topIsModal()?90:0);return}
  if(D.exportmenu){exportMenu(D.exportmenu);return}
  if(D.favview){quickView(D.favview);return}
  if(D.favadd){const c=M.get(String(D.favadd));if(c)addCardToDeck(c);return}
  if(D.dknew!==undefined){deckForm(null,(n,i)=>{createDeck(n,i);openDeckPanel()});return}
  if(D.viewdeck){showDeck(D.viewdeck);return}
  if(D.dkpaste!==undefined){pasteDeckModal();return}
  if(D.legal){legalityModal(D.legal);return}
  if(D.matchlog){matchLogModal(D.matchlog);return}
  if(D.copyydke){const d=deckById(D.copyydke);if(d){const t=ydkeEncode(d);if(topIsModal())closeModal();setTimeout(()=>copyText(t,'Copied deck link'),120)}return}
  if(D.copytext){const d=deckById(D.copytext);if(d){const t=textListOf(d);if(topIsModal())closeModal();setTimeout(()=>copyText(t,'Copied text list'),120)}return}
  if(D.copyydk){window.__ydkCopy=true;exportYdk(D.copyydk);setTimeout(()=>{if(topIsModal())closeModal()},250);return}
  if(D.exportydk){exportYdk(D.exportydk);setTimeout(()=>{if(topIsModal())closeModal()},250);return}
  if(D.pdfdeck){const id=D.pdfdeck;if(topIsModal())closeModal();setTimeout(()=>pdfForm(id),90);return}
  if(D.poster){exportDeckPoster(D.poster);return}
  if(D.editdeck){const a=deckById(D.editdeck);if(a)deckForm(a,(n,i)=>{const all=deckStore(),x=all.find(v=>v.id===a.id);if(x){x.name=n.slice(0,60);x.icon=i;saveDecks(all)}window.activeDeckId&&String(window.activeDeckId)===String(a.id)?showDeck(a.id):openDeckPanel()});return}
  if(D.deletedeck){const a=deckById(D.deletedeck);if(a)confirmBox(`Delete “${a.name}”?`,'Delete',()=>{saveDecks(deckStore().filter(x=>x.id!==a.id));openDeckPanel()});return}
  if(D.removefromdeck){const a=deckStore(),d=a.find(x=>x.id===D.removefromdeck);if(d){dropCopy(d,D.cardid,D.sec||'main');saveDecks(a);showDeck(d.id);refreshCardList()}return}
  if(b.id==='deckBack'){if(L[L.length-1]==='dv')history.back();else openDeckPanel();return}
});
$('tb').addEventListener('dragstart',e=>{const b=e.target.closest('[data-dragcard]');if(!b)return;b.classList.add('dragging');e.dataTransfer.effectAllowed='move';e.dataTransfer.setData('text/plain',JSON.stringify({cardId:b.dataset.dragcard,from:b.dataset.fromsec,deckId:window.activeDeckId}))});
$('tb').addEventListener('dragend',e=>{const b=e.target.closest('[data-dragcard]');if(b)b.classList.remove('dragging');document.querySelectorAll('.deck-section.drag-target').forEach(x=>x.classList.remove('drag-target'))});
$('tb').addEventListener('dragover',e=>{const sec=e.target.closest('[data-dropsection]');if(!sec)return;e.preventDefault();e.dataTransfer.dropEffect='move';sec.classList.add('drag-target')});
$('tb').addEventListener('dragleave',e=>{const sec=e.target.closest('[data-dropsection]');if(sec&&!sec.contains(e.relatedTarget))sec.classList.remove('drag-target')});
$('tb').addEventListener('drop',e=>{const sec=e.target.closest('[data-dropsection]');if(!sec)return;e.preventDefault();sec.classList.remove('drag-target');try{const p=JSON.parse(e.dataTransfer.getData('text/plain'));if(String(p.deckId)===String(sec.dataset.dropdeck))moveCopy(p.deckId,p.cardId,p.from,sec.dataset.dropsection)}catch(err){}});
let touchDeckDrag=null,suppressDeckClick=false;
function clearTouchDrag(){if(touchDeckDrag&&touchDeckDrag.timer)clearTimeout(touchDeckDrag.timer);document.querySelectorAll('.deck-section.drag-target').forEach(x=>x.classList.remove('drag-target'));document.querySelectorAll('.deck-card-thumb.dragging,.drag-ready').forEach(x=>x.classList.remove('dragging','drag-ready'));touchDeckDrag=null}
$('tb').addEventListener('pointerdown',e=>{if(e.pointerType==='mouse')return;const b=e.target.closest('[data-dragcard]');if(!b)return;clearTouchDrag();const st={el:b,id:b.dataset.dragcard,from:b.dataset.fromsec,deckId:window.activeDeckId,x:e.clientX,y:e.clientY,armed:false,dragging:false,timer:null};touchDeckDrag=st;st.timer=setTimeout(()=>{if(touchDeckDrag===st){st.armed=true;b.classList.add('drag-ready')}},600)},{passive:true});
$('tb').addEventListener('pointermove',e=>{const st=touchDeckDrag;if(!st)return;const dist=Math.hypot(e.clientX-st.x,e.clientY-st.y);if(!st.armed&&!st.dragging){if(dist>10){clearTimeout(st.timer);touchDeckDrag=null}return}if(st.armed&&dist>8){st.dragging=true;st.el.classList.add('dragging');const u=document.elementFromPoint(e.clientX,e.clientY),tgt=u&&u.closest('[data-dropsection]');document.querySelectorAll('.deck-section').forEach(x=>x.classList.toggle('drag-target',x===tgt));e.preventDefault()}},{passive:false});
$('tb').addEventListener('pointerup',e=>{const st=touchDeckDrag;if(!st)return;if(st.timer)clearTimeout(st.timer);if(st.dragging){suppressDeckClick=true;setTimeout(()=>{suppressDeckClick=false},450);const el=document.elementFromPoint(e.clientX,e.clientY),sec=el&&el.closest('[data-dropsection]');clearTouchDrag();if(sec&&String(sec.dataset.dropdeck)===String(st.deckId))moveCopy(st.deckId,st.id,st.from,sec.dataset.dropsection);return}clearTouchDrag()},{passive:true});
$('tb').addEventListener('pointercancel',clearTouchDrag);
document.addEventListener('change',e=>{
  if(e.target.id==='ydkImport'&&e.target.files&&e.target.files[0])importYdk(e.target.files[0]).catch(err=>toast('Import failed: '+err.message));
  if(e.target.id==='posterBg'&&e.target.files&&e.target.files[0])loadPosterBackground(e.target.files[0]).catch(err=>toast('Could not load background'));
});

$('bHis').onclick=()=>{const a=S.g('hist',[]);tool('Search History',a.length?`<button class="btn" id="hc" style="margin:10px 0">Clear history</button>`+a.map(x=>`<button class="lnk" style="background:none;border:0;border-top:1px solid var(--line);width:100%;text-align:left" data-s="${esc(x)}">⌕ ${esc(x)}</button>`).join(''):'<p class="note">No searches recorded yet.</p>');const h=$('hc');if(h)h.onclick=()=>{S.s('hist',[]);history.back()}};
$('tb').addEventListener('click',e=>{const o=e.target.closest('[data-open]'),s=e.target.closest('[data-s]');if(o)openCard(o.dataset.open);if(s){q.value=s.dataset.s;hideAll();settle();run()}});
$('bAbout').onclick=()=>tool('Legal & Privacy',`<div class="about"><h4>License</h4><p>Duel Synapse: KodeX and the Duel Arena are a project of Meta Insider OCG (MEIOCG), since 2023.</p><p>© 2023–2026 Meta Insider OCG. All rights reserved. KodeX, the Duel Arena and their features, code, design, artwork, animations, sounds, name and logos are protected by copyright. They may not be copied, modified, redistributed, republished, decompiled, disassembled or otherwise reverse engineered without written permission. Ask first: <a href="mailto:metainsiderocg@gmail.com?subject=KodeX%20permission%20request">metainsiderocg@gmail.com</a>. Full terms: <a href="https://kodex.meiocg.org/license" target="_blank" rel="noopener">kodex.meiocg.org/license</a>.</p><p>The Duel Arena includes open-source components (the ygopro-core rules engine and Project Ignis card scripts). They are not MEIOCG materials: they stay under their own licences (GNU AGPL-3.0) and anyone may use them as those licences allow. Details: Arena › Licences &amp; notices.</p><h4>Disclaimer</h4><p>Duel Synapse: KodeX is an independent project founded by Meta Insider OCG. It is not affiliated with, sponsored by, endorsed by, or approved by ©Studio Dice, SHUEISHA, TV Tokyo, or Konami. Some images, card artwork and card information are the property of ©Studio Dice/SHUEISHA, TV Tokyo, and Konami.</p><h4>Rulings</h4><p>Provided by Konami OCG Japan, publicly mirrored and translated by YGOrganization, and delivered through the Duel Synapse/MEIOCG server.</p><h4>Privacy</h4><p>KodeX has no accounts and no analytics. Settings, favorites, decks, history and downloaded data stay on your device. Card and ruling requests go to kodex.meiocg.org. Translation is optional: only when you tap “Translate to English”, that ruling’s text is sent to translate.meiocg.org (or api.mymemory.translated.net if it is unavailable) and is not linked to you. Sponsored banners, when shown, may open external links. In online duels, your name, deck list, chat and chosen sleeves and field are relayed to the players in your room and are not kept afterwards. Full policy: <a href="https://kodex.meiocg.org/privacy-policy" target="_blank" rel="noopener">kodex.meiocg.org/privacy-policy</a>.</p><h4>Fair use</h4><p>Third-party material is used for identification, reference, commentary, research and community information. If you are a rights holder with a concern, contact metainsiderocg@gmail.com.</p><p class="ver">KodeX ${document.querySelector('meta[name=kodex-build]').content.replace('KODEX-','')}</p></div>`);

/* ---------- offline rulings download ---------- */
let dl=false;
$('bDl').onclick=async()=>{
  if(dl){dl=false;return}
  if(!navigator.onLine){$('dlst').textContent='Connect to the internet to download.';return}
  const ids=[...new Set(cards.map(c=>c.kid).filter(Boolean).map(String))];
  if(!ids.length){$('dlst').textContent='Card database not loaded yet.';return}
  dl=true;$('bDl').textContent='Stop download';let n=0,bad=0,i=0;
  const w=async()=>{while(dl){const id=ids[i++];if(id===undefined)return;try{const c=await kv('get','r:'+id);if(!c||!c.data)await getRul(id,true)}catch(e){if(/404/.test(e.message))await kv('put','r:'+id,{t:Date.now(),data:{records:[]}});else bad++}n++;if(n%10===0||n===ids.length){$('pg').style.width=(n/ids.length*100)+'%';$('dlst').textContent=`Downloading… ${n.toLocaleString()} / ${ids.length.toLocaleString()}${bad?' • '+bad+' failed':''}`}}};
  await Promise.all([w(),w(),w(),w()]);
  $('dlst').textContent=n>=ids.length?`Done • rulings saved on this device${bad?' • '+bad+' failed, run again to retry':''}`:`Stopped at ${n.toLocaleString()} / ${ids.length.toLocaleString()}. Tap download to resume.`;
  dl=false;$('bDl').textContent='Download all rulings';
};

/* ---------- wallpaper, offline count, ruling search, diagnostics ---------- */
const kvCur=async(p,withVal)=>{try{const d=await db();return await new Promise((ok,no)=>{const out=[],o=d.transaction('kv').objectStore('kv'),r=withVal?o.openCursor(IDBKeyRange.bound(p,p+'\uffff')):o.openKeyCursor(IDBKeyRange.bound(p,p+'\uffff'));r.onsuccess=()=>{const c=r.result;if(c){out.push(withVal?c.value:c.key);c.continue()}else ok(out)};r.onerror=()=>no(r.error)})}catch(e){return[]}};
async function savedCount(){if(dl)return;const k=await kvCur('r:',false);$('dlst').textContent=k.length?`${k.length.toLocaleString()} ruling files saved on this device.`:'Not downloaded yet.'}
let wurl;
function wpShow(blob){if(wurl)URL.revokeObjectURL(wurl);wurl=blob?URL.createObjectURL(blob):'';$('wp').style.backgroundImage=wurl?`url("${wurl}")`:'none';$('wp').style.backgroundSize=S.g('wf','cover');$('ws').style.background=`rgba(0,0,0,${wurl?S.g('wo',35)/100:0})`;$('wo').value=S.g('wo',35);$('wov').textContent=S.g('wo',35)+'%';$('wf').value=S.g('wf','cover')}
async function wpApply(){const x=await kv('get','wp');wpShow(x&&x.buf?new Blob([x.buf],{type:x.type||'image/jpeg'}):x&&x.blob?x.blob:null)}
$('wpIn').onchange=async e=>{const f=e.target.files&&e.target.files[0];if(!f)return;try{if(!f.type.startsWith('image/'))throw Error('Please choose an image file.');if(f.size>30*1024*1024)throw Error('Image must be 30 MB or smaller.');const buf=await f.arrayBuffer(),type=f.type||'image/jpeg';wpShow(new Blob([buf],{type}));const saved=await kv('put','wp',{buf,type});if(saved===undefined)throw Error('Device storage is unavailable.');}catch(err){$('wov').textContent=err.message||'Could not save wallpaper';}finally{e.target.value=''}};
$('wo').oninput=e=>{S.s('wo',+e.target.value);$('ws').style.background=`rgba(0,0,0,${wurl?+e.target.value/100:0})`;$('wov').textContent=e.target.value+'%'};$('wf').onchange=e=>{S.s('wf',e.target.value);$('wp').style.backgroundSize=e.target.value};
$('wrm').onclick=async()=>{wpShow(null);await kv('put','wp',null)};
$('bAdv').onclick=()=>{tool('Advanced Ruling Search','<input id="as" class="tl" style="border:1px solid var(--line);border-radius:12px;padding:0 12px;margin:10px 0;background:var(--panel2)" placeholder="Enter ruling text or phrase…" aria-label="Search downloaded rulings"><p class="note">Searches rulings saved on this device.</p><div id="ar"></div>');let rows=null,t;$('as').oninput=()=>{clearTimeout(t);t=setTimeout(async()=>{const z=nt($('as').value);if(z.length<3){$('ar').innerHTML='';return}rows=rows||await kvCur('r:',true);const out=[];for(const r of rows){if(!r||!r.data||!r.data.records)continue;for(const x of entries(r.data)){if(nt(x.t+' '+x.q+' '+x.a).includes(z))out.push(x);if(out.length>=40)break}if(out.length>=40)break}$('ar').innerHTML=out.length?out.map(x=>`<details class="qa"><summary>${esc(x.t||x.q.slice(0,160))}<span class="meta"> #${esc(x.id)}</span></summary><div class="qb"><p><b>Q:</b> ${esc(x.q)}</p><p><b>A:</b> ${esc(x.a)}</p></div></details>`).join(''):'<p class="note">No matching saved ruling. Download rulings first in Settings.</p>'},200)}};
$('bChk').onclick=async()=>{const k=await kvCur('r:',false);let p=false;try{p=await navigator.storage.persisted()}catch(e){}const ok=(n,v,d)=>`<div class="row"><div><strong>${n}</strong><small>${esc(d)}</small></div><b style="color:${v?'#74e3a6':'#ff8d9a'}">${v?'PASS':'CHECK'}</b></div>`;tool('System Check',ok('Card database',cards.length>0,cards.length.toLocaleString()+' cards loaded')+ok('Saved rulings',k.length>0,k.length.toLocaleString()+' files on this device')+ok('Network',navigator.onLine,navigator.onLine?'Online':'Offline'))};

$('nSearch').onclick=()=>{if(L.length){hideAll();settle();navSync()}else{$('main').scrollTop=0;q.focus()}};
$('nDeck').onclick=()=>{if(L.includes('fil')||L.includes('set')||L.includes('tool')){hideAll();settle()}openDeckPanel()};
addEventListener('keydown',e=>{if(e.key==='Escape'&&L.length)history.back()});
function syncAd(){const a=$('topAdSafeArea');if(!a)return;document.documentElement.style.setProperty('--adh',Math.max(0,Math.round(a.getBoundingClientRect().bottom))+'px')}
function applySat(){const u=S.g('sat',null);let v;if(u!==null&&u!==undefined)v=+u;else{const p=document.createElement('div');p.style.cssText='position:fixed;top:0;visibility:hidden;padding-top:env(safe-area-inset-top,0px)';document.body.appendChild(p);const e=parseFloat(getComputedStyle(p).paddingTop)||0;p.remove();v=e>0?e:0}document.documentElement.style.setProperty('--sat',v+'px');syncAd();$('sat').value=v;$('satv').textContent=(u===null||u===undefined)?'Auto · '+v+' px':v+' px'}

/* ---------- card art cache (IndexedDB, survives app restarts) ---------- */
const IC_MAX=800,icMem=new Map();
const kvDel=async k=>{try{const d=await db();return await new Promise((ok,no)=>{const t=d.transaction('kv','readwrite');t.objectStore('kv').delete(k);t.oncomplete=()=>ok(true);t.onerror=()=>no(t.error)})}catch(e){return false}};
const svcBase=()=>IMG_BASE;
const artSrc=u=>{const b=svcBase(),m=b&&/^https:\/\/images\.ygoprodeck\.com\/images\/cards(?:_small|_cropped)?\/(\d{3,10})\.jpg$/.exec(u||'');return m?b+'/img/'+m[1]+'.jpg':u};
async function icGet(u){if(!u||u.startsWith('data:'))return u||null;if(icMem.has(u))return icMem.get(u);const r=await kv('get','i:'+u);const v=r&&r.d||null;if(v)icMem.set(u,v);return v}
const icInflight=new Map();
let icAct=0;const icQ=[];const icSlot=()=>new Promise(r=>{const go=()=>{icAct++;r()};icAct<4?go():icQ.push(go)});const icFree=()=>{icAct--;const n=icQ.shift();if(n)n()};
const icFetch=src=>new Promise((ok,no)=>{const i=new Image();i.crossOrigin='anonymous';let t=setTimeout(()=>no(new Error('timeout')),7000);i.onload=()=>{clearTimeout(t);try{const w=Math.min(300,i.naturalWidth),h=Math.round(i.naturalHeight*w/i.naturalWidth),c=document.createElement('canvas');c.width=w;c.height=h;c.getContext('2d').drawImage(i,0,0,w,h);ok(c.toDataURL('image/jpeg',.82))}catch(e){no(e)}};i.onerror=()=>{clearTimeout(t);no(new Error('img'))};i.src=src});
function icLoad(u){
  if(icInflight.has(u))return icInflight.get(u);
  const p=(async()=>{const hit=await icGet(u);if(hit)return hit;
    await icSlot();let d=null,err=null;try{for(const src of [artSrc(u),artSrc(u),u]){try{d=await icFetch(src);break}catch(e){err=e;await new Promise(r=>setTimeout(r,500))}}}finally{icFree()}if(!d)throw err||new Error('img');
    icMem.set(u,d);await kv('put','i:'+u,{d,t:Date.now()});icTrim();icStat();return d})();
  icInflight.set(u,p);p.then(()=>icInflight.delete(u),()=>icInflight.delete(u));return p
}
let icTrimT=0;async function icTrim(){if(Date.now()-icTrimT<20000)return;icTrimT=Date.now();try{const k=await kvCur('i:',false);if(k.length<=IC_MAX)return;const rows=[];for(const key of k){const r=await kv('get',key);rows.push([key,r&&r.t||0])}rows.sort((a,b)=>a[1]-b[1]);for(const [key] of rows.slice(0,k.length-IC_MAX+100)){await kvDel(key);icMem.delete(key.slice(2))}}catch(e){}}
async function icStat(){const e=$('icv');if(!e)return;try{const k=await kvCur('i:',false);e.textContent=k.length?k.length.toLocaleString()+' images saved':'Empty'}catch(x){e.textContent='Empty'}}
function icWarm(urls){[...new Set(urls.filter(u=>/^https:/.test(u||'')))].slice(0,120).reduce((p,u)=>p.then(()=>icLoad(u).catch(()=>{})),Promise.resolve())}
icStat();$('icClr').onclick=async()=>{const k=await kvCur('i:',false);for(const x of k)await kvDel(x);icMem.clear();icStat();toast('Image cache cleared')};
/* offline / failed thumbnails fall back to the saved copy */
function kxHydrate(im){if(im.dataset.h||!im.dataset.u)return;im.dataset.h='1';const u=im.dataset.u;icGet(u).then(v=>{im.src=v||u},()=>{im.src=u})}
new MutationObserver(ms=>{for(const m of ms)for(const n of m.addedNodes){if(n.nodeType!==1)continue;if(n.tagName==='IMG')kxHydrate(n);else n.querySelectorAll&&n.querySelectorAll('img[data-u]').forEach(kxHydrate)}}).observe(document.body,{childList:true,subtree:true});
function kxImgErr(im){return kxImgErr0(im)}
async function kxImgErr0(im){const u=im.dataset.u||im.src;if(!im.dataset.icTried&&/^https:/.test(u)){im.dataset.icTried='1';const v=await icGet(u);if(v&&im.src!==v){im.style.visibility='';im.src=v;return}if(im.dataset.u&&im.src!==im.dataset.u&&!im.src.startsWith('data:')){im.style.visibility='';im.src=im.dataset.u;return}}const b=im.closest('button');if(b)b.classList.add('image-missing');im.remove()}
document.addEventListener('load',e=>{const im=e.target;if(im&&im.tagName==='IMG'&&im.style.visibility==='hidden')im.style.visibility='';if(im&&im.tagName==='IMG'&&im.closest('.deck-card-thumb')&&im.dataset.u&&!(im.currentSrc||'').startsWith('data:')&&!im.dataset.icQ){im.dataset.icQ='1';icLoad(im.dataset.u).catch(()=>{})}},true);
function applySab(){const u=S.g('sab',null);let v;if(u!==null&&u!==undefined)v=+u;else{const p=document.createElement('div');p.style.cssText='position:fixed;bottom:0;visibility:hidden;padding-bottom:env(safe-area-inset-bottom,0px)';document.body.appendChild(p);const e=parseFloat(getComputedStyle(p).paddingBottom)||0;p.remove();v=e>0?e:0}document.documentElement.style.setProperty('--sab',v+'px');$('sab').value=v;$('sabv').textContent=(u===null||u===undefined)?'Auto · '+v+' px':v+' px'}

$('sab').oninput=e=>{S.s('sab',+e.target.value);applySab()};$('sabAuto').onclick=()=>{S.s('sab',null);applySab()};
$('sat').oninput=e=>{S.s('sat',+e.target.value);applySat()};$('satAuto').onclick=()=>{S.s('sat',null);applySat()};

/* ---------- self-check ---------- */
const DG_ID='46986414';
const dgTO=(p,ms,l)=>Promise.race([p,new Promise((_,no)=>setTimeout(()=>no(new Error((l||'Timed out')+' after '+ms/1000+'s')),ms))]);
const dgSleep=ms=>new Promise(r=>setTimeout(r,ms));
async function dgFetch(u,o){const c=new AbortController(),t=setTimeout(()=>c.abort(),9000);try{return await fetch(u,Object.assign({signal:c.signal},o||{}))}finally{clearTimeout(t)}}
const DG=[
['Build',async()=>{const b=document.querySelector('meta[name=kodex-build]');return['ok',(b?b.content:'?')+' · '+(isWV()?'Android app':'Browser')+' · '+(navigator.onLine?'online':'offline')]}],
['Card data',async()=>{if(!cards.length)return['fail','No cards loaded'];return[M.size===cards.length||M.size>cards.length*0.99?'ok':'warn',cards.length.toLocaleString()+' cards · '+src+' · index '+M.size.toLocaleString()]}],
['Storage',async()=>{const k='diag:t',v={t:Date.now()};await kv('put',k,v);const r=await kv('get',k);await kvDel(k);let ls=false;try{S.s('diag',1);ls=S.g('diag',0)===1;localStorage.removeItem('kx_diag')}catch(e){}let q='';try{const e=await navigator.storage.estimate();q=' · '+Math.round(e.usage/1048576)+' of '+Math.round(e.quota/1048576)+' MB used'}catch(e){}return[r&&r.t===v.t&&ls?'ok':'fail','Database '+(r?'ok':'failed')+' · settings '+(ls?'ok':'failed')+q]}],
['Screen fit',async()=>{const cs=getComputedStyle(document.documentElement),sat=cs.getPropertyValue('--sat').trim(),sab=cs.getPropertyValue('--sab').trim(),ad=$('topAdSlot'),n=$('nSearch'),a=ad&&ad.getBoundingClientRect(),nb=n&&n.getBoundingClientRect(),h=innerHeight;const bad=[];if(a&&a.top<(parseFloat(sat)||0)-1)bad.push('ad slot under status bar');if(nb&&nb.bottom>h+1)bad.push('nav below screen');if(document.documentElement.scrollWidth>innerWidth+1)bad.push('sideways scroll');return[bad.length?'fail':'ok','top '+sat+' · bottom '+sab+' · '+innerWidth+'×'+h+(bad.length?' · '+bad.join(', '):'')]}],
['Back stack',async()=>{const bad=[];L.forEach(x=>{if(x==='noop')bad.push('stale layer');if(x.startsWith('m:')&&!document.getElementById(x.slice(2)))bad.push('missing '+x)});const mods=document.querySelectorAll('.mdl').length,lm=L.filter(x=>x.startsWith('m:')).length;if(mods!==lm)bad.push('orphan dialogs '+(mods-lm));if(L.includes('dv')&&!(L.includes('tool')&&$('tt').textContent==='Decks'))bad.push('deck view without tool');const n0=L.length,id=openModal('<p>t</p>','','diag-t');const up=L.length===n0+1;history.back();await dgSleep(350);const down=L.length===n0&&!document.getElementById(id.id);if(!up)bad.push('open failed');if(!down)bad.push('back did not close dialog');return[bad.length?'fail':'ok',bad.length?bad.join(', '):'layers '+L.length+' · back closes one step']}],
['Decks',async()=>{const ds=deckStore();let over=0,unk=0,tot=0;ds.forEach(d=>{const m=new Map();(d.cards||[]).forEach(c=>{const q=Math.max(1,c.qty||1);m.set(String(c.id),(m.get(String(c.id))||0)+q);tot+=q;if(!resolveDeckCard(c))unk++});m.forEach(v=>{if(v>3)over++})});return[over?'fail':unk?'warn':'ok',ds.length+' decks · '+tot+' cards'+(over?' · '+over+' over 3 copies':'')+(unk?' · '+unk+' not in database':'')]}],
['Image cache',async()=>{const k=await kvCur('i:',false);return['ok',k.length.toLocaleString()+' images saved on this device']}],
['Image export',async()=>{const c=document.createElement('canvas');c.width=c.height=4;const x=c.getContext('2d');x.fillStyle='#fff';x.fillRect(0,0,4,4);const u=c.toDataURL('image/png');const b=await new Promise(r=>c.toBlob(r,'image/png'));return[u.startsWith('data:image/png')&&b&&b.size>0?'ok':'fail','Canvas to PNG '+(b?b.size+' bytes':'failed')]}],
['Save method',async()=>{const B=window.KodexBridge||window.AndroidBridge;const sb=B&&typeof B.saveBase64==='function',cr=B&&typeof B.captureRect==='function';return['ok',(sb?'Native save':isWV()?'Direct download (Android)':'Browser download')+(cr?' · screen capture available':'')+(inApp()?' · links open in this window':'')]}],
['Card art service',async()=>{const u=IMG_BASE+'/img/'+DG_ID+'.jpg';let r;try{r=await dgFetch(u,{mode:'cors'})}catch(e){return['fail','Cannot reach '+IMG_BASE+'/img ('+(e.message||'blocked')+'). Worker not deployed or blocked']}const ct=r.headers.get('content-type')||'';if(r.ok&&/image/.test(ct))return['ok','Serving card art · '+ct+' · '+(r.headers.get('cache-control')||'').slice(0,40)];let t='';try{t=(await r.text()).slice(0,120)}catch(e){}return['fail','HTTP '+r.status+' '+t]}],
['Save art into images',async()=>{const u=IMG_BASE+'/img/'+DG_ID+'.jpg';try{const im=await dgTO(new Promise((ok,no)=>{const i=new Image();i.crossOrigin='anonymous';i.onload=()=>ok(i);i.onerror=()=>no(new Error('image failed to load'));i.src=u}),9000);const c=document.createElement('canvas');c.width=c.height=8;const x=c.getContext('2d');x.drawImage(im,0,0,8,8);c.toDataURL('image/png');return['ok','Card art can be written into saved images']}catch(e){return['fail',(e.name==='SecurityError'?'Browser blocks reading card art':e.message)+' · saved images will have name tiles']}}],
['Deck codes',async()=>{const bad=[];let n=0;deckStore().forEach(d=>{const p=deckPayload(d);['m','e','s'].forEach(k=>(p[k]||[]).forEach(e=>{n++;const c=(d.cards||[]).find(x=>String(x.name||'').slice(0,40)===e[1]);const live=c&&resolveDeckCard(c);if(live&&/^\d{3,10}$/.test(String(e[0]))&&String(e[0])!==String(live.id))bad.push(e[1])}))});return[bad.length?'fail':'ok',n+' entries'+(bad.length?' · wrong code for '+bad.slice(0,3).join(', '):' use the card passcode')]}],
['Art burst',async()=>{const ids=cards.slice(0,40).map(c=>c.id).filter(Boolean).slice(0,10);if(!ids.length)return['warn','No cards'];const res=await Promise.all(ids.map(id=>dgFetch(IMG_BASE+'/img/'+id+'.jpg',{mode:'cors'}).then(r=>r.status).catch(()=>0)));const okN=res.filter(x=>x===200).length;return[okN===ids.length?'ok':okN?'warn':'fail',okN+' of '+ids.length+' card pictures loaded at once'+(okN<ids.length?' · codes '+[...new Set(res.filter(x=>x!==200))].join(','):'')]}],
['Arena',async()=>{const bad=[];for(const f of ['/duel/','/duel/sw.js','/duel/offline.js']){try{const r=await dgFetch(IMG_BASE+f,{mode:'cors'});if(!r.ok)bad.push(f+' '+r.status)}catch(e){try{await dgFetch(IMG_BASE+f,{mode:'no-cors'})}catch(x){bad.push(f)}}}return[bad.length?'fail':'ok',bad.length?'Not reachable: '+bad.join(', '):'Arena and offline files reachable']}],
['Deck page',async()=>{const u=deckPageUrl();try{const r=await dgFetch(u,{mode:'cors'});return[r.ok?'ok':'fail','HTTP '+r.status+' · '+u]}catch(e){try{await dgFetch(u,{mode:'no-cors'});return['ok','Reachable · '+u]}catch(e2){return['fail','Cannot reach '+u]}}}],
['Card lookup',async()=>{try{const r=await dgFetch('https://db.ygoprodeck.com/api/v7/cardinfo.php?id='+DG_ID);const j=await r.json();return[j&&j.data&&j.data[0]?'ok':'warn','YGOPRODeck: '+(j&&j.data&&j.data[0]?j.data[0].name:'HTTP '+r.status)]}catch(e){return['warn','YGOPRODeck not reachable ('+(e.message||'blocked')+')']}}],
['Rulings service',async()=>{try{const r=await dgFetch(IMG_BASE+'/api/health');const j=await r.json();return[j&&j.ok?'ok':'warn','HTTP '+r.status]}catch(e){return['warn','Not reachable ('+(e.message||'blocked')+')']}}],
['Deck list PDF',async()=>{const d={id:'diag',name:'Self Check',cards:[{id:'1',name:'Sample Monster',section:'main',qty:2},{id:'2',name:'Sample Spell',type:'Spell Card',section:'main',qty:1}]};const r=buildKdePdf(d,{});const buf=new Uint8Array(await r.blob.arrayBuffer());const head=String.fromCharCode(...buf.slice(0,5));return[head==='%PDF-'&&buf.length>4000?'ok':'fail','Built '+Math.round(buf.length/1024)+' KB']}],
];
async function runDiagChecks(onRow){const out=[];for(const[n,f]of DG){let r;try{r=await dgTO(f(),20000,n+' timed out')}catch(e){r=['fail',String(e&&e.message||e)]}const row={n,s:r[0],d:r.slice(1).join(' ')};out.push(row);if(onRow)onRow(row)}return out}
function diagReport(rows){const f=rows.filter(r=>r.s==='fail').length,w=rows.filter(r=>r.s==='warn').length;return'KodeX self-check · '+new Date().toISOString().slice(0,19).replace('T',' ')+'\n'+(f?f+' failed':'All passed')+(w?' · '+w+' warnings':'')+'\n\n'+rows.map(r=>r.s.toUpperCase().padEnd(5)+' '+r.n+' — '+r.d).join('\n')+'\n\n'+navigator.userAgent}
$('arenaOpen').onclick=()=>openArena('');
let arenaActive=false,arenaBye=false,notifAsked=false;
addEventListener('message',e=>{const f=$('arenaFrame');if(!f||e.source!==f.contentWindow)return;const d=e.data||{};
  if((d.kx==='card'||d.kx==='rulings')&&/^\d{1,10}$/.test(String(d.id))){quickView(String(d.id));if(d.kx==='rulings'){const r=document.querySelector('.mdl[data-k=qv] [data-qvrul]');if(r)r.click()}}
  if(d.kx==='ready')skinsToArena();   if(d.kx==='stats'){try{recordStats(d)}catch(x){}}
  if(d.kx==='duel'){arenaActive=!!d.active;if(arenaActive&&!notifAsked&&window.CastelApp&&CastelApp.notificationPermission&&CastelApp.notificationPermission()==='default'){notifAsked=true;try{CastelApp.requestNotificationPermission()}catch(x){}}}
  if(d.kx==='chat'&&document.hidden&&window.CastelApp&&CastelApp.notify){try{CastelApp.notify(String(d.from||'Opponent').slice(0,24)+' · Duel Synapse',String(d.text||'').slice(0,200),'duel-chat')}catch(x){}}
  if(d.kx==='save'&&typeof d.data==='string'&&/^data:[\w/+.-]+;base64,[A-Za-z0-9+/=]+$/.test(d.data)&&d.data.length<8e6){const nm=String(d.name||'duel.yrp').replace(/[\\/:*?"<>|]/g,'_').slice(0,80);if(window.CastelApp&&CastelApp.saveBase64File){CastelApp.saveBase64File(d.data,nm);toast('Replay saved to Downloads (.yrp).')}else{const a=document.createElement('a');a.href=d.data;a.download=nm;document.body.appendChild(a);a.click();a.remove();toast('Replay saved')}}
});
/** Leaving the Arena mid-duel (X or Back) asks first. */
function confirmLeaveArena(){const m=openModal(`<div class="dk-hd"><h3>Leave the duel?</h3></div><p class="note">The duel will end and can't be continued.</p><div class="sacts" style="display:flex;gap:8px;justify-content:flex-end;margin-top:14px"><button class="btn" data-close>Keep playing</button><button class="btn p" data-leave>Leave duel</button></div>`,'','leave');m.querySelector('[data-leave]').onclick=()=>{arenaBye=true;L.pop();m.remove();history.go(-2)}}
function sndPanel(tb){const lim={music:8e6};tb.querySelectorAll('[data-snd]').forEach(async row=>{const k=row.dataset.snd,v=await kv('get','snd_'+k);if(v&&v.name){row.querySelector('[data-sndname]').textContent=v.name;row.querySelector('[data-snddel]').hidden=false}});tb.querySelectorAll('[data-sndadd]').forEach(inp=>inp.onchange=async()=>{const f=inp.files&&inp.files[0],k=inp.dataset.sndadd;if(!f)return;if(!/^audio\//.test(f.type)&&!/\.(mp3|m4a|aac|ogg|oga|wav|opus)$/i.test(f.name)){toast('Choose an audio file');return}if(f.size>(lim[k]||1e6)){toast(k==='music'?'Music must be 8 MB or less':'Sounds must be 1 MB or less');return}const buf=await f.arrayBuffer();if(await kv('put','snd_'+k,{name:f.name.slice(0,60),buf})){toast('Saved');audioToArena();openSkins()}else toast('Could not save that file')});tb.querySelectorAll('[data-snddel]').forEach(b=>b.onclick=async()=>{await kvDel('snd_'+b.dataset.snddel);audioToArena();openSkins()})}
function sigPanel(tb){const qi=tb.querySelector('[data-sigq]'),res=tb.querySelector('[data-sigres]'),lst=tb.querySelector('[data-siglist]');if(!qi)return;const code=c=>String(/^\d{3,10}$/.test(String(c.kid||''))?c.kid:c.id);const draw=()=>{const a=sigCards();lst.innerHTML=a.length?a.map(id=>{const c=M.get(id)||cards.find(v=>String(v.kid)===id)||{};const fx=(S.g('sig_fx',{})||{})[id]||'';return `<span class="sig-chip">${esc(c.name||id)}<select data-sigfx="${esc(id)}" aria-label="Finishing move for ${esc(c.name||id)}"><option value="">Default move</option>${FIN_T.map(([k,l])=>`<option value="${k}"${fx===k?' selected':''}>${l}</option>`).join('')}</select><select data-sigent="${esc(id)}" aria-label="Entrance for ${esc(c.name||id)}"><option value="">Default entrance</option>${ENT_T.map(([k,l])=>`<option value="${k}"${((S.g('sig_ent',{})||{})[id]||'')===k?' selected':''}>${l}</option>`).join('')}</select><select data-sigatk="${esc(id)}" aria-label="Attack for ${esc(c.name||id)}"><option value="">Default attack</option>${ATK_T.map(([k,l])=>`<option value="${k}"${((S.g('sig_atk',{})||{})[id]||'')===k?' selected':''}>${l}</option>`).join('')}</select><button type="button" data-sigace="${esc(id)}" class="${(S.g('ace_cards',[])||[]).map(String).includes(id)?'on':''}" aria-label="Ace card" aria-pressed="${(S.g('ace_cards',[])||[]).map(String).includes(id)}" title="Ace card">★</button><button type="button" data-sigvoice="${esc(id)}" class="${MEDIA.voices[id]?'on':''}" aria-label="Card voice" title="Card voice">🎙</button><button type="button" data-sigpv="${esc(id)}" aria-label="Preview" title="Preview">▶</button><button type="button" data-sigdel="${esc(id)}" aria-label="Remove">×</button></span>`}).join(''):'<p class="note">No signature cards yet. Bosses (3000+ ATK, Level 8+, Link 4+) always get an entrance.</p>';lst.querySelectorAll('[data-sigdel]').forEach(b=>b.onclick=()=>{S.s('sig_cards',sigCards().filter(x=>x!==b.dataset.sigdel));draw();skinsToArena()});lst.querySelectorAll('[data-sigpv]').forEach(b=>b.onclick=()=>previewFin((S.g('sig_fx',{})||{})[b.dataset.sigpv]||finStyle()));lst.querySelectorAll('[data-sigfx]').forEach(sl=>sl.onchange=()=>{const o=Object.assign({},S.g('sig_fx',{}));if(sl.value)o[sl.dataset.sigfx]=sl.value;else delete o[sl.dataset.sigfx];S.s('sig_fx',o);skinsToArena()});for(const [a,key,kind] of [['sigent','sig_ent','ent'],['sigatk','sig_atk','atk']])lst.querySelectorAll(`[data-${a}]`).forEach(sl=>sl.onchange=()=>{const o=Object.assign({},S.g(key,{}));if(sl.value)o[sl.dataset[a]]=sl.value;else delete o[sl.dataset[a]];S.s(key,o);skinsToArena();if(sl.value)previewMove(kind,sl.value)})};qi.oninput=()=>{const t=nt(qi.value);if(t.length<2){res.innerHTML='';return}const hits=[];for(const c of cards){if(nt(c.name).includes(t)){hits.push(c);if(hits.length>=8)break}}res.innerHTML=hits.map(c=>`<button type="button" class="sig-hit" data-sigadd="${esc(code(c))}">${esc(c.name)}</button>`).join('');res.querySelectorAll('[data-sigadd]').forEach(b=>b.onclick=()=>{const a=sigCards();if(!a.includes(b.dataset.sigadd)){if(a.length>=60){toast('Up to 60 signature cards');return}a.push(b.dataset.sigadd);S.s('sig_cards',a);skinsToArena()}qi.value='';res.innerHTML='';draw()})};draw()}
$('arenaFrame').addEventListener('load',skinsToArena);
/* KodeX Premium: MEIOCG animations (moving background with floating MEIOCG cards, animated lists). Above any wallpaper, below the content; paused while hidden or in the Arena. */function kxFx(){const on=PREMIUM&&S.g('kx_fx',true)&&!matchMedia('(prefers-reduced-motion: reduce)').matches;document.documentElement.classList.toggle('kx-fx',on);if(on){const lg=document.querySelector('header .logo img');if(lg)document.documentElement.style.setProperty('--kxlogo',`url("${lg.src}")`)}}{const ls=$('list');let first='';new MutationObserver(()=>{const f=ls.firstElementChild,id=f&&f.dataset?f.dataset.id||'':'';if(id&&id!==first&&document.documentElement.classList.contains('kx-fx')){ls.classList.remove('deal');void ls.offsetWidth;ls.classList.add('deal');clearTimeout(ls._dt);ls._dt=setTimeout(()=>ls.classList.remove('deal'),1400)}first=id}).observe(ls,{childList:true})}kxFx();document.addEventListener('visibilitychange',()=>document.documentElement.classList.toggle('kx-paused',document.hidden));{const la=$('Larena');new MutationObserver(()=>document.documentElement.classList.toggle('kx-arena',la.classList.contains('open'))).observe(la,{attributes:true,attributeFilter:['class']})}
{const la=$('Larena');new MutationObserver(()=>document.body.classList.toggle('arena-on',la.classList.contains('open'))).observe(la,{attributes:true,attributeFilter:['class']})}
if(PREMIUM){const b=$('bPrem');b.querySelector('span').textContent='Skins';document.querySelector('#Lset .sec + .grp').previousElementSibling.textContent='Premium';document.title='Duel Synapse: KodeX Premium'}
$('bPrem').onclick=()=>{if(PREMIUM){openSkins();return}openPremiumInfo()};const SCAN_FREE=4,DAY=864e5;function scanUses(){const a=S.g('scan_uses',[]),now=Date.now();return(Array.isArray(a)?a:[]).filter(t=>typeof t==='number'&&now-t<DAY&&t<=now+6e4)}window.scanGate=function(){if(PREMIUM)return true;const u=scanUses();if(u.length>=SCAN_FREE){const next=Math.min(...u)+DAY-Date.now(),h=Math.floor(next/36e5),mn=Math.ceil(next%36e5/6e4);const m=openModal(`<div class="dk-hd"><h3>Free scans used</h3><button class="ibtn" data-close aria-label="Close">${ic('x')}</button></div><p class="note">The free edition includes ${SCAN_FREE} card scans every 24 hours. Your next free scan is in ${h?h+' h ':''}${mn} min.</p><p class="note"><strong>KodeX Premium</strong> scans without limits.</p><div class="acts" style="display:grid;gap:8px;margin-top:10px"><button class="btn p" data-gp>See KodeX Premium</button><button class="btn" data-close>OK</button></div>`,'','scanlim');m.querySelector('[data-gp]').onclick=()=>{history.back();setTimeout(openPremiumInfo,250)};return false}u.push(Date.now());S.s('scan_uses',u);kv('put','scan_uses',u);const left=SCAN_FREE-u.length;setTimeout(()=>toast(left?`Free scan ${u.length} of ${SCAN_FREE} today · ${left} left`:`That was your last free scan for today · Premium scans without limits`),400);return true};kv('get','scan_uses').then(v=>{if(Array.isArray(v)&&!PREMIUM){const m=[...new Set([...scanUses(),...v.filter(t=>Date.now()-t<DAY)])];S.s('scan_uses',m)}});const PREMIUM_URL='https://play.google.com/store/apps/details?id=com.duelsynapse.kodex.premium';function premiumCard(){return `<div class="pcard"><h4>KodeX Premium</h4><p class="lead">Everything in KodeX, plus:</p><ul class="pf"><li><i>${ic('star',16)}</i><span><strong>No ads</strong><small>The sponsor strip is gone.</small></span></li><li><i>${ic('star',16)}</i><span><strong>Unlimited card scanner</strong><small>Free: 4 scans every 24 hours.</small></span></li><li><i>${ic('star',16)}</i><span><strong>Finishing moves</strong><small>Shatter, Meteor, Thunder, Vortex or Slash when you win, and one per signature card.</small></span></li><li><i>${ic('star',16)}</i><span><strong>Grand entrances and attacks</strong><small>Portal, Storm, Inferno, Nova or Glitch entrances and Beam, Comet, Claw or Phantom attacks, as your default or per card. Free: Rise and Lunge.</small></span></li><li><i>${ic('star',16)}</i><span><strong>Winning-attack showdowns</strong><small>13 showdowns (Domain Expansion, All-Out Attack, Time Stop, Final Blow and more, or Random) for 3 to 5 seconds before the winning blow, from an attack or a Spell, Trap or effect. Free: Menacing.</small></span></li><li><i>${ic('star',16)}</i><span><strong>Ace cards</strong><small>Your chosen cards (monsters, Spells or Traps) fill the screen with a showdown before their effect resolves.</small></span></li><li><i>${ic('star',16)}</i><span><strong>Card voices</strong><small>Your own sound or recording when a chosen card is activated or summoned.</small></span></li><li><i>${ic('star',16)}</i><span><strong>Sound emotes</strong><small>9 more built-in sounds, plus your own files and recordings.</small></span></li><li><i>${ic('star',16)}</i><span><strong>Your own emotes</strong><small>Send your pictures and animated GIFs at any time in a duel.</small></span></li><li><i>${ic('star',16)}</i><span><strong>Chat on the field</strong><small>Messages float on screen by the player who sent them.</small></span></li><li><i>${ic('star',16)}</i><span><strong>Signature cards</strong><small>Your chosen cards get the big entrance in every duel.</small></span></li><li><i>${ic('star',16)}</i><span><strong>Custom sleeves and field</strong><small>Main and Extra Deck sleeves and a field your opponent sees.</small></span></li><li><i>${ic('star',16)}</i><span><strong>Your own music and sounds</strong><small>Duel music and sound effects from your files.</small></span></li><li><i>${ic('star',16)}</i><span><strong>MEIOCG animations</strong><small>A moving MEIOCG background and animated lists across KodeX.</small></span></li><li><i>${ic('star',16)}</i><span><strong>Replay files</strong><small>Save any duel as a .yrp replay.</small></span></li></ul><h4 style="font-size:.9rem;margin:0 0 6px">Finishing moves · tap to preview</h4>${finTiles('')}<h4 style="font-size:.9rem;margin:0 0 6px">Entrances · tap to preview</h4>${mvTiles('ent','')}<h4 style="font-size:.9rem;margin:0 0 6px">Attacks · tap to preview</h4>${mvTiles('atk','')}<h4 style="font-size:.9rem;margin:0 0 6px">Winning attack · tap to preview</h4>${showTiles('finale','')}<div class="acts"><button class="btn p" data-getprem>Get KodeX Premium</button><button class="btn" data-noads>Remove ads only · coming soon</button></div><p class="scan-left">Free card scans left today: ${Math.max(0,4-scanUses().length)} of 4</p></div>`}function bindPremiumCard(root){root.querySelectorAll('[data-fin]').forEach(b=>b.onclick=()=>previewFin(b.dataset.fin));root.querySelectorAll('[data-mv]').forEach(b=>b.onclick=()=>previewMove(b.dataset.mv,b.dataset.mvk));root.querySelectorAll('[data-show]').forEach(b=>b.onclick=()=>previewShow(b.dataset.show,b.dataset.showk));const g=root.querySelector('[data-getprem]');if(g)g.onclick=()=>{try{window.open(PREMIUM_URL,'_blank','noopener')}catch(e){location.href=PREMIUM_URL}};const n=root.querySelector('[data-noads]');if(n)n.onclick=()=>toast('Coming soon')}function openPremiumInfo(){tool('KodeX Premium',premiumCard());bindPremiumCard($('tb'))}if(!PREMIUM){const grp=$('bPrem').parentNode;const box=document.createElement('div');box.style.padding='12px 0 4px';grp.insertBefore(box,$('bPrem'));const draw=()=>{box.innerHTML=premiumCard();bindPremiumCard(box)};draw();$('bSet').addEventListener('click',()=>setTimeout(draw,30));$('bPrem').querySelector('span').textContent='More about KodeX Premium'}$('arenaPrep').onclick=saveArenaOffline;
$('diagRun').onclick=async()=>{const m=openModal(`<div class="dk-hd"><h3>Self-check</h3><button class="ibtn" data-close aria-label="Close">${ic('x')}</button></div><div class="qv-scroll"><div class="dg-s" id="dgS">Running…</div><div id="dgL"></div><div id="dgA" hidden><button class="btn p" id="dgCopy" style="width:100%;margin-top:12px">Copy report</button><textarea class="dg-t" id="dgT" readonly></textarea></div></div>`,'big','diag');const L2=m.querySelector('#dgL');const rows=await runDiagChecks(r=>{const e=document.createElement('div');e.className='dg';e.innerHTML=`<div>${esc(r.n)}<small>${esc(r.d)}</small></div><b class="${r.s}">${r.s==='ok'?'OK':r.s==='warn'?'WARN':'FAIL'}</b>`;L2.appendChild(e)});const f=rows.filter(r=>r.s==='fail').length,w=rows.filter(r=>r.s==='warn').length,rep=diagReport(rows);window.__diagReport=rep;const st=m.querySelector('#dgS');if(!st)return;st.textContent=f?f+' check'+(f>1?'s':'')+' failed':w?'Passed with '+w+' warning'+(w>1?'s':''):'All checks passed';m.querySelector('#dgA').hidden=false;m.querySelector('#dgT').value=rep;m.querySelector('#dgCopy').onclick=async()=>{try{await navigator.clipboard.writeText(rep);toast('Report copied')}catch(e){const t=m.querySelector('#dgT');t.focus();t.select();toast('Select the text and copy it')}}};
window.__diag=runDiagChecks;
/* ---------- start ---------- */
addEventListener('online',()=>{if(!cards.length)boot();else set(`${src} • ${cards.length.toLocaleString()} cards`)});
addEventListener('offline',()=>set('Offline • saved data is available',true));
if(navigator.storage&&navigator.storage.persist)navigator.storage.persist().catch(()=>{});
syncAd();addEventListener('resize',syncAd);addEventListener('load',syncAd);try{new ResizeObserver(syncAd).observe($('topAdSafeArea'))}catch(e){}
applySat();applySab();applyUI();wpApply();boot();
</script>
<!-- ===================== Card scanner (camera → card) =====================
 Reads a card's passcode, set code and name with on-device text recognition
 (Tesseract.js, loaded from jsDelivr the first time) and opens the card.
 Matching data: https://kodex.meiocg.org/scan/cards.json (falls back to the cards already loaded). -->
<style>
.scanbtn{display:grid;place-items:center;color:var(--accent)!important}
.scanbtn svg{width:22px;height:22px}
.mdl.scanm{padding:0;background:#000;z-index:90}
.scanm .dlg.scan{width:100%;max-width:none;height:100%;max-height:none;border:0;border-radius:0;padding:0;background:#000;gap:0;position:relative;overflow:hidden}
.scan video,.scan #scPrev{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;background:#000}.scan video::-webkit-media-controls{display:none!important}.scan #scStill{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;background:#000}.scan .sstart{position:absolute;left:50%;top:46%;transform:translate(-50%,-50%);z-index:2;min-width:220px}
.scan .sguide{position:absolute;left:50%;top:46%;transform:translate(-50%,-50%);height:min(62vh,calc(84vw * 86 / 59));aspect-ratio:59/86;border-radius:14px;box-shadow:0 0 0 200vmax rgba(0,0,0,.55);outline:2px solid rgba(255,255,255,.85);transition:outline-color .2s;pointer-events:none}
.scan .sguide.reading{outline-color:var(--accent)}
.scan .sguide i{position:absolute;width:26px;height:26px;border:solid var(--accent)}
.scan .sguide i:nth-child(1){left:-4px;top:-4px;border-width:4px 0 0 4px;border-top-left-radius:16px}.scan .sguide i:nth-child(2){right:-4px;top:-4px;border-width:4px 4px 0 0;border-top-right-radius:16px}
.scan .sguide i:nth-child(3){left:-4px;bottom:-4px;border-width:0 0 4px 4px;border-bottom-left-radius:16px}.scan .sguide i:nth-child(4){right:-4px;bottom:-4px;border-width:0 4px 4px 0;border-bottom-right-radius:16px}
.scan .stop{position:absolute;left:0;right:0;top:0;padding:calc(10px + var(--sat)) 12px 10px;display:flex;align-items:center;gap:10px;background:linear-gradient(#000c,transparent);color:#fff}
.scan .stop b{flex:1;font-size:1.05rem}
.scan .sib{min-width:44px;height:44px;border-radius:22px;border:1px solid #ffffff33;background:#0008;color:#fff;display:grid;place-items:center;padding:0 14px;font-weight:700}
.scan .sib svg{width:22px;height:22px}
.scan #scTorch[aria-pressed=true]{background:#fbbf24;color:#1a1405;border-color:#fbbf24}
.scan #scAuto[aria-pressed=true]{background:var(--accent);color:#06101f;border-color:var(--accent)}
.scan .shint{position:absolute;left:12px;right:12px;bottom:calc(112px + var(--sab));text-align:center;color:#fff;font-weight:700;text-shadow:0 1px 6px #000}
.scan .shint small{display:block;font-weight:500;color:#d6dbe5;margin-top:3px;overflow-wrap:anywhere}
.scan .sbar{position:absolute;left:0;right:0;bottom:0;padding:14px 16px calc(16px + var(--sab));display:flex;gap:12px;justify-content:center;align-items:center;background:linear-gradient(transparent,#000d)}
.scan .sside{width:96px;display:flex;justify-content:center}
.scan .shut{width:72px;height:72px;border-radius:50%;border:4px solid #fff;background:#ffffff22;display:grid;place-items:center}
.scan .shut b{width:54px;height:54px;border-radius:50%;background:#fff}
.scan .shut.busy b{background:var(--accent);animation:scpulse 1s infinite}
@keyframes scpulse{50%{transform:scale(.82)}}
.scan .ssheet{position:absolute;left:0;right:0;bottom:0;max-height:86%;overflow:auto;background:var(--panel);border-top:1px solid var(--line);border-radius:20px 20px 0 0;padding:18px 16px calc(18px + var(--sab));transform:translateY(105%);transition:transform .25s ease;color:var(--text)}
.scan .ssheet.on{transform:none}
.scan .ssheet h3{margin:0 0 4px;font-size:1.1rem}.scan .ssheet .ssub{color:var(--muted);font-size:.85rem;margin:0 0 12px}
.scan .shit{display:flex;gap:14px;align-items:flex-start}.scan .shit img{width:112px;aspect-ratio:59/86;object-fit:cover;border-radius:8px;background:var(--bg);flex:none}
.scan .shit b{display:block;font-size:1.05rem;line-height:1.25}.scan .shit small{color:var(--muted)}
.scan .sacts{display:flex;gap:10px;margin-top:16px;flex-wrap:wrap}.scan .sacts .btn{flex:1;min-width:130px}
.scan .scands{display:grid;gap:8px}
.scan .scand{display:flex;gap:12px;align-items:center;text-align:left;padding:8px;border-radius:12px;border:1px solid var(--line);background:var(--panel2);color:var(--text);width:100%}
.scan .scand img{width:44px;aspect-ratio:59/86;object-fit:cover;border-radius:5px;background:var(--bg);flex:none}
.scan .scand span{flex:1;min-width:0;overflow-wrap:anywhere;font-weight:700}.scan .scand small{display:block;color:var(--muted);font-weight:500}
.scan .smsg{position:absolute;inset:0;display:none;place-items:center;padding:24px;text-align:center;background:var(--bg);color:var(--text)}
.scan .smsg.on{display:grid}.scan .smsg p{color:var(--muted)}
.scan .sload{position:absolute;left:50%;top:46%;transform:translate(-50%,-50%);color:#d6dbe5;font-weight:700;pointer-events:none;text-align:center}
.scan .snot{border:0;background:var(--soft);color:var(--accent);border-radius:999px;padding:3px 10px;font-weight:700;font-size:.78rem;margin-top:8px}
</style>
<script>
/* KodeX card scanner: turns text read from a card photo into a card.
 * A card is identified by, in order of reliability:
 *   1. its passcode (8 digits, bottom-left corner)
 *   2. its set code (e.g. "LOB-EN001", under the artwork on the right)
 *   3. its name (top banner), matched approximately because OCR makes mistakes
 * Works in the browser (window.KodexMatch) and in Node (module.exports) for tests.
 */
(function (root) {
  "use strict";

  const normName = (s) => String(s || "").toLowerCase().normalize("NFKD").replace(/[̀-ͯ]/g, "")
    .replace(/[^a-z0-9 ]/g, " ").replace(/\s+/g, " ").trim();

  // Characters OCR confuses with digits, for fields that only contain digits.
  const DIGIT_FIX = { O: "0", o: "0", Q: "0", D: "0", I: "1", l: "1", i: "1", "|": "1", "!": "1", Z: "2", z: "2", S: "5", s: "5", B: "8", G: "6", b: "6", T: "7", g: "9", q: "9" };
  const toDigits = (s) => String(s || "").replace(/[OoQDIli|!ZzSsBGbTgq]/g, (c) => DIGIT_FIX[c]);

  function setKey(code) {
    const m = /^([A-Z0-9]{2,5})-([A-Z]{0,2})(\d{3})$/.exec(String(code || "").toUpperCase().replace(/\s+/g, ""));
    return m ? m[1] + "-" + m[3] : "";
  }

  function trigrams(s) {
    const t = new Set();
    const x = "  " + s + " ";
    for (let i = 0; i < x.length - 2; i++) t.add(x.slice(i, i + 3));
    return t;
  }

  function levenshtein(a, b) {
    if (a === b) return 0;
    if (!a.length) return b.length;
    if (!b.length) return a.length;
    let prev = new Array(b.length + 1), cur = new Array(b.length + 1);
    for (let j = 0; j <= b.length; j++) prev[j] = j;
    for (let i = 1; i <= a.length; i++) {
      cur[0] = i;
      for (let j = 1; j <= b.length; j++) {
        const cost = a.charCodeAt(i - 1) === b.charCodeAt(j - 1) ? 0 : 1;
        cur[j] = Math.min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + cost);
      }
      [prev, cur] = [cur, prev];
    }
    return prev[b.length];
  }

  /** Builds lookup tables from scan/cards.json rows: [id, name, setCodes, altIds]. */
  function buildIndex(rows) {
    const cards = [], byId = new Map(), bySet = new Map();
    for (const [id, name, sets, alts] of rows) {
      const card = { id, name, n: normName(name), sets: sets || [], alts: alts || [] };
      card.i = cards.length;
      cards.push(card);
      byId.set(id, card);
      for (const a of card.alts) if (!byId.has(a)) byId.set(a, card);
      for (const s of card.sets) {
        const k = setKey(s);
        if (!k) continue;
        if (!bySet.has(k)) bySet.set(k, new Set());
        bySet.get(k).add(card);
      }
    }
    return { cards, byId, bySet, grams: null };
  }

  /** The name search table (trigram → cards), built the first time a name is matched: it takes a moment. */
  function nameGrams(index) {
    if (index.grams) return index.grams;
    const grams = new Map();
    for (const card of index.cards) for (const g of trigrams(card.n)) { if (!grams.has(g)) grams.set(g, []); grams.get(g).push(card.i); }
    return (index.grams = grams);
  }

  /** Similarity in [0,1] between an OCR'd name and a card name (both normalised). */
  function nameSimilarity(read, name) {
    if (!read || !name) return 0;
    if (read === name) return 1;
    const d = levenshtein(read, name);
    let s = 1 - d / Math.max(read.length, name.length);
    // The banner is often cut off on the right: also compare against the card name's prefix.
    if (read.length >= 6 && name.length > read.length) {
      const p = 1 - levenshtein(read, name.slice(0, read.length)) / read.length;
      s = Math.max(s, p * 0.94);
    }
    return Math.max(0, s);
  }

  /** Best name matches for OCR text, highest first: [{card, score}]. */
  /** OCR of shading or artwork gives junk like "iii iii": a real name has a word of 3+ letters with a vowel that isn't one letter repeated. */
  const looksLikeName = (read) => read.split(" ").some((w) => w.length >= 3 && new Set(w).size >= 2 && /[aeiouy]/.test(w));

  function matchName(index, text, limit = 6) {
    const read = normName(text);
    if (read.length < 3 || !looksLikeName(read)) return [];
    const counts = new Map();
    const grams = nameGrams(index);
    for (const g of trigrams(read)) {
      const list = grams.get(g);
      if (!list || list.length > 4000) continue; // very common trigrams don't help
      for (const i of list) counts.set(i, (counts.get(i) || 0) + 1);
    }
    const pool = [...counts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 300).map(([i]) => index.cards[i]);
    return pool.map((card) => ({ card, score: nameSimilarity(read, card.n) }))
      .sort((a, b) => b.score - a.score || a.card.n.length - b.card.n.length).slice(0, limit);
  }

  /** Passcodes (8 digits) found in OCR text that belong to a card. */
  function findPasscodes(index, text) {
    const found = [];
    const digits = toDigits(text).replace(/[^0-9]+/g, " ");
    for (const m of digits.matchAll(/\d{8,9}/g)) {
      const n = Number(m[0]);
      const card = index.byId.get(n) || (m[0].length === 9 ? index.byId.get(Number(m[0].slice(0, 8))) || index.byId.get(Number(m[0].slice(1))) : null);
      if (card && !found.includes(card)) found.push(card);
    }
    return found;
  }

  /** Cards whose printed set code appears in OCR text. */
  function findSetCodes(index, text) {
    const found = [];
    const up = String(text || "").toUpperCase().replace(/[–—_]/g, "-");
    for (const m of up.matchAll(/([A-Z0-9]{2,5})\s*-\s*([A-Z0-9]{3,6})/g)) {
      const tail = m[2];
      const region = (/^([A-Z]{0,2})/.exec(tail.replace(/\d.*$/, "")) || ["", ""])[1].slice(0, 2);
      const num = toDigits(tail.slice(region.length)).slice(0, 3);
      if (!/^\d{3}$/.test(num)) continue;
      for (const card of index.bySet.get(m[1] + "-" + num) || []) if (!found.includes(card)) found.push(card);
    }
    return found;
  }

  /**
   * Decides which card was scanned from the three reads.
   * Returns {card, sure, via, candidates:[{card, score}]} or {card:null, candidates} when unsure.
   */
  function identify(index, { name = "", setCode = "", passcode = "" } = {}) {
    const byName = matchName(index, name, 6);
    const nameScore = (card) => (byName.find((x) => x.card === card) || { score: nameSimilarity(normName(name), card.n) }).score;
    const nameRead = normName(name).length >= 3 && looksLikeName(normName(name));

    const pass = findPasscodes(index, passcode + " " + setCode);
    for (const card of pass) {
      // A misread digit can land on another real card: trust it unless the name clearly disagrees.
      if (!nameRead || nameScore(card) >= 0.35 || !byName[0] || byName[0].score < 0.8) {
        return { card, sure: true, via: "passcode", candidates: rank(card, byName) };
      }
    }
    const sets = findSetCodes(index, setCode + " " + passcode);
    if (sets.length === 1 && (!nameRead || nameScore(sets[0]) >= 0.3)) return { card: sets[0], sure: true, via: "set", candidates: rank(sets[0], byName) };
    if (sets.length > 1) {
      const best = sets.map((card) => ({ card, score: nameScore(card) })).sort((a, b) => b.score - a.score);
      if (best[0].score >= 0.5) return { card: best[0].card, sure: true, via: "set", candidates: rank(best[0].card, byName) };
    }
    const top = byName[0], second = byName[1];
    if (top && top.score >= 0.84 && (!second || top.score - second.score >= 0.06 || top.score === 1)) {
      return { card: top.card, sure: true, via: "name", candidates: byName };
    }
    const cands = [...sets.map((card) => ({ card, score: Math.max(0.5, nameScore(card)) })), ...byName].filter((x, i, a) => a.findIndex((y) => y.card === x.card) === i);
    if (top && top.score >= 0.6) return { card: top.card, sure: false, via: "name", candidates: cands.slice(0, 6) };
    return { card: null, sure: false, via: "", candidates: cands.filter((x) => x.score >= 0.5).slice(0, 6) };
  }

  function rank(card, byName) {
    return [{ card, score: 1 }, ...byName.filter((x) => x.card !== card)].slice(0, 6);
  }

  const api = { buildIndex, identify, matchName, findPasscodes, findSetCodes, normName, setKey, nameSimilarity, levenshtein };
  if (typeof module === "object" && module.exports) module.exports = api;
  else root.KodexMatch = api;
})(typeof self !== "undefined" ? self : this);

</script>
<script>
/* KodeX card scanner: recognise a card by its artwork.
 *
 * Each card's artwork gets a 64-bit perceptual hash (pHash): the picture is
 * turned grey, averaged down to 32×32, transformed with a DCT, and the 63
 * lowest frequencies (without the overall brightness) are compared with their
 * median. Similar pictures give hashes that differ in few bits, even with a
 * different camera, lighting, blur or JPEG quality, and whatever the card's
 * language, since the artwork is the same.
 *
 * scripts/build_art_index.py computes the same hash in Python for every
 * card image and writes scan/art.json. This file is used by the KodeX app and by
 * tests (Node: module.exports, browser: window.KodexArt).
 */
(function (root) {
  "use strict";
  const N = 32;

  /** Grey levels (0-255) averaged down to N×N cells from RGBA pixels. */
  function grayCells(rgba, width, height) {
    const out = new Float64Array(N * N);
    for (let cy = 0; cy < N; cy++) {
      const y0 = Math.floor((cy * height) / N), y1 = Math.max(y0 + 1, Math.floor(((cy + 1) * height) / N));
      for (let cx = 0; cx < N; cx++) {
        const x0 = Math.floor((cx * width) / N), x1 = Math.max(x0 + 1, Math.floor(((cx + 1) * width) / N));
        let sum = 0, n = 0;
        for (let y = y0; y < y1; y++) {
          let i = (y * width + x0) * 4;
          for (let x = x0; x < x1; x++, i += 4) { sum += 0.299 * rgba[i] + 0.587 * rgba[i + 1] + 0.114 * rgba[i + 2]; n++; }
        }
        out[cy * N + cx] = sum / n;
      }
    }
    return out;
  }

  const COS = (() => { const c = new Float64Array(8 * N); for (let u = 0; u < 8; u++) for (let x = 0; x < N; x++) c[u * N + x] = Math.cos(((2 * x + 1) * u * Math.PI) / (2 * N)); return c; })();

  /** 64-bit pHash of N×N grey cells, as [hi, lo] 32-bit unsigned integers. */
  function phashCells(g) {
    // Separable DCT, keeping only the 8×8 lowest frequencies.
    const rows = new Float64Array(N * 8);
    for (let y = 0; y < N; y++) for (let u = 0; u < 8; u++) { let s = 0; for (let x = 0; x < N; x++) s += g[y * N + x] * COS[u * N + x]; rows[y * 8 + u] = s; }
    const f = new Float64Array(64);
    for (let v = 0; v < 8; v++) for (let u = 0; u < 8; u++) { let s = 0; for (let y = 0; y < N; y++) s += rows[y * 8 + u] * COS[v * N + y]; f[v * 8 + u] = s; }
    const ac = Array.from(f).slice(1).sort((a, b) => a - b);
    const median = (ac[31] + ac[32]) / 2; // 63 values: the middle one, averaged with its neighbour for stability
    let hi = 0, lo = 0;
    for (let k = 1; k < 64; k++) {
      if (f[k] > median) { if (k < 32) hi |= 1 << (31 - k); else lo |= 1 << (63 - k); }
    }
    return [hi >>> 0, lo >>> 0];
  }

  const phashRGBA = (rgba, w, h) => phashCells(grayCells(rgba, w, h));
  const toHex = ([hi, lo]) => hi.toString(16).padStart(8, "0") + lo.toString(16).padStart(8, "0");
  const fromHex = (s) => [parseInt(s.slice(0, 8), 16) >>> 0, parseInt(s.slice(8, 16), 16) >>> 0];
  function popcount(x) { x -= (x >>> 1) & 0x55555555; x = (x & 0x33333333) + ((x >>> 2) & 0x33333333); return (((x + (x >>> 4)) & 0x0f0f0f0f) * 0x01010101) >>> 24; }

  /** Loads scan/art.json: {v, ids:[passcode...], h:"hex hex hex..."} into typed arrays. */
  function buildArtIndex(json) {
    const ids = json.ids, n = ids.length, hi = new Uint32Array(n), lo = new Uint32Array(n);
    const h = json.h;
    for (let i = 0; i < n; i++) { hi[i] = parseInt(h.substr(i * 16, 8), 16) >>> 0; lo[i] = parseInt(h.substr(i * 16 + 8, 8), 16) >>> 0; }
    return { ids, hi, lo, n };
  }

  /**
   * Best artwork matches for one or more query hashes (e.g. several crops of the same photo).
   * Returns [{id, d}] sorted by distance, one entry per passcode.
   */
  function nearest(index, queries, limit = 8) {
    const best = new Map();
    for (const [qh, ql] of queries) {
      for (let i = 0; i < index.n; i++) {
        const d = popcount((index.hi[i] ^ qh) >>> 0) + popcount((index.lo[i] ^ ql) >>> 0);
        if (d <= 24) { const id = index.ids[i], prev = best.get(id); if (prev === undefined || d < prev) best.set(id, d); }
      }
    }
    return [...best.entries()].map(([id, d]) => ({ id, d })).sort((a, b) => a.d - b.d).slice(0, limit);
  }

  /** Is the top match clearly the card? Close in absolute terms and well ahead of the next card. */
  function confident(matches, sameCard = (a, b) => a === b) {
    if (!matches.length) return false;
    const [a] = matches, b = matches.find((m) => !sameCard(m.id, a.id));
    const gap = b ? b.d - a.d : 64;
    // Tuned on real card images made to look like phone photos (tests/scan/art-accuracy.mjs):
    // wrong top matches there had distance 10-14 with a gap of 0-2.
    return (a.d <= 6 && gap >= 2) || (a.d <= 10 && gap >= 4) || (a.d <= 14 && gap >= 8);
  }

  // Where the artwork sits on a card (fractions of the card's width/height): normal and Pendulum frames.
  const ART_CROPS = [{ x: 0.119, y: 0.181, w: 0.762, h: 0.523 }, { x: 0.066, y: 0.181, w: 0.868, h: 0.44 }];
  const SHIFTS = [-0.02, 0, 0.02];

  /**
   * Hashes of a card photo's artwork (browser only). The card is the whole canvas; framing is never
   * exact, so it hashes slightly shifted and zoomed crops and keeps the best match of any of them.
   */
  function queriesFromCard(card, { quick = false, rect = null } = {}) {
    const c = document.createElement("canvas"); c.width = c.height = 128;
    const x = c.getContext("2d", { willReadFrequently: true });
    x.imageSmoothingQuality = "high";
    const R = rect || { x: 0, y: 0, w: card.width, h: card.height }, out = [];
    for (const crop of ART_CROPS) {
      for (const dx of quick ? [0] : SHIFTS) for (const dy of quick ? [0] : SHIFTS) for (const s of quick ? [1] : [1, 0.95]) {
        const w = crop.w * s, h = crop.h * s, cx = crop.x + crop.w / 2 + dx, cy = crop.y + crop.h / 2 + dy;
        x.drawImage(card, R.x + (cx - w / 2) * R.w, R.y + (cy - h / 2) * R.h, w * R.w, h * R.h, 0, 0, 128, 128);
        out.push(phashRGBA(x.getImageData(0, 0, 128, 128).data, 128, 128));
      }
    }
    return out;
  }

  const api = { N, grayCells, phashCells, phashRGBA, toHex, fromHex, popcount, buildArtIndex, nearest, confident, queriesFromCard, ART_CROPS };
  if (typeof module === "object" && module.exports) module.exports = api;
  else root.KodexArt = api;
})(typeof self !== "undefined" ? self : this);

</script>
<script>
(function(){
  "use strict";
  const TESSERACT="https://cdn.jsdelivr.net/npm/tesseract.js@5.1.1/dist/tesseract.min.js";
  const SCAN_DATA="https://kodex.meiocg.org/scan/cards.json";
  const ART_DATA="https://kodex.meiocg.org/scan/art.json";
  // The scanner's data also lives in the public repository: used when the site doesn't answer, and kept on the device.
  const RAW="https://raw.githubusercontent.com/castelnoleal/Duel-Synapse-KodeX/main/scan/";
  async function scanJson(url,alt){
    let cache=null,hit=null;try{cache=await caches.open("kx-scan");const c=await cache.match(url);if(c)hit=await c.json()}catch(e){}
    const net=async()=>{
      for(const u of [url,alt]){
        try{const r=await fetch(u,{cache:"no-cache"});if(!r.ok)continue;const copy=r.clone();const j=await r.json();if(j&&(Array.isArray(j)?j.length:Object.keys(j).length)){if(cache)try{await cache.put(url,copy)}catch(e){}return j}}catch(e){}
      }
      return null;
    };
    if(hit){net();return hit}   // saved copy now, refreshed in the background for next time
    const j=await net();if(j)return j;
    throw new Error("scan data unavailable");
  }
  const YGOPRO="https://db.ygoprodeck.com/api/v7/";
  const IMG=id=>`https://images.ygoprodeck.com/images/cards_small/${id}.jpg`;
  // Where each field sits on a card, as fractions of its width/height.
  const ZONES={name:{x:.04,y:.03,w:.82,h:.09},set:{x:.40,y:.695,w:.57,h:.06},pass:{x:.015,y:.925,w:.47,h:.065}};
  const h=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
  let index=null,indexFrom="",reader=null,artIndex=null,artLoading=null;
  /** Artwork fingerprints of every card (about 0.5 MB, cached by the app after the first download). */
  function getArt(){
    if(artIndex)return Promise.resolve(artIndex);
    if(!artLoading)artLoading=scanJson(ART_DATA,RAW+"art.json").then(j=>artIndex=KodexArt.buildArtIndex(j)).catch(()=>{artLoading=null;return null});
    return artLoading;
  }
  /** Looks a card up on YGOPRODeck when it isn't in the app's list yet (new or Japanese-only printings). */
  async function onlineLookup({passcode,setCode}){
    const tries=[];
    for(const m of String(passcode||"").replace(/[^0-9]+/g," ").matchAll(/\d{8}/g))tries.push(YGOPRO+"cardinfo.php?id="+Number(m[0]));
    for(const m of String(setCode||"").toUpperCase().matchAll(/([A-Z0-9]{2,5})-([A-Z]{0,2})(\d{3})/g))for(const reg of ["EN","",m[2]])tries.push(YGOPRO+"cardsetsinfo.php?setcode="+encodeURIComponent(m[1]+"-"+reg+m[3]));
    for(const u of [...new Set(tries)].slice(0,4)){
      try{const r=await fetch(u,{cache:"force-cache"});if(!r.ok)continue;const d=await r.json();const c=Array.isArray(d.data)?d.data[0]:d;
        if(c&&c.id&&c.name)return {id:Number(c.id),name:c.name}}catch(e){}
    }
    return null;
  }


  // ---- Online lookup: the photo is read by a vision model on the KodeX server, then the card is pulled by what it read ----
  const LENS="https://kodex.meiocg.org/api/lens";
  const lens={off:false,retry:0,why:""};
  const lensUsable=()=>!lens.off&&Date.now()>=lens.retry&&navigator.onLine!==false;
  /** Sends one picture to the server. Null when it can't be reached (the offline scanner takes over). */
  async function lensAsk(cv){
    if(!lensUsable())return null;
    try{
      const blob=await new Promise(r=>cv.toBlob(r,"image/jpeg",.82));if(!blob)return null;
      const ctl=new AbortController(),t=setTimeout(()=>ctl.abort(),15000);
      const r=await fetch(LENS,{method:"POST",headers:{"Content-Type":"image/jpeg"},body:blob,signal:ctl.signal});clearTimeout(t);
      if(r.status===503){lens.off=true;lens.why="not_configured";return null}
      if(r.status===429){lens.retry=Date.now()+20000;lens.why="busy";return null}
      if(!r.ok){lens.retry=Date.now()+15000;lens.why="error "+r.status;return null}
      const j=await r.json();return j&&typeof j==="object"?j:null;
    }catch(e){lens.retry=Date.now()+10000;lens.why="offline";return null}
  }
  /** The card database answers by name: exact name first, then the closest names. */
  async function onlineName(name){
    const out={exact:false,list:[]};
    for(const [q,exact] of [["name",true],["fname",false]]){
      try{
        const ctl=new AbortController(),t=setTimeout(()=>ctl.abort(),7000);
        const r=await fetch(YGOPRO+"cardinfo.php?"+q+"="+encodeURIComponent(name),{signal:ctl.signal,cache:"force-cache"});clearTimeout(t);
        if(!r.ok)continue;const d=await r.json();const rows=Array.isArray(d.data)?d.data:[];
        if(rows.length){out.exact=exact&&rows.length===1;out.list=rows.slice(0,8).map(c=>({id:Number(c.id),name:c.name,atk:c.atk,def:c.def}));return out}
      }catch(e){}
    }
    return out;
  }
  const fin=v=>v!=null&&v!==""&&Number.isFinite(Number(v));
  /** Does the card's ATK/DEF agree with what the picture says? 1 yes, -1 no, 0 can't tell. */
  function statOf(c,L){
    const own=(typeof M!=="undefined"&&(M.get(String(c.id))||(index.byId.get(c.id)&&M.get(String(index.byId.get(c.id).id)))))||c;
    let ok=0;
    if(fin(L.atk)&&fin(own.atk)){if(Number(own.atk)!==L.atk)return -1;ok=1}
    if(fin(L.def)&&fin(own.def)){if(Number(own.def)!==L.def)return -1;ok=1}
    return ok;
  }
  /**
   * What the server read -> a card. The model's name is never taken on trust: it has to be a real card name,
   * and the passcode, set code and ATK/DEF it read must not disagree with the card it points to.
   */
  async function lensResolve(L){
    if(!L||L.card===false)return {state:"none"};
    await getIndex();
    const name=L.name||"",card=c=>index.byId.get(c.id)||c;
    const r=KodexMatch.identify(index,{name,setCode:L.setCode||"",passcode:L.passcode||""});
    if(r.card&&r.sure){
      const s=statOf(r.card,L);
      if(r.via==="passcode"||r.via==="set"||s>=0)return {state:"sure",card:r.card,cands:r.candidates,weak:r.via==="name"&&s===0};
    }
    // A real card the app's list doesn't have yet (new or Japanese-only): ask the database for that exact name.
    if(name){
      const on=await onlineName(name);
      if(on.exact&&statOf(on.list[0],L)>=0){const c=card(on.list[0]);return {state:"sure",card:c,cands:[{card:c,score:1}],weak:statOf(on.list[0],L)===0}}
      const list=on.list.filter(c=>statOf(c,L)>=0).map(c=>({card:card(c),score:KodexMatch.nameSimilarity(KodexMatch.normName(name),KodexMatch.normName(c.name))})).filter(x=>x.score>=.5).sort((a,b)=>b.score-a.score);
      r.candidates=[...(r.candidates||[]),...list].filter((x,i,a)=>a.findIndex(y=>y.card.id===x.card.id)===i);
    }
    // Cards whose printed ATK and DEF match, ranked by how close their name is.
    let list=(r.candidates||[]).filter(x=>x.score>=.5&&statOf(x.card,L)>=0);
    const withStats=list.filter(x=>statOf(x.card,L)===1);
    if(withStats.length===1&&withStats[0].score>=.6)return {state:"sure",card:withStats[0].card,cands:list};
    return list.length?{state:"pick",list:list.slice(0,6)}:{state:"unread",L};
  }
  /** A downscaled copy of any picture, for sending. */
  function scaled(src,w,hh,max){const k=Math.min(1,max/Math.max(w,hh)),c=document.createElement("canvas");c.width=Math.round(w*k);c.height=Math.round(hh*k);c.getContext("2d").drawImage(src,0,0,c.width,c.height);return c}

  async function getIndex(){
    if(index)return index;
    try{index=KodexMatch.buildIndex(await scanJson(SCAN_DATA,RAW+"cards.json"));indexFrom="kodex";}
    catch(e){ // offline: use the cards the app already has (no set codes)
      if(typeof M==="undefined"||!M.size)throw new Error("Cards are still loading. Try again in a moment.");
      index=KodexMatch.buildIndex([...M.values()].map(c=>[Number(c.id),c.name,[],[]]));indexFrom="app";
    }
    return index;
  }
  function loadScript(src){return new Promise((res,rej)=>{const s=document.createElement("script");s.src=src;s.async=true;s.onload=res;s.onerror=()=>rej(new Error("Card reading needs an internet connection the first time."));document.head.appendChild(s)})}
  async function getReader(){
    if(reader)return reader;
    if(window.KodexScanOCR)return reader=window.KodexScanOCR; // tests supply a stand-in
    if(!window.Tesseract)await loadScript(TESSERACT);
    reader=await Tesseract.createWorker("eng",1,{logger:()=>{}});
    return reader;
  }

  /** Crops a field, enlarges it and makes it dark text on light. Null when there's no printed text. */
  function zone(card,z,targetH){
    const sx=card.width*z.x,sy=card.height*z.y,sw=card.width*z.w,sh=card.height*z.h,k=Math.max(1,targetH/sh);
    const c=document.createElement("canvas");c.width=Math.round(sw*k);c.height=Math.round(sh*k);
    const x=c.getContext("2d",{willReadFrequently:true});x.imageSmoothingQuality="high";x.drawImage(card,sx,sy,sw,sh,0,0,c.width,c.height);
    const d=x.getImageData(0,0,c.width,c.height),p=d.data;let sum=0,mn=255,mx=0;
    for(let i=0;i<p.length;i+=4){const l=.299*p[i]+.587*p[i+1]+.114*p[i+2];p[i]=l;sum+=l;if(l<mn)mn=l;if(l>mx)mx=l}
    if(mx-mn<48)return null;
    const inv=sum/(p.length/4)<120,sp=Math.max(1,mx-mn);
    for(let i=0;i<p.length;i+=4){let l=(p[i]-mn)/sp*255;if(inv)l=255-l;p[i]=p[i+1]=p[i+2]=l}
    x.putImageData(d,0,0);return c;
  }
  async function readCard(card,{passOnly=false}={}){
    const w=await getReader(),out={};
    for(const [k,params,th] of [["pass",{tessedit_char_whitelist:"0123456789",tessedit_pageseg_mode:"7"},70],["name",{tessedit_char_whitelist:"",tessedit_pageseg_mode:"7"},90],["set",{tessedit_char_whitelist:"ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-",tessedit_pageseg_mode:"7"},70]]){
      const img=zone(card,ZONES[k],th);if(!img){out[k]="";continue}
      await w.setParameters(params);const r=await w.recognize(img);
      out[k]=String((r&&r.data&&r.data.text)||"").replace(/\s+/g," ").trim();
      if(k==="pass"&&(passOnly||KodexMatch.findPasscodes(index,out.pass).length))break;
    }
    return {name:out.name||"",setCode:out.set||"",passcode:out.pass||""};
  }
  /** Other ways the card might sit in a photo: zoomed in and nudged around, as small copies. */
  function photoFramings(img){
    const out=[];
    for(const z of [.9,.8,.7,.6])for(const dx of [-.12,0,.12])for(const dy of [-.08,0,.08])out.push(photoCard(img,z,dx*(1-z)*4,dy*(1-z)*4,300));
    return out;
  }
  function photoCard(img,zoom=1,dx=0,dy=0,maxW=1100){
    const ratio=59/86;let w=img.naturalWidth,hh=img.naturalHeight,sx=0,sy=0;
    if(w/hh>ratio){const nw=hh*ratio;sx=(w-nw)/2;w=nw}else{const nh=w/ratio;sy=(hh-nh)/2;hh=nh}
    sx+=w*(1-zoom)/2+dx*w;sy+=hh*(1-zoom)/2+dy*hh;w*=zoom;hh*=zoom;
    const c=document.createElement("canvas");c.width=Math.round(Math.min(maxW,w));c.height=Math.round(c.width/ratio);
    c.getContext("2d").drawImage(img,sx,sy,w,hh,0,0,c.width,c.height);return c;
  }

  /** Opens the scanner as a full-screen pop-up (the back button closes it). */
  window.openScanner=async function(){
    const el=openModal(`<div class="scan" style="position:absolute;inset:0">
      <video id="scVideo" playsinline muted autoplay disablepictureinpicture poster="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"></video><canvas id="scPrev" hidden></canvas><img id="scStill" alt="" hidden><button class="btn p sstart" id="scStart" hidden>Tap to start the camera</button>
      <div class="sguide" id="scGuide"><i></i><i></i><i></i><i></i></div>
      <p class="sload" id="scLoad">Starting camera…</p>
      <div class="stop"><button class="sib" data-close aria-label="Close scanner">${ic("back")}</button><b>Scan a card</b><button class="sib" id="scTorch" aria-label="Flashlight" aria-pressed="false" hidden><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 2h10l-2 6v12a2 2 0 0 1-2 2h-2a2 2 0 0 1-2-2V8z"/><path d="M12 12v3"/></svg></button></div>
      <p class="shint" id="scHint" aria-live="polite">Fit the whole card inside the frame<small>Hold it flat, in good light, without glare</small></p>
      <div class="sbar"><div class="sside"><label class="sib" for="scPhoto">Photo</label><input type="file" id="scPhoto" accept="image/*" hidden></div><button class="shut" id="scShut" aria-label="Scan now"><b></b></button><div class="sside"><button class="sib" id="scAuto" aria-pressed="true">Auto</button></div></div>
      <section class="ssheet" id="scSheet" aria-live="polite"><h3 id="scT"></h3><p class="ssub" id="scS"></p><div id="scB"></div><div class="sacts" id="scA"></div></section>
      <div class="smsg" id="scMsg"><div><h3 id="scMT"></h3><p id="scMB"></p><div class="sacts" id="scMA"></div></div></div>
    </div>`,"scan","scan");
    el.classList.add("scanm");
    const $s=id=>el.querySelector("#"+id);
    let stream=null,track=null,auto=true,busy=false,attempts=0,best=null,closed=false;
    /** Turns the camera off (the scanner stays open, e.g. while a photo is searched). */
    const camOff=()=>{if(stream)stream.getTracks().forEach(t=>t.stop());stream=track=null;capture=null};
    const stop=()=>{closed=true;camOff()};
    // Stop the camera as soon as the pop-up goes away (back button, close, or opening a card).
    new MutationObserver((m,o)=>{if(!document.body.contains(el)){stop();o.disconnect()}}).observe(document.body,{childList:true});
    const msg=(t,b,acts)=>{$s("scMT").textContent=t;$s("scMB").textContent=b;$s("scMA").innerHTML="";for(const [label,fn,pri] of acts){const x=document.createElement("button");x.className="btn"+(pri?" p":"");x.textContent=label;x.onclick=fn;$s("scMA").appendChild(x)}$s("scMsg").classList.add("on")};
    const sheet=(t,s,body,acts)=>{$s("scT").textContent=t;$s("scS").textContent=s;$s("scB").innerHTML=body;$s("scA").innerHTML="";for(const [label,fn,pri] of acts){const x=document.createElement("button");x.className="btn"+(pri?" p":"");x.textContent=label;x.onclick=fn;$s("scA").appendChild(x)}$s("scSheet").classList.add("on")};
    const again=()=>{$s("scSheet").classList.remove("on");attempts=0;best=null;lastTop=null;lastText=null;since=Date.now();lensPrev=null;unsure=0;lensCount=0;sentSig=null;
      if(!$s("scStill").hidden){$s("scStill").hidden=true;$s("scStill").removeAttribute("src");$s("scHint").innerHTML="Fit the whole card inside the frame<small>Hold it flat, in good light, without glare</small>"}
      if(!stream)startCamera();else if(auto)loop()};
    const openIt=card=>{stop();const own=M.get(String(card.id))||(index.byId.get(card.id)&&M.get(String(index.byId.get(card.id).id)));if(own)openCard(own.id);else{history.back();q.value=card.name;q.dispatchEvent(new Event("input",{bubbles:true}));toast(card.name+" isn't in KodeX yet. Showing a search instead.")}};

    function found(r){
      const c=r.card;try{navigator.vibrate&&navigator.vibrate(40)}catch(e){}
      sheet("Card found",{passcode:"Matched by passcode",set:"Matched by set code",name:"Matched by name",art:"Matched by artwork",online:"Found online by its code",lens:"Read online"}[r.via]||"",`<div class="shit"><img src="${h(IMG(c.id))}" alt="" onerror="this.style.visibility='hidden'"><div><b>${h(c.name)}</b><small>Passcode ${h(String(c.id).padStart(8,"0"))}</small>${r.candidates.length>1?'<br><button class="snot" id="scNot">Not this card?</button>':""}</div></div>`,[["Open card",()=>openIt(c),true],["Scan another",again],...(!$s("scStill").hidden?[["Another photo",()=>$s("scPhoto").click()]]:[])]);
      const n=$s("scNot");if(n)n.onclick=()=>choose({candidates:r.candidates.filter(x=>x.card!==c)});
    }
    function choose(r,fromPhoto){
      const list=(r.candidates||[]).slice(0,6);
      if(!list.length){if(fromPhoto)$s("scHint").innerHTML=artIndex?"No card recognised in that photo<small>Use a sharp, straight photo of the whole card</small>":"Card data couldn't be loaded<small>Check your connection and try again</small>";return}
      sheet("Which card is it?","The card wasn't clear enough to be sure. Pick it below, or scan again.",`<div class="scands">${list.map((x,i)=>`<button class="scand" data-i="${i}"><img src="${h(IMG(x.card.id))}" alt="" loading="lazy" onerror="this.style.visibility='hidden'"><span>${h(x.card.name)}<small>${Math.round(x.score*100)}% match</small></span></button>`).join("")}</div>`,[["Scan again",again]]);
      $s("scB").querySelectorAll(".scand").forEach(b=>b.onclick=()=>openIt(list[+b.dataset.i].card));
    }
    const sameCard=(a,b)=>{const x=index.byId.get(a),y=index.byId.get(b);return x&&y?x===y:a===b};
    /** Picture match: the card whose artwork is closest, if it's clearly that card. */
    function byArt(card){
      if(!artIndex)return {sure:false,list:[]};
      artFrames++;
      let m=KodexArt.nearest(artIndex,KodexArt.queriesFromCard(card,{quick:true}),10);
      if(!KodexArt.confident(m,sameCard)&&(artFrames%2===0||(m[0]&&m[0].d<=22)))m=KodexArt.nearest(artIndex,KodexArt.queriesFromCard(card),10);
      const list=[];
      for(const x of m){const c=index.byId.get(x.id);if(c&&!list.some(y=>y.card===c))list.push({card:c,score:Math.max(0,1-x.d/32),d:x.d})}
      const top=list[0],next=list[1],gap=top&&next?next.d-top.d:64;
      // Live camera: the same card on top in two frames in a row is enough.
      let agree=false;
      if(top&&top.d<=12&&gap>=2){agree=lastTop===top.card;lastTop=top.card}else lastTop=null;
      return {sure:(KodexArt.confident(m,sameCard)||agree)&&!!top,list};
    }
    let lastTop=null,artFrames=0,lastWide=null,lastBox=null;
    /** The visible camera picture as a canvas (the whole screen area, not just the frame). */
    async function grabVisible(maxW){
      const f=await frame();if(!f)return null;
      const v=$s("scVideo"),r=v.getBoundingClientRect(),k=Math.max(r.width/f.w,r.height/f.h),ox=(r.width-f.w*k)/2,oy=(r.height-f.h*k)/2;
      const sx=-ox/k,sy=-oy/k,sw=r.width/k,sh=r.height/k,c=document.createElement("canvas");
      c.width=Math.round(Math.min(maxW,sw));c.height=Math.round(c.width*sh/sw);
      c.getContext("2d").drawImage(f.src,sx,sy,sw,sh,0,0,c.width,c.height);if(f.src.close)f.src.close();
      const g=$s("scGuide").getBoundingClientRect(),q=c.width/r.width;
      return {c,g:{x:(g.left-r.left)*q,y:(g.top-r.top)*q,w:g.width*q,h:g.height*q}};
    }
    /** Finds the card even when it isn't lined up with the frame: tries it at several sizes and positions around the frame. */
    function wideArt(w){
      const {c,g}=w,gx=g.x+g.w/2,gy=g.y+g.h/2,qs=[],rects=[];
      for(const s of [.92,1,1.08])for(const ix of [-3,-2,-1,0,1,2,3])for(const iy of [-3,-2,-1,0,1,2,3]){
        const ch=g.h*s,cw=ch*59/86,rect={x:gx+ix*cw*.02-cw/2,y:gy+iy*ch*.02-ch/2,w:cw,h:ch};
        rects.push(rect);qs.push(...KodexArt.queriesFromCard(c,{quick:true,rect}));
      }
      const m=KodexArt.nearest(artIndex,qs,10),list=[];
      for(const x of m){const cd=index.byId.get(x.id);if(cd&&!list.some(y=>y.card===cd))list.push({card:cd,score:Math.max(0,1-x.d/32),d:x.d})}
      const top=list[0],next=list[1],gap=top&&next?next.d-top.d:64;
      const strict=!!top&&((top.d<=6&&gap>=3)||(top.d<=8&&gap>=4));
      let agree=false;
      if(top&&top.d<=10&&gap>=3){agree=lastWide===top.card;lastWide=top.card}else lastWide=null;
      if(top&&(strict||agree)){ // where the card is, for reading its text
        const i=artIndex.ids.indexOf(m[0].id);let bd=99,bk=null;
        if(i>=0)rects.forEach((rc,k)=>{for(const [qh,ql] of [qs[2*k],qs[2*k+1]]){const d=KodexArt.popcount((artIndex.hi[i]^qh)>>>0)+KodexArt.popcount((artIndex.lo[i]^ql)>>>0);if(d<bd){bd=d;bk=rc}}});
        lastBox=bk?{box:bk,cw:c.width}:null;
      }
      return {sure:strict||agree,list};
    }
    /** The card's own picture, cut out of a sharp camera frame using the position found by wideArt. */
    async function grabLocated(){
      if(!lastBox)return null;const v=await grabVisible(1400);if(!v)return null;
      const k=v.c.width/lastBox.cw,b=lastBox.box,out=document.createElement("canvas");
      out.width=Math.round(Math.min(1100,b.w*k));out.height=Math.round(out.width*86/59);
      out.getContext("2d").drawImage(v.c,b.x*k,b.y*k,b.w*k,b.h*k,0,0,out.width,out.height);return out;
    }
    let textBusy=false,since=Date.now(),lastText=null;
    /** Reads the card's text in the background (the reader runs in its own thread). */
    function readText(card,fromPhoto){
      if(textBusy||closed)return null;textBusy=true;
      const job=(async()=>{
        try{
          const t=await readCard(card,{passOnly:!fromPhoto&&!lastText});if(closed)return null;
          lastText=t;
          const r=KodexMatch.identify(index,t);
          if(r.sure)return r;
          const art=lastArt||{list:[]};
          const both=art.list.find(a=>a.d<=16&&r.candidates.some(c=>c.card===a.card&&c.score>=0.5));
          if(both)return {card:both.card,via:"art",candidates:[both,...art.list.filter(a=>a!==both)]};
          if(t.passcode||t.setCode){const on=await onlineLookup(t);if(on){const c=index.byId.get(on.id)||{id:on.id,name:on.name};return {card:c,via:"online",candidates:[{card:c,score:1}]}}}
          const cands=[...art.list.filter(a=>a.d<=14),...r.candidates].filter((x,i,a)=>a.findIndex(y=>y.card===x.card)===i);
          if(cands.length)best={candidates:cands};
          return {card:null,candidates:cands,text:t};
        }catch(e){return {card:null,candidates:[],error:e}}
        finally{textBusy=false}
      })();
      return job;
    }
    let lastArt=null;
    async function scanOnce(card,fromPhoto,alts){
      if(busy||!card||closed)return;busy=true;$s("scShut").classList.add("busy");$s("scGuide").classList.add("reading");
      try{
        attempts++;
        if(fromPhoto)await Promise.race([getArt(),new Promise(r=>setTimeout(r,8000))]);
        let art=null;
        // Live camera: look for the card in and around the frame (never trust one crop on its own).
        if(!fromPhoto&&artIndex){const w=await grabVisible(400);if(w)art=wideArt(w)}
        if(!art)art=byArt(card);
        // A photo is rarely framed exactly on the card: also try it zoomed in, and keep the closest match.
        if(fromPhoto&&!art.sure&&alts)for(const a of alts){const x=byArt(a),t0=x.list[0],t1=x.list[1];x.sure=x.sure&&!!t0&&t0.d<=5&&(!t1||t1.d-t0.d>=4);if(x.sure||(t0&&(!art.list[0]||t0.d<art.list[0].d)))art=x;if(x.sure)break}
        lastArt=art;
        if(art.sure)return found({card:art.list[0].card,via:"art",candidates:art.list});
        if(fromPhoto){
          // A photo: read its text now (bigger image), then decide.
          const r=await readText(card,true);if(closed)return;
          if(r&&r.card)return found(r);
          return choose(best||{candidates:(r&&r.candidates)||art.list.filter(a=>a.d<=10)},true);
        }
        const near=art.list.filter(a=>a.d<=9);if(near.length)best={candidates:near};
        // Live camera: start reading text after a moment without a picture match, without waiting for it.
        if(!textBusy&&(!artIndex||Date.now()-since>1500)){
          const big=(await grabLocated())||await grab(1100);
          const job=big&&readText(big,false);
          if(job)job.then(r=>{if(!r||closed||$s("scSheet").classList.contains("on"))return;if(r.card)found(r);else if(attempts>=24&&best)choose(best);else hint(lastArt||art,null,r.text)});
        }
        if(attempts>=40&&best)return choose(best);
        hint(art);
      }catch(e){if(!closed)msg("Card reader unavailable",e.message||String(e),[["Close",()=>history.back(),true]]);stop()}
      finally{busy=false;if(!closed){$s("scShut").classList.remove("busy");$s("scGuide").classList.remove("reading")}}
    }

    // ---- Online scanning: send a steady frame, get the card's name back, pull the card by it ----
    let prevSig=null,sentSig=null,sentAt=0,lensCount=0,lensPrev=null,unsure=0;
    const sig=cv=>{const s=document.createElement("canvas");s.width=s.height=24;const x=s.getContext("2d",{willReadFrequently:true});x.drawImage(cv,0,0,24,24);const d=x.getImageData(0,0,24,24).data,o=new Uint8Array(576);for(let i=0;i<576;i++)o[i]=(d[i*4]+d[i*4+1]+d[i*4+2])/3;return o};
    const moved=(a,b)=>{if(!a||!b)return 99;let s=0;for(let i=0;i<576;i++)s+=Math.abs(a[i]-b[i]);return s/576};
    /** The camera picture around the frame, with some room for a card that isn't lined up. */
    async function lensFrame(){
      const v=await grabVisible(1400);if(!v)return null;
      const {c,g}=v,mx=g.w*.18,my=g.h*.12,x=Math.max(0,g.x-mx),y=Math.max(0,g.y-my),w=Math.min(c.width-x,g.w+2*mx),hh=Math.min(c.height-y,g.h+2*my);
      const k=Math.min(1,1000/Math.max(w,hh)),o=document.createElement("canvas");o.width=Math.round(w*k);o.height=Math.round(hh*k);
      o.getContext("2d").drawImage(c,x,y,w,hh,0,0,o.width,o.height);return o;
    }
    const lensBusy=on=>{$s("scShut").classList.toggle("busy",on);$s("scGuide").classList.toggle("reading",on)};
    /** Reports the result of an online read. */
    function lensShow(R,L,fromPhoto){
      if(closed)return;
      if(R.state==="sure"){
        if(R.weak&&!fromPhoto&&lensPrev!==R.card){lensPrev=R.card;$s("scHint").innerHTML=`Hold steady…<small>Looks like ${h(R.card.name)}</small>`;return}
        return found({card:R.card,via:"lens",candidates:R.cands&&R.cands.length?R.cands:[{card:R.card,score:1}]});
      }
      lensPrev=null;
      if(R.state==="pick"){
        if(fromPhoto||++unsure>=3){unsure=0;return choose({candidates:R.list},true)}
        $s("scHint").innerHTML=`Hold steady…<small>Looks like ${h(R.list[0].card.name)}</small>`;return;
      }
      $s("scHint").innerHTML=R.state==="none"?(fromPhoto?"No card in that photo<small>Use a photo of the whole card</small>":"Fit the whole card inside the frame<small>Hold it flat, in good light, without glare</small>"):(fromPhoto?"Couldn't read that card<small>Use a sharper, closer photo</small>":"Move closer<small>The card's text needs to be readable</small>");
    }
    /** One online read of the live camera. False when the server can't be reached (the offline scanner takes over). */
    async function lensLive(force){
      if(!lensUsable())return false;
      if(busy||closed)return true;
      const cv=await lensFrame();if(!cv||closed)return true;
      const s=sig(cv),m=moved(prevSig,s);prevSig=s;
      if(!force){
        if(Date.now()-sentAt<700)return true;
        if(m>7&&Date.now()-sentAt<3000)return true;                       // still moving
        if(!lensPrev&&!unsure&&moved(sentSig,s)<2.5&&Date.now()-sentAt<6000)return true;      // nothing new to ask about (a half-sure read is checked again at once)
        if(lensCount>=14)return true;                                       // auto reads are capped; the shutter always works
      }
      busy=true;lensBusy(true);$s("scHint").innerHTML="Searching online…<small>Hold the card steady</small>";
      try{
        sentSig=s;sentAt=Date.now();lensCount++;
        const L=await lensAsk(cv);if(closed)return true;
        if(!L)return false;
        lensShow(await lensResolve(L),L,false);return true;
      }finally{busy=false;if(!closed)lensBusy(false)}
    }
    /** One online read of a gallery photo (the whole picture, not just the middle). */
    async function lensPhoto(img){
      if(!lensUsable())return false;
      busy=true;lensBusy(true);$s("scHint").innerHTML="Searching online…<small>Reading the card</small>";
      try{
        const L=await lensAsk(scaled(img,img.naturalWidth,img.naturalHeight,1280));if(closed)return true;
        if(!L)return false;
        lensShow(await lensResolve(L),L,true);return true;
      }finally{busy=false;if(!closed)lensBusy(false)}
    }
    function hint(art,r,t){
      const guess=(art.list[0]&&art.list[0].d<=8&&art.list[0].card)||(r&&r.card);
      $s("scHint").innerHTML=guess?`Hold steady…<small>Looks like ${h(guess.name)}</small>`:(t&&(t.name||t.passcode)?"Still reading…<small>Move closer so the card fills the frame</small>":"Fit the whole card inside the frame<small>Hold it flat, in good light, without glare</small>");
    }
    let capture=null,previewing=false;
    const videoOk=()=>{const v=$s("scVideo");return v.readyState>=2&&v.videoWidth>0&&!v.paused};
    /** A camera frame: from the video when it plays, otherwise grabbed straight from the camera. */
    async function frame(){
      const v=$s("scVideo");
      if(videoOk())return {src:v,w:v.videoWidth,h:v.videoHeight};
      if(capture){try{const b=await capture.grabFrame();return {src:b,w:b.width,h:b.height}}catch(e){}}
      return null;
    }
    // Some Android WebViews give the camera to the page but never start the <video>: show the frames on a canvas instead.
    async function preview(){
      if(previewing)return;previewing=true;const c=$s("scPrev"),x=c.getContext("2d");c.hidden=false;$s("scVideo").style.visibility="hidden";
      while(!closed&&stream&&!videoOk()){
        const f=await frame();
        if(f){const r=c.getBoundingClientRect();if(c.width!==Math.round(r.width)){c.width=Math.round(r.width);c.height=Math.round(r.height)}const k=Math.max(c.width/f.w,c.height/f.h);x.drawImage(f.src,(c.width-f.w*k)/2,(c.height-f.h*k)/2,f.w*k,f.h*k);if(f.src.close)f.src.close()}
        await new Promise(r=>setTimeout(r,120));
      }
      c.hidden=true;$s("scVideo").style.visibility="";previewing=false;
    }
    async function grab(maxW=480){
      const f=await frame();if(!f)return null;
      const v=$s("scVideo"),g=$s("scGuide").getBoundingClientRect(),r=v.getBoundingClientRect(),vw=f.w,vh=f.h;
      const k=Math.max(r.width/vw,r.height/vh),ox=(r.width-vw*k)/2,oy=(r.height-vh*k)/2;
      const sx=(g.left-r.left-ox)/k,sy=(g.top-r.top-oy)/k,sw=g.width/k,sh=g.height/k;
      const c=document.createElement("canvas");c.width=Math.round(Math.min(maxW,sw));c.height=Math.round(c.width*86/59);
      c.getContext("2d").drawImage(f.src,sx,sy,sw,sh,0,0,c.width,c.height);if(f.src.close)f.src.close();return c;
    }
    let looping=false;
    async function loop(){if(looping)return;looping=true;try{while(auto&&!closed&&stream&&!$s("scSheet").classList.contains("on")){if(document.visibilityState==="visible"){if(!(lensUsable()&&await lensLive()))await scanOnce(await grab())}await new Promise(r=>setTimeout(r,lensUsable()?280:artIndex?60:350))}}finally{looping=false}}
    $s("scShut").onclick=async()=>{if(!stream)return;if(!(lensUsable()&&await lensLive(true)))scanOnce(await grab())};
    $s("scStart").onclick=async()=>{try{await $s("scVideo").play()}catch(e){}$s("scStart").hidden=true;if(!videoOk())preview()};
    $s("scAuto").onclick=()=>{auto=!auto;$s("scAuto").setAttribute("aria-pressed",String(auto));if(auto)loop()};
    $s("scTorch").onclick=async()=>{const on=$s("scTorch").getAttribute("aria-pressed")!=="true";try{await track.applyConstraints({advanced:[{torch:on}]});$s("scTorch").setAttribute("aria-pressed",String(on))}catch(e){}};
    $s("scPhoto").onchange=e=>{const f=e.target.files&&e.target.files[0];e.target.value="";if(!f)return;
      camOff();$s("scPrev").hidden=true;$s("scStart").hidden=true;$s("scSheet").classList.remove("on");
      const still=$s("scStill"),url=URL.createObjectURL(f);still.src=url;still.hidden=false;$s("scGuide").style.visibility="hidden";
      $s("scHint").innerHTML="Searching this photo…<small>The camera is off</small>";
      const img=new Image();img.onload=async()=>{attempts=0;best=null;lastTop=null;if(!(await lensPhoto(img)))await scanOnce(photoCard(img),true,photoFramings(img));$s("scGuide").style.visibility=""};img.onerror=()=>{$s("scHint").innerHTML="That photo couldn't be opened<small>Try another photo</small>";$s("scGuide").style.visibility=""};img.src=url};

    getArt();
    try{await getIndex()}catch(e){msg("Scanner unavailable",e.message,[["Close",()=>history.back(),true]]);return}
    getArt().then(a=>{if(!a&&!closed)getReader().catch(()=>{})});
    async function startCamera(){
      $s("scLoad").hidden=false;$s("scLoad").textContent="Starting camera…";
      try{
        if(!navigator.mediaDevices||!navigator.mediaDevices.getUserMedia)throw Object.assign(new Error("no camera"),{name:"NotFoundError"});
        stream=await navigator.mediaDevices.getUserMedia({audio:false,video:{facingMode:{ideal:"environment"},width:{ideal:1920},height:{ideal:1080}}});
        if(closed){stop();return}
        const v=$s("scVideo");v.srcObject=stream;
        track=stream.getVideoTracks()[0];
        try{if("ImageCapture" in window)capture=new ImageCapture(track)}catch(e){}
        await Promise.race([v.play().catch(()=>{}),new Promise(r=>setTimeout(r,3000))]);
        for(let i=0;i<12&&!videoOk();i++)await new Promise(r=>setTimeout(r,250));
        if(!videoOk()){
          const f=capture?await frame():null;
          if(f){if(f.src.close)f.src.close();preview()}
          else if(track.readyState==="live")$s("scStart").hidden=false;
          else throw Object.assign(new Error("The camera stopped ("+track.readyState+")."),{name:"CameraStopped"});
        }
        try{const caps=track.getCapabilities?track.getCapabilities():{};if(caps.torch)$s("scTorch").hidden=false}catch(e){}
        try{await track.applyConstraints({advanced:[{focusMode:"continuous"}]})}catch(e){}
        $s("scLoad").hidden=true;since=Date.now();loop();
      }catch(e){
        $s("scLoad").hidden=true;
        const denied=e&&(e.name==="NotAllowedError"||e.name==="SecurityError");
        if(e&&e.name==="CameraStopped"){msg("The camera didn't start",e.message+" Close other apps using the camera and try again, or scan a photo.",[["Choose a photo",()=>{$s("scMsg").classList.remove("on");$s("scPhoto").click()},true],["Close",()=>history.back()]]);return}
        msg(denied?"Camera access is off":"No camera available",denied?"Allow camera access for KodeX in your phone's settings (Apps → KodeX → Permissions), or scan a photo instead.":"You can still scan a photo of a card.",[["Choose a photo",()=>{$s("scMsg").classList.remove("on");$s("scPhoto").click()},true],["Close",()=>history.back()]]);
      }
    }
    startCamera();
  };
  const btn=document.getElementById("bScan");if(btn)btn.onclick=()=>{if(window.scanGate&&!window.scanGate())return;openScanner()};
})();
</script>

