<style id="kx-v55">.mv-t svg{width:40px;height:40px;display:block;overflow:visible}
.mv-rise{color:#b9c2ff}.mv-portal{color:#b08cff}.mv-storm{color:#9fd0ff}.mv-inferno{color:#ff8a3a}.mv-nova{color:#f0b429}.mv-glitch{color:#42f5d7}
.mv-lunge{color:#ff8a95}.mv-beam{color:#8d99ff}.mv-comet{color:#ffb347}.mv-claw{color:#ff6a7a}.mv-phantom{color:#c8b3ff}
.mv-t.on svg,.mv-t:hover svg{filter:drop-shadow(0 0 6px currentColor)}
.mv-t.on .beam{animation:kmvb 1.2s ease-in-out infinite}@keyframes kmvb{50%{opacity:.9}}
.mv-t.on .cd{animation:kmvr 1.2s cubic-bezier(.2,.9,.3,1) infinite}@keyframes kmvr{0%{transform:translateY(-10px);opacity:0}40%,100%{transform:none;opacity:1}}
.mv-t.on .spin{animation:kvx 1.6s linear infinite;transform-origin:24px 24px}
.mv-t.on .bolt{animation:kth 1.1s steps(1) infinite}
.mv-t.on .fl{animation:kfl .7s ease-in-out infinite alternate;transform-origin:24px 44px}@keyframes kfl{to{transform:scale(1.08,1.15)}}
.mv-t.on .gl{animation:kgl .9s steps(4) infinite}@keyframes kgl{25%{transform:translateX(3px)}50%{transform:translateX(-3px)}75%{transform:translateX(2px)}}
.mv-t.on .ar{animation:kar 1s ease-in-out infinite}@keyframes kar{50%{transform:translate(4px,-4px)}}
.mv-t.on .bm{animation:kbm 1s ease-in-out infinite;transform-origin:4px 24px}@keyframes kbm{0%{transform:scaleX(0)}50%,100%{transform:scaleX(1)}}
.mv-t.on .rock{animation:kmet 1.2s cubic-bezier(.5,0,1,1) infinite}
.mv-t.on .cl{stroke-dasharray:40;animation:ksl 1.2s ease-in-out infinite}
.mv-t.on .ph{animation:kph 1s ease-in-out infinite}@keyframes kph{50%{transform:translateX(4px)}}
@keyframes kvx{to{transform:rotate(360deg)}}@keyframes kth{0%,40%,60%{opacity:1}50%,70%{opacity:.25}}@keyframes kmet{0%{transform:translate(10px,-10px);opacity:0}30%{opacity:1}80%{transform:none;opacity:1}100%{opacity:0}}@keyframes ksl{0%{stroke-dashoffset:40}40%,80%{stroke-dashoffset:0}100%{stroke-dashoffset:-40}}
@media (prefers-reduced-motion:reduce){.mv-t svg,.mv-t svg *{animation:none!important}}
.em-row{display:flex;flex-wrap:wrap;gap:8px}.em-t{position:relative;width:64px;height:64px;border-radius:14px;background:rgba(0,0,0,.25);border:1px solid var(--line);display:grid;place-items:center;overflow:visible}
.em-t img{width:100%;height:100%;object-fit:contain;border-radius:13px}.em-t i{position:absolute;top:-6px;right:-6px;width:22px;height:22px;border-radius:50%;background:#e0566b;color:#fff;font-style:normal;display:grid;place-items:center;font-size:14px;cursor:pointer}
.em-add{cursor:pointer;color:var(--muted);font-size:26px;border-style:dashed}
.sig-chip select{max-width:110px}
.pm-f{display:grid;gap:12px}.pm-f label{display:grid;gap:6px}.pm-f label>span{font-size:.8rem;color:var(--muted);font-weight:600}.pm-f select,.pm-f input:not([type=checkbox]){min-height:44px;border-radius:12px;border:1px solid var(--line);background:rgba(0,0,0,.25);color:var(--text);padding:0 12px;font:inherit}
.pm-f .pm-c{display:flex;gap:10px;align-items:center}.pm-f .btn{min-height:46px;display:flex;gap:8px;align-items:center;justify-content:center}
.az{display:grid;gap:14px;padding-bottom:10px}
.az-hero{display:flex;gap:14px;align-items:center;padding:14px;border-radius:18px;background:linear-gradient(140deg,rgba(51,71,240,.28),rgba(122,79,214,.2) 60%,rgba(240,180,41,.14));border:1px solid rgba(141,153,255,.35)}
.az-rank{flex:none;width:78px;height:78px;border-radius:20px;display:grid;place-items:center;align-content:center;background:#0c0f1f;border:2px solid #8d99ff;box-shadow:0 0 22px rgba(51,71,240,.5)}
.az-rank b{font-size:2rem;line-height:1;font-weight:800;background:linear-gradient(180deg,#fff,#8d99ff);-webkit-background-clip:text;background-clip:text;color:transparent}.az-rank small{font-size:.7rem;color:var(--muted);margin-top:2px}
.az-rank.r-Sp,.az-rank.r-S{border-color:#f0b429;box-shadow:0 0 26px rgba(240,180,41,.55)}.az-rank.r-Sp b,.az-rank.r-S b{background-image:linear-gradient(180deg,#ffe9a8,#f0b429)}
.az-ht small{font-size:.68rem;letter-spacing:.14em;color:#f0b429;font-weight:700}.az-ht h4{margin:2px 0;font-size:1.15rem}.az-ht p{margin:0;color:var(--muted);font-size:.8rem}
.az-calc{display:flex;gap:10px;align-items:center;font-size:.85rem;color:var(--muted);padding:0 4px}.az-calc input{width:20px;height:20px}
.az-sec{padding:14px;border-radius:16px;background:rgba(255,255,255,.03);border:1px solid var(--line)}.az-sec h5{margin:0 0 10px;font-size:.78rem;letter-spacing:.12em;text-transform:uppercase;color:#f0b429}
.az-main{display:grid;gap:10px}.az-radar{width:100%;max-width:340px;margin:0 auto;display:block}.az-radar .az-poly{animation:azIn .8s cubic-bezier(.2,.9,.3,1) both;transform-origin:150px 140px}@keyframes azIn{from{transform:scale(.2);opacity:0}}
@media (min-width:720px){.az-main{grid-template-columns:320px 1fr;align-items:center}}
.az-bars{display:grid;gap:8px}.az-bar{display:grid;grid-template-columns:118px 1fr 34px;gap:8px;align-items:center;font-size:.85rem}.az-bar>i{height:8px;border-radius:4px;background:rgba(255,255,255,.08);overflow:hidden}.az-bar>i b{display:block;height:100%;border-radius:4px;background:linear-gradient(90deg,#3347f0,#7a4fd6,#f0b429);animation:azBar .9s cubic-bezier(.2,.9,.3,1) both}@keyframes azBar{from{width:0!important}}
.az-bar>em{font-style:normal;font-weight:800;text-align:right}
.az-why{display:none;grid-column:1/-1;margin:2px 0 4px;padding-left:16px;font-size:.75rem;color:var(--muted);line-height:1.45}.az.calc .az-why{display:block}.az-why li{margin:1px 0}
.az-stars{display:grid;gap:6px}@media (min-width:560px){.az-stars{grid-template-columns:1fr 1fr;column-gap:20px}}.az-sr{display:grid;grid-template-columns:1fr auto;align-items:center;font-size:.86rem}.az-st{color:#f0b429;letter-spacing:2px}.az-st i{font-style:normal;color:rgba(255,255,255,.14)}
.az-3{display:grid;gap:10px;padding:0;background:none;border:0}@media (min-width:560px){.az-3{grid-template-columns:repeat(3,1fr)}}
.az-box{padding:14px;border-radius:16px;background:rgba(255,255,255,.03);border:1px solid var(--line);display:grid;gap:6px;align-content:start}.az-big{font-size:1.25rem}.az-meter{height:6px;border-radius:3px;background:rgba(255,255,255,.08);overflow:hidden}.az-meter b{display:block;height:100%;background:linear-gradient(90deg,#38c9a6,#f0b429,#e0566b)}
.az-donut{width:120px;margin:0 auto}.az-box>small{font-size:.75rem;color:var(--muted);text-align:center}
.az-odds{display:grid;gap:8px}@media (min-width:560px){.az-odds{grid-template-columns:1fr 1fr;align-items:center}}.az-odds ul{margin:0;padding:0;list-style:none;display:grid;gap:6px;font-size:.86rem}.az-odds b{color:#f0b429}.az-curve{width:100%}
.az-chips{display:flex;flex-wrap:wrap;gap:6px}.az-chips span{padding:6px 12px;border-radius:999px;background:rgba(51,71,240,.18);border:1px solid rgba(141,153,255,.35);font-size:.82rem}
.az-best{display:flex;gap:12px;align-items:center;margin-bottom:10px}.az-best small{font-size:.68rem;letter-spacing:.14em;color:#f0b429;font-weight:700}.az-best b{display:block;font-size:1.05rem}.az-best p{margin:4px 0 0}
.az-kc h5{font-size:.72rem;color:var(--muted);margin:8px 0 6px}.az-kr{display:flex;gap:8px;overflow-x:auto;padding-bottom:4px}
.az-k{flex:none;width:76px;border:0;background:none;color:var(--text);padding:0;display:grid;gap:4px;text-align:center;cursor:pointer;font:inherit}.az-k img{width:76px;aspect-ratio:59/86;object-fit:cover;border-radius:6px;background:#1b2147;box-shadow:0 6px 16px rgba(0,0,0,.45)}.az-k span{font-size:.68rem;line-height:1.2;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.az-k.big{width:92px}.az-k.big img{width:92px;box-shadow:0 0 22px rgba(240,180,41,.45)}
.az-test{display:grid;gap:12px;align-items:center}@media (min-width:560px){.az-test{grid-template-columns:140px 1fr}}.az-tr{display:grid;justify-items:center;gap:4px}.az-ring{width:110px}.az-tr small{font-size:.75rem;color:var(--muted)}
.az-tg{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.az-tg>div{padding:8px;border-radius:12px;background:rgba(0,0,0,.2);text-align:center}.az-tg b{display:block;font-size:1.05rem}.az-tg small{font-size:.7rem;color:var(--muted)}
.az-2{display:grid;gap:10px;margin-top:10px}@media (min-width:560px){.az-2{grid-template-columns:1fr 1fr}}.az-2 h6{margin:0 0 4px;font-size:.78rem}.az-2 ol{margin:0;padding-left:18px;font-size:.82rem;display:grid;gap:3px}.az-2 em{font-style:normal;color:var(--muted);font-size:.75rem}
.az-foot{font-size:.72rem}
@media (prefers-reduced-motion:reduce){.az *{animation:none!important}}
</style>
<script id="kx-v55-poster">
/* ---------- deck image in the MEIOCG style: placement, event, player and the date ---------- */
const PLACES=[['','No placement'],['champ','Champion'],['top2','Top 2 · Finalist'],['top4','Top 4'],['top8','Top 8'],['top16','Top 16'],['top32','Top 32'],['top64','Top 64'],['play','Participant']];
const PLACE_COL={champ:['#f0b429','#ffe9a8'],top2:['#cfd6ea','#ffffff'],top4:['#e09a5a','#ffd2a8'],top8:['#8d99ff','#d6dbff'],top16:['#7a4fd6','#c8b3ff'],top32:['#38c9a6','#b5f2e2'],top64:['#67a8ff','#cfe4ff'],play:['#9aa4bd','#e6eaf5']};
function posterOptions(id){
 const p=S.g('poster_meta',{});const m=openModal(`<div class="dk-hd"><h3>Deck image</h3><button class="ibtn" data-close aria-label="Close">${ic('x')}</button></div><div class="pm-f"><label><span>Placement</span><select data-pm="place">${PLACES.map(([k,l])=>`<option value="${k}"${(p.place||'')===k?' selected':''}>${l}</option>`).join('')}</select></label><label><span>Event</span><input data-pm="event" maxlength="48" placeholder="e.g. Regional Qualifier" value="${esc(p.event||'')}"></label><label><span>Player</span><input data-pm="player" maxlength="32" placeholder="Your name" value="${esc(p.player||'')}"></label><label class="pm-c"><input type="checkbox" data-pm="types"${p.types===false?'':' checked'}><span>Show card-type counts</span></label><p class="note">The date the image is made is printed on it.</p><button class="btn p" data-pmgo>${ic('image',18)}Make image</button></div>`,'','pm');
 m.querySelector('[data-pmgo]').onclick=()=>{const o={};m.querySelectorAll('[data-pm]').forEach(x=>o[x.dataset.pm]=x.type==='checkbox'?x.checked:x.value.trim());S.s('poster_meta',o);closeModal();setTimeout(()=>exportDeckPoster(id,o),120)};
}
function buildDeckPosterSvg(d,W,H,bg,meta){
 meta=meta||{};const X=v=>String(v??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&apos;');
 const F="'Chakra Petch','Plus Jakarta Sans',Arial,sans-serif",sections=[['MAIN DECK',copies(d,'main')],['EXTRA DECK',copies(d,'extra')],['SIDE DECK',copies(d,'side')]].filter(([l,a],i)=>i<2||a.length);
 const cols=13,pad=40,gap=8,cw=Math.floor((W-pad*2-gap*(cols-1))/cols),ch=Math.round(cw*86/59),head=48,top=250;
 const kind=c=>{const t=String((resolveDeckCard(c)||{}).type||'').toLowerCase();return /spell/.test(t)?'S':/trap/.test(t)?'T':'M'};
 const date=new Date().toLocaleDateString(undefined,{year:'numeric',month:'long',day:'numeric'});
 const pc=PLACE_COL[meta.place],pl=(PLACES.find(x=>x[0]===meta.place)||['',''])[1];
 const o=[`<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="${W}" height="${H}" viewBox="0 0 ${W} ${H}">`,
 `<defs><linearGradient id="bg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#121a4a"/><stop offset=".55" stop-color="#0c0f1f"/><stop offset="1" stop-color="#1c1236"/></linearGradient>`+
 `<radialGradient id="b1" cx=".85" cy=".05" r=".55"><stop offset="0" stop-color="#3347f0" stop-opacity=".55"/><stop offset="1" stop-color="#3347f0" stop-opacity="0"/></radialGradient>`+
 `<radialGradient id="b2" cx=".05" cy=".9" r=".5"><stop offset="0" stop-color="#7a4fd6" stop-opacity=".45"/><stop offset="1" stop-color="#7a4fd6" stop-opacity="0"/></radialGradient>`+
 `<linearGradient id="gd" x1="0" x2="1"><stop offset="0" stop-color="#3347f0"/><stop offset=".55" stop-color="#7a4fd6"/><stop offset="1" stop-color="#f0b429"/></linearGradient>`+
 (pc?`<linearGradient id="pl" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="${pc[1]}"/><stop offset="1" stop-color="${pc[0]}"/></linearGradient>`:'')+
 `<pattern id="gr" width="58" height="84" patternUnits="userSpaceOnUse"><path d="M58 0H0V84" fill="none" stroke="#ffffff" stroke-opacity=".045"/></pattern><clipPath id="cc"><rect width="${cw}" height="${ch}" rx="5"/></clipPath></defs>`,
 `<rect width="100%" height="100%" fill="url(#bg)"/>`];
 if(bg)o.push(`<image href="${X(bg)}" xlink:href="${X(bg)}" x="0" y="0" width="${W}" height="${H}" preserveAspectRatio="xMidYMid slice" opacity=".35"/>`);
 o.push(`<rect width="100%" height="100%" fill="url(#b1)"/><rect width="100%" height="100%" fill="url(#b2)"/><rect width="100%" height="100%" fill="url(#gr)"/>`,
 `<rect x="14" y="14" width="${W-28}" height="${H-28}" rx="26" fill="none" stroke="url(#gd)" stroke-width="3"/>`,
 `<g font-family="${F}" fill="#fff"><text x="${pad}" y="66" font-size="18" font-weight="700" letter-spacing="5" fill="#f0b429">DUEL SYNAPSE · KODEX</text>`,
 `<text x="${pad}" y="122" font-size="48" font-weight="800">${X(String(d.name||'Deck').slice(0,30))}</text>`,
 `<text x="${pad}" y="160" font-size="19" fill="#c9d0f2">${[meta.player?X(meta.player):'',meta.event?X(meta.event):''].filter(Boolean).join('  ·  ')||X(deckTotal(d)+' cards')}</text>`,
 `<text x="${pad}" y="192" font-size="15" fill="#9aa4bd" letter-spacing="1">${X(date)}${meta.player||meta.event?'  ·  '+deckTotal(d)+' cards':''}</text></g>`,
 `<rect x="${pad}" y="208" width="${W-pad*2}" height="3" rx="1.5" fill="url(#gd)" opacity=".8"/>`);
 if(pc){const bx=W-pad-250;o.push(`<g transform="translate(${bx},40)"><rect width="250" height="150" rx="22" fill="#0c0f1f" fill-opacity=".72" stroke="url(#pl)" stroke-width="3"/>`+
  (meta.place==='champ'?`<path transform="translate(97,16) scale(1.15)" d="M8 0h32v8h8v8c0 9-6 15-14 16-2 5-6 8-10 9v7h10v6H14v-6h10v-7c-4-1-8-4-10-9C6 31 0 25 0 16V8h8zM6 13v3c0 5 3 9 8 10-2-4-2-8-2-13zm36 0h-6c0 5 0 9-2 13 5-1 8-5 8-10z" fill="url(#pl)"/>`:`<circle cx="125" cy="48" r="30" fill="none" stroke="url(#pl)" stroke-width="4"/><text x="125" y="58" font-family="${F}" font-size="${meta.place==='play'?22:26}" font-weight="800" fill="url(#pl)" text-anchor="middle">${meta.place==='play'?'★':X(pl.replace(/\D+/g,''))}</text>`)+
  `<text x="125" y="124" font-family="${F}" font-size="${pl.length>12?20:26}" font-weight="800" fill="url(#pl)" text-anchor="middle" letter-spacing="2">${X(pl.split(' · ')[0].toUpperCase())}</text></g>`)}
 let y=top;
 for(const [label,arr] of sections){
  const n={M:0,S:0,T:0};arr.forEach(c=>n[kind(c)]++);
  const sub=meta.types===false||label!=='MAIN DECK'&&label!=='SIDE DECK'?'':`${n.M} Monster${n.M===1?'':'s'}  ·  ${n.S} Spell${n.S===1?'':'s'}  ·  ${n.T} Trap${n.T===1?'':'s'}`;
  o.push(`<rect x="${pad}" y="${y}" width="${W-pad*2}" height="${head}" rx="14" fill="#151a3a" fill-opacity=".85" stroke="#2f3a86"/><rect x="${pad}" y="${y}" width="6" height="${head}" rx="3" fill="url(#gd)"/>`,
  `<g font-family="${F}"><text x="${pad+22}" y="${y+31}" font-size="20" font-weight="800" fill="#fff" letter-spacing="2">${label}</text><text x="${pad+22+label.length*14.5+14}" y="${y+31}" font-size="20" font-weight="800" fill="#f0b429">${arr.length}</text><text x="${W-pad-18}" y="${y+30}" font-size="15" fill="#c9d0f2" text-anchor="end">${sub}</text></g>`);
  y+=head+12;
  arr.forEach((c,i)=>{const x=pad+(i%cols)*(cw+gap),cy=y+Math.floor(i/cols)*(ch+gap),url=deckCardImageUrl(c);
   o.push(`<rect x="${x-1}" y="${cy+3}" width="${cw+2}" height="${ch}" rx="6" fill="#000" opacity=".45"/>`);
   if(url){let a=url;try{a=new URL(url,document.baseURI).href}catch{}o.push(`<g transform="translate(${x},${cy})" clip-path="url(#cc)"><rect width="${cw}" height="${ch}" fill="#1b2147"/><image href="${X(a)}" xlink:href="${X(a)}" width="${cw}" height="${ch}" preserveAspectRatio="none"><title>${X(c.name)}</title></image></g><rect x="${x}" y="${cy}" width="${cw}" height="${ch}" rx="5" fill="none" stroke="#ffffff" stroke-opacity=".18"/>`)}
   else{const w=String(c.name||'Card').split(/\s+/);let ls=[],l='';for(const t of w){const q=l?l+' '+t:t;if(q.length>12){if(l)ls.push(l);l=t}else l=q}if(l)ls.push(l);o.push(`<rect x="${x}" y="${cy}" width="${cw}" height="${ch}" rx="5" fill="#26306a"/><text x="${x+5}" y="${cy+16}" fill="#fff" font-family="${F}" font-size="9">${ls.slice(0,7).map((t,j)=>`<tspan x="${x+5}" dy="${j?12:0}">${X(t)}</tspan>`).join('')}</text>`)}});
  y+=Math.max(1,Math.ceil(arr.length/cols))*(ch+gap)+22;
 }
 o.push(`<g font-family="${F}"><text x="${pad}" y="${H-34}" font-size="15" fill="#9aa4bd">Made with Duel Synapse: KodeX · a project of Meta Insider OCG</text><text x="${W-pad}" y="${H-34}" font-size="15" fill="#f0b429" text-anchor="end" font-weight="700">kodex.meiocg.org</text></g></svg>`);
 return o.join('');
}
function posterHeight(d,W){const cols=13,pad=40,gap=8,cw=Math.floor((W-pad*2-gap*(cols-1))/cols),ch=Math.round(cw*86/59),sec=[copies(d,'main'),copies(d,'extra'),copies(d,'side')].filter((a,i)=>i<2||a.length);return 250+sec.reduce((h,a)=>h+48+12+Math.max(1,Math.ceil(a.length/cols))*(ch+gap)+22,0)+60}
function exportDeckPoster(deckId,meta){
 const d=deckById(deckId);if(!d)return;
 if(!meta){if(topIsModal())closeModal();setTimeout(()=>posterOptions(deckId),90);return}
 const W=1200,H=posterHeight(d,W),name=(d.name.replace(/[^\w -]/g,'').trim()||'deck')+(meta.place?'-'+meta.place:'');let svg=buildDeckPosterSvg(d,W,H,posterBackground,meta);
 (async()=>{const urls=[...new Set([...svg.matchAll(/<image href="(https:[^"]+)"/g)].map(m=>m[1].replace(/&amp;/g,'&')))];const got=await Promise.all(urls.map(u=>icGet(u).then(v=>[u,v],()=>[u,null])));for(const [u,v] of got){const e=u.replace(/&/g,'&amp;');svg=svg.split(`href="${e}"`).join(`href="${v||artSrc(u).replace(/&/g,'&amp;')}"`)}setTimeout(()=>deckViewer(svg,name,null),60);icWarm(urls)})();
}


</script>
<style id="kx-v56">.sh-menacing{color:#c48bff}.sh-rush{color:#ff7a5a}.sh-timestop{color:#bfe3ff}.sh-freeze{color:#e8c46a}.sh-spotlight{color:#8d99ff}.sh-radiant{color:#ffe08a}
.show-row .fin-t svg text{font-family:'Chakra Petch',system-ui,sans-serif}
.fin-t.on .gg{animation:kgg 1s ease-in-out infinite}.fin-t.on .g2{animation-delay:.5s}@keyframes kgg{50%{transform:translateY(-2px)}}
.fin-t.on .rs circle{animation:krs .6s ease-out infinite;transform-box:fill-box;transform-origin:center}.fin-t.on .rs circle:nth-child(2){animation-delay:.15s}.fin-t.on .rs circle:nth-child(3){animation-delay:.3s}@keyframes krs{0%{transform:scale(.4);opacity:0}50%{opacity:1}100%{transform:scale(1.1);opacity:0}}
.fin-t.on .hand{animation:khand 2.4s steps(8) infinite;transform-origin:24px 24px}@keyframes khand{to{transform:rotate(360deg)}}
.fin-t.on .tbc{animation:ktbc 1.4s ease-in-out infinite}@keyframes ktbc{0%{transform:translateX(-6px);opacity:.4}50%{transform:none;opacity:1}}
.fin-t.on .sp{animation:kmvb 1.2s ease-in-out infinite}.fin-t.on .rad{animation:kvx 4s linear infinite;transform-origin:24px 24px}
.fin-t.prem::after{content:"★";position:absolute;top:4px;right:6px;font-size:10px;color:#f0b429}
.em-t .em-snd{position:absolute;left:-6px;bottom:-6px;width:24px;height:24px;border-radius:50%;background:#1b2150;border:1px solid var(--line);display:grid;place-items:center;font-size:11px;cursor:pointer;opacity:.55}.em-t .em-snd.on{opacity:1;background:#3347f0}
.snd-list{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:8px}.snd-add{display:flex;gap:8px;flex-wrap:wrap}.snd-add .btn{display:inline-flex;align-items:center;gap:6px;min-height:40px}
.snd-pick{display:grid;gap:10px}.snd-pick .btn{min-height:46px;display:flex;align-items:center;justify-content:center;gap:8px}
.rec-box{display:grid;justify-items:center;gap:12px;padding:10px 0}.rec-btn{width:84px;height:84px;border-radius:50%;border:4px solid #e0566b;background:rgba(224,86,107,.12);display:grid;place-items:center;cursor:pointer}.rec-btn i{width:34px;height:34px;border-radius:50%;background:#e0566b;transition:border-radius .2s,transform .2s}.rec-btn.on i{border-radius:6px;transform:scale(.8)}.rec-btn.on{animation:krec 1s ease-in-out infinite}@keyframes krec{50%{box-shadow:0 0 0 10px rgba(224,86,107,.18)}}.rec-box audio{width:100%}.rec-acts{display:flex;gap:8px}
.sig-chip [data-sigace].on{background:#f0b429;color:#0c0f1f}.sig-chip [data-sigvoice].on{background:#3347f0}
.ar-min{margin-right:8px}#Larena .arbar{gap:8px!important}
.duel-pill{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(76px + env(safe-area-inset-bottom,0px));z-index:60;display:flex;align-items:center;gap:10px;padding:10px 12px 10px 14px;border-radius:999px;border:1px solid rgba(141,153,255,.5);background:linear-gradient(135deg,#1b2a8a,#3b1f6b);color:#fff;font:inherit;font-weight:700;box-shadow:0 12px 30px rgba(0,0,0,.55),0 0 24px rgba(51,71,240,.45);cursor:pointer;max-width:calc(100vw - 24px)}
.duel-pill[hidden]{display:none}.duel-pill i{width:10px;height:10px;border-radius:50%;background:#38c9a6;box-shadow:0 0 0 0 rgba(56,201,166,.6);animation:kpill 1.6s ease-out infinite}@keyframes kpill{70%{box-shadow:0 0 0 10px rgba(56,201,166,0)}}
.duel-pill b{padding:6px 12px;border-radius:999px;background:#f0b429;color:#0c0f1f;font-size:.82rem}.duel-pill.ping{animation:kping .5s ease-in-out 3}@keyframes kping{50%{transform:translateX(-50%) scale(1.06)}}
.az-starters{display:grid;gap:8px}.az-sti{display:flex;gap:10px;align-items:center;padding:8px;border-radius:14px;background:rgba(0,0,0,.18)}.az-sti.top{background:linear-gradient(135deg,rgba(240,180,41,.18),rgba(122,79,214,.16));border:1px solid rgba(240,180,41,.45)}.az-sti .az-k{width:58px}.az-sti .az-k img{width:58px}.az-sti .az-k span{display:none}.az-sti b{display:block;font-size:.66rem;letter-spacing:.14em;color:#f0b429}.az-sti span{display:block;font-weight:800}.az-sti small{display:block;font-size:.74rem;color:var(--muted);margin-top:2px}
.az-combo{margin:0;padding-left:20px;display:grid;gap:6px;font-size:.84rem}.az-combo li span{font-weight:700}.az-combo i{font-style:normal;color:#f0b429;margin:0 6px}.az-combo em{font-style:normal;color:var(--muted);margin-left:6px}
.az-pl{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:10px}@media (max-width:480px){.az-pl{grid-template-columns:repeat(2,1fr)}}.az-big2{padding:10px;border-radius:12px;background:rgba(0,0,0,.2);text-align:center}.az-big2 b{display:block;font-size:1.25rem;color:#38c9a6}.az-big2.bad b{color:#e0566b}.az-big2 small{font-size:.7rem;color:var(--muted)}
.az-cols,.az-line{width:100%}.az-leg{display:block;font-size:.72rem;color:var(--muted);text-align:center;margin-top:4px}
.az-hb{display:grid;gap:6px}.az-hr{display:grid;grid-template-columns:minmax(90px,40%) 1fr 44px;gap:8px;align-items:center;font-size:.8rem}.az-hr span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.az-hr i{height:8px;border-radius:4px;background:rgba(255,255,255,.08);overflow:hidden}.az-hr i b{display:block;height:100%;border-radius:4px}.az-hr em{font-style:normal;font-weight:800;text-align:right}
.az-res{display:flex;flex-wrap:wrap;gap:4px;margin-bottom:10px}.az-res i{width:14px;height:14px;border-radius:4px}.az-res .w{background:#38c9a6}.az-res .l{background:#e0566b}.az-res .d{background:#9aa4bd}
.az-perf h6,.az-sec h6{margin:6px 0;font-size:.78rem}
</style>
<script id="kx-v56-late">
/* ---------- KodeX 8.9 (loaded last: these replace earlier versions) ---------- */
/** Everything Premium the Arena needs: skins, moves, finale, Ace cards, emotes (HD GIFs), sound emotes, card voices. */
function skinsToArena(){const f=$('arenaFrame');if(!PREMIUM||!f||!f.contentWindow)return;const voices={};for(const id of sigCards()){const v=MEDIA.voices[id];if(v&&v.snd)voices[/^\d{3,10}$/.test(id)?id:String(id)]=v.snd}
 try{f.contentWindow.postMessage({kx:'skin',premium:PREMIUM,sleeve:skinImg('sleeve'),xsleeve:skinImg('xsleeve'),field:fieldSkin(),signature:sigCards().map(Number),finisher:finStyle(),sigFx:sigFx(),entrance:entStyle(),attack:atkStyle(),entFx:perCardFx('sig_ent',ENT_T),atkFx:perCardFx('sig_atk',ATK_T),finale:finaleStyle(),aceStyle:aceStyle(),aces:aceCards().map(Number),emotes:MEDIA.emotes.map(x=>({name:x.name,src:x.src,snd:x.snd||''})),sounds:MEDIA.sounds.map(x=>({name:x.name,snd:x.snd})),voices},'*')}catch(e){}audioToArena()}
function movesPanel(tb){
 tb.querySelectorAll('[data-mv]').forEach(b=>b.onclick=()=>{const kind=b.dataset.mv;S.s(kind==='ent'?'ent_style':'atk_style',b.dataset.mvk);tb.querySelectorAll(`[data-mv="${kind}"]`).forEach(x=>{x.classList.toggle('on',x===b);x.setAttribute('aria-checked',String(x===b))});const pv=tb.querySelector(`[data-mvpv="${kind}"]`);if(pv)pv.textContent='Preview '+b.textContent.trim();skinsToArena()});
 tb.querySelectorAll('[data-mvpv]').forEach(b=>b.onclick=()=>previewMove(b.dataset.mvpv,b.dataset.mvpv==='ent'?entStyle():atkStyle()));
 tb.querySelectorAll('[data-show]').forEach(b=>b.onclick=()=>{const kind=b.dataset.show;S.s(kind==='finale'?'finale_style':'ace_style',b.dataset.showk);tb.querySelectorAll(`[data-show="${kind}"]`).forEach(x=>{x.classList.toggle('on',x===b);x.setAttribute('aria-checked',String(x===b))});const pv=tb.querySelector(`[data-showpv="${kind}"]`);if(pv)pv.textContent='Preview '+b.textContent.trim();skinsToArena()});
 tb.querySelectorAll('[data-showpv]').forEach(b=>b.onclick=()=>previewShow(b.dataset.showpv,b.dataset.showpv==='finale'?finaleStyle():aceStyle()));
 tb.querySelectorAll('[data-emdel]').forEach(b=>b.onclick=async e=>{e.stopPropagation();MEDIA.emotes=MEDIA.emotes.filter(x=>x.id!==b.dataset.emdel);await mediaSave();skinsToArena();openSkins()});
 tb.querySelectorAll('[data-emsnd]').forEach(b=>b.onclick=e=>{e.stopPropagation();soundFor(async snd=>{const x=MEDIA.emotes.find(v=>v.id===b.dataset.emsnd);if(!x)return;x.snd=snd||'';await mediaSave();skinsToArena();openSkins()},true)});
 const ea=tb.querySelector('[data-emadd]');if(ea)ea.onchange=async()=>{const f=ea.files&&ea.files[0];if(!f)return;try{let src;if(/gif$/i.test(f.type)){if(f.size>IMG_MAX){toast('That GIF is too large (up to 3.3 MB)');return}src=await fileToDataUrl(f)}else if(f.size<=1.2e6&&/png|webp/i.test(f.type)){src=await fileToDataUrl(f)}else src=await shrinkPng(f,512);if(src.length>4.5e6){toast('That picture is too large');return}MEDIA.emotes.push({id:'e'+Date.now().toString(36),name:f.name.replace(/\.\w+$/,'').slice(0,24)||'Emote',src,snd:''});await mediaSave();skinsToArena();openSkins()}catch(e){toast('That picture could not be used')}};
 tb.querySelectorAll('[data-sndplay]').forEach(b=>b.onclick=()=>{const x=MEDIA.sounds.find(v=>v.id===b.dataset.sndplay);if(x)playData(x.snd)});
 tb.querySelectorAll('[data-snddel2]').forEach(b=>b.onclick=async()=>{MEDIA.sounds=MEDIA.sounds.filter(v=>v.id!==b.dataset.snddel2);await mediaSave();skinsToArena();openSkins()});
 const sf=tb.querySelector('[data-sndfile]');if(sf)sf.onchange=async()=>{const r=await pickAudio(sf.files&&sf.files[0]);if(!r)return;MEDIA.sounds.push({id:'s'+Date.now().toString(36),...r});await mediaSave();skinsToArena();openSkins()};
 const sr=tb.querySelector('[data-sndrec]');if(sr)sr.onclick=async()=>{const u=await recordSound(6);if(!u)return;MEDIA.sounds.push({id:'s'+Date.now().toString(36),name:'Recording '+(MEDIA.sounds.length+1),snd:u});await mediaSave();skinsToArena();setTimeout(openSkins,120)};
 if(!tb.dataset.v56){tb.dataset.v56='1';tb.addEventListener('click',async e=>{const a=e.target.closest('[data-sigace]'),v=e.target.closest('[data-sigvoice]');
  if(a){const id=a.dataset.sigace,s=new Set(S.g('ace_cards',[]).map(String));if(s.has(id))s.delete(id);else{if(aceCards().length>=12){toast('Up to 12 Ace cards');return}s.add(id)}S.s('ace_cards',[...s]);a.classList.toggle('on',s.has(id));a.setAttribute('aria-pressed',String(s.has(id)));skinsToArena();if(s.has(id))previewShow('ace',aceStyle())}
  if(v){const id=v.dataset.sigvoice;soundFor(async snd=>{if(snd)MEDIA.voices[id]={snd};else delete MEDIA.voices[id];await mediaSave();v.classList.toggle('on',!!snd);skinsToArena();toast(snd?'Card voice saved':'Card voice removed')},!!MEDIA.voices[id])}})}
}
/** Choose a sound: an audio file or a recording (and "no sound" when one is set). */
function soundFor(cb,has){const m=openModal(`<div class="dk-hd"><h3>Sound</h3><button class="ibtn" data-close aria-label="Close">${ic('x')}</button></div><div class="snd-pick"><label class="btn">${ic('plus',16)}Choose an audio file<input type="file" accept="audio/*" data-sp-file hidden></label><button type="button" class="btn" data-sp-rec>🎙 Record (up to 6 s)</button>${has?'<button type="button" class="btn" data-sp-none>No sound</button>':''}<p class="note">Up to 650 KB. Everyone in the duel hears it, unless they mute you.</p></div>`,'','snd');
 m.querySelector('[data-sp-file]').onchange=async e=>{const r=await pickAudio(e.target.files&&e.target.files[0]);if(!r)return;closeModal();cb(r.snd)};
 m.querySelector('[data-sp-rec]').onclick=async()=>{closeModal();setTimeout(async()=>{const u=await recordSound(6);if(u)cb(u)},150)};
 const n=m.querySelector('[data-sp-none]');if(n)n.onclick=()=>{closeModal();cb('')}}

/* ---------- testing data: the Arena's results per deck, now with openers and combo links ---------- */
function recordStats(m){
 if(!m||!m.result||!m.deck||!Array.isArray(m.deck.main))return;
 const want=m.deck.main.map(Number).sort((a,b)=>a-b),all=deckStore();let best=null,bs=0;
 for(const d of all){const have=deckMainCodes(d).sort((a,b)=>a-b);if(!have.length)continue;const set=new Map();for(const c of have)set.set(c,(set.get(c)||0)+1);let hit=0;for(const c of want){const n=set.get(c)||0;if(n){hit++;set.set(c,n-1)}}let sc=hit/Math.max(have.length,want.length);if(d.name===m.deck.name)sc+=.25;if(sc>bs){bs=sc;best=d}}
 if(!best||bs<.6)return;
 const st=S.g('dstats',{}),r=m.result,clean={at:+r.at||Date.now(),win:!!r.win,draw:!!r.draw,turns:+r.turns||0,dead:!!r.dead,otk:!!r.otk,first:!!r.first,vs:r.vs==='online'?'online':'ai',used:{},drawn:{},open:{},links:{}};
 for(const k of ['used','drawn','open'])if(r[k]&&typeof r[k]==='object')for(const [c,n] of Object.entries(r[k]).slice(0,120))if(/^\d{3,10}$/.test(c))clean[k][c]=Math.min(99,+n||0);
 if(r.links&&typeof r.links==='object')for(const [k,n] of Object.entries(r.links).slice(0,120))if(/^\d{3,10}>\d{3,10}$/.test(k))clean.links[k]=Math.min(99,+n||0);
 const e=st[best.id]||{games:[]};e.games.push(clean);e.games=e.games.slice(-150);st[best.id]=e;
 const ks=Object.keys(st);if(ks.length>60)delete st[ks[0]];S.s('dstats',st);
}

/* ---------- Synapse Deck Analyzer 2: real starters, combo links, a probability lab and performance graphs ---------- */
function azPmf(N,K,n){const C=(a,b)=>{if(b<0||b>a)return 0;let r=1;for(let i=1;i<=b;i++)r=r*(a-b+i)/i;return r};const out=[];for(let k=0;k<=Math.min(n,K);k++)out.push(C(K,k)*C(N-K,n-k)/C(N,n));return out}
function azMonte(pool,n,runs,test){let hit=0;const a=pool.slice();for(let r=0;r<runs;r++){for(let i=0;i<n;i++){const j=i+Math.floor(Math.random()*(a.length-i));[a[i],a[j]]=[a[j],a[i]]}if(test(a.slice(0,n)))hit++}return hit/runs}
function azLine(vals,{h=110,w=300,max=1,col='#8d99ff',label=''}={}){if(vals.length<2)return '';const X=i=>14+i*(w-28)/(vals.length-1),Y=v=>h-16-(v/max)*(h-32);const d=vals.map((v,i)=>`${i?'L':'M'}${X(i).toFixed(1)} ${Y(v).toFixed(1)}`).join('');return `<svg viewBox="0 0 ${w} ${h}" class="az-line" role="img" aria-label="${esc(label)}"><path d="M14 ${Y(max*.5)}H${w-14}" stroke="#ffffff" stroke-opacity=".12" stroke-dasharray="4 4"/><path d="${d}L${X(vals.length-1)} ${h-16}L14 ${h-16}Z" fill="${col}" opacity=".14"/><path d="${d}" fill="none" stroke="${col}" stroke-width="2.5" stroke-linejoin="round"/>${vals.map((v,i)=>`<circle cx="${X(i)}" cy="${Y(v)}" r="2.6" fill="${col}"/>`).join('')}<text x="14" y="10" font-size="9" fill="#9aa4bd">${esc(label)}</text></svg>`}
function azBars(rows,{max,col='#8d99ff',fmt=v=>v}={}){max=max||Math.max(1,...rows.map(r=>r[1]));return `<div class="az-hb">${rows.map(([l,v,c])=>`<div class="az-hr"><span>${esc(l)}</span><i><b style="width:${Math.max(2,v/max*100)}%;background:${c||col}"></b></i><em>${fmt(v)}</em></div>`).join('')}</div>`}
function azCols(vals,labels,{h=100,col='#38c9a6'}={}){const max=Math.max(1e-9,...vals),w=Math.max(160,vals.length*34);return `<svg viewBox="0 0 ${w} ${h}" class="az-cols" role="img">${vals.map((v,i)=>{const bh=(v/max)*(h-30),x=8+i*(w-16)/vals.length,bw=(w-16)/vals.length-8;return `<rect x="${x}" y="${h-18-bh}" width="${bw}" height="${bh}" rx="4" fill="${col}" opacity="${.45+.55*v/max}"/><text x="${x+bw/2}" y="${h-6}" text-anchor="middle" font-size="9" fill="#9aa4bd">${esc(labels[i])}</text><text x="${x+bw/2}" y="${h-22-bh}" text-anchor="middle" font-size="9" fill="#fff">${typeof v==='number'&&v<1.0001&&v>0&&String(labels[0]).length<3?Math.round(v*100)+'%':v}</text>`}).join('')}</svg>`}
function analyzeDeck(d){
 normalizeDeck(d);const main=copies(d,'main').map(azCard),extra=copies(d,'extra').map(azCard),all=[...main,...extra],N=main.length||1;
 const cntF=(arr,k)=>arr.filter(x=>x[k]).length,uniq=a=>[...new Map(a.map(x=>[x.id,x])).values()];
 const m={};for(const k of Object.keys(AZ_RX).concat(['mon','spell','trap','starter','qp']))m[k]=cntF(main,k);
 const ex={};for(const k of Object.keys(AZ_RX))ex[k]=cntF(extra,k);
 const games=((S.g('dstats',{})||{})[d.id]||{games:[]}).games||[];
 const sum=(k)=>{const o={};for(const g of games)for(const [c,n] of Object.entries(g[k]||{}))o[c]=(o[c]||0)+n;return o};
 const used=sum('used'),drawn=sum('drawn'),opens=sum('open'),links=sum('links');
 // --- the deck's real starters: searchers / summoners ranked by how much of THIS deck they reach, copies, and how
 //     often they actually opened a turn in your duels
 const U=uniq(main),copiesOf=x=>main.filter(v=>v.id===x.id).length,nm=x=>String(x.name||'').toLowerCase();
 const reach=x=>{const q=[...x.text.matchAll(/"([^"]{3,40})"/g)].map(r=>r[1].toLowerCase()).filter(s=>s!==nm(x));if(!q.length)return 0;return main.filter(v=>v.id!==x.id&&q.some(s=>nm(v).includes(s))).length};
 const cand=U.map(x=>{const r=reach(x),o=opens[x.code]||0,u=used[x.code]||0;const can=(x.search||x.deckSS)&&!x.handtrap;const sc=(x.search?10:0)+(x.deckSS?8:0)+Math.min(r,20)*1.2+copiesOf(x)*2.5+o*7+(x.selfSS?2:0)-(x.trap?6:0);return {x,r,o,u,sc,can}}).filter(c=>c.can||c.o>0).sort((a,b)=>b.sc-a.sc);
 const starters=cand.slice(0,6);
 const starterIds=new Set(cand.filter(c=>c.sc>=14||c.o>0).map(c=>c.x.id));
 const K=main.filter(x=>starterIds.has(x.id)).length,E=main.filter(x=>!starterIds.has(x.id)&&(x.extender||x.selfSS)&&!x.handtrap).length,H=m.handtrap,nonEngine=main.filter(x=>x.handtrap||(!x.text.match(/"[^"]{3,40}"/)&&(x.remove||x.negate))).length;
 // --- probability lab
 const pmf5=azPmf(N,K,5),pmf6=azPmf(N,K,6);
 const pool=main.map(x=>starterIds.has(x.id)?'S':(x.extender||x.selfSS)&&!x.handtrap?'E':x.handtrap?'H':'O');
 const runs=12000;
 const mc={playable5:azMonte(pool,5,runs,h=>h.includes('S')),strong5:azMonte(pool,5,runs,h=>h.includes('S')&&(h.filter(v=>v==='S').length>=2||h.includes('E'))),brick5:azMonte(pool,5,runs,h=>!h.includes('S')&&!h.includes('E')),sh5:azMonte(pool,5,runs,h=>h.includes('S')&&h.includes('H')),playable6:azMonte(pool,6,runs,h=>h.includes('S')),brick6:azMonte(pool,6,runs,h=>!h.includes('S')&&!h.includes('E'))};
 const expect5=5*K/N,sd5=Math.sqrt(5*(K/N)*(1-K/N)*(N-5)/(N-1||1));
 // --- combo links seen in your duels
 const name=c=>{const x=all.find(v=>String(v.code)===String(c)||v.id===String(c));return x?x.name:(M.get(String(c))||{}).name||('#'+c)};
 const combo=Object.entries(links).sort((a,b)=>b[1]-a[1]).slice(0,8).map(([k,n])=>{const [a,b]=k.split('>');return [name(a),name(b),n]});
 // --- the v1 stats, with consistency from the real starters
 const base=analyzeDeckV1(d);const st=base.stat.find(s=>s.k==='con');
 if(st){const sizePen=Math.max(0,N-40)*1.6;st.v=clamp100(mc.playable5*72+mc.strong5*30-sizePen+m.draw*1.2);st.why=[`Your deck's starters (${K} cards: ${starters.slice(0,3).map(c=>c.x.name).join(', ')}${starters.length>3?'…':''})`,`Playable opening (a starter in 5 cards): ${(mc.playable5*100).toFixed(1)}% × 0.72`,`Strong opening (2 starters, or a starter + an extender): ${(mc.strong5*100).toFixed(1)}% × 0.30`,`Deck size ${N}: −${sizePen.toFixed(1)}`,`Draw cards ${m.draw} × 1.2`]}
 const baseScore=base.stat.reduce((a,x)=>a+x.v,0)/base.stat.length;
 const T=base.T;const final=clamp100(T.n>=5?baseScore*.7+T.rate*100*.3:baseScore);
 const rank=final>=90?'S+':final>=80?'S':final>=70?'A':final>=58?'B':final>=45?'C':'D';
 // --- performance (decks you play often)
 const perf=games.length>=3?(()=>{const g=games.slice(-60),roll=[];let w=0;g.forEach((x,i)=>{w+=x.win?1:0;if(i>=5)w-=g[i-5].win?1:0;roll.push(w/Math.min(i+1,5))});
  const bins=[0,0,0,0,0,0];const bl=['1-3','4-5','6-7','8-9','10-13','14+'];for(const x of g){const t=x.turns;bins[t<=3?0:t<=5?1:t<=7?2:t<=9?3:t<=13?4:5]++}
  const rate=a=>a.length?a.filter(x=>x.win).length/a.length:0;
  const openers=Object.entries(opens).sort((a,b)=>b[1]-a[1]).slice(0,6).map(([c,n])=>[name(c),n]);
  const wins=g.filter(x=>x.win),avgWinT=wins.length?wins.reduce((a,x)=>a+x.turns,0)/wins.length:0;
  return {g,roll,bins,bl,first:rate(g.filter(x=>x.first)),second:rate(g.filter(x=>!x.first)),ai:rate(g.filter(x=>x.vs==='ai')),online:rate(g.filter(x=>x.vs==='online')),nAi:g.filter(x=>x.vs==='ai').length,nOn:g.filter(x=>x.vs==='online').length,openers,avgWinT,deadRoll:g.map((x,i)=>{const s=g.slice(Math.max(0,i-4),i+1);return s.filter(y=>y.dead).length/s.length})}})():null;
 return {...base,stat:base.stat,final,rank,starters,K,E,H,nonEngine,pmf5,pmf6,mc,expect5,sd5,combo,perf,used,drawn,opens,N};
}
function openAnalyzer(id){
 const d=deckById(id);if(!d)return;if(!d.cards.length){toast('Add cards to the deck first');return}
 const A=analyzeDeck(d),stars=n=>'<span class="az-st" aria-label="'+n+' of 5">'+'★'.repeat(n)+'<i>'+'★'.repeat(5-n)+'</i></span>',pc=v=>(v*100).toFixed(1)+'%';
 const kimg=x=>`<button type="button" class="az-k" data-quickview="${esc(x.id)}"><img src="${esc(deckCardImageUrl({id:x.id})||'')}" alt="" loading="lazy" onerror="this.style.visibility='hidden'"><span>${esc(x.name)}</span></button>`;
 const kc=(t,arr)=>arr&&arr.length?`<div class="az-kc"><h5>${t}</h5><div class="az-kr">${arr.map(kimg).join('')}</div></div>`:'';
 const T=A.T,pct=v=>v==null?'–':Math.round(v*100)+'%',P=A.perf;
 const html=`<div class="dk-hd"><h3>Synapse Deck Analyzer</h3><button class="ibtn" data-close aria-label="Close">${ic('x')}</button></div>
<div class="az">
<div class="az-hero"><div class="az-rank r-${A.rank.replace('+','p')}"><b>${A.rank}</b><small>${A.final}/100</small></div><div class="az-ht"><small>FINAL SCORE</small><h4>${esc(d.name)}</h4><p>${A.N} Main · ${A.extra} Extra · ${A.difficulty} · ${A.stamina}${T.n?` · ${T.n} duels tested`:''}</p></div></div>
<label class="az-calc"><input type="checkbox" data-azcalc><span>Show the calculations</span></label>
<section class="az-sec"><h5>Main stats</h5><div class="az-main">${azRadar(A.stat)}<div class="az-bars">${A.stat.map(s=>`<div class="az-bar"><span>${s.label}</span><i><b style="width:${s.v}%"></b></i><em>${s.v}</em><ul class="az-why">${s.why.map(w=>`<li>${esc(w)}</li>`).join('')}<li>Capped at 100</li></ul></div>`).join('')}</div></div></section>
<section class="az-sec"><h5>Starters in this deck</h5>${A.starters.length?`<div class="az-starters">${A.starters.map((c,i)=>`<div class="az-sti${i?'':' top'}">${kimg(c.x)}<div><b>${i?'#'+(i+1):'TOP STARTER'}</b><span>${esc(c.x.name)}</span><small>${[c.x.search?'searches':'',c.x.deckSS?'summons from the Deck':'',c.r?`reaches ${c.r} card${c.r===1?'':'s'} of this deck`:'',c.o?`opened ${c.o} of your turns`:''].filter(Boolean).join(' · ')}</small></div></div>`).join('')}</div>`:'<p class="note">No card in this deck searches or summons from the Deck.</p>'}<small class="az-why">Ranked by: searches (+10) or summons from the Deck (+8), how many cards of this deck it can reach (×1.2), copies (×2.5) and how often it opened your turns in Arena duels (×7).</small></section>
${A.combo.length?`<section class="az-sec"><h5>Combo links from your duels</h5><ol class="az-combo">${A.combo.map(([a,b,n])=>`<li><span>${esc(a)}</span><i>→</i><span>${esc(b)}</span><em>${n}×</em></li>`).join('')}</ol><small class="az-why">Plays that followed each other in the same turn, counted over every Arena duel with this deck.</small></section>`:''}
<section class="az-sec"><h5>Probability lab</h5>
<div class="az-pl"><div class="az-big2"><b>${pc(A.mc.playable5)}</b><small>playable hand going first</small></div><div class="az-big2"><b>${pc(A.mc.playable6)}</b><small>playable hand going second</small></div><div class="az-big2"><b>${pc(A.mc.strong5)}</b><small>strong hand (2 starters or starter + extender)</small></div><div class="az-big2 bad"><b>${pc(A.mc.brick5)}</b><small>brick going first</small></div><div class="az-big2"><b>${pc(A.mc.sh5)}</b><small>starter + hand trap</small></div><div class="az-big2"><b>${A.expect5.toFixed(2)}</b><small>starters per opening hand (±${A.sd5.toFixed(2)})</small></div></div>
<div class="az-2"><div><h6>Starters in 5 cards</h6>${azCols(A.pmf5.slice(0,5).concat(A.pmf5.length>5?[A.pmf5.slice(5).reduce((a,b)=>a+b,0)]:[]).map(v=>+v.toFixed(3)),['0','1','2','3','4','5'].slice(0,Math.min(6,A.pmf5.length)))}</div><div><h6>Seeing a starter by cards seen</h6>${azCurve(A.N,A.K)}</div></div>
<div class="az-2"><div><h6>What the Main Deck is made of</h6>${azDonut([['Starters',A.K,'#f0b429'],['Extenders',A.E,'#8d99ff'],['Hand traps',A.H,'#e0566b'],['Other',Math.max(0,A.N-A.K-A.E-A.H),'#38c9a6']])}<small class="az-leg"><span style="color:#f0b429">●</span> Starters ${A.K} · <span style="color:#8d99ff">●</span> Extenders ${A.E} · <span style="color:#e0566b">●</span> Hand traps ${A.H} · <span style="color:#38c9a6">●</span> Other ${Math.max(0,A.N-A.K-A.E-A.H)}</small></div><div><h6>Card types</h6>${azDonut(A.comp)}<small class="az-leg">${A.comp.map(c=>`<span style="color:${c[2]}">●</span> ${c[0]} ${c[1]}`).join(' · ')}</small></div></div>
<small class="az-why">Exact hypergeometric odds for the bars and curve (${A.N} cards, ${A.K} starters); the other figures from 12,000 shuffled opening hands. A playable hand has a starter; a brick has neither a starter nor an extender.</small></section>
<section class="az-sec"><h5>More stats</h5><div class="az-stars">${A.stars.map(([l,n,w])=>`<div class="az-sr"><span>${l}</span>${stars(n)}<small class="az-why">${esc(w)}</small></div>`).join('')}</div></section>
<section class="az-sec az-3"><div class="az-box"><h5>Deck difficulty</h5><b class="az-big">${A.difficulty}</b><i class="az-meter"><b style="width:${A.diffV}%"></b></i><small class="az-why">Long effect texts, Extra Deck size, cards for the opponent's turn and summon locks: ${Math.round(A.diffV)} pts.</small></div><div class="az-box"><h5>Deck stamina</h5><b class="az-big">${A.stamina}</b><i class="az-meter"><b style="width:${A.staminaV}%"></b></i><small class="az-why">Recovery × 0.6 + Resilience × 0.4 = ${A.staminaV}</small></div><div class="az-box"><h5>Recommended for</h5><div class="az-chips">${A.rec.map(r=>`<span>${esc(r)}</span>`).join('')}</div></div></section>
<section class="az-sec"><h5>Key cards</h5>${A.key.best?`<div class="az-best"><button type="button" class="az-k big" data-quickview="${esc(A.key.best.id)}"><img src="${esc(deckCardImageUrl({id:A.key.best.id})||'')}" alt="" onerror="this.style.visibility='hidden'"></button><div><small>BEST CARD</small><b>${esc(A.key.best.name)}</b><p class="az-why">Most impact: starts plays, stops the opponent, is named by other cards or hits hard.</p></div></div>`:''}${kc('Main beaters',A.key.beaters)}${kc('Key cards',A.key.keys)}${kc('Defenders',A.key.defenders)}</section>
<section class="az-sec"><h5>Testing data</h5>${T.n?`<div class="az-test"><div class="az-tr">${azRing(T.rate,'Win ratio','#38c9a6')}<small>Win ratio · ${T.wins} of ${T.n}</small></div><div class="az-tg"><div><b>${T.n}</b><small>duels</small></div><div><b>${T.otk}</b><small>OTKs</small></div><div><b>${pct(T.dead/T.n)}</b><small>dead hands</small></div><div><b>${T.turns.toFixed(1)}</b><small>avg. turns</small></div><div><b>${pct(T.first)}</b><small>win going first</small></div><div><b>${pct(T.second)}</b><small>win going second</small></div></div></div><div class="az-2"><div><h6>Most used</h6><ol>${T.most.map(([n,c])=>`<li>${esc(n)} <em>${c}×</em></li>`).join('')||'<li>–</li>'}</ol></div><div><h6>Least used</h6><ol>${T.least.map(([n,c,dr])=>`<li>${esc(n)} <em>${c}× used · ${dr}× drawn</em></li>`).join('')}</ol></div></div>${T.n>=5?'<small class="az-why">With 5+ duels the final score is 70% card stats + 30% win ratio.</small>':''}`:`<p class="note">No duels with this deck yet. Playtest it in the Duel Arena: every duel adds its win, OTKs, dead hands, openers, combo links and the cards you used.</p><button class="btn" data-playtest="${esc(d.id)}">${ic('play',18)}Playtest now</button>`}</section>
${P?`<section class="az-sec az-perf"><h5>Performance · ${P.g.length} recent duels</h5>
<div class="az-res">${P.g.slice(-40).map(x=>`<i class="${x.win?'w':x.draw?'d':'l'}" title="${x.win?'Win':x.draw?'Draw':'Loss'} · ${x.turns} turns${x.otk?' · OTK':''}${x.first?' · went first':' · went second'}"></i>`).join('')}</div>
<div class="az-2"><div>${azLine(P.roll,{label:'Win rate (last 5 duels)',col:'#38c9a6'})}</div><div>${azLine(P.deadRoll,{label:'Dead-hand rate (last 5 duels)',col:'#e0566b'})}</div></div>
<div class="az-2"><div><h6>Win rate</h6>${azBars([['Going first',P.first,'#8d99ff'],['Going second',P.second,'#7a4fd6'],[`Vs Synapse AI (${P.nAi})`,P.ai,'#38c9a6'],[`Online (${P.nOn})`,P.online,'#f0b429']],{max:1,fmt:v=>Math.round(v*100)+'%'})}</div><div><h6>How long duels last (turns)</h6>${azCols(P.bins,P.bl,{col:'#8d99ff'})}<small class="az-leg">Average win on turn ${P.avgWinT?P.avgWinT.toFixed(1):'–'}</small></div></div>
${P.openers.length?`<div><h6>What opened your turns</h6>${azBars(P.openers.map(([n,c])=>[n,c]),{col:'#f0b429',fmt:v=>v+'×'})}</div>`:''}
</section>`:''}
<p class="note az-foot">Card stats come from the card texts and are a guide, not a rule. A dead hand is a first turn with no summon and no activation.</p>
</div>`;
 const m=openModal(html,'big','az');const box=m.querySelector('.az'),cb=m.querySelector('[data-azcalc]');cb.checked=!!S.g('az_calc',false);box.classList.toggle('calc',cb.checked);cb.onchange=()=>{S.s('az_calc',cb.checked);box.classList.toggle('calc',cb.checked)};
}

/* ---------- deck image 2: exaggerated MEIOCG labels ---------- */
function buildDeckPosterSvg(d,W,H,bg,meta){
 meta=meta||{};const X=v=>String(v??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&apos;');
 const F="'Chakra Petch','Plus Jakarta Sans',Arial,sans-serif",sections=[['MAIN DECK',copies(d,'main')],['EXTRA DECK',copies(d,'extra')],['SIDE DECK',copies(d,'side')]].filter(([l,a],i)=>i<2||a.length);
 const cols=13,pad=40,gap=8,cw=Math.floor((W-pad*2-gap*(cols-1))/cols),ch=Math.round(cw*86/59),head=64,top=300;
 const kind=c=>{const t=String((resolveDeckCard(c)||{}).type||'').toLowerCase();return /spell/.test(t)?'S':/trap/.test(t)?'T':'M'};
 const date=new Date().toLocaleDateString(undefined,{year:'numeric',month:'long',day:'numeric'});
 const pc=PLACE_COL[meta.place],pl=(PLACES.find(x=>x[0]===meta.place)||['',''])[1];
 const logo=(()=>{const i=document.querySelector('header .logo img');return i&&/^data:image\//.test(i.src)?i.src:''})();
 const o=[`<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="${W}" height="${H}" viewBox="0 0 ${W} ${H}">`,
 `<defs><linearGradient id="bg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#141c55"/><stop offset=".5" stop-color="#0b0e1f"/><stop offset="1" stop-color="#22123f"/></linearGradient>`+
 `<radialGradient id="b1" cx=".82" cy=".04" r=".6"><stop offset="0" stop-color="#3347f0" stop-opacity=".65"/><stop offset="1" stop-color="#3347f0" stop-opacity="0"/></radialGradient>`+
 `<radialGradient id="b2" cx=".04" cy=".92" r=".55"><stop offset="0" stop-color="#7a4fd6" stop-opacity=".55"/><stop offset="1" stop-color="#7a4fd6" stop-opacity="0"/></radialGradient>`+
 `<radialGradient id="b3" cx=".5" cy=".18" r=".35"><stop offset="0" stop-color="#f0b429" stop-opacity=".16"/><stop offset="1" stop-color="#f0b429" stop-opacity="0"/></radialGradient>`+
 `<linearGradient id="gd" x1="0" x2="1"><stop offset="0" stop-color="#3347f0"/><stop offset=".5" stop-color="#7a4fd6"/><stop offset="1" stop-color="#f0b429"/></linearGradient>`+
 `<linearGradient id="rib" x1="0" x2="1"><stop offset="0" stop-color="#2b3be0"/><stop offset=".6" stop-color="#6a3fd0"/><stop offset="1" stop-color="#1a1f4f" stop-opacity=".9"/></linearGradient>`+
 `<linearGradient id="nm" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffffff"/><stop offset=".55" stop-color="#d9d0ff"/><stop offset="1" stop-color="#8d99ff"/></linearGradient>`+
 `<linearGradient id="gold" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff2c4"/><stop offset=".5" stop-color="#f0b429"/><stop offset="1" stop-color="#b67a12"/></linearGradient>`+
 `<linearGradient id="holo" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#fff" stop-opacity="0"/><stop offset=".5" stop-color="#fff" stop-opacity=".35"/><stop offset="1" stop-color="#fff" stop-opacity="0"/></linearGradient>`+
 (pc?`<linearGradient id="pl" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="${pc[1]}"/><stop offset="1" stop-color="${pc[0]}"/></linearGradient>`:'')+
 `<filter id="glow" x="-20%" y="-50%" width="140%" height="200%"><feGaussianBlur stdDeviation="6" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>`+
 `<filter id="sh" x="-10%" y="-30%" width="120%" height="160%"><feDropShadow dx="0" dy="5" stdDeviation="4" flood-color="#000" flood-opacity=".75"/></filter>`+
 `<pattern id="dia" width="46" height="46" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="46" height="46" fill="none" stroke="#ffffff" stroke-opacity=".035"/></pattern><clipPath id="cc"><rect width="${cw}" height="${ch}" rx="5"/></clipPath><clipPath id="lg"><circle cx="60" cy="60" r="56"/></clipPath></defs>`,
 `<rect width="100%" height="100%" fill="url(#bg)"/>`];
 if(bg)o.push(`<image href="${X(bg)}" xlink:href="${X(bg)}" x="0" y="0" width="${W}" height="${H}" preserveAspectRatio="xMidYMid slice" opacity=".3"/>`);
 o.push(`<rect width="100%" height="100%" fill="url(#b1)"/><rect width="100%" height="100%" fill="url(#b2)"/><rect width="100%" height="100%" fill="url(#b3)"/><rect width="100%" height="100%" fill="url(#dia)"/>`,
 `<path d="M${W*.55} 0 L${W*.75} 0 L${W*.35} ${H} L${W*.15} ${H}Z" fill="#ffffff" opacity=".025"/><path d="M${W*.8} 0 L${W*.86} 0 L${W*.46} ${H} L${W*.4} ${H}Z" fill="#ffffff" opacity=".02"/>`,
 `<rect x="12" y="12" width="${W-24}" height="${H-24}" rx="28" fill="none" stroke="url(#gd)" stroke-width="4"/><rect x="22" y="22" width="${W-44}" height="${H-44}" rx="22" fill="none" stroke="#ffffff" stroke-opacity=".08"/>`);
 // corner diamonds
 for(const [x,y] of [[12,12],[W-12,12],[12,H-12],[W-12,H-12]])o.push(`<path d="M${x} ${y-9}l9 9-9 9-9-9z" fill="url(#gold)"/>`);
 // header: logo, brand line, the deck's name
 const lx=pad,ly=44;
 if(logo)o.push(`<g transform="translate(${lx},${ly})"><circle cx="60" cy="60" r="64" fill="#0c0f1f" stroke="url(#gd)" stroke-width="4" filter="url(#glow)"/><image href="${logo}" xlink:href="${logo}" x="4" y="4" width="112" height="112" clip-path="url(#lg)"/></g>`);
 const tx=logo?lx+150:lx;
 o.push(`<g font-family="${F}"><text x="${tx}" y="${ly+26}" font-size="17" font-weight="800" letter-spacing="6" fill="url(#gold)">MEIOCG ◆ PROJECT: DUEL SYNAPSE ◆ KODEX</text>`,
 `<text x="${tx}" y="${ly+88}" font-size="58" font-weight="900" font-style="italic" fill="url(#nm)" stroke="#0b0e1f" stroke-width="6" paint-order="stroke" filter="url(#sh)" letter-spacing="1">${X(String(d.name||'Deck').slice(0,26))}</text>`,
 `<text x="${tx}" y="${ly+126}" font-size="20" font-weight="700" fill="#c9d0f2">${[meta.player?X(meta.player):'',meta.event?X(meta.event):''].filter(Boolean).join('  ◆  ')||X(deckTotal(d)+' cards')}</text>`,
 `<text x="${tx}" y="${ly+156}" font-size="15" fill="#9aa4bd" letter-spacing="2">${X(date.toUpperCase())}${meta.player||meta.event?'  ◆  '+deckTotal(d)+' CARDS':''}</text></g>`);
 o.push(`<g transform="translate(${pad},${top-52})"><rect width="${W-pad*2}" height="4" rx="2" fill="url(#gd)"/><rect width="${W-pad*2}" height="4" rx="2" fill="url(#holo)"/><path d="M${(W-pad*2)/2-10} 2l10-10 10 10-10 10z" fill="url(#gold)"/></g>`);
 if(pc){const bx=W-pad-230;o.push(`<g transform="translate(${bx},34)" font-family="${F}"><path d="M115 0 L230 34 L230 120 Q230 170 115 196 Q0 170 0 120 L0 34Z" fill="#0c0f1f" fill-opacity=".85" stroke="url(#pl)" stroke-width="5" filter="url(#glow)"/><path d="M115 14 L214 44 L214 118 Q214 158 115 180 Q16 158 16 118 L16 44Z" fill="none" stroke="url(#pl)" stroke-opacity=".5" stroke-width="2"/>`+
  (meta.place==='champ'?`<path transform="translate(85,36) scale(1.25)" d="M8 0h32v8h8v8c0 9-6 15-14 16-2 5-6 8-10 9v7h10v6H14v-6h10v-7c-4-1-8-4-10-9C6 31 0 25 0 16V8h8zM6 13v3c0 5 3 9 8 10-2-4-2-8-2-13zm36 0h-6c0 5 0 9-2 13 5-1 8-5 8-10z" fill="url(#pl)"/>`:`<text x="115" y="96" font-size="${meta.place==='play'?44:52}" font-weight="900" font-style="italic" fill="url(#pl)" text-anchor="middle" stroke="#0b0e1f" stroke-width="3" paint-order="stroke">${meta.place==='play'?'★':X(pl.replace(/\D+/g,''))}</text>`)+
  `<text x="115" y="${meta.place==='champ'?132:126}" font-size="${pl.length>12?20:24}" font-weight="900" fill="url(#pl)" text-anchor="middle" letter-spacing="3">${X(pl.split(' · ')[0].toUpperCase())}</text><text x="115" y="156" font-size="11" font-weight="700" fill="#c9d0f2" text-anchor="middle" letter-spacing="3">${meta.event?X(String(meta.event).toUpperCase().slice(0,24)):'PLACEMENT'}</text></g>`)}
 let y=top;
 for(const [label,arr] of sections){
  const n={M:0,S:0,T:0};arr.forEach(c=>n[kind(c)]++);
  const showTypes=meta.types!==false&&label!=='EXTRA DECK',rw=W-pad*2;
  o.push(`<g transform="translate(${pad},${y})" font-family="${F}">`,
   `<path d="M0 0 H${rw-40} L${rw} ${head} H0 Z" fill="#0c0f1f" fill-opacity=".55"/>`,
   `<path d="M0 0 H${Math.min(520,rw*.5)} L${Math.min(520,rw*.5)+34} ${head} H0 Z" fill="url(#rib)" filter="url(#sh)"/>`,
   `<path d="M0 0 H${Math.min(520,rw*.5)} L${Math.min(520,rw*.5)+34} ${head} H0 Z" fill="url(#holo)" opacity=".6"/>`,
   `<rect x="0" y="0" width="8" height="${head}" fill="url(#gold)"/><path d="M0 ${head-3} H${rw}" stroke="url(#gd)" stroke-width="3"/>`,
   `<path d="M34 ${head/2-12}l12 12-12 12-12-12z" fill="url(#gold)" filter="url(#glow)"/>`,
   `<text x="62" y="${head/2+11}" font-size="30" font-weight="900" font-style="italic" fill="#fff" letter-spacing="4" stroke="#0b0e1f" stroke-width="4" paint-order="stroke">${label}</text>`,
   `<g transform="translate(${62+label.length*26+34},${head/2})"><path d="M-22 0 L-11 -19 H11 L22 0 L11 19 H-11Z" fill="#0c0f1f" stroke="url(#gold)" stroke-width="3"/><text y="9" font-size="24" font-weight="900" fill="url(#gold)" text-anchor="middle">${arr.length}</text></g>`);
  if(showTypes){let px=rw-24;for(const [k,lab,col] of [['T','TRAPS','#d9729f'],['S','SPELLS','#38c9a6'],['M','MONSTERS','#e8b25a']]){const t=`${n[k]} ${lab}`,w=t.length*10+30;px-=w;o.push(`<g transform="translate(${px},${head/2-15})"><rect width="${w-8}" height="30" rx="15" fill="${col}" fill-opacity=".18" stroke="${col}" stroke-width="2"/><text x="${(w-8)/2}" y="20" font-size="14" font-weight="800" fill="${col}" text-anchor="middle" letter-spacing="1.5">${t}</text></g>`)}}
  o.push(`</g>`);
  y+=head+14;
  arr.forEach((c,i)=>{const x=pad+(i%cols)*(cw+gap),cy=y+Math.floor(i/cols)*(ch+gap),url=deckCardImageUrl(c);
   o.push(`<rect x="${x-1}" y="${cy+4}" width="${cw+2}" height="${ch}" rx="6" fill="#000" opacity=".5"/>`);
   if(url){let a=url;try{a=new URL(url,document.baseURI).href}catch{}o.push(`<g transform="translate(${x},${cy})" clip-path="url(#cc)"><rect width="${cw}" height="${ch}" fill="#1b2147"/><image href="${X(a)}" xlink:href="${X(a)}" width="${cw}" height="${ch}" preserveAspectRatio="none"><title>${X(c.name)}</title></image></g><rect x="${x}" y="${cy}" width="${cw}" height="${ch}" rx="5" fill="none" stroke="#ffffff" stroke-opacity=".22"/>`)}
   else{const w=String(c.name||'Card').split(/\s+/);let ls=[],l='';for(const t of w){const q=l?l+' '+t:t;if(q.length>12){if(l)ls.push(l);l=t}else l=q}if(l)ls.push(l);o.push(`<rect x="${x}" y="${cy}" width="${cw}" height="${ch}" rx="5" fill="#26306a"/><text x="${x+5}" y="${cy+16}" fill="#fff" font-family="${F}" font-size="9">${ls.slice(0,7).map((t,j)=>`<tspan x="${x+5}" dy="${j?12:0}">${X(t)}</tspan>`).join('')}</text>`)}});
  y+=Math.max(1,Math.ceil(arr.length/cols))*(ch+gap)+26;
 }
 o.push(`<g transform="translate(${pad},${H-70})" font-family="${F}"><rect width="${W-pad*2}" height="3" rx="1.5" fill="url(#gd)"/><text x="0" y="36" font-size="15" font-weight="700" fill="#9aa4bd" letter-spacing="1">MADE WITH DUEL SYNAPSE: KODEX ◆ A PROJECT OF META INSIDER OCG</text><text x="${W-pad*2}" y="36" font-size="17" font-weight="900" fill="url(#gold)" text-anchor="end" letter-spacing="2">KODEX.MEIOCG.ORG</text></g></svg>`);
 return o.join('');
}
function posterHeight(d,W){const cols=13,pad=40,gap=8,cw=Math.floor((W-pad*2-gap*(cols-1))/cols),ch=Math.round(cw*86/59),sec=[copies(d,'main'),copies(d,'extra'),copies(d,'side')].filter((a,i)=>i<2||a.length);return 300+sec.reduce((h,a)=>h+64+14+Math.max(1,Math.ceil(a.length/cols))*(ch+gap)+26,0)+70}

/* ---------- minimize the duel: KodeX stays usable while the Arena keeps the duel (and the room) running ---------- */
let arenaMin=false;
(function(){const bar=document.querySelector('#Larena .arbar'),x=bar&&bar.querySelector('[data-close]');if(!bar||!x)return;
 const b=document.createElement('button');b.className='ibtn ar-min';b.id='arMin';b.setAttribute('aria-label','Minimize the duel (it keeps running)');b.title='Minimize: switch to KodeX, come back any time';b.innerHTML='<svg class="i" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 14h14"/><path d="M8 19h8"/></svg>';
 bar.insertBefore(b,x);b.onclick=()=>{arenaMin=true;history.back()};
 const p=document.createElement('button');p.id='duelPill';p.className='duel-pill';p.hidden=true;p.innerHTML='<i></i><span>Duel in progress</span><b>Return</b>';p.onclick=()=>{p.hidden=true;arenaHash='';if(!L.includes('arena'))push('arena')};document.body.append(p);})();
let arenaMinimized=false;
function arenaSet(on){const p=$('duelPill');if(on){if(p)p.hidden=true;if(arenaMinimized&&!arenaHash){arenaMinimized=false;return}arenaMinimized=false;return arenaSet0(on)}if(arenaMin){arenaMin=false;arenaMinimized=true;if(p){p.hidden=false;p.querySelector('span').textContent=arenaActive?'Duel in progress':'Duel Arena'}return}arenaMinimized=false;if(p)p.hidden=true;return arenaSet0(on)}
window.addEventListener('message',e=>{const d=e.data||{};const p=$('duelPill');if(!p||p.hidden)return;if(d.kx==='duel'){p.querySelector('span').textContent=d.active?'Duel in progress':'Duel Arena'}if(d.kx==='chat'){p.classList.add('ping');setTimeout(()=>p.classList.remove('ping'),3000)}});
mediaLoad().then(()=>{try{skinsToArena()}catch(e){}});

</script>
<style id="kx-v57">/* ---------- KodeX 9.0: Premium Studio ---------- */
.studio{--gold:#f0b429;--gold2:#ffe08a;--vio:#7a4fd6;display:grid;gap:12px;padding-bottom:18px}
.st-hero{display:flex;align-items:center;gap:12px;padding:14px;border-radius:18px;border:1px solid rgba(240,180,41,.35);background:radial-gradient(120% 140% at 0% 0%,rgba(122,79,214,.35),transparent 60%),linear-gradient(135deg,#171b3a,#0e1124 70%);box-shadow:inset 0 1px 0 rgba(255,255,255,.06)}
.st-hero img{width:44px;height:44px;object-fit:contain;flex:none;filter:drop-shadow(0 0 10px rgba(240,180,41,.45))}
.st-hero b{display:block;font-size:.72rem;letter-spacing:.2em;text-transform:uppercase;background:linear-gradient(90deg,var(--gold2),var(--gold));-webkit-background-clip:text;background-clip:text;color:transparent;font-weight:900}
.st-hero span{display:block;color:var(--muted);font-size:.8rem;line-height:1.45;margin-top:3px}
.st-tabs{position:sticky;top:-1px;z-index:3;display:flex;gap:6px;overflow-x:auto;scrollbar-width:none;padding:6px;margin:0 -2px;border-radius:16px;background:rgba(14,17,36,.92);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);border:1px solid var(--line)}
.st-tabs::-webkit-scrollbar{display:none}
.st-tabs button{flex:1 0 auto;min-width:84px;min-height:42px;padding:0 14px;border-radius:11px;border:0;background:transparent;color:var(--muted);font-weight:750;font-size:.84rem;letter-spacing:.01em;cursor:pointer;white-space:nowrap}
.st-tabs button[aria-selected="true"]{color:#140f02;background:linear-gradient(135deg,var(--gold2),var(--gold));box-shadow:0 4px 14px rgba(240,180,41,.3)}
.st-pane{display:grid;gap:12px}
.st-pane[hidden]{display:none}
.st-card{border:1px solid var(--line);border-radius:18px;background:var(--panel2);padding:14px;display:grid;gap:12px}
.st-hd{display:block}
.st-hd h4{margin:0;font-size:1rem;font-weight:800;letter-spacing:-.01em;display:flex;align-items:center;gap:8px}
.st-hd h4::before{content:"";width:4px;height:16px;border-radius:2px;background:linear-gradient(var(--gold2),var(--gold))}
.st-hd p{margin:4px 0 0;color:var(--muted);font-size:.8rem;line-height:1.5}
.studio .sk-sec{margin:0}
.studio .btn{width:auto}
.st-wide,.st-pv{width:100%!important;min-height:46px}
.st-pv{border-color:rgba(240,180,41,.45)!important;background:rgba(240,180,41,.08)!important;font-weight:750}
/* style grids: big, clear tiles */
.studio .fin-row,.st-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(92px,1fr));gap:8px;margin:0}
.studio .fin-t,.st-tile{position:relative;display:grid;justify-items:center;align-content:center;gap:7px;min-height:92px;padding:12px 6px 10px;border-radius:14px;border:1px solid var(--line);background:linear-gradient(180deg,rgba(255,255,255,.035),rgba(255,255,255,0));color:var(--text);font-weight:700;font-size:.78rem;cursor:pointer;transition:border-color .15s,transform .08s,box-shadow .15s}
.studio .fin-t:active,.st-tile:active{transform:scale(.97)}
.studio .fin-t span,.st-tile span{font-size:.76rem;line-height:1.15;text-align:center;white-space:normal;overflow:visible;max-width:100%}
.studio .fin-t.on,.st-tile.on{border-color:var(--gold);box-shadow:0 0 0 1px var(--gold) inset,0 6px 20px rgba(240,180,41,.18);background:linear-gradient(180deg,rgba(240,180,41,.14),rgba(240,180,41,.02))}
.studio .fin-t svg,.st-ic svg{width:38px;height:38px;display:block;overflow:visible}
.st-ic{display:grid;place-items:center;width:44px;height:44px;border-radius:50%;background:radial-gradient(circle,rgba(141,153,255,.18),transparent 70%);color:#c9d0ff}
.st-tile.on .st-ic{color:var(--gold2);background:radial-gradient(circle,rgba(240,180,41,.25),transparent 70%)}
.st-tile.prem{opacity:.6}
.st-lock{position:absolute;top:6px;right:7px;font-style:normal;font-size:.7rem;color:var(--gold)}
.st-slider{display:grid;gap:6px;padding:10px 12px;border-radius:14px;border:1px solid var(--line);background:rgba(0,0,0,.18)}
.st-slider label{display:flex;justify-content:space-between;align-items:center;font-size:.85rem}
.st-slider output{font-weight:800;color:var(--gold2);font-variant-numeric:tabular-nums}
.st-slider input{width:100%;accent-color:var(--gold)}
/* switches */
.st-switch{display:flex;align-items:center;gap:12px;padding:12px 14px;border-radius:14px;border:1px solid var(--line);background:rgba(0,0,0,.18);cursor:pointer;min-height:58px}
.st-switch>span{flex:1;display:grid;gap:2px}
.st-switch small{color:var(--muted);font-size:.76rem;line-height:1.4}
.st-switch input{position:absolute;opacity:0;width:1px;height:1px}
.st-switch i{flex:none;width:50px;height:30px;border-radius:15px;background:#2a3047;position:relative;transition:background .15s}
.st-switch i::after{content:"";position:absolute;left:3px;top:3px;width:24px;height:24px;border-radius:50%;background:#fff;transition:transform .18s;box-shadow:0 2px 6px rgba(0,0,0,.4)}
.st-switch input:checked+i{background:linear-gradient(90deg,var(--gold),var(--gold2))}
.st-switch input:checked+i::after{transform:translateX(20px)}
.st-switch input:focus-visible+i{outline:2px solid var(--accent);outline-offset:2px}
/* signature cards */
.st-search{position:relative}
.st-search input{width:100%;min-height:48px;border-radius:14px;padding:0 14px;border:1px solid var(--line);background:rgba(0,0,0,.25);color:var(--text);font-size:.95rem}
.st-res{display:grid;gap:6px;margin-top:6px}
.st-res:empty{display:none}
.st-hit,.st-sig{display:flex;align-items:center;gap:12px;width:100%;text-align:left;padding:8px 10px;border-radius:14px;border:1px solid var(--line);background:rgba(255,255,255,.03);color:var(--text);cursor:pointer;min-height:64px}
.st-hit:disabled{opacity:.55}
.st-hit>span:nth-child(2),.st-sigt{flex:1;min-width:0;display:grid;gap:2px}
.st-hit b,.st-sigt b{font-size:.9rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.st-hit small,.st-sigt small{color:var(--muted);font-size:.74rem}
.st-hit em{font-style:normal;font-weight:800;font-size:.78rem;color:var(--gold2);padding:6px 10px;border-radius:10px;background:rgba(240,180,41,.12)}
.st-th{flex:none;width:40px;aspect-ratio:59/86;border-radius:5px;overflow:hidden;background:#1b2147;box-shadow:0 2px 8px rgba(0,0,0,.4)}
.st-th.big{width:64px}
.st-th img{width:100%;height:100%;object-fit:cover;display:block}
.st-sigs{display:grid;gap:8px}
.st-sig:hover{border-color:rgba(240,180,41,.5)}
.st-chips{display:flex;flex-wrap:wrap;gap:4px;margin-top:3px}
.st-chips .ch{font-style:normal;font-size:.68rem;font-weight:750;padding:3px 8px;border-radius:999px;background:rgba(141,153,255,.14);color:#c9d0ff}
.st-chips .ch.ace{background:linear-gradient(90deg,var(--gold2),var(--gold));color:#140f02}
.st-chips .ch.dim{background:rgba(255,255,255,.06);color:var(--muted)}
.st-go{color:var(--muted);flex:none}
.st-empty{display:grid;gap:4px;padding:16px;border-radius:14px;border:1px dashed var(--line);text-align:center}
.st-empty span{color:var(--muted);font-size:.8rem;line-height:1.5}
/* emotes and sounds inside the studio */
.studio .em-row{display:grid;grid-template-columns:repeat(auto-fill,minmax(76px,1fr));gap:8px}
.studio .em-t{width:auto;aspect-ratio:1}
.studio .snd-add{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.studio .snd-row{display:flex;align-items:center;gap:8px;padding:8px 0;border-top:1px solid var(--line)}
.studio .snd-row:first-child{border-top:0}
.studio .snd-row>span{flex:1;display:grid}
.studio .snd-row small{color:var(--muted);font-size:.74rem}
.studio .snd-row .btn{flex:none;min-height:42px}
/* the card editor */
.dlg.se{gap:10px}
.se-head{display:flex;align-items:center;gap:12px;padding:10px;border-radius:14px;background:radial-gradient(120% 140% at 0% 0%,rgba(122,79,214,.3),transparent 60%),rgba(0,0,0,.2);border:1px solid var(--line)}
.se-head>div{display:grid;gap:3px;min-width:0}
.se-head b{font-size:1rem;line-height:1.25}
.se-head small{color:var(--muted);font-size:.76rem}
.se-ace input:checked+i{background:linear-gradient(90deg,#f0b429,#ffe08a)}
.se-row{display:grid;gap:8px;padding:10px 12px;border-radius:14px;border:1px solid var(--line);background:rgba(0,0,0,.18)}
.se-l{display:grid;gap:2px}
.se-l small{color:var(--muted);font-size:.74rem;line-height:1.4}
.se-c{display:flex;gap:8px;align-items:center}
.se-sel{flex:1;min-width:0}
.se-sel select{width:100%;min-height:46px;border-radius:12px;padding:0 12px;border:1px solid var(--line);background:var(--panel2);color:var(--text);font-size:.9rem;font-weight:650}
.se-pv{flex:none;width:46px;height:46px;border-radius:12px;border:1px solid rgba(240,180,41,.45);background:rgba(240,180,41,.1);color:#ffe08a;font-size:1rem;cursor:pointer}
.se-vb{flex-wrap:wrap}
.se-vb .btn{flex:1 1 auto;width:auto;min-height:44px}
.se-foot{display:flex;gap:8px;margin-top:4px}
.se-foot .btn{flex:1;width:auto;min-height:48px}
.st-danger{color:#ff8d95!important;border-color:rgba(255,77,106,.4)!important;background:rgba(255,77,106,.08)!important}
/* showdown icons: a little life on the chosen one */
.st-tile.on .st-ic svg{animation:stPulse 1.6s ease-in-out infinite}
@keyframes stPulse{50%{transform:scale(1.08);filter:drop-shadow(0 0 6px currentColor)}}
@media (prefers-reduced-motion:reduce){.st-tile.on .st-ic svg{animation:none}}

/* ---------- KodeX 9.0: offline database (Settings) ---------- */
.grp.odb{padding:6px 14px 10px}
.odb-blk{padding:12px 0;display:grid;gap:8px}
.odb-blk+.odb-blk{border-top:1px solid var(--line)}
.odb-hd{display:flex;align-items:center;gap:12px}
.odb-hd>div{display:grid;gap:2px;min-width:0}
.odb-hd small{color:var(--muted);font-size:.78rem;line-height:1.4}
.odb-ic{flex:none;width:38px;height:38px;border-radius:12px;display:grid;place-items:center;background:var(--soft);color:var(--accent)}
.odb .prog{margin:2px 0}
.odb-q{display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:.84rem}
.odb-q[hidden]{display:none}
.odb-q select{min-height:40px;border-radius:10px;border:1px solid var(--line);background:var(--panel);color:var(--text);padding:0 10px;max-width:62%}
.odb-acts{display:flex;gap:8px;flex-wrap:wrap}
.odb-acts .btn{flex:1 1 auto;width:auto;min-height:44px}
.odb-acts .btn.p{flex:2 1 160px}
.odb-folder .note b{color:var(--text);word-break:break-all}
.odb-web:empty{display:none}
.studio .st-pane>.sk-sec{border:1px solid var(--line);border-radius:18px;background:var(--panel2);padding:14px;display:grid;gap:10px}
.studio .st-pane>.sk-sec .sk-hd h4{margin:0;font-size:1rem;font-weight:800;display:flex;align-items:center;gap:8px}
.studio .st-pane>.sk-sec .sk-hd h4::before{content:"";width:4px;height:16px;border-radius:2px;background:linear-gradient(#ffe08a,#f0b429)}
.studio .st-pane>.sk-sec .note{margin:0}
</style>
<script id="kx-v57-late">
/* ---------- KodeX 9.0 (loaded last: these replace earlier versions) ---------- */
/* ===== showdowns: one set of styles for the winning blow and for Ace cards ===== */
const SHOW_DESC={menacing:'Rumbling ゴゴゴ letters around your card',rush:'A barrage of blows and RUSH! RUSH!',timestop:'Everything freezes in grey around your card',freeze:'Sepia freeze frame with TO BE CONTINUED',domain:'A void swallows the screen, a sigil turns behind your card',allout:'Red and black comic panels, cut-out title',impact:'Black-and-white impact frames on every hit',destiny:'One card flies from the deck in gold and turns over',finalblow:'Slow zoom, flash, then K.O.!',powerup:'A golden aura bursts, the ground shakes',beam:'Energy gathers, then a beam crosses the screen',spotlight:'A spotlight and a turning reveal',radiant:'Golden rays from behind your card',random:'A different one each time'};
const showName=k=>k==='random'?'Random':((FINALE_T.find(x=>x[0]===k)||['',k])[1]);
const finaleMs=()=>{const v=Number(S.g('finale_ms',3300));return Number.isFinite(v)?Math.min(5000,Math.max(3000,Math.round(v/100)*100)):3300};
function sigShow(){const o=S.g('sig_show',{}),out={};if(o&&typeof o==='object')for(const k of sigCards())if(o[k]==='random'||FINALE_T.some(x=>x[0]===o[k]))out[k]=o[k];return out}
function showTiles(kind,sel){const all=[...FINALE_T,['random','Random']];return `<div class="st-grid show-row" role="radiogroup" aria-label="${kind==='finale'?'Winning blow':'Ace showdown'}">${all.map(([k,l])=>{const lock=!PREMIUM&&kind==='finale'&&k!=='menacing';return `<button type="button" class="st-tile sh-${k}${sel===k?' on':''}${lock?' prem':''}" role="radio" aria-checked="${sel===k}" data-show="${kind}" data-showk="${k}" title="${esc(SHOW_DESC[k]||'')}"><i class="st-ic">${SHOW_ICON[k]||''}</i><span>${l}</span>${lock?'<em class="st-lock" aria-label="KodeX Premium">★</em>':''}</button>`}).join('')}</div>`}
function previewShow(kind,k){const l=showName(k),ms=kind==='finale'?finaleMs():0;openModal(`<div class="dk-hd"><h3>${esc(l)} · ${kind==='finale'?'winning blow':'Ace card'}</h3><button class="ibtn" data-close aria-label="Close">${ic('x')}</button></div><iframe class="pv-wrap" title="Preview" src="${ARENA_URL}preview.html#${kind}:${k}${ms?':'+ms:''}"></iframe><p class="note">${kind==='finale'?`Plays for ${(ms/1000).toFixed(1)} seconds before the blow that wins the duel: an attack, or a Spell, Trap or effect that deals the last damage. Everyone in the duel sees it.`:'Your Ace cards (any card type) are shown on the big screen before their effect resolves.'}${k==='random'?' Random picks a different showdown each time; both players see the same one.':''}${PREMIUM?'':kind==='finale'?' Free edition: Menacing. The others come with KodeX Premium.':' Ace cards come with KodeX Premium.'}</p>`,'','pv')}

/* ===== the Arena gets card passcodes (cards are saved by Konami ID in KodeX) ===== */
let KP=null,KPn=0;
function pcode(id){id=String(id);if(!KP||KPn!==cards.length){KP=new Map();KPn=cards.length;for(const c of cards)if(c.kid)KP.set(String(c.kid),String(c.id))}return KP.get(id)||id}
const pcKeys=o=>{const out={};for(const [k,v] of Object.entries(o||{}))out[pcode(k)]=v;return out};
function skinsToArena(){const f=$('arenaFrame');if(!PREMIUM||!f||!f.contentWindow)return;const voices={};for(const id of sigCards()){const v=MEDIA.voices[id];if(v&&v.snd)voices[pcode(id)]=v.snd}
 try{f.contentWindow.postMessage({kx:'skin',premium:PREMIUM,sleeve:skinImg('sleeve'),xsleeve:skinImg('xsleeve'),field:fieldSkin(),signature:sigCards().map(pcode).map(Number),finisher:finStyle(),sigFx:pcKeys(sigFx()),entrance:entStyle(),attack:atkStyle(),entFx:pcKeys(perCardFx('sig_ent',ENT_T)),atkFx:pcKeys(perCardFx('sig_atk',ATK_T)),finale:finaleStyle(),aceStyle:aceStyle(),aces:aceCards().map(pcode).map(Number),finaleMs:finaleMs(),showFx:pcKeys(sigShow()),emotes:MEDIA.emotes.map(x=>({name:x.name,src:x.src,snd:x.snd||''})),sounds:MEDIA.sounds.map(x=>({name:x.name,snd:x.snd})),voices},'*')}catch(e){}audioToArena()}

/* ===== Premium Studio: everything Premium in one organized place ===== */
const STUDIO_TABS=[['look','Look'],['moves','Moves'],['shows','Showdowns'],['cards','Cards'],['emotes','Emotes'],['sound','Sound']];
let studioTab=S.g('studio_tab','look');
const sCard=(title,desc,body,extra='')=>`<section class="st-card"${extra}><div class="st-hd"><h4>${title}</h4>${desc?`<p>${desc}</p>`:''}</div>${body}</section>`;
function cardOf(id){return M.get(String(id))||cards.find(v=>String(v.kid)===String(id))||null}
function cardThumb(c){if(!c)return '';const u=c.sm||c.img||(c.id?'https://images.ygoprodeck.com/images/cards_small/'+c.id+'.jpg':'');return u?`<img data-u="${esc(u)}" alt="" loading="lazy">`:''}
function sigRows(){const a=sigCards(),aces=new Set(aceCards().map(String)),sh=sigShow(),fx=S.g('sig_fx',{})||{},en=S.g('sig_ent',{})||{},at=S.g('sig_atk',{})||{};
 if(!a.length)return '<div class="st-empty"><b>No signature cards yet</b><span>Search above to add your favourite cards. Bosses (3000+ ATK, Level 8+, Link 4+) always get an entrance.</span></div>';
 return a.map(id=>{const c=cardOf(id)||{},chips=[aces.has(id)?'<em class="ch ace">★ Ace</em>':'',sh[id]?`<em class="ch">${esc(showName(sh[id]))}</em>`:'',fx[id]?`<em class="ch">${esc((FIN_T.find(x=>x[0]===fx[id])||['',''])[1])}</em>`:'',en[id]?`<em class="ch">${esc((ENT_T.find(x=>x[0]===en[id])||['',''])[1])}</em>`:'',at[id]?`<em class="ch">${esc((ATK_T.find(x=>x[0]===at[id])||['',''])[1])}</em>`:'',MEDIA.voices[id]?'<em class="ch">🎙 Voice</em>':''].filter(Boolean).join('');
  return `<button type="button" class="st-sig" data-sigopen="${esc(id)}"><span class="st-th">${cardThumb(c)}</span><span class="st-sigt"><b>${esc(c.name||id)}</b><small>${esc(String(c.type||'').replace(/ Card$/,''))}</small><span class="st-chips">${chips||'<em class="ch dim">Default moves</em>'}</span></span><span class="st-go" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></span></button>`}).join('')}
function openSkins(){
 const sel=skinSel(),all=[...skinPacks(),...skinsOwn()],chk='<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"/></svg>';
 if(!STUDIO_TABS.some(t=>t[0]===studioTab))studioTab='look';
 const look=SKIN_T.map(([t,l])=>sCard(l,t==='field'?'Your half of the duel field. Your opponent sees it too.':t==='sleeve'?'The back of your Main Deck cards.':'The back of your face-down Extra Deck cards.',`<div class="sk-row sk-${t}" role="listbox" aria-label="${l}"><button class="sk-t sk-none${!sel[t]?' on':''}" data-skin="" data-skt="${t}" role="option" aria-selected="${!sel[t]}"><span>Default</span>${!sel[t]?`<em>${chk}</em>`:''}</button>${all.filter(x=>x.type===t).map(x=>`<button class="sk-t${sel[t]===x.id?' on':''}" data-skin="${esc(x.id)}" data-skt="${t}" role="option" aria-selected="${sel[t]===x.id}" style="background-image:url('${safeImg(x.img)}')" aria-label="${esc(x.name||'Skin')}">${sel[t]===x.id?`<em>${chk}</em>`:''}${x.pre?'':`<i data-skdel="${esc(x.id)}" role="button" aria-label="Delete">×</i>`}</button>`).join('')}<label class="sk-t sk-add" aria-label="Add from gallery"><span>+</span><input type="file" accept="image/*" data-skadd="${t}" hidden></label></div>${t==='field'&&sel.field?'<button class="btn st-wide" data-fieldedit>Adjust zoom, position and darkness</button>':''}`)).join('')
  +sCard('KodeX effects','',`<label class="st-switch"><span><strong>MEIOCG animations</strong><small>Moving background, floating MEIOCG cards and animated lists in KodeX</small></span><input type="checkbox" data-kxfx ${S.g('kx_fx',true)?'checked':''}><i aria-hidden="true"></i></label>`);
 const moves=sCard('Finishing move','How your opponent\'s field breaks when you win.',`${finTiles(finStyle())}<button type="button" class="btn st-pv" data-finpv>▶ Preview ${FIN_T.find(x=>x[0]===finStyle())[1]}</button>`)
  +sCard('Entrance','How your monsters arrive on the field. Everyone in the duel sees it.',`${mvTiles('ent',entStyle())}<button type="button" class="btn st-pv" data-mvpv="ent">▶ Preview ${ENT_T.find(x=>x[0]===entStyle())[1]}</button>`)
  +sCard('Attack','How your monsters attack. The target is always marked.',`${mvTiles('atk',atkStyle())}<button type="button" class="btn st-pv" data-mvpv="atk">▶ Preview ${ATK_T.find(x=>x[0]===atkStyle())[1]}</button>`);
 const ms=finaleMs();
 const shows=sCard('Winning blow','Plays before the blow that wins the duel: an attack, or a Spell, Trap or effect that deals the last damage. Cards with their own showdown (in Cards) use theirs.',`${showTiles('finale',finaleStyle())}<div class="st-slider"><label for="stMs"><strong>Length</strong><output id="stMsV">${(ms/1000).toFixed(1)} s</output></label><input id="stMs" type="range" min="3000" max="5000" step="100" value="${ms}" data-finms aria-label="Length of the winning blow"></div><button type="button" class="btn st-pv" data-showpv="finale">▶ Preview ${esc(showName(finaleStyle()))}</button>`)
  +sCard('Ace showdown','Your Ace cards (any card type: monsters, Spells, Traps) fill the screen before their effect resolves. Mark Ace cards in Cards.',`${showTiles('ace',aceStyle())}<button type="button" class="btn st-pv" data-showpv="ace">▶ Preview ${esc(showName(aceStyle()))}</button>`);
 const cardsP=sCard('Signature cards','Your cards with the full show. Tap a card to choose its showdown, finishing move, entrance, attack and voice, or make it an Ace card.',`<div class="st-search"><input data-sigq placeholder="Add a card by name" aria-label="Add a signature card" autocomplete="off"><div data-sigres class="st-res"></div></div><div class="st-sigs" data-siglist>${sigRows()}</div><p class="note">${sigCards().length}/60 cards · ${aceCards().length}/12 Ace cards</p>`);
 const emotes=emotesSection()+soundsSection();
 const sound=sCard('Music &amp; sounds','MP3, M4A, OGG or WAV. Music up to 8 MB, sounds up to 1 MB. Played in the Arena on this device.',`<div class="snd-list">${SND_T.map(([k,l])=>`<div class="snd-row" data-snd="${k}"><span><strong>${l}</strong><small data-sndname>Default</small></span><label class="btn">Choose<input type="file" accept="audio/*" data-sndadd="${k}" hidden></label><button class="btn" data-snddel="${k}" hidden>Reset</button></div>`).join('')}</div>`);
 const panes={look,moves,shows,cards:cardsP,emotes,sound};
 tool('Premium Studio',`<div class="studio"><div class="st-hero"><img src="${(document.querySelector('header .logo img')||{}).src||''}" alt="" onerror="this.remove()"><div><b>KodeX Premium</b><span>Make every duel yours. Your look, moves and showdowns are shown to your opponent too.</span></div></div><nav class="st-tabs" role="tablist" aria-label="Premium Studio">${STUDIO_TABS.map(([k,l])=>`<button type="button" role="tab" data-stab="${k}" aria-selected="${k===studioTab}">${l}</button>`).join('')}</nav>${STUDIO_TABS.map(([k])=>`<div class="st-pane" data-spane="${k}"${k===studioTab?'':' hidden'}>${panes[k]}</div>`).join('')}</div>`);
 const tb=$('tb');
 tb.querySelectorAll('[data-stab]').forEach(b=>b.onclick=()=>{studioTab=b.dataset.stab;S.s('studio_tab',studioTab);tb.querySelectorAll('[data-stab]').forEach(x=>x.setAttribute('aria-selected',String(x===b)));tb.querySelectorAll('[data-spane]').forEach(p=>p.hidden=p.dataset.spane!==studioTab);b.scrollIntoView({inline:'center',block:'nearest'});tb.scrollTop=0});
 tb.querySelectorAll('[data-skt]').forEach(b=>b.onclick=e=>{const del=e.target.closest('[data-skdel]');if(del){e.stopPropagation();skinsSave(skinsOwn().filter(x=>x.id!==del.dataset.skdel));const s=skinSel();for(const k in s)if(s[k]===del.dataset.skdel)delete s[k];S.s('skin_sel',s);skinsToArena();openSkins();return}const s=skinSel(),was=s[b.dataset.skt];if(b.dataset.skin)s[b.dataset.skt]=b.dataset.skin;else delete s[b.dataset.skt];S.s('skin_sel',s);skinsToArena();openSkins();if(b.dataset.skt==='field'&&b.dataset.skin&&was!==b.dataset.skin)openFieldEditor()});
 const fe=tb.querySelector('[data-fieldedit]');if(fe)fe.onclick=openFieldEditor;
 sndPanel(tb);movesPanel(tb);
 tb.querySelectorAll('[data-fin]').forEach(b=>b.onclick=()=>{S.s('fin_style',b.dataset.fin);tb.querySelectorAll('[data-fin]').forEach(x=>{x.classList.toggle('on',x===b);x.setAttribute('aria-checked',String(x===b))});const pv=tb.querySelector('[data-finpv]');if(pv)pv.textContent='▶ Preview '+b.textContent.trim();skinsToArena()});
 {const pv=tb.querySelector('[data-finpv]');if(pv)pv.onclick=()=>previewFin(finStyle())}
 tb.querySelectorAll('[data-mv]').forEach(b=>{const o=b.onclick;b.onclick=e=>{o&&o(e);const pv=tb.querySelector(`[data-mvpv="${b.dataset.mv}"]`);if(pv)pv.textContent='▶ Preview '+b.textContent.trim()}});
 tb.querySelectorAll('[data-show]').forEach(b=>b.onclick=()=>{const kind=b.dataset.show;if(!PREMIUM&&b.classList.contains('prem')){openPremiumInfo();return}S.s(kind==='finale'?'finale_style':'ace_style',b.dataset.showk);tb.querySelectorAll(`[data-show="${kind}"]`).forEach(x=>{x.classList.toggle('on',x===b);x.setAttribute('aria-checked',String(x===b))});const pv=tb.querySelector(`[data-showpv="${kind}"]`);if(pv)pv.textContent='▶ Preview '+showName(b.dataset.showk);skinsToArena()});
 tb.querySelectorAll('[data-showpv]').forEach(b=>b.onclick=()=>previewShow(b.dataset.showpv,b.dataset.showpv==='finale'?finaleStyle():aceStyle()));
 const r=tb.querySelector('[data-finms]');if(r){r.oninput=()=>{$('stMsV').textContent=(r.value/1000).toFixed(1)+' s'};r.onchange=()=>{S.s('finale_ms',+r.value);skinsToArena()}}
 const fxi=tb.querySelector('[data-kxfx]');if(fxi)fxi.onchange=()=>{S.s('kx_fx',fxi.checked);kxFx()};
 tb.querySelectorAll('[data-skadd]').forEach(inp=>inp.onchange=async()=>{const f=inp.files&&inp.files[0];if(!f)return;try{const t=inp.dataset.skadd,img=await shrinkImage(f,t==='field'?1000:420),id='u'+Date.now().toString(36);if(skinsSave([...skinsOwn(),{id,type:t,name:f.name.slice(0,40),img}])){const s=skinSel();s[t]=id;S.s('skin_sel',s);skinsToArena();openSkins();if(t==='field')openFieldEditor()}}catch(e){toast('That picture could not be used')}});
 studioCards(tb);
}
function studioCards(tb){const qi=tb.querySelector('[data-sigq]'),res=tb.querySelector('[data-sigres]'),lst=tb.querySelector('[data-siglist]');if(!qi)return;
 const code=c=>String(/^\d{3,10}$/.test(String(c.kid||''))?c.kid:c.id);
 const draw=()=>{lst.innerHTML=sigRows();lst.querySelectorAll('[data-sigopen]').forEach(b=>b.onclick=()=>openSigEditor(b.dataset.sigopen,draw));const n=lst.nextElementSibling;if(n)n.textContent=`${sigCards().length}/60 cards · ${aceCards().length}/12 Ace cards`};
 qi.oninput=()=>{const t=nt(qi.value);if(t.length<2){res.innerHTML='';return}const hits=[];for(const c of cards){if(nt(c.name).includes(t)){hits.push(c);if(hits.length>=8)break}}const have=new Set(sigCards());
  res.innerHTML=hits.map(c=>`<button type="button" class="st-hit" data-sigadd="${esc(code(c))}"${have.has(code(c))?' disabled':''}><span class="st-th">${cardThumb(c)}</span><span><b>${esc(c.name)}</b><small>${esc(String(c.type||'').replace(/ Card$/,''))}</small></span><em>${have.has(code(c))?'Added':'+ Add'}</em></button>`).join('');
  res.querySelectorAll('[data-sigadd]').forEach(b=>b.onclick=()=>{const a=sigCards();if(!a.includes(b.dataset.sigadd)){if(a.length>=60){toast('Up to 60 signature cards');return}a.push(b.dataset.sigadd);S.s('sig_cards',a);skinsToArena()}qi.value='';res.innerHTML='';draw();openSigEditor(b.dataset.sigadd,draw)})};
 lst.querySelectorAll('[data-sigopen]').forEach(b=>b.onclick=()=>openSigEditor(b.dataset.sigopen,draw));
}
/** One signature card: its showdown, finishing move, entrance, attack, voice, Ace card. */
function openSigEditor(id,onDone){
 const c=cardOf(id)||{},mon=/Monster/i.test(c.type||''),get=k=>(S.g(k,{})||{})[id]||'',isAce=aceCards().map(String).includes(String(id));
 const opt=(T,cur,def)=>`<option value="">${def}</option>`+T.map(([k,l])=>`<option value="${k}"${cur===k?' selected':''}>${l}</option>`).join('');
 const row=(key,label,help,sel,pv)=>`<div class="se-row"><label class="se-l" for="se_${key}"><strong>${label}</strong><small>${help}</small></label><div class="se-c"><div class="se-sel">${sel}</div><button type="button" class="se-pv" data-sepv="${pv}" aria-label="Preview ${label}">▶</button></div></div>`;
 const m=openModal(`<div class="dk-hd"><h3>Card settings</h3><button class="ibtn" data-close aria-label="Close">${ic('x')}</button></div>
 <div class="se-head"><span class="st-th big">${cardThumb(c)}</span><div><b>${esc(c.name||id)}</b><small>${esc(c.type||'')}</small></div></div>
 <label class="st-switch se-ace"><span><strong>★ Ace card</strong><small>Fills the screen before it resolves. Up to 12.</small></span><input type="checkbox" data-se="ace" ${isAce?'checked':''}><i aria-hidden="true"></i></label>
 ${row('show','Showdown','Before its winning blow, and as an Ace card',`<select id="se_show" data-se="show">${opt([...FINALE_T,['random','Random']],get('sig_show'),'My default ('+esc(showName(finaleStyle()))+')')}</select>`,'show')}
 ${row('fx','Finishing move','When it lands the winning blow',`<select id="se_fx" data-se="fx">${opt(FIN_T,get('sig_fx'),'My default ('+esc((FIN_T.find(x=>x[0]===finStyle())||['',''])[1])+')')}</select>`,'fx')}
 ${mon?row('ent','Entrance','When it is summoned',`<select id="se_ent" data-se="ent">${opt(ENT_T,get('sig_ent'),'My default ('+esc((ENT_T.find(x=>x[0]===entStyle())||['',''])[1])+')')}</select>`,'ent')+row('atk','Attack','When it attacks',`<select id="se_atk" data-se="atk">${opt(ATK_T,get('sig_atk'),'My default ('+esc((ATK_T.find(x=>x[0]===atkStyle())||['',''])[1])+')')}</select>`,'atk'):'<p class="note">Spells and Traps use the showdown, finishing move and voice; entrances and attacks are for monsters.</p>'}
 <div class="se-row se-voice"><div class="se-l"><strong>Voice</strong><small data-sevs>${MEDIA.voices[id]?'Your sound plays when this card is activated or summoned':'No sound yet: the usual sound plays'}</small></div><div class="se-c se-vb"><button type="button" class="btn" data-sev="set">${MEDIA.voices[id]?'Change':'🎙 Add sound'}</button><button type="button" class="btn" data-sev="play"${MEDIA.voices[id]?'':' hidden'}>▶ Play</button><button type="button" class="btn" data-sev="del"${MEDIA.voices[id]?'':' hidden'}>Remove</button></div></div>
 <div class="se-foot"><button type="button" class="btn st-danger" data-sedel>Remove card</button><button type="button" class="btn p" data-close>Done</button></div>`,'se','se');
 const save=(key,v)=>{const o=Object.assign({},S.g(key,{}));if(v)o[id]=v;else delete o[id];S.s(key,o);skinsToArena()};
 m.querySelector('[data-se="ace"]').onchange=e=>{const s=new Set(S.g('ace_cards',[]).map(String));if(e.target.checked){if(aceCards().length>=12){e.target.checked=false;toast('Up to 12 Ace cards');return}s.add(String(id))}else s.delete(String(id));S.s('ace_cards',[...s]);skinsToArena()};
 for(const [k,key] of [['show','sig_show'],['fx','sig_fx'],['ent','sig_ent'],['atk','sig_atk']]){const sl=m.querySelector(`[data-se="${k}"]`);if(sl)sl.onchange=()=>save(key,sl.value)}
 m.querySelectorAll('[data-sepv]').forEach(b=>b.onclick=()=>{const k=b.dataset.sepv,v=(m.querySelector(`[data-se="${k}"]`)||{}).value;if(k==='show')previewShow(m.querySelector('[data-se="ace"]').checked?'ace':'finale',v||finaleStyle());else if(k==='fx')previewFin(v||finStyle());else previewMove(k,v||(k==='ent'?entStyle():atkStyle()))});
 const vs=m.querySelector('[data-sevs]'),vb=k=>m.querySelector(`[data-sev="${k}"]`),vdraw=()=>{const on=!!MEDIA.voices[id];vs.textContent=on?'Your sound plays when this card is activated or summoned':'No sound yet: the usual sound plays';vb('set').textContent=on?'Change':'🎙 Add sound';vb('play').hidden=!on;vb('del').hidden=!on};
 vb('set').onclick=()=>soundFor(async snd=>{if(!snd)return;MEDIA.voices[id]={snd};await mediaSave();skinsToArena();vdraw();toast('Card voice saved')},false);
 vb('play').onclick=()=>{const v=MEDIA.voices[id];if(v)playData(v.snd)};
 vb('del').onclick=async()=>{delete MEDIA.voices[id];await mediaSave();skinsToArena();vdraw()};
 m.querySelector('[data-sedel]').onclick=()=>{S.s('sig_cards',sigCards().filter(x=>x!==String(id)));const s=new Set(S.g('ace_cards',[]).map(String));s.delete(String(id));S.s('ace_cards',[...s]);skinsToArena();history.back()};
 const obs=new MutationObserver(()=>{if(!m.isConnected){obs.disconnect();onDone&&onDone()}});obs.observe(document.body,{childList:true});
}

/* ===== Settings: the Premium entry opens the Studio ===== */
{const b=$('bPrem'),sp=b&&b.querySelector('span');if(PREMIUM&&sp)sp.textContent='Premium Studio'}
// (the back-navigation fix is in the main script: minimizing no longer asks "Leave the duel?")

/* ===== offline card database: pictures and rulings on this device, in folders you can fill yourself ===== */
const KXF=window.CastelFiles||null,PIC_DIR='KodeX/pics',RUL_DIR='KodeX/rulings';
const ODB={ids:new Set(),webCount:0,job:'',busy:false};
const picId=u=>{const m=/\/(?:images\/cards(?:_small)?|img(?:\/full)?)\/(\d{3,10})\.jpg(?:$|\?)/.exec(u||'');return m?m[1]:''};
function odbScan(){if(KXF){try{KXF.ensure(PIC_DIR+','+RUL_DIR);if(!KXF.exists('KodeX/README.txt'))KXF.writeText('KodeX/README.txt','KodeX offline database\n\npics/     card pictures, named by passcode: 89631139.jpg (the same names desktop duel clients use).\n          Paste pictures here, or download them all in KodeX: Settings > Offline database.\nrulings/  rulings, named by Konami ID: 4007.json. Downloaded by KodeX, or pasted here.\n\nKodeX uses whatever is in these folders, no internet needed.\n');const a=JSON.parse(KXF.list(PIC_DIR));ODB.ids=new Set(a.map(n=>(/^(\d{3,10})\.(jpe?g|png|webp)$/i.exec(n)||[])[1]).filter(Boolean))}catch(e){}picsToArena()}}
async function odbWebCount(){try{ODB.webCount=(await kvCur('p:',false)).length}catch(e){ODB.webCount=0}}
function picsToArena(){const f=$('arenaFrame');if(!KXF||!f||!f.contentWindow)return;try{f.contentWindow.postMessage({kx:'pics',base:KXF.url(PIC_DIR)+'/',ids:[...ODB.ids].map(Number)},'*')}catch(e){}}
/** A picture saved on the phone, for a card picture address. */
const PICM=new Map();
async function localPicUrl(u){const id=picId(u);if(!id)return null;if(KXF)return ODB.ids.has(id)?KXF.url(PIC_DIR+'/'+id+'.jpg'):null;if(!ODB.webCount)return null;if(PICM.has(id))return PICM.get(id);try{const b=await kv('get','p:'+id);if(b instanceof Blob){const o=URL.createObjectURL(b);PICM.set(id,o);return o}}catch(e){}return null}
// pictures on screen come from the phone first (the deck image keeps using its own copies, which it can embed)
function kxHydrate(im){if(im.dataset.h||!im.dataset.u)return;im.dataset.h='1';const u=im.dataset.u;localPicUrl(u).then(l=>l||icGet(u)).then(v=>{im.src=v||u},()=>{im.src=u})}
async function kxImgErr(im){const u=im.dataset.u||im.src;if(!im.dataset.lpTried){im.dataset.lpTried='1';const l=await localPicUrl(u);if(l&&im.src!==l){im.style.visibility='';im.src=l;return}}return kxImgErr0(im)}
/** Rulings: the copy in the rulings folder counts as saved. Downloads are copied there too. */
async function getRul(id,force){
 let c=await kv('get','r:'+id);
 if(!c&&KXF){try{const t=KXF.readText(RUL_DIR+'/'+id+'.json');if(t){const d=JSON.parse(t);if(d&&Array.isArray(d.records)){c={t:Date.now(),data:d};kv('put','r:'+id,c)}}}catch(e){}}
 if(c&&c.data&&!force&&Date.now()-c.t<TTL)return c;
 try{const d=await fj(RUL+encodeURIComponent(id)+'.json',15000);if(!d||!Array.isArray(d.records))throw Error('bad');const r={t:Date.now(),data:d};await kv('put','r:'+id,r);if(KXF)try{KXF.writeText(RUL_DIR+'/'+id+'.json',JSON.stringify(d))}catch(e){}return r}
 catch(e){if(c&&c.data)return Object.assign({stale:1},c);throw e}
}
const fmtMB=b=>b>=1e9?(b/1e9).toFixed(2)+' GB':Math.max(0,Math.round(b/1e6))+' MB';
function odbUi(){
 const sec=document.querySelector('[data-odb]');if(!sec)return;
 const st=$('picSt'),pg=$('picPg'),dl=$('picDl'),total=cards.length;
 const have=KXF?ODB.ids.size:ODB.webCount;
 if(!ODB.busy){st.textContent=have?`${total?have.toLocaleString()+' of '+total.toLocaleString():have.toLocaleString()} picture${(total||have)===1?'':'s'} saved on this device${KXF?' · '+fmtMB(JSON.parse(KXF.usage(PIC_DIR)).bytes):''}`:'No pictures saved yet: they load from the internet';pg.style.width=total?Math.min(100,have/total*100)+'%':'0';dl.textContent=have&&total&&have<total?'Download the rest':'Download all pictures'}
 const w=$('odbWhere');if(w)w.innerHTML=KXF?`Folder: <b>${esc(JSON.parse(KXF.info()).root||'')}/KodeX</b>. Pictures go in <b>pics</b> (named by passcode, like <b>89631139.jpg</b>, the same as desktop duel clients) and rulings in <b>rulings</b>. Paste files there and they're used straight away.`:'Saved in this browser. In the KodeX app they go in a folder on your phone that you can also fill yourself.';
 const fb=$('odbFolder');if(fb)fb.hidden=!KXF;
 $('picQ').closest('.odb-q').hidden=!KXF;
}
function odbInit(){
 const old=$('bDl');if(!old||document.querySelector('[data-odb]'))return;
 const grp=old.closest('.grp'),sec=grp.previousElementSibling;
 if(sec&&sec.classList.contains('sec'))sec.textContent='Offline database';
 grp.classList.add('odb');grp.dataset.odb='1';grp.removeAttribute('style');
 grp.innerHTML=`<div class="odb-blk"><div class="odb-hd"><span class="odb-ic">${ic('image',20)}</span><div><strong>Card pictures</strong><small id="picSt">Checking…</small></div></div><div class="prog"><i id="picPg"></i></div>
  <label class="odb-q"><span>Picture size</span><select id="picQ"><option value="full">Full size · ~1.5 GB</option><option value="small">Small · ~250 MB</option></select></label>
  <div class="odb-acts"><button id="picDl" class="btn p">Download all pictures</button><button id="picImp" class="btn">Import</button><button id="picClr" class="btn">Clear</button></div></div>
 <div class="odb-blk"><div class="odb-hd"><span class="odb-ic">${ic('list',20)}</span><div><strong>Rulings</strong><small id="dlst">Not downloaded yet.</small></div></div><div class="prog"><i id="pg"></i></div>
  <div class="odb-acts"><button id="bDl" class="btn p">Download all rulings</button><button id="rulImp" class="btn">Import</button></div></div>
 <div class="odb-blk odb-folder" id="odbFolder" hidden><p class="note" id="odbWhere"></p><div class="odb-acts"><button id="odbPick" class="btn">Choose a folder</button><button id="odbScan" class="btn">Rescan</button></div></div>
 <p class="note odb-web" id="odbWhere2"></p><input type="file" id="odbFile" hidden multiple>`;
 const nb=$('bDl');nb.onclick=old.onclick;   // the rulings download keeps working as before
 $('picQ').value=S.g('pic_q','full');$('picQ').onchange=()=>S.s('pic_q',$('picQ').value);
 $('picDl').onclick=picDownload;$('picClr').onclick=picClear;$('picImp').onclick=()=>odbImport('pics');$('rulImp').onclick=()=>odbImport('rulings');
 if(KXF){$('odbPick').onclick=()=>{const opts=JSON.parse(KXF.info()).kind==='folder';odbChoose(opts)};$('odbScan').onclick=()=>{odbScan();odbUi();toast('Folder scanned')}}
 if(!KXF)$('odbWhere2').textContent='';
 rulCount();odbUi();
}
async function rulCount(){try{const n=(await kvCur('r:',false)).length,f=KXF?JSON.parse(KXF.list(RUL_DIR)).length:0;if(!dl&&(n||f))$('dlst').textContent=`${Math.max(n,f).toLocaleString()} cards' rulings saved on this device`}catch(e){}}
function odbChoose(inFolder){const m=openModal(`<div class="dk-hd"><h3>Where to keep the database</h3><button class="ibtn" data-close aria-label="Close">${ic('x')}</button></div><p class="note">Pick a folder such as <b>Internal storage/KodeX</b> to keep pictures and rulings where any file manager can reach them. KodeX makes <b>pics</b> and <b>rulings</b> folders inside it.</p><button class="btn p" data-o="pick">Choose a folder</button>${inFolder?'<button class="btn" data-o="app">Use the app folder again</button>':''}`,'','odb');
 m.querySelector('[data-o="pick"]').onclick=()=>{closeModal();window.__kxFolder=(ok,label)=>{if(ok){odbScan();odbUi();toast('Using '+label)}else if(label&&label!=='cancelled')toast(label)};KXF.chooseFolder('__kxFolder')};
 const a=m.querySelector('[data-o="app"]');if(a)a.onclick=()=>{KXF.useAppFolder();closeModal();odbScan();odbUi();toast('Using the app folder')}}
function picDownload(){
 if(ODB.busy){if(KXF&&ODB.job)KXF.cancel(ODB.job);ODB.busy=false;$('picDl').textContent='Download all pictures';odbUi();return}
 if(!navigator.onLine){toast('Connect to the internet to download');return}
 const ids=[...new Set(cards.map(c=>String(c.id)).filter(x=>/^\d{3,10}$/.test(x)))];
 if(!ids.length){toast('The card database is still loading');return}
 const full=!!KXF&&$('picQ').value!=='small',base=svcBase();
 ODB.busy=true;$('picDl').textContent='Stop';
 if(KXF){
  const todo=ids.filter(id=>!ODB.ids.has(id)).map(id=>({u:`${base}/img/${full?'full/':''}${id}.jpg`,p:`${PIC_DIR}/${id}.jpg`}));
  if(!todo.length){ODB.busy=false;toast('All pictures are already saved');odbUi();return}
  ODB.job='p'+Date.now().toString(36);const startHave=ODB.ids.size;
  window.__castelFiles=(job,done,total,failed,fin)=>{if(job!==ODB.job)return;$('picSt').textContent=fin?'':`Downloading… ${(startHave+done).toLocaleString()} / ${ids.length.toLocaleString()}${failed?' · '+failed+' failed':''}`;$('picPg').style.width=Math.min(100,(startHave+done)/ids.length*100)+'%';if(fin){ODB.busy=false;odbScan();odbUi();toast(failed?`Pictures saved · ${failed} failed, download again to retry`:'Pictures saved on this device');$('picDl').textContent='Download all pictures'}};
  try{navigator.storage&&navigator.storage.persist&&navigator.storage.persist()}catch(e){}
  KXF.download(ODB.job,JSON.stringify(todo),12);return}
 // browser: small pictures, kept in this browser's storage
 (async()=>{try{await navigator.storage.persist()}catch(e){}let have=new Set((await kvCur('p:',false)).map(k=>k.slice(2))),n=0,bad=0,i=0;const todo=ids.filter(id=>!have.has(id)),T=todo.length,start=have.size;
  const w=async()=>{while(ODB.busy){const id=todo[i++];if(id===undefined)return;try{const r=await fetch(`${base}/img/${id}.jpg`,{mode:'cors'});if(!r.ok)throw 0;const b=await r.blob();if(!/^image\//.test(b.type)||!b.size)throw 0;await kv('put','p:'+id,b)}catch(e){bad++}n++;if(n%10===0||n===T){$('picSt').textContent=`Downloading… ${(start+n).toLocaleString()} / ${ids.length.toLocaleString()}${bad?' · '+bad+' failed':''}`;$('picPg').style.width=Math.min(100,(start+n)/ids.length*100)+'%'}await new Promise(r=>setTimeout(r,60))}};
  await Promise.all([w(),w(),w(),w()]);const was=ODB.busy;ODB.busy=false;await odbWebCount();odbUi();$('picDl').textContent='Download all pictures';if(was)toast(bad?`Pictures saved · ${bad} failed, download again to retry`:'Pictures saved in this browser')})();
}
async function picClear(){const m=openModal(`<div class="dk-hd"><h3>Clear saved pictures?</h3></div><p class="note">Card pictures will load from the internet again. Rulings are kept.</p><div class="sacts" style="display:flex;gap:8px;justify-content:flex-end"><button class="btn" data-close>Cancel</button><button class="btn p" data-ok>Clear</button></div>`,'','odb');
 m.querySelector('[data-ok]').onclick=async()=>{closeModal();if(KXF){KXF.remove(PIC_DIR);odbScan()}else{for(const k of await kvCur('p:',false))await kvDel(k);await odbWebCount()}icMem.clear();odbUi();toast('Pictures cleared')}}
function odbImport(kind){
 if(KXF){const dest=kind==='pics'?PIC_DIR:RUL_DIR;const m=openModal(`<div class="dk-hd"><h3>Import ${kind==='pics'?'pictures':'rulings'}</h3><button class="ibtn" data-close aria-label="Close">${ic('x')}</button></div><p class="note">${kind==='pics'?'Pictures named by passcode (<b>89631139.jpg</b>), like a desktop duel client\'s <b>pics</b> folder.':'Rulings named by Konami ID (<b>4007.json</b>), like KodeX\'s <b>rulings</b> folder.'}</p><button class="btn p" data-o="folder">From a folder</button><button class="btn" data-o="zip">From a ZIP file</button>`,'','odb');
  window.__kxImport=(ok,n)=>{if(ok){odbScan();odbUi();rulCount();toast(`${Number(n).toLocaleString()} files imported`)}else if(n&&n!=='cancelled')toast(n)};
  m.querySelector('[data-o="folder"]').onclick=()=>{closeModal();KXF.importFolder(dest,'__kxImport')};
  m.querySelector('[data-o="zip"]').onclick=()=>{closeModal();KXF.importZip(dest,'__kxImport')};return}
 const f=$('odbFile');f.accept=kind==='pics'?'image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp':'application/json,.json';f.value='';
 f.onchange=async()=>{let n=0,bad=0;for(const file of f.files){const m=/^(\d{3,10})\.(jpe?g|png|webp|json)$/i.exec(file.name);if(!m){bad++;continue}try{if(kind==='pics'){if(!/^image\//.test(file.type)&&!/jpe?g|png|webp/i.test(m[2])){bad++;continue}await kv('put','p:'+m[1],file.slice(0,file.size,file.type||'image/jpeg'));n++}else{const d=JSON.parse(await file.text());if(!d||!Array.isArray(d.records)){bad++;continue}await kv('put','r:'+m[1],{t:Date.now(),data:d});n++}}catch(e){bad++}}
  await odbWebCount();odbUi();rulCount();toast(`${n.toLocaleString()} imported${bad?` · ${bad} skipped (name them by ${kind==='pics'?'passcode, like 89631139.jpg':'Konami ID, like 4007.json'})`:''}`)};
 f.click()}
(async()=>{await odbWebCount();odbScan();odbInit();const go=()=>{odbUi()};if(!cards.length){let t=0;const iv=setInterval(()=>{if(cards.length||++t>60){clearInterval(iv);go()}},1000)}})();
$('arenaFrame').addEventListener('load',()=>setTimeout(picsToArena,300));
window.addEventListener('message',e=>{const d=e.data||{};if(d.kx==='ready')picsToArena()});

/* ---------- minimize the duel, then load the late v56 bits ---------- */
mediaLoad().then(()=>{try{skinsToArena()}catch(e){}});

</script>
</body>
</html>


