<script>
/* ==========================================================================
   Duel Synapse Swiss Engine — pure rules / scoring / pairing logic.
   No DOM access in this file, so it can be unit-tested in Node.
   ========================================================================== */
const Engine = (() => {
  'use strict';

  /* ---------- small helpers ---------- */
  const clone = o => JSON.parse(JSON.stringify(o));
  const uid = () => (globalThis.crypto && crypto.randomUUID) ? crypto.randomUUID()
    : 'id-' + Math.random().toString(36).slice(2) + Date.now().toString(36);
  function hashStr(s) { let h = 2166136261; for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 16777619); } return h >>> 0; }
  function rng(seed) { let a = seed >>> 0; return () => { a |= 0; a = a + 0x6D2B79F5 | 0; let t = Math.imul(a ^ a >>> 15, 1 | a); t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t; return ((t ^ t >>> 14) >>> 0) / 4294967296; }; }
  function shuffle(arr, r) { const a = arr.slice(); for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(r() * (i + 1));[a[i], a[j]] = [a[j], a[i]]; } return a; }
  const r6 = x => Math.round(x * 1e6) / 1e6;

  /* ---------- rule presets ---------- */
  // procedure ids:
  //  ocg-match   OCG 2026 Swiss match (判定1/2 = Double Loss, 判定3 = extra turns + LP, 判定4 = compare Duel wins)
  //  ocg-single  OCG 2026 1-Duel: unfinished at time = Double Loss
  //  dl          Unfinished Match at time = Double Loss (TCG KDE v2.5 / YCSJ)
  //  manual      Judge chooses the result
  // top-cut procedure ids: ocg-elim (extra turns -> LP -> sudden death, extra Duel), dl-elim, manual
  const PRESETS = {
    ocg2026: {
      presetId: 'ocg2026', short: 'Bo3 · 40 min · TCG scoring, tie ranks above Double Loss', label: 'OCG 2026 · Match', tag: 'OFFICIAL OCG',
      blurb: 'Konami OCG shop-event regulation (rev. 2026-07-21) with TCG scoring: best of 3, 40-minute Match, extra-turn End-of-Match procedure. A tied Match scores 0 like a Double Loss but always ranks above a real Double Loss.',
      format: { winsNeeded: 2, maxDuels: 3, duelDraws: true, matchDraws: true },
      time: { limit: 40, procedure: 'ocg-match', overtimeCap: 30, topLimit: 40, topProcedure: 'ocg-elim' },
      points: { win: 3, draw: 0, loss: 0, dl: 0, bye: 3 }, hiddenDraw: 1,
      byeDuels: [2, 0],
      tiebreakers: ['omw', 'oomw', 'gwp'], omwFloor: 0,
      rounds: 'auto', topCut: 0, elimLosses: 0, r1: 'random'
    },
    ocg2026single: {
      presetId: 'ocg2026single', short: '1 Duel · 25 min · TCG scoring, tie ranks above Double Loss', label: 'OCG 2026 · 1 Duel', tag: 'OFFICIAL OCG',
      blurb: 'Konami OCG 1-Duel regulation (rev. 2026-07-21) with TCG scoring: single Duel, 25 minutes, unfinished Duel at time = Double Loss. A drawn Duel scores 0 but ranks above a real Double Loss.',
      format: { winsNeeded: 1, maxDuels: 1, duelDraws: true, matchDraws: true },
      time: { limit: 25, procedure: 'ocg-single', overtimeCap: 0, topLimit: 25, topProcedure: 'ocg-elim' },
      points: { win: 3, draw: 0, loss: 0, dl: 0, bye: 3 }, hiddenDraw: 1,
      byeDuels: [1, 0],
      tiebreakers: ['omw', 'oomw', 'gwp'], omwFloor: 0,
      rounds: 'auto', topCut: 0, elimLosses: 0, r1: 'random'
    },
    ocgcs: {
      presetId: 'ocgcs', short: '1 Duel · 25 min · out after 2 losses', label: 'OCG Championship Swiss', tag: 'YCSJ STYLE',
      blurb: 'YCSJ 2026-style preliminaries: 1 Duel, 25 minutes, a draw or unfinished Duel counts as a loss for both, eliminated after 2 losses.',
      format: { winsNeeded: 1, maxDuels: 1, duelDraws: true, matchDraws: false },
      time: { limit: 25, procedure: 'dl', overtimeCap: 0, topLimit: 25, topProcedure: 'ocg-elim' },
      points: { win: 3, draw: 0, loss: 0, dl: 0, bye: 3 },
      byeDuels: [1, 0],
      tiebreakers: ['omw', 'oomw', 'gwp'], omwFloor: 0,
      rounds: 'auto', topCut: 0, elimLosses: 2, r1: 'random'
    },
    kde25: {
      presetId: 'kde25', short: 'Bo3 · 50 min · no draws', label: 'TCG · KDE Policy v2.5', tag: 'TCG',
      blurb: 'KDE Tournament Policy v2.5: best of 3, 50 minutes, no Match Draws. A Match not finished at time is a Double Loss; a 4th Duel is played if 3 Duels end without a winner.',
      format: { winsNeeded: 2, maxDuels: 0, duelDraws: true, matchDraws: false },
      time: { limit: 50, procedure: 'dl', overtimeCap: 0, topLimit: 0, topProcedure: 'manual' },
      points: { win: 3, draw: 0, loss: 0, dl: 0, bye: 3 },
      byeDuels: [2, 0],
      tiebreakers: ['omw', 'oomw'], omwFloor: 0,
      rounds: 'auto', topCut: 0, elimLosses: 0, r1: 'random'
    },
    custom: {
      presetId: 'custom', short: 'Set your own format and scoring', label: 'Universal / Custom', tag: 'ANY GAME',
      blurb: 'Fully adjustable Swiss for any game: format, points, time procedure, tie-breakers, cut and elimination.',
      format: { winsNeeded: 2, maxDuels: 3, duelDraws: true, matchDraws: true },
      time: { limit: 50, procedure: 'manual', overtimeCap: 0, topLimit: 0, topProcedure: 'manual' },
      points: { win: 3, draw: 1, loss: 0, dl: 0, bye: 3 },
      byeDuels: [2, 0],
      tiebreakers: ['omw', 'gwp', 'ogw'], omwFloor: 0.33,
      rounds: 'auto', topCut: 0, elimLosses: 0, r1: 'random'
    }
  };
  const PRESET_ORDER = ['ocg2026', 'ocg2026single', 'ocgcs', 'kde25', 'custom'];

  const TIEBREAKERS = {
    omw:   { short: 'OMW%',  name: "Opponents' Match Win %", desc: 'Average match-win percentage of every opponent faced (byes excluded).' },
    oomw:  { short: 'OOMW%', name: "Opponents' Opponents' Match Win %", desc: 'Average OMW% of every opponent faced.' },
    gwp:   { short: 'DW%',   name: 'Duel Win %', desc: 'Your own Duel (game) win percentage. A Duel draw counts as one third of a win.' },
    ogw:   { short: 'ODW%',  name: "Opponents' Duel Win %", desc: 'Average Duel win percentage of every opponent faced.' },
    buch:  { short: 'BUCH',  name: 'Buchholz', desc: 'Sum of the match points of every opponent faced.' },
    sb:    { short: 'SB',    name: 'Sonneborn-Berger', desc: 'Points of opponents you beat, plus half the points of opponents you drew.' },
    wins:  { short: 'W',     name: 'Most Match wins', desc: 'Number of Match wins (byes included).' },
    h2h:   { short: 'H2H',   name: 'Head-to-head', desc: 'If exactly two players are still tied and they played each other, the winner ranks higher.' }
  };

  const PROCEDURES = {
    'ocg-match': 'OCG 2026 Match: Duel 1 in progress or Duel 2 not started → Double Loss. Duel 2/3 in progress → finish the turn, then 3 extra turns (counted from the opponent’s turn), higher LP wins the Duel, equal LP = Duel draw; the Match goes to the player with more Duel wins, otherwise a Match Draw. Before Duel 3 starts → more Duel wins takes the Match, otherwise a Match Draw.',
    'ocg-single': 'OCG 2026 1-Duel: a Duel not decided at time = Double Loss. A Duel that ends in a draw within time = draw.',
    'dl': 'A Match without a winner when time expires = Double Loss (both players receive a loss).',
    'manual': 'The judge chooses the result for unfinished Matches.',
    'ocg-elim': 'OCG 2026 elimination: Duel 1 in progress or Duel 2 not started → Double Loss. Duel 2/3 in progress → finish the turn, 3 extra turns, higher LP wins, equal LP → sudden death. Before Duel 3+ → a 4-turn extra Duel at 8000 LP decides it.',
    'dl-elim': 'Elimination: a Match without a winner at time = Double Loss (the next opponent advances).'
  };

  function makeRules(presetId) { const p = PRESETS[presetId] || PRESETS.ocg2026; return clone(p); }

  // Normalises a rules object, filling anything missing from its preset.
  function normalizeRules(r) {
    const base = makeRules(r && r.presetId);
    if (!r || typeof r !== 'object') return base;
    const out = Object.assign(base, r);
    out.format = Object.assign(clone(base.format), r.format || {});
    out.time = Object.assign(clone(base.time), r.time || {});
    out.points = Object.assign(clone(base.points), r.points || {});
    out.format.winsNeeded = clampInt(out.format.winsNeeded, 1, 5, 2);
    out.format.maxDuels = clampInt(out.format.maxDuels, 0, 9, 0);
    if (out.format.maxDuels && out.format.maxDuels < out.format.winsNeeded) out.format.maxDuels = out.format.winsNeeded;
    out.time.limit = clampInt(out.time.limit, 0, 600, 40);
    out.time.topLimit = clampInt(out.time.topLimit, 0, 600, 0);
    out.time.overtimeCap = clampInt(out.time.overtimeCap, 0, 240, 0);
    for (const k of ['win', 'draw', 'loss', 'dl', 'bye']) { const v = Number(out.points[k]); out.points[k] = Number.isFinite(v) ? v : 0; }
    if (!Array.isArray(out.byeDuels)) out.byeDuels = [out.format.winsNeeded, 0];
    out.tiebreakers = (Array.isArray(out.tiebreakers) ? out.tiebreakers : []).filter(k => TIEBREAKERS[k]);
    out.hiddenDraw = Math.max(0, Math.min(5, Number(out.hiddenDraw) || 0));
    out.omwFloor = Math.max(0, Math.min(0.5, Number(out.omwFloor) || 0));
    out.elimLosses = clampInt(out.elimLosses, 0, 9, 0);
    out.topCut = [0, 2, 4, 8, 16, 32, 64].includes(Number(out.topCut)) ? Number(out.topCut) : 0;
    if (out.rounds !== 'auto') out.rounds = clampInt(out.rounds, 1, 30, 5);
    if (!['random', 'seed'].includes(out.r1)) out.r1 = 'random';
    return out;
  }
  function clampInt(v, lo, hi, def) { v = parseInt(v, 10); if (!Number.isFinite(v)) return def; return Math.max(lo, Math.min(hi, v)); }

  // Konami Swiss guide: rounds by starting participants (65+ extrapolated by doubling).
  function konamiRounds(n) {
    if (n <= 2) return 1; if (n <= 4) return 2; if (n <= 8) return 3; if (n <= 16) return 4;
    if (n <= 32) return 5; if (n <= 64) return 6; if (n <= 128) return 7; if (n <= 256) return 8;
    if (n <= 512) return 9; return 10;
  }
  function plannedRounds(T) {
    const r = T.rules;
    if (r.rounds !== 'auto') return r.rounds;
    const n = T.startCount || T.players.filter(p => !p.dropped).length;
    return konamiRounds(Math.max(2, n));
  }

  /* ---------- match evaluation ---------- */
  function duelCount(duels) { let a = 0, b = 0, d = 0; for (const x of duels || []) { if (x === 'A') a++; else if (x === 'B') b++; else d++; } return { a, b, d }; }

  // Normal (non-time) completion of a Match from its Duel record.
  function evaluate(duels, rules, stage) {
    const f = rules.format, c = { a: 0, b: 0, d: 0 };
    let n = 0;
    for (const x of duels || []) {
      n++; if (x === 'A') c.a++; else if (x === 'B') c.b++; else c.d++;
      if (c.a >= f.winsNeeded) return { done: true, result: 'A', used: n };
      if (c.b >= f.winsNeeded) return { done: true, result: 'B', used: n };
      if (f.maxDuels && n >= f.maxDuels) break;
    }
    if (f.maxDuels && n >= f.maxDuels) {
      if (c.a > c.b) return { done: true, result: 'A' };
      if (c.b > c.a) return { done: true, result: 'B' };
      if (stage === 'top') return { done: false, result: null, needsDecider: true };
      return { done: true, result: f.matchDraws ? 'D' : 'DL' };
    }
    return { done: false, result: null };
  }
  // Result when time is called and Duel wins are compared (OCG 判定3/判定4).
  function timeCompare(duels, rules) {
    const c = duelCount(duels);
    if (c.a > c.b) return 'A'; if (c.b > c.a) return 'B';
    return rules.format.matchDraws ? 'D' : 'DL';
  }
  function scoreText(m) {
    if (!m) return '';
    if (m.result === 'BYE') return 'BYE';
    const c = duelCount(m.duels);
    return c.d ? `${c.a}–${c.b}–${c.d}` : `${c.a}–${c.b}`;
  }
  const RESULT_LABEL = { A: 'Win', B: 'Win', D: 'Match Draw', DL: 'Double Loss', BYE: 'Bye' };

  /* ---------- player result helpers ---------- */
  // returns 'W' | 'L' | 'D' | 'DL' | 'BYE' | null for player id in match m
  function resultFor(m, id) {
    if (!m.result) return null;
    if (m.result === 'BYE') return m.a === id ? 'BYE' : null;
    if (m.result === 'DL') return 'DL';
    if (m.result === 'D') return 'D';
    if (m.result === 'A') return m.a === id ? 'W' : 'L';
    if (m.result === 'B') return m.b === id ? 'W' : 'L';
    return null;
  }

  /* ---------- standings ---------- */
  function standings(T, opts = {}) {
    const rules = T.rules, P = rules.points, winPts = P.win || 1;
    const S = new Map();
    for (const p of T.players) S.set(p.id, {
      id: p.id, name: p.name, seed: p.seed, dropped: !!p.dropped, elim: !!p.elim,
      pts: 0, w: 0, l: 0, d: 0, dl: 0, byes: 0, played: 0,
      gw: 0, gl: 0, gd: 0, opps: [], beat: [], drew: [], hist: []
    });
    const rounds = T.rounds.filter(r => r.stage !== 'top' && (opts.includeOpen || r.complete || opts.live !== false));
    for (const r of rounds) for (const m of r.matches) {
      if (!m.result) continue;
      const A = S.get(m.a), B = m.b ? S.get(m.b) : null;
      if (m.result === 'BYE') {
        if (!A) continue;
        A.pts += P.bye; A.w++; A.byes++; A.played++;
        A.gw += rules.byeDuels[0] || 0; A.gl += rules.byeDuels[1] || 0;
        A.hist.push({ round: r.n, opp: null, res: 'BYE' });
        continue;
      }
      if (!A || !B) continue;
      const c = duelCount(m.duels);
      A.gw += c.a; A.gl += c.b; A.gd += c.d; B.gw += c.b; B.gl += c.a; B.gd += c.d;
      A.opps.push(B.id); B.opps.push(A.id); A.played++; B.played++;
      const ra = resultFor(m, A.id), rb = resultFor(m, B.id);
      for (const [X, res, O] of [[A, ra, B], [B, rb, A]]) {
        if (res === 'W') { X.pts += P.win; X.w++; X.beat.push(O.id); }
        else if (res === 'L') { X.pts += P.loss; X.l++; }
        else if (res === 'D') { X.pts += P.draw; X.d++; X.drew.push(O.id); }
        else if (res === 'DL') { X.pts += P.dl; X.dl++; }
        X.hist.push({ round: r.n, opp: O.id, res });
      }
    }
    const floor = rules.omwFloor || 0;
    for (const s of S.values()) {
      s.mwp = s.played ? Math.max(floor, s.pts / (s.played * winPts)) : floor;
      const games = s.gw + s.gl + s.gd;
      s.gwp = games ? Math.max(floor, (s.gw * 3 + s.gd) / (games * 3)) : floor;
      s.losses = s.l + s.dl;
    }
    const avg = (ids, f) => ids.length ? ids.reduce((t, id) => t + f(S.get(id)), 0) / ids.length : 0;
    for (const s of S.values()) {
      s.omw = avg(s.opps, o => o.mwp);
      s.ogw = avg(s.opps, o => o.gwp);
      s.buch = s.opps.reduce((t, id) => t + S.get(id).pts, 0);
      s.sb = s.beat.reduce((t, id) => t + S.get(id).pts, 0) + s.drew.reduce((t, id) => t + S.get(id).pts / 2, 0);
    }
    for (const s of S.values()) s.oomw = avg(s.opps, o => o.omw);
    for (const s of S.values()) { s.wins = s.w; s.hid = s.d * (rules.hiddenDraw || 0); }

    const keys = rules.tiebreakers.filter(k => k !== 'h2h');
    const tieSalt = hashStr(T.id || 'x');
    const list = [...S.values()];
    list.forEach(s => { s.tieRand = hashStr(s.id + tieSalt) ; });
    list.sort((x, y) => {
      if (y.pts !== x.pts) return y.pts - x.pts;
      if (y.hid !== x.hid) return y.hid - x.hid;
      for (const k of keys) { const d = r6(y[k]) - r6(x[k]); if (d) return d; }
      return x.tieRand - y.tieRand;
    });
    // head-to-head for groups of exactly two identical players
    if (rules.tiebreakers.includes('h2h')) {
      const sig = s => [s.pts, s.hid, ...keys.map(k => r6(s[k]))].join('|');
      for (let i = 0; i < list.length - 1; i++) {
        const a = list[i], b = list[i + 1];
        if (sig(a) !== sig(b)) continue;
        if (i + 2 < list.length && sig(list[i + 2]) === sig(a)) continue;
        if (i > 0 && sig(list[i - 1]) === sig(a)) continue;
        if (b.beat.includes(a.id) && !a.beat.includes(b.id)) { list[i] = b; list[i + 1] = a; }
      }
    }
    list.forEach((s, i) => s.rank = i + 1);
    return list;
  }

  /* ---------- Swiss pairing ---------- */
  function playedPairs(T) {
    const set = new Set();
    for (const r of T.rounds) for (const m of r.matches) if (m.b) { set.add(m.a + '|' + m.b); set.add(m.b + '|' + m.a); }
    return set;
  }
  function byeCounts(T) {
    const c = {}; for (const r of T.rounds) for (const m of r.matches) if (!m.b) c[m.a] = (c[m.a] || 0) + 1; return c;
  }
  function eligiblePlayers(T) { return T.players.filter(p => !p.dropped && !p.elim); }

  // Returns { pairs:[[idA,idB]...], bye:id|null, rematches:n }
  function pairSwiss(T, roundNo) {
    const r = rng(hashStr((T.id || '') + ':' + roundNo + ':' + (T.pairSalt || 0)));
    const active = eligiblePlayers(T);
    const st = standings(T);
    const ptsOf = new Map(st.map(s => [s.id, s.pts]));
    let order;
    const noResultsYet = !T.rounds.some(rd => rd.stage !== 'top' && rd.matches.some(m => m.b && m.result));
    if (noResultsYet && T.rules.r1 === 'seed') {
      // seeded: top half vs bottom half
      const bySeed = active.slice().sort((a, b) => a.seed - b.seed);
      const half = Math.ceil(bySeed.length / 2);
      order = [];
      for (let i = 0; i < half; i++) { order.push(bySeed[i]); if (bySeed[i + half]) order.push(bySeed[i + half]); }
      order = order.map(p => p.id);
    } else {
      // group by points, random inside each group
      const groups = new Map();
      for (const p of active) { const k = ptsOf.get(p.id) || 0; if (!groups.has(k)) groups.set(k, []); groups.get(k).push(p.id); }
      order = [...groups.keys()].sort((a, b) => b - a).flatMap(k => shuffle(groups.get(k), r));
    }
    const played = playedPairs(T), byes = byeCounts(T);
    let bye = null;
    if (order.length % 2 === 1) {
      // lowest score group first, fewest previous byes, random inside group (order is already shuffled)
      const cand = order.slice().reverse();
      const minByes = Math.min(...cand.map(id => byes[id] || 0));
      bye = cand.filter(id => (byes[id] || 0) === minByes).sort((a, b) => (ptsOf.get(a) || 0) - (ptsOf.get(b) || 0))[0];
      order = order.filter(id => id !== bye);
    }
    const idx = new Map(order.map((id, i) => [id, i]));
    const pts = id => ptsOf.get(id) || 0;
    function solve(allowRematch) {
      const used = new Set(); const out = []; let steps = 0; const LIMIT = 250000;
      function dfs() {
        if (++steps > LIMIT) return false;
        let i = 0; while (i < order.length && used.has(order[i])) i++;
        if (i >= order.length) return true;
        const a = order[i]; used.add(a);
        const cands = order.filter(b => !used.has(b));
        cands.sort((x, y) => {
          const rx = played.has(a + '|' + x) ? 1 : 0, ry = played.has(a + '|' + y) ? 1 : 0;
          if (rx !== ry) return rx - ry;
          const dx = Math.abs(pts(a) - pts(x)), dy = Math.abs(pts(a) - pts(y));
          if (dx !== dy) return dx - dy;
          return idx.get(x) - idx.get(y);
        });
        for (const b of cands) {
          if (!allowRematch && played.has(a + '|' + b)) continue;
          used.add(b); out.push([a, b]);
          if (dfs()) return true;
          out.pop(); used.delete(b);
          if (steps > LIMIT) break;
        }
        used.delete(a); return false;
      }
      return dfs() ? out : null;
    }
    let pairs = solve(false), rematches = 0;
    if (!pairs) { pairs = solve(true); }
    if (!pairs) { // absolute fallback: sequential
      pairs = []; for (let i = 0; i + 1 < order.length; i += 2) pairs.push([order[i], order[i + 1]]);
    }
    for (const [a, b] of pairs) if (played.has(a + '|' + b)) rematches++;
    // higher score tables first
    pairs.sort((x, y) => (Math.max(pts(y[0]), pts(y[1])) - Math.max(pts(x[0]), pts(x[1]))) || ((pts(y[0]) + pts(y[1])) - (pts(x[0]) + pts(x[1]))));
    pairs = pairs.map(([a, b]) => pts(b) > pts(a) ? [b, a] : [a, b]);
    return { pairs, bye, rematches };
  }

  function newMatch(table, a, b) {
    return { id: uid(), table, a, b, duels: [], result: b ? null : 'BYE', how: b ? null : 'bye', note: '', at: b ? null : Date.now(), live: null };
  }
  function newRound(T, stage) {
    const swiss = T.rounds.filter(r => r.stage !== 'top').length;
    const top = T.rounds.filter(r => r.stage === 'top').length;
    const limit = stage === 'top' ? T.rules.time.topLimit : T.rules.time.limit;
    return { id: uid(), n: stage === 'top' ? top + 1 : swiss + 1, stage, matches: [], complete: false, createdAt: Date.now(),
      timer: { limit: limit * 60, start: null, acc: 0, running: false, alerted5: false, alerted0: false } };
  }
  function buildSwissRound(T) {
    const round = newRound(T, 'swiss');
    const { pairs, bye, rematches } = pairSwiss(T, round.n);
    round.matches = pairs.map((p, i) => newMatch(i + 1, p[0], p[1]));
    if (bye) round.matches.push(newMatch(0, bye, null));
    round.rematches = rematches;
    return round;
  }

  /* ---------- single-elimination top cut ---------- */
  function bracketOrder(n) { let o = [1, 2]; while (o.length < n) { const m = o.length * 2 + 1; o = o.flatMap(x => [x, m - x]); } return o; }
  function buildTopRound(T, size) {
    const round = newRound(T, 'top');
    const prev = T.rounds.filter(r => r.stage === 'top');
    let entrants;
    if (!prev.length) {
      const st = standings(T).filter(s => !s.dropped);
      const seeds = st.slice(0, size).map(s => s.id);
      round.seeds = seeds;
      entrants = bracketOrder(size).map(i => seeds[i - 1] || null);
    } else {
      const last = prev[prev.length - 1];
      entrants = last.matches.slice().sort((a, b) => a.slot - b.slot).map(m => topWinner(m));
    }
    const ms = [];
    for (let i = 0; i < entrants.length; i += 2) {
      let a = entrants[i], b = entrants[i + 1];
      if (!a && b) { a = b; b = null; }
      const m = newMatch(ms.length + 1, a, b);
      m.slot = i / 2;
      if (!a) { m.result = 'VOID'; m.how = 'void'; m.a = null; }
      ms.push(m);
    }
    round.matches = ms;
    round.size = entrants.length;
    return round;
  }
  function topWinner(m) {
    if (!m) return null;
    if (m.result === 'BYE') return m.a;
    if (m.result === 'A') return m.a; if (m.result === 'B') return m.b;
    return null;
  }
  function topRoundName(size) { return size === 2 ? 'Final' : size === 4 ? 'Semifinals' : size === 8 ? 'Quarterfinals' : 'Top ' + size; }

  /* ---------- final placements ---------- */
  function finalPlacements(T) {
    const st = standings(T);
    const tops = T.rounds.filter(r => r.stage === 'top');
    if (!tops.length) return st.map(s => ({ ...s, place: s.rank, note: '' }));
    const placed = new Map(); // id -> {place, note}
    const swissRank = new Map(st.map(s => [s.id, s.rank]));
    const last = tops[tops.length - 1];
    const sizeOf = r => r.size || r.matches.length * 2;
    const finalDone = last.matches.length === 1 && sizeOf(last) === 2 && last.matches[0].result;
    if (finalDone) {
      const fm = last.matches[0], w = topWinner(fm);
      if (w) placed.set(w, { place: 1, note: 'Champion' });
      const lo = fm.b ? (w === fm.a ? fm.b : fm.a) : null;
      if (lo && !placed.has(lo)) placed.set(lo, { place: 2, note: 'Finalist' });
      if (!w) { if (fm.a) placed.set(fm.a, { place: 1, note: 'Final · Double Loss' }); if (fm.b) placed.set(fm.b, { place: 1, note: 'Final · Double Loss' }); }
    }
    // losers of each earlier round, placed by Swiss rank
    for (let ri = tops.length - 1; ri >= 0; ri--) {
      const r = tops[ri]; const size = sizeOf(r);
      const losers = [];
      for (const m of r.matches) {
        if (!m.result || m.result === 'BYE' || m.result === 'VOID') continue;
        const w = topWinner(m);
        for (const id of [m.a, m.b]) if (id && id !== w && !placed.has(id)) losers.push(id);
      }
      losers.sort((a, b) => swissRank.get(a) - swissRank.get(b));
      const base = size / 2 + 1;
      losers.forEach((id, i) => placed.set(id, { place: base + i, note: 'Top ' + size }));
    }
    const out = [];
    const inCut = st.filter(s => placed.has(s.id)).sort((a, b) => placed.get(a.id).place - placed.get(b.id).place || a.rank - b.rank);
    const rest = st.filter(s => !placed.has(s.id));
    let p = 1;
    inCut.forEach(s => { out.push({ ...s, place: placed.get(s.id).place, note: placed.get(s.id).note }); p = Math.max(p, placed.get(s.id).place + 1); });
    rest.forEach(s => out.push({ ...s, place: p++, note: '' }));
    return out;
  }

  /* ---------- integrity ---------- */
  function audit(T) {
    const issues = [], warn = [];
    if (!T) return { issues: ['No tournament loaded'], warn };
    const ids = new Set();
    for (const p of T.players) { if (!p.id || ids.has(p.id)) issues.push('Duplicate or missing player id: ' + p.name); ids.add(p.id); if (!String(p.name || '').trim()) issues.push('Player with empty name'); }
    const names = new Map(); for (const p of T.players) { const k = String(p.name).trim().toLowerCase(); if (names.has(k)) warn.push('Duplicate player name: ' + p.name); names.set(k, 1); }
    const pairCount = new Map();
    for (const r of T.rounds) {
      const seen = new Set();
      for (const m of r.matches) {
        if (m.result === 'VOID') continue;
        for (const id of [m.a, m.b]) if (id) { if (!ids.has(id)) issues.push(`Unknown player in ${r.stage === 'top' ? 'Top cut' : 'Round'} ${r.n}`); if (seen.has(id)) issues.push(`Player seated twice in Round ${r.n}`); seen.add(id); }
        if (m.b && m.a === m.b) issues.push(`Player paired against themself in Round ${r.n}`);
        if (m.b && m.result && m.result !== 'DL' && m.result !== 'D') {
          const c = duelCount(m.duels);
          if (m.result === 'A' && c.a < c.b) issues.push(`Round ${r.n} table ${m.table}: result contradicts Duel score`);
          if (m.result === 'B' && c.b < c.a) issues.push(`Round ${r.n} table ${m.table}: result contradicts Duel score`);
        }
        if (m.b && r.stage !== 'top') { const k = [m.a, m.b].sort().join('|'); pairCount.set(k, (pairCount.get(k) || 0) + 1); }
      }
      if (r.complete && r.matches.some(m => !m.result)) issues.push(`Round ${r.n} marked complete with missing results`);
    }
    const rem = [...pairCount.values()].filter(v => v > 1).length;
    if (rem) warn.push(rem + ' rematch' + (rem > 1 ? 'es' : '') + ' in Swiss rounds (unavoidable with few players)');
    return { issues, warn };
  }

  return { PRESETS, PRESET_ORDER, TIEBREAKERS, PROCEDURES, makeRules, normalizeRules, konamiRounds, plannedRounds,
    duelCount, evaluate, timeCompare, scoreText, RESULT_LABEL, resultFor, standings, pairSwiss, buildSwissRound,
    buildTopRound, topWinner, topRoundName, bracketOrder, finalPlacements, audit, newMatch, uid, clone, hashStr, rng, shuffle, eligiblePlayers };
})();
if (typeof module !== 'undefined') module.exports = Engine;

</script>
<script>
(() => {
'use strict';
const EMBLEM = 'data:image/png;base64,';
const WORDMARK = 'data:image/webp;base64,';
const TITLE = 'data:image/webp;base64,';
/* ===================== core: utils, state, persistence ===================== */
const E = Engine;
/* ---- MEIOCG links: fill in a URL to show it in Settings → Privacy & Social. Empty = hidden. ---- */
const LINKS = {
  website: 'https://meiocg.org',
  facebook: 'https://www.facebook.com/meiocgOfficial',
  youtube: 'https://youtube.com/@meiocg',
  tiktok: '',
  instagram: '',
  discord: '',
  x: '',
  email: 'metainsiderocg@gmail.com',
  kodex: 'https://kodex.meiocg.org'
};
const POLICY_DATE = 'October 20, 2026';
const VERSION = '3.0.0';
const K = { active: 'meiocg.swiss.v3.active', archive: 'meiocg.swiss.v3.archive', prefs: 'meiocg.swiss.v3.prefs', auto: 'meiocg.swiss.v3.autobackup', free: 'meiocg.swiss.v3.freelp' };
const LEGACY = { state: 'ocgSwissManager_v2', archive: 'ocgSwissTournamentArchives_v1', migrated: 'meiocg.swiss.v3.migrated' };

const $ = (s, r = document) => r.querySelector(s);
const $$ = (s, r = document) => [...r.querySelectorAll(s)];
const esc = x => String(x ?? '').replace(/[&<>"']/g, m => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m]));
const ic = (n, cls = '') => `<svg class="i ${cls}"><use href="#i-${n}"/></svg>`;
const pct = x => (x * 100).toFixed(2) + '%';
const pts = n => `${n} ${n === 1 ? 'pt' : 'pts'}`;
const plural = (n, w, p) => `${n} ${n === 1 ? w : (p || w + 's')}`;
const fmtDate = t => { try { return new Date(t).toLocaleString(undefined, { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }); } catch (e) { return '—'; } };
const fmtDay = t => { try { return new Date(t).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' }); } catch (e) { return '—'; } };
const hue = s => E.hashStr(String(s)) % 360;
const initials = n => String(n || '?').trim().split(/\s+/).slice(0, 2).map(w => w[0] || '').join('').toUpperCase() || '?';
const clampN = (v, lo, hi) => Math.max(lo, Math.min(hi, v));
const slug = s => String(s || 'tournament').replace(/[^a-z0-9]+/gi, '-').replace(/^-|-$/g, '').slice(0, 60) || 'tournament';
function mmss(sec) { const neg = sec < 0; sec = Math.abs(Math.floor(sec)); const h = Math.floor(sec / 3600), m = Math.floor((sec % 3600) / 60), s = sec % 60; const body = h ? `${h}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}` : `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`; return (neg ? '+' : '') + body; }

const Store = {
  get(k, def) { try { const v = localStorage.getItem(k); return v == null ? def : JSON.parse(v); } catch (e) { return def; } },
  set(k, v) { try { localStorage.setItem(k, JSON.stringify(v)); return true; } catch (e) { console.error('storage', e); return false; } },
  del(k) { try { localStorage.removeItem(k); } catch (e) { } },
  size() { let n = 0; try { for (let i = 0; i < localStorage.length; i++) { const k = localStorage.key(i); n += k.length + (localStorage.getItem(k) || '').length; } } catch (e) { } return n * 2; }
};

const DEFAULT_PREFS = { theme: 'dark', accent: '#2f8cff', bg: '', panel: 90, wp: { on: false, strength: 45, blur: 0, pos: 'center' }, sound: true, vibrate: true, wake: true, tab: 'home' };
let T = null;          // active tournament
let ARCH = [];         // archived tournaments (newest first)
let PREFS = E.clone(DEFAULT_PREFS);
let FREE = null;       // free LP calculator state
let TAB = 'home';
let MC = null;         // match-control context {roundId, matchId} | {free:true}
const UNDO = [];
let saveFailed = false;

function normalizeT(t) {
  if (!t || typeof t !== 'object') return null;
  t.v = 3;
  t.id = t.id || E.uid();
  t.name = String(t.name || 'Swiss Tournament').slice(0, 80);
  t.rules = E.normalizeRules(t.rules);
  t.players = Array.isArray(t.players) ? t.players.filter(p => p && p.id) : [];
  t.players.forEach((p, i) => { p.name = String(p.name || 'Player').slice(0, 60); p.seed = Number(p.seed) || i + 1; p.dropped = !!p.dropped; p.elim = !!p.elim; p.note = p.note || ''; });
  t.rounds = Array.isArray(t.rounds) ? t.rounds : [];
  t.rounds.forEach(r => { r.id = r.id || E.uid(); r.stage = r.stage === 'top' ? 'top' : 'swiss'; r.matches = Array.isArray(r.matches) ? r.matches : []; r.matches.forEach(m => { m.id = m.id || E.uid(); m.duels = Array.isArray(m.duels) ? m.duels.filter(x => x === 'A' || x === 'B' || x === 'D') : []; }); r.timer = r.timer || { limit: 0, start: null, acc: 0, running: false }; });
  t.log = Array.isArray(t.log) ? t.log.slice(-400) : [];
  t.createdAt = t.createdAt || Date.now(); t.updatedAt = t.updatedAt || Date.now();
  t.locked = !!t.locked;
  t.status = t.status || 'setup';
  return t;
}

function loadAll() {
  PREFS = Object.assign(E.clone(DEFAULT_PREFS), Store.get(K.prefs, {}));
  PREFS.wp = Object.assign(E.clone(DEFAULT_PREFS.wp), PREFS.wp || {});
  T = normalizeT(Store.get(K.active, null));
  ARCH = (Store.get(K.archive, []) || []).map(normalizeT).filter(Boolean);
  FREE = Store.get(K.free, null) || { names: ['Player A', 'Player B'], live: freshLive() };
  if (!T && !ARCH.length && !Store.get(LEGACY.migrated, false)) migrateLegacy();
}
function persist() {
  if (T) T.updatedAt = Date.now();
  const ok = T ? Store.set(K.active, T) : (Store.del(K.active), true);
  if (!ok && !saveFailed) { saveFailed = true; toast('Storage is full — export a backup and clear old archives.', { kind: 'bad', ms: 6000 }); }
  if (ok) saveFailed = false;
  return ok;
}
function persistArchive() { if (!Store.set(K.archive, ARCH)) toast('Could not save the archive (storage full).', { kind: 'bad' }); }
function persistPrefs() { Store.set(K.prefs, PREFS); }
function persistFree() { Store.set(K.free, FREE); }
let autoTimer = 0;
function scheduleAutoBackup() { clearTimeout(autoTimer); autoTimer = setTimeout(() => { if (T) Store.set(K.auto, { at: Date.now(), t: T }); }, 4000); }

function log(msg) { if (!T) return; T.log.push({ t: Date.now(), m: msg }); if (T.log.length > 400) T.log.splice(0, T.log.length - 400); }

// All state changes go through mutate(): snapshot for undo, persist, re-render.
function mutate(label, fn, opts = {}) {
  if (!T && !opts.allowNoT) return false;
  const before = T ? JSON.stringify(T) : null;
  let res;
  try { res = fn(); } catch (e) { console.error(e); if (before) T = JSON.parse(before); toast('Action failed: ' + e.message, { kind: 'bad' }); return false; }
  if (res === false) { if (before) T = JSON.parse(before); return false; }
  if (opts.undo !== false && before) { UNDO.push({ label, state: before }); if (UNDO.length > 40) UNDO.shift(); }
  if (label && !opts.silentLog) log(label);
  persist(); scheduleAutoBackup(); renderAll();
  if (opts.toast) toast(opts.toast, { undo: opts.undo !== false, kind: opts.kind });
  return true;
}
function undo() {
  const u = UNDO.pop();
  if (!u) return toast('Nothing to undo');
  T = normalizeT(JSON.parse(u.state)); log('Undo: ' + u.label);
  persist(); renderAll(); syncTimers(); toast('Undone · ' + u.label);
}

/* ---------- legacy (v2) migration ---------- */
function migrateLegacyT(S, finished) {
  if (!S || !Array.isArray(S.players)) return null;
  const rules = E.makeRules('kde25');
  rules.time.limit = Number(S.settings && S.settings.minutes) || 50;
  rules.rounds = Number(S.settings && S.settings.rounds) || 'auto';
  const t = { id: S.archiveId || E.uid(), name: S.name || 'Swiss Tournament', rules, locked: !!S.locked,
    createdAt: Date.parse(S.createdAt) || Date.now(), updatedAt: Date.parse(S.updatedAt) || Date.now(),
    players: S.players.map((p, i) => ({ id: p.id || E.uid(), name: p.name || 'Player ' + (i + 1), seed: p.seed || i + 1, dropped: p.active === false, elim: false, note: '' })),
    rounds: [], log: [{ t: Date.now(), m: 'Imported from Duel Synapse v2 (KDE v2.5 rules)' }] };
  const conv = (r, complete) => ({ id: r.id || E.uid(), n: r.number || t.rounds.length + 1, stage: 'swiss', complete,
    timer: { limit: rules.time.limit * 60, start: null, acc: 0, running: false },
    matches: (r.pairs || []).map((m, i) => {
      const duels = [];
      if (m.bye) return { id: m.id || E.uid(), table: 0, a: m.a, b: null, duels: [], result: 'BYE', how: 'bye', note: '', at: Date.parse(m.finishedAt) || null };
      (m.duels || []).forEach(d => { const s = String(d.result || ''); if (s.startsWith('A')) duels.push('A'); else if (s.startsWith('B')) duels.push('B'); else if (s.startsWith('DRAW')) duels.push('D'); });
      if (!duels.length) { for (let k = 0; k < (m.aw || 0); k++) duels.push('A'); for (let k = 0; k < (m.bw || 0); k++) duels.push('B'); }
      const res = m.result === 'A WIN' ? 'A' : m.result === 'B WIN' ? 'B' : m.result === 'DOUBLE LOSS' ? 'DL' : null;
      return { id: m.id || E.uid(), table: m.table || i + 1, a: m.a, b: m.b, duels, result: res, how: res ? 'imported' : null, note: m.reason || '', at: Date.parse(m.finishedAt) || null };
    }) });
  (S.rounds || []).forEach(r => t.rounds.push(conv(r, true)));
  if (S.current && S.current.pairs) t.rounds.push(conv(S.current, false));
  t.startCount = t.players.length;
  t.status = finished ? 'complete' : (t.rounds.length ? 'swiss' : 'setup');
  return normalizeT(t);
}
function migrateLegacy() {
  try {
    const old = Store.get(LEGACY.state, null), oldArch = Store.get(LEGACY.archive, []);
    let n = 0;
    if (Array.isArray(oldArch)) oldArch.forEach(a => { const t = migrateLegacyT(a, true); if (t) { ARCH.push(t); n++; } });
    if (old && old.players && old.players.length) {
      const t = migrateLegacyT(old, false);
      if (t && !(t.players.length && t.players.every(p => /^Player \d+$/.test(p.name)) && !t.rounds.length)) { T = t; n++; }
    }
    Store.set(LEGACY.migrated, true);
    if (n) { persist(); persistArchive(); setTimeout(() => toast(`Imported ${plural(n, 'tournament')} from the previous app version`, { kind: 'good', ms: 5000 }), 600); }
  } catch (e) { console.warn('migration skipped', e); }
}

/* ---------- derived helpers ---------- */
const P = id => T && T.players.find(p => p.id === id);
const pn = (id, t = T) => { if (!id) return 'BYE'; const p = t && t.players.find(x => x.id === id); return p ? p.name : '(removed)'; };
const swissRounds = (t = T) => t ? t.rounds.filter(r => r.stage !== 'top') : [];
const topRounds = (t = T) => t ? t.rounds.filter(r => r.stage === 'top') : [];
const lastRound = () => T && T.rounds.length ? T.rounds[T.rounds.length - 1] : null;
const curRound = () => { const r = lastRound(); return r && !r.complete ? r : null; };
const findRound = id => T && T.rounds.find(r => r.id === id);
const pendingIn = r => r ? r.matches.filter(m => !m.result).length : 0;
const roundTitle = r => r.stage === 'top' ? E.topRoundName(r.size || r.matches.length * 2) : `Round ${r.n}`;
const activeCount = () => T ? T.players.filter(p => !p.dropped && !p.elim).length : 0;
function plannedRounds() { return T ? E.plannedRounds(T) : 0; }
function swissDone() { const s = swissRounds(); return s.length >= plannedRounds() && s.every(r => r.complete); }
function liveStandings() { return T ? E.standings(T) : []; }
function freshLive() { return { lpA: 8000, lpB: 8000, turn: 1, extra: 0, log: [], active: 'A', entry: '' }; }

// What should the organizer do next?
function nextStep() {
  if (!T) return { label: 'Create a tournament', sub: 'Set the rules and start adding players', act: 'newTournament', icon: 'plus' };
  if (T.status === 'complete') return { label: 'View final standings', sub: 'The tournament is finished', act: 'tab', tab: 'standings', icon: 'trophy', alt: true };
  const cr = curRound();
  if (cr) {
    const pend = pendingIn(cr);
    if (pend) return { label: `${roundTitle(cr)} in progress`, sub: `${cr.matches.length - pend}/${cr.matches.length} results reported`, act: 'tab', tab: 'round', icon: 'swords' };
    return { label: `Complete ${roundTitle(cr)}`, sub: 'All results are in — lock the round', act: 'completeRound', icon: 'check', alt: true };
  }
  if (T.players.length < 2) return { label: 'Add players', sub: 'At least 2 players are needed', act: 'tab', tab: 'players', icon: 'user-plus' };
  const tops = topRounds();
  if (tops.length) {
    const last = tops[tops.length - 1];
    if ((last.size || last.matches.length * 2) <= 2) return { label: 'Finish tournament', sub: 'Crown the champion', act: 'finishTournament', icon: 'crown', alt: true };
    return { label: 'Pair next bracket round', sub: E.topRoundName((last.size || last.matches.length * 2) / 2), act: 'pairNext', icon: 'swords' };
  }
  if (swissDone()) {
    if (T.rules.topCut >= 2) return { label: `Start Top ${T.rules.topCut}`, sub: 'Swiss rounds are complete', act: 'startTop', icon: 'trophy', alt: true };
    return { label: 'Finish tournament', sub: 'Swiss rounds are complete', act: 'finishTournament', icon: 'crown', alt: true };
  }
  const n = swissRounds().length + 1;
  if (!T.locked && n === 1) return { label: 'Lock roster & pair Round 1', sub: `${activeCount()} players · ${plannedRounds()} Swiss rounds`, act: 'pairNext', icon: 'swords' };
  return { label: `Pair Round ${n}`, sub: `of ${plannedRounds()} Swiss rounds`, act: 'pairNext', icon: 'swords' };
}

/* ===================== UI infrastructure ===================== */
const ACT = {};          // click actions: data-act
const ON = {};           // input/change handlers: data-on
let sheetRefresh = null; // re-render function for the open sheet
let sheetOpen = false, dialogOpen = false;
let popIgnore = 0;
const layers = [];

// One history "sentinel" entry while any layer (sheet/dialog/match) is open, so the Android back
// button closes the top layer instead of leaving the app. Race-safe: never more than one pending back().
const onSentinel = () => !!(history.state && history.state.ds);
function ensureSentinel() { if (layers.length && !onSentinel()) { try { history.pushState({ ds: 1 }, ''); } catch (e) { } } }
function pushLayer(name) { layers.push(name); ensureSentinel(); }
function dropLayer(name) {
  const i = layers.lastIndexOf(name); if (i < 0) return; layers.splice(i, 1);
  if (!layers.length) goBackOnce();
}
let backPending = false;
function goBackOnce() { if (backPending || !onSentinel()) return; backPending = true; popIgnore++; try { history.back(); } catch (e) { popIgnore--; backPending = false; } }
window.addEventListener('popstate', () => {
  if (popIgnore > 0) { popIgnore--; backPending = false; if (layers.length) ensureSentinel(); else goBackOnce(); return; }
  const top = layers.pop();
  setTimeout(ensureSentinel, 0);
  if (top === 'dialog') closeDialog(null, true);
  else if (top === 'sheet') closeSheet(true);
  else if (top === 'match') closeMatch(true);
});

function openSheet(title, body, foot = '', opts = {}) {
  $('#sheetTitle').textContent = title;
  const sub = $('#sheetSub'); sub.hidden = !opts.sub; sub.textContent = opts.sub || '';
  $('#sheetBody').innerHTML = body;
  $('#sheetFoot').innerHTML = foot;
  sheetRefresh = opts.refresh || null;
  if (!sheetOpen) { $('#sheet').hidden = false; sheetOpen = true; pushLayer('sheet'); $('#sheetBody').scrollTop = 0; }
  else if (!opts.keepScroll) $('#sheetBody').scrollTop = 0;
  if (opts.focus) setTimeout(() => { const el = $(opts.focus); if (el) el.focus(); }, 60);
}
function closeSheet(fromPop) {
  if (!sheetOpen) return;
  $('#sheet').hidden = true; sheetOpen = false; sheetRefresh = null;
  $('#sheetBody').innerHTML = ''; $('#sheetFoot').innerHTML = '';
  if (!fromPop) dropLayer('sheet');
}
ACT.closeSheet = () => closeSheet();

let dialogResolve = null;
function ask({ title, msg = '', ok = 'Confirm', cancel = 'Cancel', danger = false, input = null, choices = null }) {
  return new Promise(res => {
    if (dialogOpen) closeDialog(null, false);
    dialogResolve = res;
    $('#dlgTitle').textContent = title; $('#dlgMsg').textContent = msg;
    const extra = $('#dlgExtra'); extra.innerHTML = '';
    if (input) extra.innerHTML = `<input class="input" id="dlgInput" style="margin-top:14px" maxlength="${input.max || 80}" value="${esc(input.value || '')}" placeholder="${esc(input.placeholder || '')}">`;
    const btns = $('#dlgBtns');
    if (choices) {
      btns.style.flexDirection = 'column';
      btns.innerHTML = choices.map((c, i) => `<button class="btn block ${c.cls || ''}" data-dlg="${i}">${esc(c.label)}</button>`).join('') + `<button class="btn ghost block" data-dlg="cancel">${esc(cancel)}</button>`;
      $$('[data-dlg]', btns).forEach(b => b.onclick = () => closeDialog(b.dataset.dlg === 'cancel' ? null : choices[+b.dataset.dlg].value));
    } else {
      btns.style.flexDirection = '';
      btns.innerHTML = (cancel ? `<button class="btn" data-dlg="0">${esc(cancel)}</button>` : '') + `<button class="btn ${danger ? 'danger' : 'primary'}" data-dlg="1">${esc(ok)}</button>`;
      $$('[data-dlg]', btns).forEach(b => b.onclick = () => closeDialog(b.dataset.dlg === '1' ? (input ? ($('#dlgInput').value || '').trim() : true) : (input ? null : false)));
    }
    $('#dialog').hidden = false; dialogOpen = true; pushLayer('dialog');
    setTimeout(() => { const i = $('#dlgInput'); if (i) { i.focus(); i.select(); i.onkeydown = e => { if (e.key === 'Enter') closeDialog((i.value || '').trim()); }; } else { const b = $('#dlgBtns .btn.primary,#dlgBtns .btn.danger'); if (b) b.focus(); } }, 50);
  });
}
function closeDialog(val, fromPop) {
  if (!dialogOpen) return;
  $('#dialog').hidden = true; dialogOpen = false;
  if (!fromPop) dropLayer('dialog');
  const r = dialogResolve; dialogResolve = null; if (r) r(fromPop ? (val ?? null) : val);
}
const confirmDo = (title, msg, ok = 'Confirm', danger = false) => ask({ title, msg, ok, danger });

function toast(msg, opts = {}) {
  const box = $('#toasts'); if (!box) return;
  const el = document.createElement('div');
  el.className = 'toast' + (opts.kind ? ' ' + opts.kind : '');
  el.innerHTML = `<span>${esc(msg)}</span>` + (opts.undo ? `<button>Undo</button>` : '');
  if (opts.undo) el.querySelector('button').onclick = () => { el.remove(); undo(); };
  box.appendChild(el);
  while (box.children.length > 2) box.firstChild.remove();
  setTimeout(() => { el.style.transition = 'opacity .3s'; el.style.opacity = '0'; setTimeout(() => el.remove(), 320); }, opts.ms || (opts.undo ? 5000 : 2600));
}

// delegated events
document.addEventListener('click', e => {
  const el = e.target.closest('[data-act]');
  if (!el || el.disabled || el.getAttribute('aria-disabled') === 'true') return;
  const fn = ACT[el.dataset.act];
  if (!fn) { console.warn('No action', el.dataset.act); return; }
  e.preventDefault();
  try { const r = fn(el.dataset, el, e); if (r && r.catch) r.catch(err => { console.error(err); toast('Error: ' + err.message, { kind: 'bad' }); }); }
  catch (err) { console.error(err); toast('Error: ' + err.message, { kind: 'bad' }); }
});
for (const evt of ['input', 'change']) document.addEventListener(evt, e => {
  const el = e.target.closest(`[data-on${evt}]`); if (!el) return;
  const fn = ON[el.getAttribute('data-on' + evt)];
  if (fn) try { fn(el, e); } catch (err) { console.error(err); }
});
document.addEventListener('keydown', e => {
  if (e.key === 'Escape') { if (dialogOpen) closeDialog(null); else if (sheetOpen) closeSheet(); else if (TAB === 'match') closeMatch(); }
  const el = e.target.closest && e.target.closest('[data-enter]');
  if (el && e.key === 'Enter') { e.preventDefault(); const fn = ACT[el.dataset.enter]; if (fn) fn(el.dataset, el, e); }
});

/* ---------- tab navigation ---------- */
function showTab(tab, opts = {}) {
  if (tab !== 'match' && TAB === 'match' && !opts.keepMatch) { if (layers.includes('match')) dropLayer('match'); MC = null; }
  TAB = tab;
  $$('.screen').forEach(s => s.classList.toggle('active', s.id === 'scr-' + tab));
  $$('#tabbar button').forEach(b => b.classList.toggle('active', b.dataset.tab === (tab === 'match' ? 'round' : tab)));
  renderScreen(tab);
  if (!opts.keepScroll) $('#view').scrollTop = 0;
  if (tab !== 'match') { PREFS.tab = tab; persistPrefs(); }
}
ACT.tab = d => { if (sheetOpen) closeSheet(); showTab(d.tab); };

/* ===================== screens ===================== */
function renderAll() {
  renderChrome();
  renderScreen(TAB);
  if (sheetOpen && sheetRefresh) { try { sheetRefresh(); } catch (e) { console.error(e); } }
}
function renderScreen(tab) {
  const map = { home: renderHome, players: renderPlayers, round: renderRound, standings: renderStandings, history: renderHistory, match: renderMatch };
  try { (map[tab] || renderHome)(); } catch (e) { console.error(e); $('#scr-' + tab).innerHTML = `<div class="empty"><b>Something went wrong</b>${esc(e.message)}<br><button class="btn" data-act="tab" data-tab="home">Go home</button></div>`; }
}
function renderChrome() {
  const bs = $('#brandSub'); bs.textContent = T ? T.name : ''; bs.hidden = !T;
  const chip = $('#statusChip'), dot = $('#roundDot');
  const cr = curRound();
  if (cr && cr.timer && (cr.timer.running || cr.timer.acc > 0)) {
    chip.hidden = false; updateTimerNodes();
  } else if (T) {
    chip.hidden = false; chip.className = 'status-chip' + (T.locked ? '' : ' warn');
    chip.innerHTML = T.status === 'complete' ? `${ic('trophy', 'sm')} Finished` : `${ic(T.locked ? 'lock' : 'unlock', 'sm')} ${T.players.length}`;
  } else chip.hidden = true;
  dot.hidden = !cr;
}

/* ---------- HOME ---------- */
function renderHome() {
  const el = $('#scr-home');
  const identity = `<div class="identity"><img src="${EMBLEM}" alt="MEIOCG emblem"><div><img class="wordmark id-word" src="${WORDMARK}" alt="MEIOCG"><h1><img class="id-title" src="${TITLE}" alt="Project: Duel Synapse"></h1><p>Swiss Tournament Manager</p></div></div>`;
  if (!T) {
    el.innerHTML = identity + `
      <button class="cta" data-act="newTournament"><span class="cta-ico">${ic('plus', 'lg')}</span><span><b>New Tournament</b></span>${ic('chev', 'chev')}</button>
      <div class="tiles">
        <button class="tile" data-act="tab" data-tab="history" style="--c:var(--gold)"><span class="t-ico">${ic('trophy')}</span><span><b>Previous events</b><small>${plural(ARCH.length, 'saved tournament')}</small></span></button>
        <button class="tile" data-act="openTools" style="--c:var(--draw)"><span class="t-ico">${ic('tools')}</span><span><b>Tools</b></span></button>
        <button class="tile" data-act="importFile"><span class="t-ico">${ic('upload')}</span><span><b>Import</b></span></button>
        <button class="tile" data-act="openRulesRef" style="--c:var(--good)"><span class="t-ico">${ic('book')}</span><span><b>Rules guide</b></span></button>
      </div>`;
    return;
  }
  const ns = nextStep(), cr = curRound(), sw = swissRounds();
  const planned = plannedRounds();
  const reported = cr ? cr.matches.length - pendingIn(cr) : 0;
  const statusPill = T.status === 'complete' ? '<span class="pill good">FINISHED</span>' : cr ? `<span class="pill info">${esc(roundTitle(cr)).toUpperCase()} LIVE</span>` : T.locked ? '<span class="pill info">LOCKED</span>' : '<span class="pill warn">SETUP</span>';
  const roundTxt = `${Math.min(sw.length, planned)}/${planned}`;
  el.innerHTML = identity + `
    <div class="card glow">
      <div class="row between"><span class="pill info">${esc(T.rules.label)}</span>${statusPill}</div>
      <div class="row" style="margin-top:8px"><div class="event-name grow">${esc(T.name)}</div><button class="mini-btn edit" data-act="renameT" aria-label="Rename tournament">${ic('edit', 'sm')}</button></div>
      <div class="kpis">
        <div class="kpi"><b>${activeCount()}</b><span>Active</span></div>
        <div class="kpi"><b>${roundTxt}</b><span>Rounds</span></div>
        <div class="kpi"><b>${cr ? reported + '/' + cr.matches.length : '—'}</b><span>Reported</span></div>
        <div class="kpi"><b>${T.rules.topCut ? 'Top ' + T.rules.topCut : 'None'}</b><span>Cut</span></div>
      </div>
      ${cr ? `<div style="margin-top:12px"><div class="row between small"><span class="muted">${esc(roundTitle(cr))} · <span data-timer-text>--:--</span></span><span class="muted">${Math.round(reported / Math.max(1, cr.matches.length) * 100)}%</span></div><div class="progress" style="margin-top:6px"><i style="width:${reported / Math.max(1, cr.matches.length) * 100}%"></i></div></div>` : ''}
    </div>
    <div style="margin-top:12px"><button class="cta ${ns.alt ? 'alt' : ''}" data-act="${ns.act}" ${ns.tab ? `data-tab="${ns.tab}"` : ''}><span class="cta-ico">${ic(ns.icon, 'lg')}</span><span><b>${esc(ns.label)}</b><small>${esc(ns.sub)}</small></span>${ic('chev', 'chev')}</button></div>
    <div class="tiles">
      <button class="tile" data-act="tab" data-tab="players"><span class="t-ico">${ic('users')}</span><span><b>Players</b><small>${T.players.length}</small></span></button>
      <button class="tile" data-act="tab" data-tab="round" style="--c:var(--accent-2)"><span class="t-ico">${ic('swords')}</span><span><b>Round</b></span></button>
      <button class="tile" data-act="tab" data-tab="standings" style="--c:var(--gold)"><span class="t-ico">${ic('chart')}</span><span><b>Standings</b></span></button>
      <button class="tile" data-act="openRules" style="--c:var(--good)"><span class="t-ico">${ic('shield')}</span><span><b>Rules</b></span></button>
      <button class="tile" data-act="openTools" style="--c:var(--draw)"><span class="t-ico">${ic('tools')}</span><span><b>Tools</b></span></button>
      <button class="tile" data-act="newTournament" style="--c:var(--warn)"><span class="t-ico">${ic('plus')}</span><span><b>New event</b></span></button>
    </div>`;
  updateTimerNodes();
}

/* ---------- PLAYERS ---------- */
let playerQuery = '';
function renderPlayers() {
  const el = $('#scr-players');
  if (!T) { el.innerHTML = `<div class="page-head"><div><h1>${ic('users')} Players</h1></div></div>` + emptyState('users', 'No tournament yet', '', 'newTournament', 'New Tournament'); return; }
  const started = T.rounds.length > 0;
  const st = started ? new Map(liveStandings().map(s => [s.id, s])) : null;
  const q = playerQuery.trim().toLowerCase();
  const list = T.players.slice().sort((a, b) => a.seed - b.seed).filter(p => !q || p.name.toLowerCase().includes(q));
  const active = activeCount();
  el.innerHTML = `
    <div class="page-head"><div><h1>${ic('users')} Players</h1><p>${plural(T.players.length, 'registered player')} · ${active} active</p></div>
      <button class="btn sm" data-act="playerMenu">${ic('more')}</button></div>
    <div class="lock-banner ${T.locked ? 'locked' : 'open'}">
      <span class="ico">${ic(T.locked ? 'lock' : 'unlock')}</span>
      <div class="grow"><b>${T.locked ? 'Roster locked' : 'Roster open'}</b>${started && !T.locked ? '<small>Late entries start with 0 points.</small>' : ''}</div>
      <button class="btn sm ${T.locked ? '' : 'good'}" data-act="toggleLock">${T.locked ? 'Unlock' : 'Lock'}</button>
    </div>
    ${T.locked ? '' : `<div class="card" style="margin-top:12px">
      <div class="add-row"><input class="input" id="addName" placeholder="Player name" maxlength="60" autocomplete="off" enterkeyhint="done" data-enter="addPlayer"><button class="btn primary" data-act="addPlayer">${ic('plus')} Add</button></div>
      <div class="btn-grid" style="margin-top:8px"><button class="btn sm" data-act="bulkAdd">${ic('paste', 'sm')} Paste list</button><button class="btn sm" data-act="pastPlayers">${ic('history', 'sm')} Past players</button></div>
    </div>`}
    <div class="card" style="margin-top:12px;padding:0">
      <div style="padding:12px 12px 0"><div class="search">${ic('search', 'sm')}<input class="input sm" placeholder="Search players" value="${esc(playerQuery)}" data-oninput="playerSearch" aria-label="Search players"></div></div>
      <div class="plist">${list.length ? list.map(p => {
        const s = st && st.get(p.id);
        const status = p.elim ? '<span class="pill bad">OUT</span>' : p.dropped ? '<span class="pill bad">DROPPED</span>' : '';
        const canDel = !T.locked && !playerHasMatches(p.id);
        return `<div class="prow ${p.dropped || p.elim ? 'out' : ''}">
          <span class="seedn">${p.seed}</span><span class="avatar" style="--h:${hue(p.name)}">${esc(initials(p.name))}</span>
          <button class="pmain" data-act="playerSheet" data-id="${p.id}"><b>${esc(p.name)}</b>${s || p.note ? `<small>${s ? `${pts(s.pts)} · ${s.w}-${s.losses}-${s.d}` : ''}${s && p.note ? ' · ' : ''}${p.note ? esc(p.note) : ''}</small>` : ''}</button>
          ${status}
          <div class="acts"><button class="mini-btn edit" data-act="renamePlayer" data-id="${p.id}" aria-label="Rename ${esc(p.name)}">${ic('edit', 'sm')}</button>${canDel ? `<button class="mini-btn del" data-act="deletePlayer" data-id="${p.id}" aria-label="Delete ${esc(p.name)}">${ic('trash', 'sm')}</button>` : ''}</div>
        </div>`;
      }).join('') : `<div class="empty"><b>${q ? 'No match' : 'No players yet'}</b></div>`}</div>
    </div>`;
}
function playerHasMatches(id) { return T.rounds.some(r => r.matches.some(m => m.a === id || m.b === id)); }
ON.playerSearch = el => { playerQuery = el.value; const pos = el.selectionStart; renderPlayers(); const n = $('#scr-players input[data-oninput="playerSearch"]'); if (n) { n.focus(); n.setSelectionRange(pos, pos); } };

/* ---------- ROUND ---------- */
let roundQuery = '', swapMode = false, swapSel = null;
function renderRound() {
  const el = $('#scr-round');
  if (!T) { el.innerHTML = `<div class="page-head"><div><h1>${ic('swords')} Round</h1></div></div>` + emptyState('swords', 'No tournament yet', '', 'newTournament', 'New Tournament'); return; }
  const cr = curRound(), lr = lastRound();
  const r = cr || lr;
  if (!r) {
    const ns = nextStep();
    el.innerHTML = `<div class="page-head"><div><h1>${ic('swords')} Round</h1><p>${esc(T.name)}</p></div></div>` +
      emptyState('swords', 'No rounds yet', `${activeCount()} players · ${plannedRounds()} rounds`, ns.act, ns.label, ns.tab);
    return;
  }
  const pend = pendingIn(r), total = r.matches.length, done = total - pend;
  const isTop = r.stage === 'top';
  const st = new Map(liveStandings().map(s => [s.id, s]));
  const q = roundQuery.trim().toLowerCase();
  const anyResult = r.matches.some(m => m.b && m.result);
  const canSwap = cr && !anyResult;
  if (!canSwap) { swapMode = false; swapSel = null; }
  const ms = r.matches.slice().sort((a, b) => (a.table || 999) - (b.table || 999));
  const shown = q ? ms.filter(m => pn(m.a).toLowerCase().includes(q) || (m.b && pn(m.b).toLowerCase().includes(q)) || String(m.table) === q) : ms;
  const sub = isTop ? 'Single elimination' : `of ${plannedRounds()}`;
  const proc = isTop ? T.rules.time.topProcedure : T.rules.time.procedure;
  const banners = cr ? roundBanners(cr, proc) : '';
  el.innerHTML = `
    <div class="page-head"><div><h1>${ic('swords')} ${esc(roundTitle(r))}</h1><p>${esc(sub)}</p></div>
      ${cr ? `<button class="btn sm" data-act="roundMenu" aria-label="Round options">${ic('more')}</button>` : ''}</div>
    ${cr ? timerCard(cr) : `<div class="banner good"><span class="b-ico">${ic('check')}</span><div class="b-body"><b>${esc(roundTitle(r))} complete</b></div></div>`}
    ${banners}
    <div class="row" style="margin-top:12px">
      <div class="search grow">${ic('search', 'sm')}<input class="input sm" placeholder="Find player or table" value="${esc(roundQuery)}" data-oninput="roundSearch" aria-label="Find player or table"></div>
      ${canSwap ? `<button class="btn sm ${swapMode ? 'primary' : ''}" data-act="toggleSwap">${ic('swap', 'sm')} ${swapMode ? 'Done' : 'Swap'}</button>` : ''}
    </div>
    ${swapMode ? `<div class="banner info"><span class="b-ico">${ic('swap')}</span><div class="b-body"><b>Tap two players to swap</b></div></div>` : ''}
    <div class="row between small muted" style="margin:12px 4px 0"><span>${done}/${total} reported</span><span>${r.rematches ? `<span class="pill warn">${plural(r.rematches, 'rematch', 'rematches')}</span>` : ''}</span></div>
    <div class="progress" style="margin:6px 2px 0"><i style="width:${done / Math.max(1, total) * 100}%"></i></div>
    <div class="mlist">${shown.map(m => matchCard(m, r, st, q)).join('') || '<div class="empty">No table matches your search.</div>'}</div>
    ${cr ? `<div class="sticky-cta">${pend ? `<button class="btn block lg" disabled>${plural(pend, 'result')} still needed</button>` : `<button class="btn primary block lg" data-act="completeRound">${ic('check')} Complete ${esc(roundTitle(cr))}</button>`}</div>`
      : `<div class="sticky-cta">${(() => { const ns = nextStep(); return `<button class="btn primary block lg" data-act="${ns.act}" ${ns.tab ? `data-tab="${ns.tab}"` : ''}>${ic(ns.icon)} ${esc(ns.label)}</button>`; })()}</div>`}`;
  updateTimerNodes();
}
ON.roundSearch = el => { roundQuery = el.value; const pos = el.selectionStart; renderRound(); const n = $('#scr-round input[data-oninput="roundSearch"]'); if (n) { n.focus(); n.setSelectionRange(pos, pos); } };

function matchCard(m, r, st, q) {
  if (m.result === 'VOID') return '';
  const sA = st.get(m.a), sB = m.b ? st.get(m.b) : null;
  const hl = q && (pn(m.a).toLowerCase().includes(q) || (m.b && pn(m.b).toLowerCase().includes(q)));
  if (!m.b) return `<div class="mcard done ${hl ? 'hl' : ''}"><div class="tno"><small>BYE</small><b>—</b></div><div class="vs"><div class="side win"><b>${esc(pn(m.a))}</b><small>${sA ? pts(sA.pts) : ''}</small></div><div class="score"><small>BYE</small>+${T.rules.points.bye}</div><div class="side r"><small>${r.stage === 'top' ? 'Advances' : 'Match win (' + T.rules.byeDuels.join('–') + ')'}</small></div></div></div>`;
  const c = E.duelCount(m.duels);
  const sideCls = (who) => !m.result ? '' : (m.result === who ? 'win' : (m.result === 'A' || m.result === 'B') ? 'lose' : '');
  let label = 'PENDING', scls = '';
  if (m.result === 'A' || m.result === 'B') label = 'FINAL';
  else if (m.result === 'D') { label = 'DRAW'; scls = 'dr'; }
  else if (m.result === 'DL') { label = 'DBL LOSS'; scls = 'dl'; }
  else if (m.duels.length) label = 'LIVE';
  const tag = (id, s) => `${s ? pts(s.pts) : ''}${P(id) && P(id).dropped ? ' · dropped' : ''}`;
  if (swapMode) {
    const chip = (side, id) => `<button class="swap-chip ${swapSel && swapSel.m === m.id && swapSel.side === side ? 'sel' : ''}" data-act="swapPick" data-m="${m.id}" data-side="${side}"><b>${esc(pn(id))}</b><small class="muted"> ${tag(id, st.get(id))}</small></button>`;
    return `<div class="mcard ${hl ? 'hl' : ''}"><div class="tno"><small>TABLE</small><b>${m.table}</b></div><div class="vs">${chip('a', m.a)}<div class="score"><small>VS</small></div>${chip('b', m.b)}</div></div>`;
  }
  return `<button class="mcard ${m.result ? 'done' : ''} ${hl ? 'hl' : ''}" data-act="openResult" data-r="${r.id}" data-m="${m.id}" aria-label="Table ${m.table}: ${esc(pn(m.a))} versus ${esc(pn(m.b))}">
    <div class="tno"><small>TABLE</small><b>${m.table}</b></div>
    <div class="vs"><div class="side ${sideCls('A')}"><b>${esc(pn(m.a))}</b><small>${tag(m.a, sA)}</small></div>
    <div class="score ${scls}"><small>${label}</small>${m.duels.length || m.result ? `${c.a}–${c.b}` : 'vs'}</div>
    <div class="side r ${sideCls('B')}"><b>${esc(pn(m.b))}</b><small>${tag(m.b, sB)}</small></div></div></button>`;
}

function timerCard(r) {
  const tm = r.timer, untimed = !tm.limit;
  const running = tm.running;
  return `<div class="card timer-card glow">
    <div class="timer-label">${untimed ? 'ROUND CLOCK · NO LIMIT' : 'ROUND TIMER'}</div>
    <div class="timer" data-timer-big>--:--</div>
    <div class="timer-sub" data-timer-sub>&nbsp;</div>
    <div class="timer-ctrls">
      <button class="btn ${running ? '' : 'primary'}" data-act="timerToggle">${ic(running ? 'pause' : 'play', 'sm')} ${running ? 'Pause' : (tm.acc > 0 ? 'Resume' : 'Start')}</button>
      <button class="btn" data-act="timerReset">${ic('reset', 'sm')} Reset</button>
      <button class="btn" data-act="timerAdj" data-d="-60" aria-label="Minus one minute" ${untimed ? 'disabled' : ''}>−1</button>
      <button class="btn" data-act="timerAdj" data-d="60" aria-label="Plus one minute" ${untimed ? 'disabled' : ''}>+1</button>
    </div></div>`;
}
function roundBanners(r, proc) {
  const tm = r.timer; if (!tm.limit) return '';
  const rem = timerRemaining(tm), pend = pendingIn(r);
  if (rem > 0 || !pend) return '';
  const over = -rem;
  const cap = r.stage === 'top' ? 0 : (T.rules.time.overtimeCap || 0);
  let out = '';
  if (cap && over >= cap * 60) out += `<div class="banner bad"><span class="b-ico">${ic('alert')}</span><div class="b-body"><b>${cap}-minute overtime limit reached</b><button class="btn danger sm" data-act="applyAllDL" data-why="overtime">Apply Double Loss to ${plural(pend, 'match', 'matches')}</button></div></div>`;
  const procTxt = { 'ocg-match': 'Run the End-of-Match procedure at each unfinished table: tap the table, then “Time called”.', 'ocg-elim': 'Run the End-of-Match procedure at each unfinished table: tap the table, then “Time called”.', 'ocg-single': 'Unfinished Duels at time are a Double Loss.', 'dl': 'Matches without a winner at time are a Double Loss.', 'dl-elim': 'Matches without a winner at time are a Double Loss.', 'manual': 'Record each unfinished Match as decided by the judge.' }[proc] || '';
  const dlAll = ['ocg-single', 'dl', 'dl-elim'].includes(proc);
  out += `<div class="banner warn"><span class="b-ico">${ic('timer')}</span><div class="b-body"><b>TIME — ${plural(pend, 'unfinished match', 'unfinished matches')}</b><p>${esc(procTxt)}</p>${dlAll ? `<button class="btn warn sm" data-act="applyAllDL" data-why="time">Apply Double Loss to all ${pend}</button>` : ''}</div></div>`;
  return out;
}

/* ---------- STANDINGS ---------- */
let standView = 'swiss';
function renderStandings() {
  const el = $('#scr-standings');
  if (!T) { el.innerHTML = `<div class="page-head"><div><h1>${ic('chart')} Standings</h1></div></div>` + emptyState('chart', 'No standings yet', '', 'newTournament', 'New Tournament'); return; }
  const hasTop = topRounds().length > 0;
  if (!hasTop && standView !== 'swiss') standView = 'swiss';
  const cr = curRound();
  const completed = swissRounds().filter(r => r.complete).length;
  const tb = T.rules.tiebreakers;
  const info = cr && cr.stage !== 'top' ? `Live · includes ${roundTitle(cr)} results so far` : `After ${plural(completed, 'Swiss round')}`;
  let body = '';
  if (standView === 'final') {
    const fp = E.finalPlacements(T);
    body = `<div class="card" style="padding:0">${standHead()}${fp.map(s => standRow(s, s.place, s.note)).join('')}</div>
      <div class="section-title">Bracket</div><div class="card">${bracketView()}</div>`;
  } else {
    const st = liveStandings();
    body = st.length ? `<div class="card" style="padding:0">${standHead()}${st.map(s => standRow(s, s.rank)).join('')}</div>` : emptyState('chart', 'No players', '', 'tab', 'Players', 'players');
  }
  el.innerHTML = `
    <div class="page-head"><div><h1>${ic('chart')} Standings</h1><p>${esc(info)}</p></div><button class="btn sm" data-act="standMenu">${ic('share', 'sm')} Share</button></div>
    ${hasTop ? `<div class="seg" style="margin-bottom:12px"><button class="${standView === 'swiss' ? 'on' : ''}" data-act="standView" data-v="swiss">Swiss</button><button class="${standView === 'final' ? 'on' : ''}" data-act="standView" data-v="final">Final placings</button></div>` : ''}
    ${body}
    <details class="rnd" style="margin-top:14px"><summary>How ranking works ${ic('chev', 'chev sm')}</summary><div class="small" style="padding:0 14px 14px">
      <div class="row wrap" style="gap:6px"><span class="pill good">Win ${T.rules.points.win}</span><span class="pill draw">Draw ${T.rules.points.draw}</span><span class="pill">Loss ${T.rules.points.loss}</span><span class="pill bad">Double Loss ${T.rules.points.dl}</span><span class="pill info">Bye ${T.rules.points.bye}</span></div>
      <ol style="margin:12px 0 0;padding-left:20px;line-height:1.6"><li><b>Match points</b></li>${T.rules.hiddenDraw ? '<li><b>Ties rank above Double Losses</b></li>' : ''}${tb.map(k => `<li><b>${E.TIEBREAKERS[k].name}</b></li>`).join('')}<li class="muted">Remaining ties: fixed random order</li></ol>
      ${T.rules.omwFloor ? `<p class="muted" style="margin:8px 0 0">${Math.round(T.rules.omwFloor * 100)}% minimum per player.</p>` : ''}
    </div></details>`;
}
function standHead() { return `<div class="thead"><span>#</span><span>Player · record · tie-breakers</span><span>Pts</span></div>`; }
function standRow(s, place, note) {
  const tb = T.rules.tiebreakers.filter(k => k !== 'h2h').map(k => `${E.TIEBREAKERS[k].short} ${['omw', 'oomw', 'gwp', 'ogw'].includes(k) ? pct(s[k]) : (Math.round(s[k] * 100) / 100)}`).join(' · ');
  const tag = s.elim ? ' <span class="pill bad">OUT</span>' : s.dropped ? ' <span class="pill bad">DROP</span>' : '';
  return `<button class="srow" data-act="playerSheet" data-id="${s.id}"><span class="rank ${place <= 3 ? 'r' + place : ''}">${place}</span>
    <span class="who"><b><span class="nm">${esc(s.name)}</span>${tag}${note ? `<span class="pill info">${esc(note)}</span>` : ''}</b><small>${s.w}-${s.losses}-${s.d}${s.dl ? ` (${s.dl} DL)` : ''}${s.byes ? ` · ${s.byes} bye` : ''} · ${tb}</small></span>
    <span class="pts"><b>${s.pts}</b><small>${s.gw}-${s.gl}${s.gd ? '-' + s.gd : ''} duels</small></span></button>`;
}
function bracketView() {
  const tops = topRounds();
  return `<div class="bracket">${tops.map(r => `<div class="bcol"><h4>${esc(roundTitle(r))}</h4>${r.matches.slice().sort((a, b) => a.slot - b.slot).map(m => {
    if (m.result === 'VOID') return '';
    const w = E.topWinner(m), c = E.duelCount(m.duels);
    const line = (id, sc) => `<div class="${!m.result ? '' : id && id === w ? 'w' : 'l'}"><span class="ellipsis">${esc(id ? pn(id) : 'BYE')}</span><span class="num">${m.b && m.result ? sc : ''}</span></div>`;
    return `<div class="bm">${line(m.a, c.a)}${line(m.b, c.b)}</div>`;
  }).join('')}</div>`).join('')}</div>`;
}
ACT.standView = d => { standView = d.v; renderStandings(); };

/* ---------- HISTORY ---------- */
let histView = 'event', histQuery = '';
function renderHistory() {
  const el = $('#scr-history');
  const q = histQuery.trim().toLowerCase();
  let body = '';
  if (histView === 'event') {
    if (!T || !T.rounds.length) body = emptyState('history', 'No rounds played yet', '', T ? 'tab' : 'newTournament', T ? 'Go to Round' : 'New Tournament', 'round');
    else body = T.rounds.slice().reverse().map((r, i) => {
      const rows = r.matches.filter(m => m.result !== 'VOID').filter(m => !q || pn(m.a).toLowerCase().includes(q) || (m.b && pn(m.b).toLowerCase().includes(q)));
      if (q && !rows.length) return '';
      const pend = pendingIn(r);
      return `<details class="rnd" ${i === 0 || q ? 'open' : ''}><summary>${esc(roundTitle(r))} <span class="pill ${r.complete ? 'good' : 'info'}">${r.complete ? 'COMPLETE' : 'LIVE'}</span><span class="muted small">${r.matches.length - pend}/${r.matches.length}</span>${ic('chev', 'chev sm')}</summary>
        ${rows.sort((a, b) => (a.table || 999) - (b.table || 999)).map(m => histRow(m, r)).join('')}</details>`;
    }).join('') || '<div class="empty">No matching records.</div>';
  } else if (histView === 'archive') {
    body = ARCH.length ? `<div class="card">${ARCH.filter(a => !q || a.name.toLowerCase().includes(q) || a.players.some(p => p.name.toLowerCase().includes(q))).map(a => {
      const fp = safeFinal(a); const champ = fp[0];
      return `<div class="arch"><span class="a-ico">${ic('trophy')}</span><div class="grow" style="min-width:0"><b class="ellipsis" style="display:block">${esc(a.name)}</b><small class="muted">${fmtDay(a.createdAt)} · ${plural(a.players.length, 'player')} · ${plural(swissRounds(a).length, 'round')}${champ && a.status === 'complete' ? ' · 🏆 ' + esc(champ.name) : a.status !== 'complete' ? ' · unfinished' : ''}</small></div><button class="btn sm" data-act="viewArchive" data-id="${a.id}">View</button></div>`;
    }).join('')}</div>` : emptyState('trophy', 'No previous tournaments', '');
  } else {
    body = T && T.log.length ? `<div class="card"><div class="log">${T.log.slice().reverse().map(l => `<div>${esc(fmtDate(l.t))} · ${esc(l.m)}</div>`).join('')}</div></div>` : emptyState('list', 'Activity log is empty', '');
  }
  el.innerHTML = `
    <div class="page-head"><div><h1>${ic('history')} History</h1></div></div>
    <div class="seg"><button class="${histView === 'event' ? 'on' : ''}" data-act="histView" data-v="event">This event</button><button class="${histView === 'archive' ? 'on' : ''}" data-act="histView" data-v="archive">Archive (${ARCH.length})</button><button class="${histView === 'log' ? 'on' : ''}" data-act="histView" data-v="log">Log</button></div>
    ${histView !== 'log' ? `<div class="search" style="margin:12px 0">${ic('search', 'sm')}<input class="input sm" placeholder="${histView === 'event' ? 'Search player' : 'Search event or player'}" value="${esc(histQuery)}" data-oninput="histSearch" aria-label="Search history"></div>` : '<div style="height:12px"></div>'}
    ${body}`;
}
function histRow(m, r) {
  if (!m.b) return `<div class="hrow"><span class="t">—</span><span>${esc(pn(m.a))} <span class="muted">· bye</span></span><span class="res"><span class="pill info">BYE</span></span></div>`;
  const c = E.duelCount(m.duels);
  const res = !m.result ? '<span class="pill">PENDING</span>' : m.result === 'D' ? '<span class="pill draw">DRAW</span>' : m.result === 'DL' ? '<span class="pill bad">DBL LOSS</span>' : `<span class="pill good">${esc(pn(m.result === 'A' ? m.a : m.b))}</span>`;
  return `<button class="hrow" style="width:100%;background:none;border-left:0;border-right:0;border-bottom:0;color:inherit;text-align:left" data-act="openResult" data-r="${r.id}" data-m="${m.id}"><span class="t">${m.table}</span><span class="ellipsis">${esc(pn(m.a))} <span class="muted">vs</span> ${esc(pn(m.b))} <span class="muted num">· ${c.a}-${c.b}${c.d ? '-' + c.d : ''}</span></span><span class="res">${res}</span></button>`;
}
function safeFinal(a) { try { return E.finalPlacements(a); } catch (e) { return []; } }
ACT.histView = d => { histView = d.v; renderHistory(); };
ON.histSearch = el => { histQuery = el.value; const pos = el.selectionStart; renderHistory(); const n = $('#scr-history input[data-oninput="histSearch"]'); if (n) { n.focus(); n.setSelectionRange(pos, pos); } };

function emptyState(icon, title, text, act, label, tab) {
  return `<div class="card"><div class="empty"><div class="e-ico">${ic(icon, 'lg')}</div><b>${esc(title)}</b>${esc(text)}${act ? `<br><button class="btn primary" data-act="${act}" ${tab ? `data-tab="${tab}"` : ''}>${esc(label)}</button>` : ''}</div></div>`;
}

/* ===================== tournament lifecycle ===================== */
function archiveT(t, why) {
  if (!t || (!t.players.length && !t.rounds.length)) return;
  const c = E.clone(t); c.archivedAt = Date.now(); if (why) c.log.push({ t: Date.now(), m: why });
  ARCH = ARCH.filter(a => a.id !== c.id); ARCH.unshift(c);
  if (ARCH.length > 60) ARCH.length = 60;
  persistArchive();
}

let ND = null; // new tournament draft
ACT.newTournament = () => {
  ND = { name: '', presetId: 'ocg2026', rounds: 'auto', topCut: 0, carry: false };
  renderNewT();
};
function renderNewT() {
  const canCarry = T && T.players.length;
  const est = canCarry && ND.carry ? E.konamiRounds(T.players.filter(p => !p.dropped).length) : null;
  openSheet('New tournament', `
    <label class="f"><span>Tournament name</span><input class="input" id="ntName" maxlength="80" placeholder="e.g. MEIOCG Weekly #12" value="${esc(ND.name)}" data-oninput="ndName"></label>
    <div class="section-title">Rule set</div>
    <div class="presets">${E.PRESET_ORDER.map(id => { const p = E.PRESETS[id]; return `<button class="preset ${ND.presetId === id ? 'on' : ''}" data-act="ndPreset" data-id="${id}"><b>${esc(p.label)}</b><span class="pill ${id.startsWith('ocg') ? 'info' : ''}">${esc(p.tag)}</span><small>${esc(p.short)}</small></button>`; }).join('')}</div>
    <div class="section-title">Structure</div>
    <div class="fields">
      <label class="f"><span>Swiss rounds</span><select class="input" data-onchange="ndRounds"><option value="auto" ${ND.rounds === 'auto' ? 'selected' : ''}>Auto (Konami table)</option>${Array.from({ length: 15 }, (_, i) => `<option value="${i + 1}" ${ND.rounds == i + 1 ? 'selected' : ''}>${i + 1}</option>`).join('')}</select></label>
      <label class="f"><span>Top cut</span><select class="input" data-onchange="ndTop">${[0, 4, 8, 16, 32, 64].map(n => `<option value="${n}" ${ND.topCut == n ? 'selected' : ''}>${n ? 'Top ' + n : 'None (Swiss only)'}</option>`).join('')}</select></label>
    </div>
    ${canCarry ? `<label class="switch"><span><b>Carry over roster</b><small>${plural(T.players.length, 'player')}</small></span><span class="toggle"><input type="checkbox" ${ND.carry ? 'checked' : ''} data-onchange="ndCarry"><span></span></span></label>` : ''}
    ${T ? `<div class="banner info"><span class="b-ico">${ic('info')}</span><div class="b-body"><b>“${esc(T.name)}” will be archived</b></div></div>` : ''}
`,
    `<button class="btn" data-act="closeSheet">Cancel</button><button class="btn primary" data-act="createTournament">${ic('check', 'sm')} Create</button>`,
    { focus: ND.name ? null : '#ntName', keepScroll: true });
}
ON.ndName = el => { ND.name = el.value; };
ON.ndRounds = el => { ND.rounds = el.value === 'auto' ? 'auto' : +el.value; };
ON.ndTop = el => { ND.topCut = +el.value; };
ON.ndCarry = el => { ND.carry = el.checked; renderNewT(); };
ACT.ndPreset = d => { ND.presetId = d.id; renderNewT(); };
ACT.createTournament = () => {
  const name = (ND.name || '').trim() || `${E.PRESETS[ND.presetId].label} · ${fmtDay(Date.now())}`;
  const rules = E.makeRules(ND.presetId); rules.rounds = ND.rounds; rules.topCut = ND.topCut;
  const carried = ND.carry && T ? T.players.map((p, i) => ({ id: E.uid(), name: p.name, seed: i + 1, dropped: false, elim: false, note: p.note || '' })) : [];
  if (T) archiveT(T, 'Archived when a new tournament was created');
  T = normalizeT({ id: E.uid(), name, rules, players: carried, rounds: [], log: [], status: 'setup', locked: false, createdAt: Date.now() });
  log(`Tournament created (${rules.label})`);
  UNDO.length = 0; persist(); closeSheet(); renderAll(); showTab('players');
  toast('Tournament created — add your players', { kind: 'good' });
};
ACT.renameT = async () => {
  const v = await ask({ title: 'Rename tournament', input: { value: T.name, max: 80 }, ok: 'Save' });
  if (v) mutate('Renamed tournament to “' + v + '”', () => { T.name = v.slice(0, 80); });
};

/* ---------- rules editor ---------- */
let RD = null;
ACT.openRules = () => { if (!T) return ACT.openRulesRef(); RD = E.clone(T.rules); renderRulesEditor(); };
function renderRulesEditor() {
  const started = T.rounds.length > 0;
  const f = RD.format, t = RD.time, p = RD.points;
  const procOpts = (v, list) => list.map(([k, l]) => `<option value="${k}" ${v === k ? 'selected' : ''}>${l}</option>`).join('');
  const all = Object.keys(E.TIEBREAKERS);
  const order = RD.tiebreakers.concat(all.filter(k => !RD.tiebreakers.includes(k)));
  const dis = started ? 'disabled' : '';
  openSheet('Rules & scoring', `
    ${started ? `<div class="banner info" style="margin-top:0"><span class="b-ico">${ic('lock')}</span><div class="b-body"><b>Match format locked after Round 1</b></div></div>` : ''}
    <div class="section-title">Rule set</div>
    <div class="presets">${E.PRESET_ORDER.map(id => { const pr = E.PRESETS[id]; return `<button class="preset ${RD.presetId === id ? 'on' : ''}" data-act="rdPreset" data-id="${id}" ${dis}><b>${esc(pr.label)}</b><span class="pill">${esc(pr.tag)}</span><small>${esc(pr.short)}</small></button>`; }).join('')}</div>
    <div class="section-title">Match format</div>
    <div class="fields">
      <label class="f"><span>Duel wins needed</span><select class="input" data-onchange="rd" data-k="format.winsNeeded" data-t="int" ${dis}>${[1, 2, 3].map(n => `<option value="${n}" ${f.winsNeeded == n ? 'selected' : ''}>${n} (best of ${n * 2 - 1})</option>`).join('')}</select></label>
      <label class="f"><span>Maximum Duels</span><select class="input" data-onchange="rd" data-k="format.maxDuels" data-t="int" ${dis}><option value="0" ${!f.maxDuels ? 'selected' : ''}>No cap (extra Duels)</option>${[1, 2, 3, 4, 5].filter(n => n >= f.winsNeeded).map(n => `<option value="${n}" ${f.maxDuels == n ? 'selected' : ''}>${n}</option>`).join('')}</select></label>
    </div>
    <label class="switch"><span><b>Duel draws</b></span><span class="toggle"><input type="checkbox" ${f.duelDraws ? 'checked' : ''} data-onchange="rd" data-k="format.duelDraws" data-t="bool" ${dis}><span></span></span></label>
    <label class="switch"><span><b>Match Draws</b>${f.matchDraws ? '' : '<small>Tied Match = Double Loss</small>'}</span><span class="toggle"><input type="checkbox" ${f.matchDraws ? 'checked' : ''} data-onchange="rd" data-k="format.matchDraws" data-t="bool" data-rerender="1" ${dis}><span></span></span></label>
    <div class="section-title">Time</div>
    <div class="fields">
      <label class="f"><span>Swiss round (minutes, 0 = none)</span><input class="input" type="number" inputmode="numeric" min="0" max="600" value="${t.limit}" data-onchange="rd" data-k="time.limit" data-t="int"></label>
      <label class="f"><span>Overtime cap (minutes)</span><input class="input" type="number" inputmode="numeric" min="0" max="240" value="${t.overtimeCap}" data-onchange="rd" data-k="time.overtimeCap" data-t="int"></label>
      <label class="f full"><span>End-of-Match procedure (Swiss)</span><select class="input" data-onchange="rd" data-k="time.procedure" data-rerender="1">${procOpts(t.procedure, [['ocg-match', 'OCG 2026 Match — extra turns & Duel compare'], ['ocg-single', 'OCG 2026 1-Duel — unfinished = Double Loss'], ['dl', 'Unfinished = Double Loss (TCG v2.5)'], ['manual', 'Judge decides manually']])}</select></label>
      <label class="f"><span>Top cut round (min, 0 = none)</span><input class="input" type="number" inputmode="numeric" min="0" max="600" value="${t.topLimit}" data-onchange="rd" data-k="time.topLimit" data-t="int"></label>
      <label class="f"><span>Top cut procedure</span><select class="input" data-onchange="rd" data-k="time.topProcedure">${procOpts(t.topProcedure, [['ocg-elim', 'OCG 2026 elimination'], ['dl-elim', 'Unfinished = Double Loss'], ['manual', 'Judge decides']])}</select></label>
    </div>
    <div class="section-title">Match points</div>
    <div class="fields" style="grid-template-columns:repeat(3,1fr)">
      ${[['win', 'Win'], ['draw', 'Draw'], ['loss', 'Loss'], ['dl', 'Double Loss'], ['bye', 'Bye']].map(([k, l]) => `<label class="f"><span>${l}</span><input class="input" type="number" inputmode="decimal" step="0.5" value="${p[k]}" data-onchange="rd" data-k="points.${k}" data-t="num"></label>`).join('')}
      <label class="f"><span>Bye Duel score</span><select class="input" data-onchange="rd" data-k="byeDuels" data-t="pair">${[[2, 0], [1, 0], [0, 0]].map(v => `<option value="${v.join('-')}" ${RD.byeDuels.join('-') === v.join('-') ? 'selected' : ''}>${v.join('–')}</option>`).join('')}</select></label>
    </div>
    <label class="switch"><span><b>Tie ranks above Double Loss</b><small>Hidden point, ranking only</small></span><span class="toggle"><input type="checkbox" ${RD.hiddenDraw ? 'checked' : ''} data-onchange="rd" data-k="hiddenDraw" data-t="hid"><span></span></span></label>
    <div class="section-title">Tie-breakers (in order)</div>
    <div class="tbl">${order.map((k, i) => { const on = RD.tiebreakers.includes(k); const tb = E.TIEBREAKERS[k]; return `<div class="tbi ${on ? '' : 'off'}"><span class="toggle"><input type="checkbox" ${on ? 'checked' : ''} data-onchange="rdTb" data-k="${k}" aria-label="${esc(tb.name)}"><span></span></span><div class="grow"><b>${esc(tb.name)}</b></div>${on ? `<button class="mini-btn" data-act="rdTbMove" data-k="${k}" data-d="-1" aria-label="Move up" ${RD.tiebreakers.indexOf(k) === 0 ? 'disabled' : ''}>▲</button><button class="mini-btn" data-act="rdTbMove" data-k="${k}" data-d="1" aria-label="Move down" ${RD.tiebreakers.indexOf(k) === RD.tiebreakers.length - 1 ? 'disabled' : ''}>▼</button>` : ''}</div>`; }).join('')}</div>
    <label class="f" style="margin-top:10px"><span>Minimum percentage per player (OMW% floor)</span><select class="input" data-onchange="rd" data-k="omwFloor" data-t="num">${[[0, 'None (0%)'], [0.25, '25%'], [0.33, '33% (MTG style)']].map(([v, l]) => `<option value="${v}" ${RD.omwFloor == v ? 'selected' : ''}>${l}</option>`).join('')}</select></label>
    <div class="section-title">Structure</div>
    <div class="fields">
      <label class="f"><span>Swiss rounds</span><select class="input" data-onchange="rd" data-k="rounds" data-t="rounds"><option value="auto" ${RD.rounds === 'auto' ? 'selected' : ''}>Auto (${E.konamiRounds(Math.max(2, T.startCount || activeCount()))} for ${T.startCount || activeCount()} players)</option>${Array.from({ length: 20 }, (_, i) => `<option value="${i + 1}" ${RD.rounds == i + 1 ? 'selected' : ''}>${i + 1}</option>`).join('')}</select></label>
      <label class="f"><span>Top cut</span><select class="input" data-onchange="rd" data-k="topCut" data-t="int">${[0, 2, 4, 8, 16, 32, 64].map(n => `<option value="${n}" ${RD.topCut == n ? 'selected' : ''}>${n ? 'Top ' + n : 'None'}</option>`).join('')}</select></label>
      <label class="f"><span>Eliminate after losses</span><select class="input" data-onchange="rd" data-k="elimLosses" data-t="int">${[0, 1, 2, 3, 4].map(n => `<option value="${n}" ${RD.elimLosses == n ? 'selected' : ''}>${n ? n + ' losses' : 'Off'}</option>`).join('')}</select></label>
      <label class="f"><span>Round 1 pairing</span><select class="input" data-onchange="rd" data-k="r1"><option value="random" ${RD.r1 === 'random' ? 'selected' : ''}>Random</option><option value="seed" ${RD.r1 === 'seed' ? 'selected' : ''}>By seed (1 vs half+1)</option></select></label>
    </div>`,
    `<button class="btn" data-act="closeSheet">Cancel</button><button class="btn primary" data-act="saveRules">${ic('check', 'sm')} Save rules</button>`, { keepScroll: true });
}
ON.rd = el => {
  const k = el.dataset.k, ty = el.dataset.t; let v = el.type === 'checkbox' ? el.checked : el.value;
  if (ty === 'hid') v = v ? 1 : 0; else if (ty === 'int') v = parseInt(v, 10) || 0; else if (ty === 'num') v = Number(v) || 0; else if (ty === 'bool') v = !!v;
  else if (ty === 'pair') v = String(v).split('-').map(Number); else if (ty === 'rounds') v = v === 'auto' ? 'auto' : parseInt(v, 10);
  const path = k.split('.'); let o = RD; while (path.length > 1) o = o[path.shift()]; o[path[0]] = v;
  if (k === 'format.winsNeeded' && RD.format.maxDuels && RD.format.maxDuels < v) RD.format.maxDuels = v * 2 - 1;
  if (!['rounds', 'topCut', 'elimLosses', 'r1', 'time.limit', 'time.topLimit', 'time.overtimeCap'].includes(k) && RD.presetId !== 'custom' && !k.startsWith('points') && k !== 'omwFloor' && k !== 'hiddenDraw') RD.presetId = 'custom', RD.label = E.PRESETS.custom.label;
  if (el.dataset.rerender || k.startsWith('format')) renderRulesEditor();
};
ON.rdTb = el => { const k = el.dataset.k; if (el.checked) { if (!RD.tiebreakers.includes(k)) RD.tiebreakers.push(k); } else RD.tiebreakers = RD.tiebreakers.filter(x => x !== k); renderRulesEditor(); };
ACT.rdTbMove = d => { const a = RD.tiebreakers, i = a.indexOf(d.k), j = i + (+d.d); if (i < 0 || j < 0 || j >= a.length) return;[a[i], a[j]] = [a[j], a[i]]; renderRulesEditor(); };
ACT.rdPreset = d => { const keep = { rounds: RD.rounds, topCut: RD.topCut }; RD = Object.assign(E.makeRules(d.id), keep); renderRulesEditor(); };
ACT.saveRules = () => {
  const nr = E.normalizeRules(RD);
  mutate('Rules updated', () => {
    T.rules = nr;
    const cr = curRound();
    if (cr && !cr.timer.running && !cr.timer.acc) cr.timer.limit = (cr.stage === 'top' ? nr.time.topLimit : nr.time.limit) * 60;
  }, { toast: 'Rules saved' });
  closeSheet();
};

/* ---------- roster ---------- */
function nameTaken(name, exceptId) { const k = name.trim().toLowerCase(); return T.players.some(p => p.id !== exceptId && p.name.trim().toLowerCase() === k); }
function addNames(names) {
  const clean = []; const seen = new Set(T.players.map(p => p.name.trim().toLowerCase()));
  let dup = 0;
  for (let n of names) {
    n = String(n).replace(/^\s*\d+\s*[.)\-:]\s*/, '').replace(/\s+/g, ' ').trim().slice(0, 60);
    if (!n) continue; const k = n.toLowerCase(); if (seen.has(k)) { dup++; continue; } seen.add(k); clean.push(n);
  }
  if (!clean.length) { toast(dup ? 'Already in the roster' : 'Enter a name first', { kind: 'bad' }); return 0; }
  const late = T.rounds.length > 0;
  mutate(`Added ${plural(clean.length, 'player')}${late ? ' (late entry)' : ''}: ${clean.slice(0, 5).join(', ')}${clean.length > 5 ? '…' : ''}`, () => {
    let seed = T.players.reduce((m, p) => Math.max(m, p.seed), 0);
    clean.forEach(n => T.players.push({ id: E.uid(), name: n, seed: ++seed, dropped: false, elim: false, note: '', lateRound: late ? swissRounds().length + 1 : null }));
  }, { toast: `${plural(clean.length, 'player')} added${dup ? ` · ${dup} duplicate skipped` : ''}${late ? ' · late entry' : ''}` });
  return clean.length;
}
ACT.addPlayer = () => {
  if (T.locked) return toast('Unlock the roster to add players', { kind: 'bad' });
  const inp = $('#addName'); const v = inp ? inp.value : '';
  if (addNames([v])) { const n = $('#addName'); if (n) { n.value = ''; n.focus(); } }
};
ACT.bulkAdd = () => {
  if (T.locked) return toast('Unlock the roster to add players', { kind: 'bad' });
  openSheet('Paste a player list', `<p class="muted small" style="margin-top:0">One name per line.</p><textarea class="input" id="bulkTxt" placeholder="Yugi Muto&#10;Seto Kaiba&#10;Jaden Yuki"></textarea>`,
    `<button class="btn" data-act="closeSheet">Cancel</button><button class="btn primary" data-act="bulkSave">${ic('plus', 'sm')} Add players</button>`, { focus: '#bulkTxt' });
};
ACT.bulkSave = () => { const v = $('#bulkTxt').value; const names = v.split(/\r?\n|\t|;/); if (addNames(names)) closeSheet(); };
ACT.pastPlayers = () => {
  if (T.locked) return toast('Unlock the roster to add players', { kind: 'bad' });
  const map = new Map(); const cur = new Set(T.players.map(p => p.name.trim().toLowerCase()));
  ARCH.forEach(a => a.players.forEach(p => { const k = p.name.trim().toLowerCase(); if (cur.has(k)) return; const x = map.get(k) || { name: p.name.trim(), n: 0, last: 0 }; x.n++; x.last = Math.max(x.last, a.createdAt || 0); map.set(k, x); }));
  const list = [...map.values()].sort((a, b) => b.last - a.last || a.name.localeCompare(b.name));
  if (!list.length) return openSheet('Past players', emptyState('history', 'No past players yet', ''));
  openSheet('Past players', `<div class="search" style="margin-bottom:10px">${ic('search', 'sm')}<input class="input sm" placeholder="Filter names" data-oninput="pastFilter"></div>
    <div class="row between small" style="margin-bottom:8px"><span class="muted">${plural(list.length, 'player')} from ${plural(ARCH.length, 'event')}</span><button class="btn sm ghost" data-act="pastAll">Select all</button></div>
    <div class="picker" id="pastList">${list.map(p => `<label class="pick" data-name="${esc(p.name.toLowerCase())}"><input type="checkbox" value="${esc(p.name)}"><span><b>${esc(p.name)}</b><small>${plural(p.n, 'event')} · last ${fmtDay(p.last)}</small></span></label>`).join('')}</div>`,
    `<button class="btn" data-act="closeSheet">Cancel</button><button class="btn primary" data-act="pastAdd">${ic('check', 'sm')} Add selected</button>`);
};
ON.pastFilter = el => { const q = el.value.trim().toLowerCase(); $$('#pastList .pick').forEach(r => r.hidden = q && !r.dataset.name.includes(q)); };
ACT.pastAll = () => { const boxes = $$('#pastList .pick:not([hidden]) input'); const all = boxes.every(b => b.checked); boxes.forEach(b => b.checked = !all); };
ACT.pastAdd = () => { const names = $$('#pastList input:checked').map(b => b.value); if (!names.length) return toast('Select at least one player'); if (addNames(names)) closeSheet(); };
ACT.renamePlayer = async d => {
  const p = P(d.id); if (!p) return;
  const v = await ask({ title: 'Rename player', input: { value: p.name, max: 60 }, ok: 'Save' });
  if (!v || v === p.name) return;
  if (nameTaken(v, p.id)) return toast('Another player already has that name', { kind: 'bad' });
  mutate(`Renamed ${p.name} → ${v}`, () => { P(d.id).name = v.slice(0, 60); });
};
ACT.deletePlayer = async d => {
  const p = P(d.id); if (!p) return;
  if (T.locked) return toast('Unlock the roster first', { kind: 'bad' });
  if (playerHasMatches(p.id)) return toast('Players with matches can only be dropped', { kind: 'bad' });
  if (!await confirmDo('Remove player?', `${p.name} will be removed from the roster.`, 'Remove', true)) return;
  mutate('Removed ' + p.name, () => { T.players = T.players.filter(x => x.id !== p.id); T.players.sort((a, b) => a.seed - b.seed).forEach((x, i) => x.seed = i + 1); }, { toast: p.name + ' removed' });
  if (sheetOpen) closeSheet();
};
ACT.toggleLock = async () => {
  if (T.locked) { mutate('Roster unlocked', () => { T.locked = false; }, { toast: 'Roster unlocked' }); return; }
  if (T.players.length < 2) return toast('Add at least 2 players first', { kind: 'bad' });
  mutate(`Roster locked (${T.players.length} players)`, () => { T.locked = true; }, { toast: `Roster locked · ${T.players.length} players` });
};
ACT.playerMenu = () => {
  const started = T.rounds.length > 0;
  openSheet('Roster tools', `<div class="stack">
    <button class="btn block" data-act="seedShuffle" ${started ? 'disabled' : ''}>${ic('dice', 'sm')} Shuffle seeds</button>
    <button class="btn block" data-act="seedAlpha" ${started ? 'disabled' : ''}>${ic('list', 'sm')} Sort seeds A → Z</button>
    <button class="btn block" data-act="printRoster">${ic('print', 'sm')} Print roster / sign-in sheet</button>
    <button class="btn block" data-act="copyRoster">${ic('copy', 'sm')} Copy roster as text</button>
    <button class="btn block danger" data-act="clearRoster" ${started || T.locked ? 'disabled' : ''}>${ic('trash', 'sm')} Remove all players</button>
</div>`);
};
ACT.seedShuffle = () => { mutate('Seeds shuffled', () => { const r = E.rng(Date.now() >>> 0); E.shuffle(T.players, r).forEach((p, i) => P(p.id).seed = i + 1); }, { toast: 'Seeds shuffled' }); closeSheet(); };
ACT.seedAlpha = () => { mutate('Seeds sorted A–Z', () => { T.players.slice().sort((a, b) => a.name.localeCompare(b.name)).forEach((p, i) => P(p.id).seed = i + 1); }, { toast: 'Seeds sorted A–Z' }); closeSheet(); };
ACT.clearRoster = async () => { if (!await confirmDo('Remove all players?', 'The whole roster will be cleared.', 'Remove all', true)) return; mutate('Roster cleared', () => { T.players = []; }, { toast: 'Roster cleared' }); closeSheet(); };
ACT.copyRoster = () => copyText(T.players.slice().sort((a, b) => a.seed - b.seed).map(p => `${p.seed}. ${p.name}${p.dropped ? ' (dropped)' : ''}`).join('\n'), 'Roster copied');

ACT.playerSheet = d => { const id = d.id; const fn = () => renderPlayerSheet(id); fn(); sheetRefresh = fn; };
function renderPlayerSheet(id) {
  const p = P(id); if (!p) { closeSheet(); return; }
  const st = liveStandings(); const s = st.find(x => x.id === id);
  const rows = [];
  for (const r of T.rounds) for (const m of r.matches) {
    if (m.a !== id && m.b !== id) continue;
    const opp = m.a === id ? m.b : m.a; const c = E.duelCount(m.duels); const mine = m.a === id ? `${c.a}–${c.b}` : `${c.b}–${c.a}`;
    const res = E.resultFor(m, id);
    const pill = !m.result ? '<span class="pill">PENDING</span>' : res === 'W' ? '<span class="pill good">WIN</span>' : res === 'L' ? '<span class="pill bad">LOSS</span>' : res === 'D' ? '<span class="pill draw">DRAW</span>' : res === 'DL' ? '<span class="pill bad">DBL LOSS</span>' : '<span class="pill info">BYE</span>';
    rows.push(`<button class="hrow" style="width:100%;background:none;border-left:0;border-right:0;border-bottom:0;color:inherit;text-align:left" ${opp ? `data-act="openResult" data-r="${r.id}" data-m="${m.id}"` : ''}><span class="t">${r.stage === 'top' ? 'T' : 'R'}${r.n}</span><span class="ellipsis">${opp ? 'vs ' + esc(pn(opp)) : 'Bye'} <span class="muted num">${opp && m.result ? '· ' + mine : ''}</span></span><span class="res">${pill}</span></button>`);
  }
  const cr = curRound();
  openSheet(p.name, `
    <div class="row" style="gap:12px"><span class="avatar" style="--h:${hue(p.name)};width:52px;height:52px;font-size:19px">${esc(initials(p.name))}</span>
      <div class="grow"><div class="row wrap" style="gap:6px">${p.elim ? '<span class="pill bad">ELIMINATED</span>' : p.dropped ? '<span class="pill bad">DROPPED</span>' : '<span class="pill good">ACTIVE</span>'}<span class="pill">Seed ${p.seed}</span>${s && T.rounds.length ? `<span class="pill info">Rank ${s.rank}</span>` : ''}</div>
      ${p.note ? `<p class="muted small" style="margin:6px 0 0">${esc(p.note)}</p>` : ''}</div></div>
    ${s && T.rounds.length ? `<div class="kpis"><div class="kpi"><b>${s.pts}</b><span>Points</span></div><div class="kpi"><b>${s.w}-${s.losses}-${s.d}</b><span>W-L-D</span></div><div class="kpi"><b>${pct(s.omw)}</b><span>OMW</span></div><div class="kpi"><b>${pct(s.gwp)}</b><span>Duel win</span></div></div>` : ''}
    <div class="section-title">Matches</div>
    <div class="card" style="padding:0">${rows.join('') || '<div class="empty">No matches yet.</div>'}</div>
    <div class="btn-grid" style="margin-top:14px">
      <button class="btn" data-act="renamePlayer" data-id="${id}">${ic('edit', 'sm')} Rename</button>
      <button class="btn" data-act="notePlayer" data-id="${id}">${ic('file', 'sm')} Note</button>
      ${p.dropped || p.elim ? `<button class="btn good full" data-act="reinstate" data-id="${id}">${ic('user-plus', 'sm')} Re-enter player</button>` : `<button class="btn danger full" data-act="dropPlayer" data-id="${id}" ${T.rounds.length ? '' : 'disabled'}>${ic('user-x', 'sm')} Drop from tournament</button>`}
      ${!T.locked && !playerHasMatches(id) ? `<button class="btn danger full" data-act="deletePlayer" data-id="${id}">${ic('trash', 'sm')} Delete player</button>` : ''}
    </div>
`, '', { refresh: () => renderPlayerSheet(id), keepScroll: true });
}
ACT.notePlayer = async d => { const p = P(d.id); const v = await ask({ title: 'Player note', msg: 'Deck, judge note, contact…', input: { value: p.note || '', max: 120, placeholder: 'e.g. Snake-Eye Fire King' }, ok: 'Save' }); if (v === null) return; mutate('Note updated for ' + p.name, () => { P(d.id).note = v; }); };
ACT.dropPlayer = async d => {
  const p = P(d.id); if (!p) return;
  const cr = curRound();
  const m = cr && cr.matches.find(x => !x.result && (x.a === p.id || x.b === p.id));
  let award = false;
  if (m) {
    const opp = m.a === p.id ? m.b : m.a;
    const ch = await ask({ title: `Drop ${p.name}?`, msg: `${p.name} has an unreported match against ${pn(opp)} at table ${m.table}.`, choices: [{ label: `Drop · ${pn(opp)} wins this match`, value: 'award', cls: 'danger' }, { label: 'Drop · let the judge record this match', value: 'leave' }] });
    if (!ch) return; award = ch === 'award';
  } else if (!await confirmDo(`Drop ${p.name}?`, 'They will not be paired in future rounds. Their results stay in the standings.', 'Drop player', true)) return;
  mutate(`Dropped ${p.name}${cr ? ' during ' + roundTitle(cr) : ''}`, () => {
    const pp = P(p.id); pp.dropped = true; pp.dropRound = swissRounds().length;
    if (award && m) { const n = T.rules.format.winsNeeded; m.duels = Array(n).fill(m.a === p.id ? 'B' : 'A'); m.result = m.a === p.id ? 'B' : 'A'; m.how = 'drop'; m.at = Date.now(); m.note = p.name + ' dropped'; }
  }, { toast: p.name + ' dropped' });
};
ACT.reinstate = d => { const p = P(d.id); mutate('Re-entered ' + p.name, () => { const pp = P(d.id); pp.dropped = false; pp.elim = false; }, { toast: p.name + ' is active again (from the next pairing)' }); };

/* ---------- pairing & rounds ---------- */
ACT.pairNext = async () => {
  if (!T) return;
  if (curRound()) { toast('Finish the current round first'); return showTab('round'); }
  if (T.status === 'complete') return toast('The tournament is finished');
  const tops = topRounds();
  if (tops.length) {
    const last = tops[tops.length - 1];
    if ((last.size || last.matches.length * 2) <= 2) return ACT.finishTournament();
    mutate(`Paired ${E.topRoundName((last.size || last.matches.length * 2) / 2)}`, () => { const r = E.buildTopRound(T); T.rounds.push(r); }, { toast: 'Next bracket round paired' });
    return showTab('round');
  }
  if (activeCount() < 2) return toast('At least 2 active players are needed', { kind: 'bad' });
  const n = swissRounds().length + 1;
  if (swissDone()) {
    if (!await confirmDo('All Swiss rounds are complete', `${plannedRounds()} rounds were planned. Pair an extra Round ${n} anyway?`, 'Pair extra round')) return;
  } else if (!T.locked) {
    if (!await confirmDo(`Lock roster and pair Round ${n}?`, `${activeCount()} active players. ${n === 1 ? `${plannedRounds()} Swiss rounds will be played (${T.rules.rounds === 'auto' ? 'Konami table' : 'manual setting'}).` : ''}`, 'Lock & pair')) return;
  }
  const t0 = performance.now();
  const ok = mutate(`Paired Round ${n}`, () => {
    T.locked = true;
    if (n === 1 || !T.startCount) T.startCount = activeCount();
    if (swissDone() && T.rules.rounds === 'auto') T.rules.rounds = n;
    const r = E.buildSwissRound(T); T.rounds.push(r); T.status = 'swiss';
  }, { toast: `Round ${n} paired` });
  if (ok) { roundQuery = ''; showTab('round'); const r = lastRound(); if (r && r.rematches) setTimeout(() => toast(`${plural(r.rematches, 'rematch', 'rematches')} could not be avoided`, { kind: 'bad', ms: 4500 }), 400); }
  console.debug('pairing ms', Math.round(performance.now() - t0));
};
ACT.completeRound = async () => {
  const cr = curRound(); if (!cr) return;
  const pend = pendingIn(cr); if (pend) return toast(`${plural(pend, 'result')} still missing`, { kind: 'bad' });
  let elimNames = [];
  mutate(`Completed ${roundTitle(cr)}`, () => {
    const tm = cr.timer; if (tm.running) { tm.acc = timerElapsed(tm); tm.running = false; tm.start = null; }
    cr.complete = true;
    if (cr.stage !== 'top' && T.rules.elimLosses) {
      const st = E.standings(T);
      st.forEach(s => { if (!s.dropped && !s.elim && s.losses >= T.rules.elimLosses) { P(s.id).elim = true; P(s.id).elimRound = cr.n; elimNames.push(s.name); } });
    }
  }, { toast: `${roundTitle(cr)} complete` });
  syncTimers();
  if (elimNames.length) setTimeout(() => toast(`${plural(elimNames.length, 'player')} eliminated (${T.rules.elimLosses} losses)`, { ms: 4000 }), 300);
  if (cr.stage === 'top') { if ((cr.size || cr.matches.length * 2) <= 2) return ACT.finishTournament(); return; }
  if (swissDone()) {
    if (T.rules.topCut >= 2) { if (await confirmDo('Swiss rounds complete', `Start the Top ${T.rules.topCut} single-elimination bracket now?`, `Start Top ${T.rules.topCut}`)) ACT.startTop(); }
    else if (await confirmDo('Swiss rounds complete', 'Finish the tournament and save the final standings?', 'Finish tournament')) ACT.finishTournament();
  }
};
ACT.startTop = async () => {
  if (curRound()) return toast('Finish the current round first');
  let size = T.rules.topCut;
  const elig = T.players.filter(p => !p.dropped).length;
  if (elig < 2) return toast('Not enough players for a top cut', { kind: 'bad' });
  if (elig < size) { let s = 2; while (s * 2 <= elig) s *= 2; if (!await confirmDo('Smaller top cut', `Only ${elig} players remain, so the cut becomes Top ${s}.`, `Start Top ${s}`)) return; size = s; }
  mutate(`Started Top ${size}`, () => { T.status = 'top'; const r = E.buildTopRound(T, size); T.rounds.push(r); }, { toast: `Top ${size} paired` });
  standView = 'swiss'; showTab('round');
};
ACT.finishTournament = async () => {
  if (curRound() && pendingIn(curRound())) return toast('Report all results first', { kind: 'bad' });
  mutate('Tournament finished', () => { const cr = curRound(); if (cr) cr.complete = true; T.status = 'complete'; T.finishedAt = Date.now(); }, { toast: 'Tournament finished and archived', kind: 'good' });
  archiveT(T);
  syncTimers();
  if (topRounds().length) standView = 'final';
  showChampion();
};
function showChampion() {
  const fp = E.finalPlacements(T); const top = fp.slice(0, 4);
  openSheet('Final results', `<div style="text-align:center;padding:6px 0 4px"><div class="e-ico" style="width:72px;height:72px;margin:0 auto 10px;border-radius:20px;display:grid;place-items:center;background:color-mix(in srgb,var(--gold) 18%,transparent);color:var(--gold)">${ic('crown', 'lg')}</div>
    <div class="muted small">CHAMPION</div><h2 style="font-size:24px;margin:4px 0">${esc(top[0] ? top[0].name : '—')}</h2><div class="muted small">${esc(T.name)}</div></div>
    <div class="card" style="padding:0;margin-top:12px">${top.map(s => standRow(s, s.place, s.note)).join('')}</div>`,
    `<button class="btn" data-act="standImage">${ic('image', 'sm')} Share image</button><button class="btn primary" data-act="tab" data-tab="standings">Full standings</button>`);
}
ACT.reopenTournament = () => mutate('Tournament reopened', () => { T.status = topRounds().length ? 'top' : 'swiss'; }, { toast: 'Tournament reopened' });

ACT.roundMenu = () => {
  const cr = curRound(); if (!cr) return;
  const anyResult = cr.matches.some(m => m.b && m.result);
  openSheet(roundTitle(cr) + ' options', `<div class="stack">
    <button class="btn block" data-act="printPairings" data-by="table">${ic('print', 'sm')} Print pairings by table</button>
    <button class="btn block" data-act="printPairings" data-by="name">${ic('print', 'sm')} Print pairings by name (for posting)</button>
    <button class="btn block" data-act="printSlips">${ic('file', 'sm')} Print result slips</button>
    <button class="btn block" data-act="copyPairings">${ic('copy', 'sm')} Copy pairings as text</button>
    ${cr.stage !== 'top' ? `<button class="btn block" data-act="repair" ${anyResult ? 'disabled' : ''}>${ic('dice', 'sm')} Re-pair this round</button>` : ''}
    <button class="btn block danger" data-act="cancelRound" ${anyResult ? 'disabled' : ''}>${ic('x', 'sm')} Cancel this round</button>
</div>`);
};
ACT.repair = async () => {
  const cr = curRound(); if (!cr || cr.stage === 'top') return;
  if (!await confirmDo('Re-pair this round?', 'New random pairings will be generated within the same score groups.', 'Re-pair')) return;
  mutate(`Re-paired ${roundTitle(cr)}`, () => { T.rounds.pop(); T.pairSalt = (T.pairSalt || 0) + 1; T.rounds.push(E.buildSwissRound(T)); }, { toast: 'Round re-paired' });
  closeSheet();
};
ACT.cancelRound = async () => {
  const cr = curRound(); if (!cr) return;
  if (!await confirmDo(`Cancel ${roundTitle(cr)}?`, 'The pairings are deleted. You can pair again afterwards.', 'Cancel round', true)) return;
  mutate(`Cancelled ${roundTitle(cr)}`, () => { T.rounds.pop(); if (!T.rounds.length) T.status = 'setup'; else if (!topRounds().length) T.status = 'swiss'; }, { toast: 'Round cancelled' });
  closeSheet(); syncTimers();
};
ACT.toggleSwap = () => { swapMode = !swapMode; swapSel = null; renderRound(); };
ACT.swapPick = d => {
  if (!swapSel) { swapSel = { m: d.m, side: d.side }; return renderRound(); }
  if (swapSel.m === d.m && swapSel.side === d.side) { swapSel = null; return renderRound(); }
  const cr = curRound(); const a = swapSel; swapSel = null;
  mutate('Swapped seats', () => {
    const r = curRound(); const m1 = r.matches.find(x => x.id === a.m), m2 = r.matches.find(x => x.id === d.m);
    const k1 = a.side, k2 = d.side; const tmp = m1[k1]; m1[k1] = m2[k2]; m2[k2] = tmp;
    for (const m of [m1, m2]) { if (!m.a && m.b) { m.a = m.b; m.b = null; } if (!m.b) { m.result = 'BYE'; m.how = 'bye'; m.duels = []; m.table = 0; } else if (m.result === 'BYE') { m.result = null; m.how = null; } }
    let t = 1; r.matches.filter(m => m.b).forEach(m => m.table = t++);
    const played = new Set(); T.rounds.filter(x => x !== r && x.stage !== 'top').forEach(x => x.matches.forEach(m => m.b && played.add([m.a, m.b].sort().join('|'))));
    r.rematches = r.matches.filter(m => m.b && played.has([m.a, m.b].sort().join('|'))).length;
  }, { toast: 'Seats swapped' });
};
ACT.applyAllDL = async d => {
  const cr = curRound(); if (!cr) return; const pend = cr.matches.filter(m => !m.result);
  if (!await confirmDo('Apply Double Loss?', `${plural(pend.length, 'unfinished match', 'unfinished matches')} will be recorded as a Double Loss (0 points each).`, 'Apply Double Loss', true)) return;
  mutate(`Double Loss applied to ${pend.length} unfinished matches (${d.why === 'overtime' ? 'overtime cap' : 'time'})`, () => {
    curRound().matches.forEach(m => { if (!m.result) { m.result = 'DL'; m.how = d.why === 'overtime' ? 'overtime' : 'time'; m.at = Date.now(); m.note = d.why === 'overtime' ? 'Overtime cap reached' : 'Unfinished at time'; } });
  }, { toast: 'Double Loss recorded' });
};

/* ---------- result sheet ---------- */
let RS = null;
ACT.openResult = d => {
  const r = findRound(d.r); const m = r && r.matches.find(x => x.id === d.m); if (!m || !m.b) return;
  RS = { rid: r.id, mid: m.id, duels: m.duels.slice(), view: 'main', wiz: null, note: m.note || '' };
  renderResult();
};
function rsCtx() { const r = findRound(RS.rid); const m = r && r.matches.find(x => x.id === RS.mid); return { r, m }; }
function verdictOf(duels, r) { const e = E.evaluate(duels, T.rules, r.stage); return e; }
function resultText(res, m) { if (res === 'A') return pn(m.a) + ' wins'; if (res === 'B') return pn(m.b) + ' wins'; if (res === 'D') return 'Match Draw'; if (res === 'DL') return 'Double Loss'; return ''; }
function renderResult() {
  const { r, m } = rsCtx(); if (!m) { closeSheet(); return; }
  const isTop = r.stage === 'top', rules = T.rules, f = rules.format;
  const laterTop = isTop && T.rounds.indexOf(r) < T.rounds.length - 1;
  const st = new Map(liveStandings().map(s => [s.id, s]));
  const c = E.duelCount(RS.duels), ev = verdictOf(RS.duels, r);
  const sub = `${roundTitle(r)} · Table ${m.table}${r.complete ? ' · round complete' : ''}`;
  if (RS.view === 'time') return renderTimeWizard(r, m);
  const qopts = quickOptions(m, r);
  const cur = m.result ? `${m.result}|${m.duels.join('')}` : '';
  const vcls = ev.done ? (ev.result === 'DL' ? 'dl' : ev.result === 'D' ? 'dr' : 'done') : '';
  const vtxt = ev.done ? `${resultText(ev.result, m)} · ${c.a}–${c.b}${c.d ? '–' + c.d : ''}` : ev.needsDecider ? 'Tied after the maximum Duels — use “Time called” to decide' : RS.duels.length ? `In progress · Duel ${RS.duels.length + 1} next` : 'No Duels recorded yet';
  const maxShow = Math.max(f.maxDuels || (f.winsNeeded * 2 - 1), RS.duels.length + (ev.done ? 0 : 1));
  const duelBoxes = Array.from({ length: maxShow }, (_, i) => { const x = RS.duels[i]; const lab = x === 'A' ? esc(pn(m.a)) : x === 'B' ? esc(pn(m.b)) : x === 'D' ? 'Draw' : (i === RS.duels.length && !ev.done ? 'Next' : '—'); return `<div class="duel ${x || (i === RS.duels.length && !ev.done ? 'next' : '')}"><small>DUEL ${i + 1}</small><b>${lab}</b></div>`; }).join('');
  openSheet(`${pn(m.a)} vs ${pn(m.b)}`, `
    ${laterTop ? `<div class="banner bad" style="margin-top:0"><span class="b-ico">${ic('lock')}</span><div class="b-body"><b>Locked — next bracket round already paired</b></div></div>` : ''}
    ${r.complete && !isTop && !laterTop ? `<div class="banner warn" style="margin-top:0"><span class="b-ico">${ic('alert')}</span><div class="b-body"><b>Editing a completed round</b></div></div>` : ''}
    <div class="vs-head"><div><b>${esc(pn(m.a))}</b><small>${st.get(m.a) ? pts(st.get(m.a).pts) : ''}</small></div><div class="big">${c.a}–${c.b}</div><div><b>${esc(pn(m.b))}</b><small>${st.get(m.b) ? pts(st.get(m.b).pts) : ''}</small></div></div>
    <div class="verdict ${vcls}">${esc(vtxt)}</div>
    ${laterTop ? '' : `
    <div class="section-title">Quick result</div>
    <div class="qgrid">${qopts.map(o => `<button class="qbtn ${o.cls} ${o.full ? 'full' : ''} ${cur === o.res + '|' + o.duels.join('') ? 'cur' : ''}" data-act="quickResult" data-res="${o.res}" data-duels="${o.duels.join('')}" data-how="${o.how || 'normal'}"><b>${esc(o.label)}</b><small>${esc(o.sub)}</small></button>`).join('')}</div>
    <div class="section-title">Duel by Duel</div>
    <div class="duels">${duelBoxes}</div>
    <div class="grid3" style="margin-top:8px">
      <button class="btn sm" data-act="rsDuel" data-w="A" ${ev.done ? 'disabled' : ''}>+ ${esc(shortName(pn(m.a)))}</button>
      <button class="btn sm" data-act="rsDuel" data-w="D" ${ev.done || !f.duelDraws ? 'disabled' : ''}>+ Draw</button>
      <button class="btn sm" data-act="rsDuel" data-w="B" ${ev.done ? 'disabled' : ''}>+ ${esc(shortName(pn(m.b)))}</button>
    </div>
    <div class="row" style="margin-top:8px"><button class="btn sm ghost" data-act="rsDuelUndo" ${RS.duels.length ? '' : 'disabled'}>${ic('undo', 'sm')} Remove last Duel</button><span class="grow"></span><button class="btn sm" data-act="matchControl">${ic('heart', 'sm')} LP & Match control</button></div>
    <div class="section-title">Time & judge calls</div>
    <div class="btn-grid">
      <button class="btn warn full" data-act="rsTime" ${m.result && !RS.duels.length ? '' : ''}>${ic('timer', 'sm')} Time called — End-of-Match procedure</button>
      <button class="btn danger" data-act="rsSet" data-res="DL" data-how="judge">Double Loss</button>
      ${f.matchDraws && !isTop ? `<button class="btn" data-act="rsSet" data-res="D" data-how="judge">Match Draw</button>` : `<button class="btn" data-act="rsClear" ${m.result ? '' : 'disabled'}>Clear result</button>`}
    </div>
    <label class="f" style="margin-top:12px"><span>Judge note</span><input class="input sm" maxlength="140" value="${esc(RS.note)}" data-oninput="rsNote" placeholder="e.g. Game loss for marked sleeves in Duel 2"></label>`}`,
    laterTop ? `<button class="btn" data-act="closeSheet">Close</button>` :
    `${m.result && (f.matchDraws && !isTop) ? `<button class="btn" data-act="rsClear">Clear</button>` : ''}<button class="btn" data-act="closeSheet">Cancel</button><button class="btn primary" data-act="rsSave" ${ev.done ? '' : 'disabled'}>${ic('check', 'sm')} Save result</button>`,
    { sub, refresh: () => { if (RS) renderResult(); }, keepScroll: true });
}
const shortName = n => n.length > 12 ? n.slice(0, 11) + '…' : n;
function quickOptions(m, r) {
  const f = T.rules.format, n = f.winsNeeded, isTop = r.stage === 'top';
  const A = shortName(pn(m.a)), B = shortName(pn(m.b)), o = [];
  // winner w with k lost Duels: w,l,w,l,…,w (never reaches n wins early)
  const seq = (w, k) => { const l = w === 'A' ? 'B' : 'A', d = []; for (let i = 0; i < k; i++) d.push(w, l); while (d.filter(x => x === w).length < n) d.push(w); return d; };
  for (let k = 0; k < n; k++) o.push({ res: 'A', duels: seq('A', k), label: `${A} wins`, sub: `${n}–${k}`, cls: 'a' });
  for (let k = 0; k < n; k++) o.push({ res: 'B', duels: seq('B', k), label: `${B} wins`, sub: `${n}–${k}`, cls: 'b' });
  // interleave A/B for a two-column grid
  const out = []; for (let k = 0; k < n; k++) { out.push(o[k]); out.push(o[n + k]); }
  if (f.matchDraws && !isTop) out.push({ res: 'D', duels: n > 1 ? ['A', 'B'] : ['D'], label: T.rules.hiddenDraw && !T.rules.points.draw ? 'Tie' : 'Match Draw', sub: T.rules.hiddenDraw && !T.rules.points.draw ? '0 pts · above DL' : (n > 1 ? '1–1 at time' : 'Duel draw'), cls: 'd', how: n > 1 ? 'time' : 'normal' });
  if (!f.matchDraws && f.winsNeeded === 1 && f.duelDraws && !isTop) out.push({ res: 'DL', duels: ['D'], label: 'Duel Draw', sub: 'counts as Double Loss', cls: 'x' });
  out.push({ res: 'DL', duels: [], label: 'Double Loss', sub: 'both players lose', cls: 'x', how: 'judge' });
  if (out.length % 2) out[out.length - 1].full = true;
  return out;
}
ON.rsNote = el => { RS.note = el.value; };
ACT.rsDuel = d => { const { r } = rsCtx(); if (verdictOf(RS.duels, r).done) return; RS.duels.push(d.w); renderResult(); };
ACT.rsDuelUndo = () => { RS.duels.pop(); renderResult(); };
ACT.rsSave = () => {
  const { r, m } = rsCtx(); const ev = verdictOf(RS.duels, r);
  if (!ev.done) return toast('The Match is not finished yet — add Duels or use Time called', { kind: 'bad' });
  commitResult(r, m, RS.duels.slice(0, ev.used || RS.duels.length), ev.result, 'normal', RS.note);
};
ACT.quickResult = d => { const { r, m } = rsCtx(); commitResult(r, m, d.duels ? d.duels.split('') : [], d.res, d.how, RS.note); };
ACT.rsSet = d => { const { r, m } = rsCtx(); commitResult(r, m, RS.duels.slice(), d.res, d.how, RS.note); };
ACT.rsClear = async () => {
  const { r, m } = rsCtx(); if (!m.result) { RS.duels = []; return renderResult(); }
  mutate(`Cleared result: ${roundTitle(r)} table ${m.table}`, () => { const mm = rsCtx().m; mm.result = null; mm.how = null; mm.duels = []; mm.at = null; }, { toast: 'Result cleared' });
  RS.duels = []; renderResult();
};
function commitResult(r, m, duels, res, how, note) {
  if (r.stage === 'top' && T.rounds.indexOf(r) < T.rounds.length - 1) return toast('Locked — the next bracket round already exists', { kind: 'bad' });
  if (r.stage === 'top' && res === 'D') return toast('Elimination matches need a winner', { kind: 'bad' });
  const c = E.duelCount(duels);
  const label = `${roundTitle(r)} T${m.table}: ${pn(m.a)} vs ${pn(m.b)} → ${resultText(res, m)} (${c.a}-${c.b}${c.d ? '-' + c.d : ''})${how && how !== 'normal' ? ' [' + how + ']' : ''}`;
  const ok = mutate(label, () => { const mm = findRound(r.id).matches.find(x => x.id === m.id); mm.duels = duels; mm.result = res; mm.how = how; mm.at = Date.now(); mm.note = note || ''; mm.live = null; }, { toast: `T${m.table} · ${resultText(res, m)}` });
  if (!ok) return;
  closeSheet(); RS = null;
  if (TAB === 'match') closeMatch();
  const cr = curRound();
  if (cr && cr.id === r.id && !pendingIn(cr) && !(cr.stage === 'top' && (cr.size || cr.matches.length * 2) <= 2)) setTimeout(() => toast(`All results in — tap “Complete ${roundTitle(cr)}”`, { kind: 'good', ms: 4000 }), 350);
}

/* ---------- OCG End-of-Match wizard ---------- */
ACT.rsTime = () => { RS.view = 'time'; RS.wiz = { step: 'start' }; const { m } = rsCtx(); const lv = m.live || {}; RS.wiz.lpA = lv.lpA ?? 8000; RS.wiz.lpB = lv.lpB ?? 8000; renderResult(); };
ACT.wizBack = () => { if (RS.wiz.step === 'start') { RS.view = 'main'; RS.wiz = null; } else RS.wiz = { step: 'start', lpA: RS.wiz.lpA, lpB: RS.wiz.lpB }; renderResult(); };
function renderTimeWizard(r, m) {
  const isTop = r.stage === 'top', proc = isTop ? T.rules.time.topProcedure : T.rules.time.procedure;
  const w = RS.wiz, c = E.duelCount(RS.duels), A = pn(m.a), B = pn(m.b);
  const prior = `<div class="duels" style="margin-top:8px">${RS.duels.length ? RS.duels.map((x, i) => `<div class="duel ${x}"><small>DUEL ${i + 1}</small><b>${x === 'A' ? esc(A) : x === 'B' ? esc(B) : 'Draw'}</b></div>`).join('') : '<div class="duel"><small>NO DUELS</small><b>finished yet</b></div>'}</div>`;
  let body = '', foot = `<button class="btn" data-act="wizBack">${ic('back', 'sm')} Back</button>`;
  const outcome = (duels, res, why) => { w.final = { duels, res, why }; w.step = 'confirm'; };
  if (w.step === 'confirm') {
    const fc = E.duelCount(w.final.duels);
    body = `<div class="verdict ${w.final.res === 'DL' ? 'dl' : w.final.res === 'D' ? 'dr' : 'done'}" style="font-size:16px">${esc(resultText(w.final.res, m))} · ${fc.a}–${fc.b}${fc.d ? '–' + fc.d : ''}</div><p class="muted small" style="text-align:center">${esc(w.final.why)}</p>`;
    foot += `<button class="btn primary" data-act="wizSave">${ic('check', 'sm')} Record result</button>`;
  } else if (proc === 'ocg-match' || proc === 'ocg-elim') {
    const elim = proc === 'ocg-elim';
    if (w.step === 'start') {
      body = `<div class="rule-quote">${elim ? 'OCG 2026 elimination End-of-Match (shop-event regulation rev. 2026-07-21)' : 'OCG 2026 Swiss End-of-Match (shop-event regulation rev. 2026-07-21)'}</div>
        ${prior}
        <div class="section-title">What was happening when time was called?</div>
        <div class="steps">
          <button class="step" data-act="wizPick" data-s="j1"><b>Duel 1 was still in progress</b><small>Result: Double Loss (判定1)</small></button>
          <button class="step" data-act="wizPick" data-s="j2"><b>Duel 1 had ended, Duel 2 had not started</b><small>Result: Double Loss (判定2)</small></button>
          <button class="step" data-act="wizPick" data-s="j3"><b>Duel 2 or Duel 3 was in progress</b><small>Finish the turn, then 3 extra turns; LP decides (判定3)</small></button>
          <button class="step" data-act="wizPick" data-s="j4"><b>Between Duels — Duel 3 (or later) had not started</b><small>${elim ? 'A 4-turn extra Duel at 8000 LP decides (判定4)' : 'More Duel wins takes the Match; equal = Match Draw (判定4)'}</small></button>
        </div>`;
    } else if (w.step === 'extra') {
      body = `<div class="rule-quote">Play continues to the end of the current turn. If undecided, 3 extra turns are played, counted from the opponent’s turn. If still undecided, the player with more LP wins the Duel. ${elim ? 'Equal LP → sudden death: the first turn that ends with a LP change decides it.' : 'Equal LP → the Duel is a draw.'}</div>
        <div class="btn-grid"><button class="btn" data-act="wizDuel" data-w="A">${esc(shortName(A))} won the Duel</button><button class="btn" data-act="wizDuel" data-w="B">${esc(shortName(B))} won the Duel</button></div>
        <div class="section-title">Or decide by Life Points after the extra turns</div>
        <div class="fields"><label class="f"><span>${esc(A)} LP</span><input class="input" type="number" inputmode="numeric" min="0" value="${w.lpA}" data-oninput="wizLp" data-k="lpA"></label><label class="f"><span>${esc(B)} LP</span><input class="input" type="number" inputmode="numeric" min="0" value="${w.lpB}" data-oninput="wizLp" data-k="lpB"></label></div>
        <button class="btn primary block" style="margin-top:10px" data-act="wizLpDecide">Compare Life Points</button>`;
    } else if (w.step === 'sudden') {
      body = `<div class="rule-quote">Life Points are equal: sudden death. Continue playing; at the end of the first turn in which Life Points change, the player with more LP wins.</div>
        <div class="btn-grid"><button class="btn primary" data-act="wizDuel" data-w="A" data-sd="1">${esc(shortName(A))} won</button><button class="btn primary" data-act="wizDuel" data-w="B" data-sd="1">${esc(shortName(B))} won</button></div>`;
    } else if (w.step === 'xduel') {
      const cc = E.duelCount(w.duels || RS.duels);
      body = `<div class="rule-quote">Extra Duel: finish deck adjustment quickly, decide who goes first by rock-paper-scissors, start at 8000 LP and play 4 turns. More LP after 4 turns wins; equal LP → sudden death.</div>
        <p class="muted small">Current Duel score ${cc.a}–${cc.b}.</p>
        <div class="btn-grid"><button class="btn primary" data-act="wizXDuel" data-w="A">${esc(shortName(A))} won the extra Duel</button><button class="btn primary" data-act="wizXDuel" data-w="B">${esc(shortName(B))} won the extra Duel</button></div>`;
    }
  } else if (proc === 'manual') {
    body = `<p class="muted">The judge decides unfinished Matches for this event.</p>${prior}<div class="btn-grid" style="margin-top:12px">
      <button class="btn" data-act="wizManual" data-res="A">${esc(shortName(A))} wins</button><button class="btn" data-act="wizManual" data-res="B">${esc(shortName(B))} wins</button>
      ${T.rules.format.matchDraws && !isTop ? `<button class="btn" data-act="wizManual" data-res="D">Match Draw</button>` : ''}<button class="btn danger ${T.rules.format.matchDraws && !isTop ? '' : 'full'}" data-act="wizManual" data-res="DL">Double Loss</button></div>`;
  } else {
    const ev = E.evaluate(RS.duels, T.rules, r.stage);
    body = `<div class="rule-quote">${esc(E.PROCEDURES[proc] || '')}</div>${prior}
      ${ev.done ? `<div class="banner good"><span class="b-ico">${ic('check')}</span><div class="b-body"><b>This Match already has a winner</b><p>${esc(resultText(ev.result, m))} — save it from the previous screen.</p></div></div>` : `<button class="btn danger block lg" style="margin-top:14px" data-act="wizManual" data-res="DL">Record Double Loss</button>`}`;
  }
  openSheet('Time called', body, foot, { sub: `${roundTitle(r)} · Table ${m.table} · ${A} vs ${B}`, refresh: () => { if (RS) renderResult(); }, keepScroll: true });
}
ON.wizLp = el => { RS.wiz[el.dataset.k] = Math.max(0, parseInt(el.value, 10) || 0); };
ACT.wizPick = d => {
  const { r, m } = rsCtx(); const w = RS.wiz; const elim = r.stage === 'top';
  if (d.s === 'j1') { w.final = { duels: RS.duels.slice(), res: 'DL', why: 'Time: Duel 1 in progress → Double Loss (判定1)' }; w.step = 'confirm'; }
  else if (d.s === 'j2') { w.final = { duels: RS.duels.slice(), res: 'DL', why: 'Time: before Duel 2 → Double Loss (判定2)' }; w.step = 'confirm'; }
  else if (d.s === 'j3') { w.step = 'extra'; }
  else if (d.s === 'j4') {
    if (elim) { w.duels = RS.duels.slice(); w.step = 'xduel'; }
    else { const res = E.timeCompare(RS.duels, T.rules); w.final = { duels: RS.duels.slice(), res, why: 'Time: before Duel 3 → compare Duel wins (判定4)' }; w.step = 'confirm'; }
  }
  renderResult();
};
function wizAfterDuel(duelsAfter, why) {
  const { r } = rsCtx(); const w = RS.wiz;
  if (r.stage === 'top') {
    const ev = E.evaluate(duelsAfter, T.rules, 'top');
    if (ev.done) { w.final = { duels: duelsAfter, res: ev.result, why }; w.step = 'confirm'; }
    else { w.duels = duelsAfter; w.step = 'xduel'; }
  } else {
    const ev = E.evaluate(duelsAfter, T.rules, 'swiss');
    const res = ev.done ? ev.result : E.timeCompare(duelsAfter, T.rules);
    w.final = { duels: duelsAfter, res, why: why + ' → compare Duel wins' }; w.step = 'confirm';
  }
  renderResult();
}
ACT.wizDuel = d => wizAfterDuel(RS.duels.concat(d.w), d.sd ? 'Time: sudden death decided the Duel' : 'Time: Duel decided during extra turns');
ACT.wizLpDecide = () => {
  const { r } = rsCtx(); const w = RS.wiz; const a = +w.lpA, b = +w.lpB;
  if (a === b) { if (r.stage === 'top') { w.step = 'sudden'; return renderResult(); } return wizAfterDuel(RS.duels.concat('D'), `Time: extra turns, LP ${a}–${b} → Duel draw`); }
  wizAfterDuel(RS.duels.concat(a > b ? 'A' : 'B'), `Time: extra turns, LP ${a}–${b}`);
};
ACT.wizXDuel = d => { const w = RS.wiz; const after = (w.duels || RS.duels).concat(d.w); wizAfterDuel(after, 'Time: extra Duel decided the Match'); };
ACT.wizManual = d => { const { r, m } = rsCtx(); commitResult(r, m, RS.duels.slice(), d.res, d.res === 'DL' && T.rules.time.procedure !== 'manual' ? 'time' : 'judge', RS.note || 'Decided at time'); };
ACT.wizSave = () => { const { r, m } = rsCtx(); const f = RS.wiz.final; commitResult(r, m, f.duels, f.res, 'time', (RS.note ? RS.note + ' · ' : '') + f.why); };

/* ===================== match control (LP calculator) ===================== */
ACT.matchControl = () => {
  const { r, m } = rsCtx();
  // keep unsaved Duel-by-Duel progress
  if (RS.duels.join('') !== m.duels.join('') && !m.result) mutate(`Duel progress T${m.table}`, () => { const mm = findRound(r.id).matches.find(x => x.id === m.id); mm.duels = RS.duels.slice(); }, { silentLog: true });
  openMatch(r.id, m.id);
};
ACT.openMatchFree = () => { if (!layers.includes('match')) pushLayer('match'); closeSheet(); MC = { free: true }; showTab('match', { keepMatch: true }); };
function openMatch(rid, mid) {
  if (!layers.includes('match')) pushLayer('match');
  closeSheet();
  const m = findRound(rid).matches.find(x => x.id === mid);
  if (!m.live) { m.live = freshLive(); persist(); }
  MC = { rid, mid };
  showTab('match', { keepMatch: true });
}
function closeMatch(fromPop) {
  if (TAB !== 'match') return;
  const back = MC && MC.free ? 'home' : 'round';
  if (!fromPop && layers.includes('match')) dropLayer('match');
  MC = null; showTab(back);
}
ACT.closeMatch = () => closeMatch();
function mcCtx() {
  if (!MC) return null;
  if (MC.free) return { free: true, live: FREE.live, A: FREE.names[0], B: FREE.names[1], duels: FREE.duels || (FREE.duels = []) };
  const r = findRound(MC.rid), m = r && r.matches.find(x => x.id === MC.mid);
  if (!m) return null; if (!m.live) m.live = freshLive();
  return { r, m, live: m.live, A: pn(m.a), B: pn(m.b), duels: m.duels };
}
function saveLive() { if (MC && MC.free) persistFree(); else persist(); }
function renderMatch() {
  const el = $('#scr-match'); const x = mcCtx();
  if (!x) { el.innerHTML = emptyState('heart', 'No match selected', 'Open a table from the Round screen.', 'tab', 'Go to Round', 'round'); return; }
  const L = x.live, c = E.duelCount(x.duels);
  const ev = x.free ? { done: false } : E.evaluate(x.duels, T.rules, x.r.stage);
  const allowDraw = x.free || T.rules.format.duelDraws;
  const lpBox = (k, name) => { const v = L['lp' + k]; return `<button class="lp ${L.active === k ? 'on' : ''}" data-act="lpActive" data-k="${k}" aria-label="${esc(name)} life points ${v}"><div class="nm">${esc(name)}</div><div class="val ${v <= 2000 ? 'low' : ''}">${v}</div><div class="dw">${x.free ? '' : (k === 'A' ? c.a : c.b) + ' Duel win' + ((k === 'A' ? c.a : c.b) === 1 ? '' : 's')}</div></button>`; };
  el.innerHTML = `
    <div class="mc-top"><button class="icon-btn" data-act="closeMatch" aria-label="Back">${ic('back')}</button>
      <div class="grow"><b>${x.free ? 'Life Point calculator' : `${esc(roundTitle(x.r))} · Table ${x.m.table}`}</b><div class="muted small">${x.free ? 'Not linked to a match' : `Duel ${x.duels.length + (ev.done ? 0 : 1)} · score ${c.a}–${c.b}${c.d ? '–' + c.d : ''}`}${!x.free && curRound() && curRound().id === x.r.id ? ` · <span data-timer-text>--:--</span>` : ''}</div></div>
      ${x.free ? `<button class="btn sm" data-act="freeNames">${ic('edit', 'sm')} Names</button>` : ''}</div>
    ${ev.done ? `<div class="banner good" style="margin:0 0 10px"><span class="b-ico">${ic('check')}</span><div class="b-body"><b>${esc(resultText(ev.result, x.m))}</b><button class="btn good sm" data-act="mcResult">Open result</button></div></div>` : ''}
    <div class="lp-wrap">${lpBox('A', x.A)}${lpBox('B', x.B)}</div>
    <div class="chips">${[-1000, -500, -100, 100, 500, 1000].map(v => `<button class="${v < 0 ? 'neg' : 'pos'}" data-act="lpDelta" data-v="${v}">${v > 0 ? '+' : '−'}${Math.abs(v)}</button>`).join('')}</div>
    <div class="lp-display" aria-live="polite">${L.entry ? (L.entry) : '<span class="faint">0</span>'}</div>
    <div class="keypad">
      ${[7, 8, 9].map(n => `<button data-act="lpKey" data-k="${n}">${n}</button>`).join('')}<button class="minus" data-act="lpApply" data-op="-">−</button>
      ${[4, 5, 6].map(n => `<button data-act="lpKey" data-k="${n}">${n}</button>`).join('')}<button class="plus" data-act="lpApply" data-op="+">+</button>
      ${[1, 2, 3].map(n => `<button data-act="lpKey" data-k="${n}">${n}</button>`).join('')}<button class="op" data-act="lpApply" data-op="=">=</button>
      <button data-act="lpKey" data-k="C">C</button><button data-act="lpKey" data-k="0">0</button><button data-act="lpKey" data-k="00">00</button><button class="op" data-act="lpHalve">½</button>
    </div>
    <div class="row" style="margin-top:8px"><button class="btn sm" data-act="lpUndo" ${L.log.length ? '' : 'disabled'}>${ic('undo', 'sm')} Undo LP</button><button class="btn sm" data-act="lpReset">${ic('reset', 'sm')} New Duel (8000)</button><span class="grow"></span><button class="btn sm" data-act="toolCoin">${ic('coin', 'sm')}</button><button class="btn sm" data-act="toolDice">${ic('dice', 'sm')}</button></div>
    <div class="turnbar ${L.extraMode ? 'extra' : ''}"><span>${L.extraMode ? `Extra turn <b>${L.extra}</b>/3` : `Turn <b>${L.turn}</b>`}</span>
      <span class="row"><button class="btn sm" data-act="turnPrev">−</button><button class="btn sm primary" data-act="turnNext">Next turn</button><button class="btn sm ${L.extraMode ? 'warn' : ''}" data-act="turnExtra">${L.extraMode ? 'Normal' : 'Extra turns'}</button></span></div>
    ${L.log.length ? `<div class="lplog">${L.log.slice(-12).reverse().map(e => `<div>${esc(e.who === 'A' ? x.A : x.B)}: ${e.from} → ${e.to} (${e.to - e.from > 0 ? '+' : ''}${e.to - e.from})</div>`).join('')}</div>` : ''}
    <div class="section-title">Record this Duel</div>
    <div class="grid3"><button class="btn good" data-act="mcDuel" data-w="A" ${ev.done ? 'disabled' : ''}>${esc(shortName(x.A))}</button><button class="btn" data-act="mcDuel" data-w="D" ${ev.done || !allowDraw ? 'disabled' : ''}>Draw</button><button class="btn good" data-act="mcDuel" data-w="B" ${ev.done ? 'disabled' : ''}>${esc(shortName(x.B))}</button></div>
    ${x.free ? `<div class="row between small muted" style="margin-top:10px"><span>Duels: ${x.duels.map(d => d === 'D' ? 'Draw' : d === 'A' ? x.A : x.B).join(' · ') || 'none yet'}</span><button class="btn sm ghost" data-act="freeClear">Clear</button></div>`
      : `<div class="btn-grid" style="margin-top:10px"><button class="btn warn" data-act="mcTime">${ic('timer', 'sm')} Time called</button><button class="btn" data-act="mcResult">${ic('list', 'sm')} Result sheet</button></div>`}`;
  updateTimerNodes();
}
function lpMut(fn) { const x = mcCtx(); if (!x) return; fn(x.live, x); saveLive(); renderMatch(); }
ACT.lpActive = d => lpMut(L => { L.active = d.k; });
ACT.lpKey = d => lpMut(L => { if (d.k === 'C') L.entry = ''; else if ((L.entry + d.k).length <= 6) L.entry = String(Number(L.entry + d.k) || '') || (d.k === '0' || d.k === '00' ? '' : ''); });
function setLp(L, who, to) { to = Math.max(0, Math.min(999999, Math.round(to))); const from = L['lp' + who]; if (from === to) return; L.log.push({ who, from, to }); if (L.log.length > 80) L.log.shift(); L['lp' + who] = to; if (to === 0) { buzz(); toast(`${who === 'A' ? mcCtx().A : mcCtx().B} reached 0 LP`); } }
ACT.lpApply = d => lpMut(L => { const v = Number(L.entry) || 0; if (!v && d.op !== '=') return; const k = L.active || 'A'; const cur = L['lp' + k]; setLp(L, k, d.op === '-' ? cur - v : d.op === '+' ? cur + v : v); L.entry = ''; });
ACT.lpDelta = d => lpMut(L => { const k = L.active || 'A'; setLp(L, k, L['lp' + k] + Number(d.v)); });
ACT.lpHalve = () => lpMut(L => { const k = L.active || 'A'; setLp(L, k, Math.ceil(L['lp' + k] / 2)); });
ACT.lpUndo = () => lpMut(L => { const e = L.log.pop(); if (e) L['lp' + e.who] = e.from; });
ACT.lpReset = () => lpMut(L => { Object.assign(L, freshLive(), { active: L.active }); });
ACT.turnNext = () => lpMut(L => { if (L.extraMode) { L.extra = Math.min(3, L.extra + 1); if (L.extra >= 3) toast('Extra turn 3 of 3 — compare Life Points at the end of this turn'); } else L.turn++; });
ACT.turnPrev = () => lpMut(L => { if (L.extraMode) L.extra = Math.max(0, L.extra - 1); else L.turn = Math.max(1, L.turn - 1); });
ACT.turnExtra = () => lpMut(L => { L.extraMode = !L.extraMode; if (L.extraMode && !L.extra) L.extra = 1; });
ACT.mcDuel = d => {
  const x = mcCtx(); if (!x) return;
  if (x.free) { x.duels.push(d.w); Object.assign(x.live, freshLive()); persistFree(); renderMatch(); return toast('Duel recorded'); }
  const duels = x.m.duels.concat(d.w); const ev = E.evaluate(duels, T.rules, x.r.stage);
  if (ev.done) { commitResult(x.r, x.m, duels.slice(0, ev.used || duels.length), ev.result, 'normal', x.m.note); return; }
  mutate(`T${x.m.table} Duel ${duels.length}: ${d.w === 'D' ? 'draw' : (d.w === 'A' ? x.A : x.B)}`, () => { const mm = findRound(x.r.id).matches.find(y => y.id === x.m.id); mm.duels = duels; mm.live = Object.assign(freshLive(), { active: 'A' }); }, { toast: `Duel ${duels.length} recorded` });
};
ACT.mcResult = () => { const x = mcCtx(); if (!x || x.free) return; ACT.openResult({ r: x.r.id, m: x.m.id }); };
ACT.mcTime = () => { const x = mcCtx(); if (!x || x.free) return; ACT.openResult({ r: x.r.id, m: x.m.id }); ACT.rsTime(); };
ACT.freeNames = async () => { const a = await ask({ title: 'Player 1 name', input: { value: FREE.names[0], max: 30 }, ok: 'Next' }); if (a === null) return; const b = await ask({ title: 'Player 2 name', input: { value: FREE.names[1], max: 30 }, ok: 'Save' }); if (b === null) return; FREE.names = [a || 'Player A', b || 'Player B']; persistFree(); renderMatch(); };
ACT.freeClear = () => { FREE.duels = []; FREE.live = freshLive(); persistFree(); renderMatch(); };

/* ===================== round timer ===================== */
function timerElapsed(tm) { return (tm.acc || 0) + (tm.running && tm.start ? (Date.now() - tm.start) / 1000 : 0); }
function timerRemaining(tm) { return (tm.limit || 0) - timerElapsed(tm); }
ACT.timerToggle = () => {
  const cr = curRound(); if (!cr) return; const tm = cr.timer;
  if (tm.running) { tm.acc = timerElapsed(tm); tm.running = false; tm.start = null; log(`${roundTitle(cr)} timer paused at ${mmss(tm.limit ? timerRemaining(tm) : timerElapsed(tm))}`); }
  else { tm.start = Date.now(); tm.running = true; log(`${roundTitle(cr)} timer ${tm.acc ? 'resumed' : 'started'}`); unlockAudio(); }
  persist(); syncTimers(); renderAll();
};
ACT.timerReset = async () => {
  const cr = curRound(); if (!cr) return; const tm = cr.timer;
  if ((tm.acc || tm.running) && !await confirmDo('Reset the round timer?', `It returns to ${mmss(tm.limit || 0)} and stops.`, 'Reset', true)) return;
  Object.assign(tm, { acc: 0, start: null, running: false, alerted5: false, alerted0: false, alertedCap: false });
  log(`${roundTitle(cr)} timer reset`); persist(); syncTimers(); renderAll();
};
ACT.timerAdj = d => { const cr = curRound(); if (!cr) return; const tm = cr.timer; tm.limit = Math.max(60, (tm.limit || 0) + Number(d.v || d.d)); if (timerRemaining(tm) > 300) tm.alerted5 = false; if (timerRemaining(tm) > 0) tm.alerted0 = false; log(`${roundTitle(cr)} time adjusted to ${Math.round(tm.limit / 60)} min`); persist(); updateTimerNodes(); renderChrome(); if (TAB === 'round') renderRound(); };
let tickH = 0;
function syncTimers() { const cr = curRound(); const running = cr && cr.timer.running; clearInterval(tickH); tickH = 0; if (running) tickH = setInterval(tick, 250); updateTimerNodes(); wake(running); }
function tick() {
  const cr = curRound(); if (!cr || !cr.timer.running) { syncTimers(); return; }
  const tm = cr.timer; updateTimerNodes();
  if (!tm.limit) return;
  const rem = timerRemaining(tm);
  if (rem <= 300 && rem > 0 && !tm.alerted5) { tm.alerted5 = true; persist(); alertUser('5 minutes remaining', 1); }
  if (rem <= 0 && !tm.alerted0) { tm.alerted0 = true; persist(); alertUser('TIME! End-of-Match procedure', 3); renderAll(); }
  const cap = cr.stage === 'top' ? 0 : (T.rules.time.overtimeCap || 0);
  if (cap && -rem >= cap * 60 && !tm.alertedCap && pendingIn(cr)) { tm.alertedCap = true; persist(); alertUser(`${cap}-minute overtime reached`, 2); renderAll(); }
}
function updateTimerNodes() {
  const cr = curRound(); const chip = $('#statusChip');
  if (!cr) { $$('[data-timer-text]').forEach(n => n.textContent = '—'); return; }
  const tm = cr.timer, untimed = !tm.limit;
  const rem = untimed ? timerElapsed(tm) : timerRemaining(tm);
  const txt = mmss(rem);
  const cls = untimed ? '' : rem <= 0 ? 'bad' : rem <= 300 ? 'warn' : '';
  const idle = !tm.running && !tm.acc;
  $$('[data-timer-big]').forEach(n => { n.textContent = txt; n.className = 'timer ' + (idle ? 'idle' : cls); });
  $$('[data-timer-text]').forEach(n => n.textContent = untimed ? txt + ' elapsed' : rem <= 0 ? 'TIME ' + txt : txt + ' left');
  $$('[data-timer-sub]').forEach(n => n.textContent = idle ? `${untimed ? 'No time limit' : Math.round(tm.limit / 60) + ' minutes'}` : !tm.running ? 'Paused' : untimed ? 'Running' : rem <= 0 ? `OVERTIME · ${pendingIn(cr)} unfinished` : `Ends ${new Date(Date.now() + rem * 1000).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`);
  if (chip && (tm.running || tm.acc)) { chip.hidden = false; chip.className = 'status-chip ' + (tm.running ? (cls === 'bad' ? 'bad' : cls === 'warn' ? 'warn' : 'live') : ''); chip.innerHTML = `${ic(tm.running ? 'timer' : 'pause', 'sm')} ${txt}`; }
}
let audioCtx = null;
function unlockAudio() { try { audioCtx = audioCtx || new (window.AudioContext || window.webkitAudioContext)(); if (audioCtx.state === 'suspended') audioCtx.resume(); } catch (e) { } }
function beep(times) { if (!PREFS.sound) return; try { unlockAudio(); const t0 = audioCtx.currentTime; for (let i = 0; i < times; i++) { const o = audioCtx.createOscillator(), g = audioCtx.createGain(); o.type = 'square'; o.frequency.value = 880; g.gain.setValueAtTime(0.0001, t0 + i * 0.45); g.gain.exponentialRampToValueAtTime(0.25, t0 + i * 0.45 + 0.02); g.gain.exponentialRampToValueAtTime(0.0001, t0 + i * 0.45 + 0.32); o.connect(g).connect(audioCtx.destination); o.start(t0 + i * 0.45); o.stop(t0 + i * 0.45 + 0.35); } } catch (e) { } }
function buzz(p = [120]) { if (PREFS.vibrate && navigator.vibrate) try { navigator.vibrate(p); } catch (e) { } }
function alertUser(msg, n) { beep(n); buzz(n > 1 ? [300, 150, 300, 150, 300] : [250]); toast(msg, { kind: n > 1 ? 'bad' : '', ms: 6000 }); }
let wakeLock = null;
async function wake(on) {
  try {
    if (on && PREFS.wake && 'wakeLock' in navigator && document.visibilityState === 'visible') { if (!wakeLock) { wakeLock = await navigator.wakeLock.request('screen'); wakeLock.addEventListener('release', () => { wakeLock = null; }); } }
    else if (wakeLock) { await wakeLock.release(); wakeLock = null; }
  } catch (e) { wakeLock = null; }
}
document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible') { const cr = curRound(); syncTimers(); if (cr && cr.timer.running) tick(); } });

/* ===================== tools ===================== */
ACT.openTools = () => {
  const cr = curRound();
  openSheet('Tools', `
    <label class="f"><span>Find a player's table</span><div class="search">${ic('search', 'sm')}<input class="input" placeholder="Type a name" data-oninput="findTable" ${T && cr ? '' : 'disabled'}></div></label>
    <div id="findOut" class="small muted" style="margin-top:8px">${T && cr ? '' : 'Available during a round.'}</div>
    <div class="section-title">Duel tools</div>
    <div class="tiles" style="margin-top:0">
      <button class="tile" data-act="openMatchFree" style="--c:var(--bad)"><span class="t-ico">${ic('heart')}</span><span><b>LP calculator</b></span></button>
      <button class="tile" data-act="toolCoin" style="--c:var(--gold)"><span class="t-ico">${ic('coin')}</span><span><b>Coin flip</b></span></button>
      <button class="tile" data-act="toolDice" style="--c:var(--accent-2)"><span class="t-ico">${ic('dice')}</span><span><b>Dice roll</b></span></button>
      <button class="tile" data-act="openRulesRef" style="--c:var(--good)"><span class="t-ico">${ic('book')}</span><span><b>Rules guide</b></span></button>
    </div>
    ${T ? `<div class="section-title">Event</div><div class="stack">
      <button class="btn block" data-act="printPairings" data-by="table" ${cr ? '' : 'disabled'}>${ic('print', 'sm')} Print current pairings</button>
      <button class="btn block" data-act="printSlips" ${cr ? '' : 'disabled'}>${ic('file', 'sm')} Print result slips</button>
      <button class="btn block" data-act="standImage">${ic('image', 'sm')} Standings image</button>
      <button class="btn block" data-act="runAudit">${ic('shield', 'sm')} Integrity check</button></div>` : ''}`);
};
ON.findTable = el => {
  const q = el.value.trim().toLowerCase(); const out = $('#findOut'); const cr = curRound(); if (!out || !cr) return;
  if (!q) { out.innerHTML = ''; return; }
  const hits = cr.matches.filter(m => pn(m.a).toLowerCase().includes(q) || (m.b && pn(m.b).toLowerCase().includes(q))).slice(0, 8);
  out.innerHTML = hits.length ? hits.map(m => { const me = pn(m.a).toLowerCase().includes(q) ? m.a : m.b, opp = me === m.a ? m.b : m.a; return `<div class="banner info" style="margin-top:6px"><span class="b-ico"><b style="font-size:20px">${m.b ? m.table : '—'}</b></span><div class="b-body"><b>${esc(pn(me))}</b><p>${m.b ? `Table ${m.table} · vs ${esc(pn(opp))}` : 'Bye this round'}${m.result ? ' · reported' : ''}</p></div></div>`; }).join('') : 'No player found in this round.';
};
ACT.toolCoin = () => { const v = crypto.getRandomValues(new Uint32Array(1))[0] % 2 ? 'HEADS' : 'TAILS'; openSheet('Coin flip', `<div class="coin spin">${v}</div>`, `<button class="btn" data-act="closeSheet">Close</button><button class="btn primary" data-act="toolCoin">Flip again</button>`); buzz([40]); };
ACT.toolDice = () => { const v = 1 + crypto.getRandomValues(new Uint32Array(1))[0] % 6; openSheet('Dice roll', `<div class="die spin">${v}</div>`, `<button class="btn" data-act="closeSheet">Close</button><button class="btn primary" data-act="toolDice">Roll again</button>`); buzz([40]); };
ACT.openRulesRef = () => {
  const r = T ? T.rules : E.makeRules('ocg2026');
  openSheet('Rules guide', `
    <div class="banner info" style="margin-top:0"><span class="b-ico">${ic('book')}</span><div class="b-body"><b>${esc(r.label)}</b><p>${esc(r.blurb || '')}</p></div></div>
    <div class="section-title">This event</div>
    <dl class="kv"><dt>Format</dt><dd>${r.format.winsNeeded === 1 ? 'Single Duel' : `First to ${r.format.winsNeeded} Duel wins`}${r.format.maxDuels ? `, max ${r.format.maxDuels}` : ', extra Duels if needed'}</dd>
      <dt>Round time</dt><dd>${r.time.limit ? r.time.limit + ' min' : 'No limit'}${r.time.overtimeCap ? ` (+${r.time.overtimeCap} min cap)` : ''}</dd>
      <dt>Match Draws</dt><dd>${r.format.matchDraws ? 'Allowed' : 'Not used (→ Double Loss)'}</dd>
      <dt>Points</dt><dd>W ${r.points.win} · D ${r.points.draw} · L ${r.points.loss} · DL ${r.points.dl} · Bye ${r.points.bye}</dd>
      <dt>Tie-breakers</dt><dd>${r.tiebreakers.map(k => E.TIEBREAKERS[k].short).join(' → ') || '—'}</dd></dl>
    <div class="section-title">Swiss End-of-Match</div><p class="small">${esc(E.PROCEDURES[r.time.procedure])}</p>
    <div class="section-title">Top cut End-of-Match</div><p class="small">${esc(E.PROCEDURES[r.time.topProcedure])}</p>
    <div class="section-title">OCG 2026 Swiss Match result examples</div>
    <dl class="kv small"><dt>2 wins – 0</dt><dd>Win</dd><dt>1 win + 1 draw</dt><dd>Win</dd><dt>1 win – 1 loss (time)</dt><dd>Match Draw</dd><dt>2 draws</dt><dd>Match Draw</dd><dt>2 wins – 1 loss</dt><dd>Win</dd><dt>1 win + 2 draws</dt><dd>Win</dd><dt>1 win, 1 loss, 1 draw</dt><dd>Match Draw</dd><dt>3 draws</dt><dd>Match Draw</dd></dl>
    <p class="muted small" style="margin-top:14px">Sources: Konami 遊戯王OCG ショップイベント大会規定 and 1デュエル戦大会規定 (rev. 2026-07-21); Konami Swiss round guide; KDE Tournament Policy v2.5. Konami does not publish an OCG Match-point table, so the standard 3 / 1 / 0 is used and can be changed under Rules.</p>`);
};

/* ===================== export / import / share ===================== */
function download(blob, name) {
  try { const url = URL.createObjectURL(blob); const a = document.createElement('a'); a.href = url; a.download = name; a.rel = 'noopener'; document.body.appendChild(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(url), 5000); return true; } catch (e) { return false; }
}
async function deliver(blob, name, title) {
  const file = (() => { try { return new File([blob], name, { type: blob.type }); } catch (e) { return null; } })();
  const coarse = matchMedia('(pointer:coarse)').matches;
  if (file && coarse && navigator.canShare && navigator.canShare({ files: [file] })) {
    try { await navigator.share({ files: [file], title: title || name }); return; } catch (e) { if (e.name === 'AbortError') return; }
  }
  if (download(blob, name)) toast('Saved ' + name, { kind: 'good' }); else toast('Download not supported here — use Copy instead', { kind: 'bad' });
}
async function copyText(txt, msg) {
  try { await navigator.clipboard.writeText(txt); toast(msg || 'Copied', { kind: 'good' }); }
  catch (e) { openSheet('Copy text', `<p class="muted small" style="margin-top:0">Select all and copy:</p><textarea class="input" readonly style="min-height:260px" onfocus="this.select()">${esc(txt)}</textarea>`); }
}
const pack = (kind, extra) => Object.assign({ app: 'meiocg-duel-synapse-swiss', version: VERSION, kind, exportedAt: new Date().toISOString() }, extra);
ACT.exportT = () => { if (!T) return toast('No tournament to export'); deliver(new Blob([JSON.stringify(pack('tournament', { tournament: T }), null, 1)], { type: 'application/json' }), slug(T.name) + '.json'); };
ACT.backupAll = () => deliver(new Blob([JSON.stringify(pack('backup', { active: T, archive: ARCH, prefs: PREFS }), null, 1)], { type: 'application/json' }), `meiocg-swiss-backup-${new Date().toISOString().slice(0, 10)}.json`);
ACT.copyJSON = () => { if (!T) return; copyText(JSON.stringify(pack('tournament', { tournament: T })), 'Tournament JSON copied'); };
ACT.importFile = () => { const f = $('#fileImport'); f.value = ''; f.click(); };
ACT.importPaste = () => openSheet('Paste backup JSON', `<textarea class="input" id="pasteJson" style="min-height:220px" placeholder='{"app":"meiocg-duel-synapse-swiss", …}'></textarea>`, `<button class="btn" data-act="closeSheet">Cancel</button><button class="btn primary" data-act="importPasteGo">Import</button>`, { focus: '#pasteJson' });
ACT.importPasteGo = () => handleImport($('#pasteJson').value);
async function handleImport(text) {
  let data; try { data = JSON.parse(text); } catch (e) { return toast('That is not valid JSON', { kind: 'bad' }); }
  let list = [], active = null, archive = [];
  if (data && data.kind === 'backup') { active = normalizeT(data.active); archive = (data.archive || []).map(normalizeT).filter(Boolean); }
  else if (data && data.kind === 'tournament') active = normalizeT(data.tournament);
  else if (data && data.tournament && data.tournament.players && data.tournament.rounds && data.tournament.rounds.some && (data.tournament.pairs || (data.tournament.rounds[0] || {}).pairs || data.tournament.settings)) { active = migrateLegacyT(data.tournament, false); archive = (data.archives || []).map(a => migrateLegacyT(a, true)).filter(Boolean); }
  else if (data && Array.isArray(data.players) && (data.settings || data.current !== undefined)) active = migrateLegacyT(data, false);
  else if (data && Array.isArray(data.players) && Array.isArray(data.rounds) && data.rules) active = normalizeT(data);
  if (!active && !archive.length) return toast('Unrecognised file format', { kind: 'bad' });
  list = archive;
  const choice = active ? await ask({ title: 'Import', msg: `Found “${active.name}” (${plural(active.players.length, 'player')}, ${plural(active.rounds.length, 'round')})${archive.length ? ` and ${plural(archive.length, 'archived event')}` : ''}.`, choices: [{ label: 'Open as current tournament', value: 'active', cls: 'primary' }, { label: 'Add to archive only', value: 'archive' }] }) : 'archive';
  if (!choice) return;
  if (choice === 'active') { if (T && T.id !== active.id) archiveT(T, 'Archived before import'); T = active; UNDO.length = 0; persist(); }
  else if (active) list = [active, ...archive];
  list.forEach(a => { ARCH = ARCH.filter(x => x.id !== a.id); ARCH.push(a); });
  ARCH.sort((a, b) => (b.createdAt || 0) - (a.createdAt || 0)); persistArchive();
  if (data.kind === 'backup' && data.prefs && await confirmDo('Restore appearance too?', 'The backup includes theme and alert settings.', 'Restore')) { PREFS = Object.assign(E.clone(DEFAULT_PREFS), data.prefs); persistPrefs(); applyPrefs(); }
  closeSheet(); renderAll(); syncTimers(); toast('Import complete', { kind: 'good' });
}
$('#fileImport').addEventListener('change', e => { const f = e.target.files && e.target.files[0]; if (!f) return; const rd = new FileReader(); rd.onload = () => handleImport(String(rd.result)); rd.onerror = () => toast('Could not read the file', { kind: 'bad' }); rd.readAsText(f); });

/* ---------- standings share ---------- */
ACT.standMenu = () => openSheet('Share standings', `<div class="stack">
  <button class="btn block primary" data-act="standImage">${ic('image', 'sm')} Standings image (PNG)</button>
  <button class="btn block" data-act="printStandings">${ic('print', 'sm')} Print standings</button>
  <button class="btn block" data-act="copyStandings">${ic('copy', 'sm')} Copy as text (chat / social)</button>
  <button class="btn block" data-act="csvStandings">${ic('download', 'sm')} Download CSV (spreadsheet)</button></div>`);
function standList() { return standView === 'final' && topRounds().length ? E.finalPlacements(T).map(s => ({ ...s, rank: s.place })) : liveStandings(); }
function tbCols() { return T.rules.tiebreakers.filter(k => k !== 'h2h'); }
const tbVal = (s, k) => ['omw', 'oomw', 'gwp', 'ogw'].includes(k) ? pct(s[k]) : String(Math.round(s[k] * 100) / 100);
ACT.copyStandings = () => { const L = standList(); const head = `${T.name}\n${standingsCaption()}\n`; copyText(head + L.map(s => `${s.rank}. ${s.name} — ${s.pts} pts (${s.w}-${s.losses}-${s.d})${s.note ? ' · ' + s.note : ''} · ${tbCols().map(k => E.TIEBREAKERS[k].short + ' ' + tbVal(s, k)).join(' · ')}`).join('\n') + '\n\nMEIOCG · Project: Duel Synapse', 'Standings copied'); };
ACT.csvStandings = () => { const L = standList(); const cols = tbCols(); const q = v => `"${String(v).replace(/"/g, '""')}"`; const rows = [['Rank', 'Player', 'Points', 'W', 'L', 'D', 'DoubleLoss', 'Byes', 'DuelW', 'DuelL', 'DuelD', ...cols.map(k => E.TIEBREAKERS[k].short), 'Status'].map(q).join(',')]; L.forEach(s => rows.push([s.rank, s.name, s.pts, s.w, s.l, s.d, s.dl, s.byes, s.gw, s.gl, s.gd, ...cols.map(k => tbVal(s, k)), s.elim ? 'Eliminated' : s.dropped ? 'Dropped' : (s.note || 'Active')].map(q).join(','))); deliver(new Blob(['﻿' + rows.join('\r\n')], { type: 'text/csv' }), slug(T.name) + '-standings.csv'); };
function standingsCaption() { const cr = curRound(); if (T.status === 'complete') return 'Final standings'; if (standView === 'final') return 'Final placings'; const done = swissRounds().filter(r => r.complete).length; return cr && cr.stage !== 'top' ? `Live standings · Round ${cr.n} in progress` : `Standings after Round ${done} of ${plannedRounds()}`; }
let emblemImg = null;
function loadImg(src) { return new Promise(res => { const i = new Image(); i.onload = () => res(i); i.onerror = () => res(null); i.src = src; }); }
function loadEmblem() { return new Promise(res => { if (emblemImg) return res(emblemImg); const i = new Image(); i.onload = () => { emblemImg = i; res(i); }; i.onerror = () => res(null); i.src = EMBLEM; }); }
async function standingsPNG() {
  const L = standList(), cols = tbCols().slice(0, 3);
  const W = 1080, rowH = 64, head = 230, foot = 80, H = head + 50 + L.length * rowH + foot;
  const cv = document.createElement('canvas'); cv.width = W; cv.height = H; const g = cv.getContext('2d');
  const acc = PREFS.accent || '#2f8cff';
  const grd = g.createLinearGradient(0, 0, W, H); grd.addColorStop(0, '#081226'); grd.addColorStop(1, '#04070e'); g.fillStyle = grd; g.fillRect(0, 0, W, H);
  g.fillStyle = acc; g.globalAlpha = .18; g.beginPath(); g.arc(W - 80, 40, 260, 0, 7); g.fill(); g.globalAlpha = 1;
  const em = await loadEmblem(); if (em) g.drawImage(em, 56, 50, 96, 98);
  const F = 'Inter, "Segoe UI", Roboto, Arial, sans-serif';
  const wm = await loadImg(WORDMARK); if (wm) g.drawImage(wm, 172, 44, 220, 220 * wm.height / wm.width); else { g.fillStyle = '#fff'; g.font = `italic 900 46px ${F}`; g.fillText('MEIOCG', 172, 96); }
  const tt = await loadImg(TITLE); if (tt) g.drawImage(tt, 174, 104, 200, 200 * tt.height / tt.width); else { g.fillStyle = '#8ca2c3'; g.font = `600 22px ${F}`; g.fillText('Project: Duel Synapse', 174, 132); }
  g.fillStyle = '#fff'; g.font = `800 34px ${F}`; g.fillText(T.name.slice(0, 48), 56, 196);
  g.fillStyle = acc; g.font = `700 20px ${F}`; g.fillText(standingsCaption() + ' · ' + T.rules.label, 56, 226);
  let y = head + 20;
  const cx = { rank: 56, name: 130, rec: 600, pts: 720, tb: [810, 900, 990] };
  g.fillStyle = '#5d7290'; g.font = `800 15px ${F}`; g.fillText('#', cx.rank, y); g.fillText('PLAYER', cx.name, y); g.fillText('W-L-D', cx.rec, y); g.fillText('PTS', cx.pts, y); cols.forEach((k, i) => g.fillText(E.TIEBREAKERS[k].short, cx.tb[i], y));
  y += 18;
  L.forEach((s, i) => {
    g.fillStyle = i % 2 ? 'rgba(255,255,255,.025)' : 'rgba(255,255,255,.055)'; g.fillRect(40, y, W - 80, rowH - 6);
    const col = s.rank === 1 ? '#ffcf4d' : s.rank === 2 ? '#c9d6ea' : s.rank === 3 ? '#e0995e' : '#e9f1ff';
    g.fillStyle = col; g.font = `900 24px ${F}`; g.fillText(String(s.rank), cx.rank, y + 39);
    g.fillStyle = s.dropped || s.elim ? '#8ca2c3' : '#e9f1ff'; g.font = `700 24px ${F}`; let nm = s.name; while (g.measureText(nm).width > 450 && nm.length > 3) nm = nm.slice(0, -2); if (nm !== s.name) nm += '…'; g.fillText(nm, cx.name, y + 39);
    g.fillStyle = '#8ca2c3'; g.font = `600 21px ${F}`; g.fillText(`${s.w}-${s.losses}-${s.d}`, cx.rec, y + 39);
    g.fillStyle = '#fff'; g.font = `900 25px ${F}`; g.fillText(String(s.pts), cx.pts, y + 39);
    g.fillStyle = '#8ca2c3'; g.font = `600 17px ${F}`; cols.forEach((k, j) => g.fillText(tbVal(s, k).replace('%', ''), cx.tb[j], y + 38));
    y += rowH;
  });
  g.fillStyle = '#5d7290'; g.font = `600 16px ${F}`; g.fillText(`Generated ${new Date().toLocaleString()} · MEIOCG Swiss Tournament Manager v${VERSION}`, 56, H - 34);
  return new Promise(res => cv.toBlob(b => res({ blob: b, url: cv.toDataURL('image/png') }), 'image/png'));
}
ACT.standImage = async () => {
  if (!T) return; const { blob, url } = await standingsPNG();
  window._lastPng = blob;
  openSheet('Standings image', `<img class="img-preview" src="${url}" alt="Standings image">`,
    `<button class="btn" data-act="pngSave">${ic('download', 'sm')} Save</button><button class="btn primary" data-act="pngShare">${ic('share', 'sm')} Share</button>`);
};
ACT.pngSave = () => { if (window._lastPng) download(window._lastPng, slug(T.name) + '-standings.png') ? toast('Image saved', { kind: 'good' }) : toast('Long-press the image to save it'); };
ACT.pngShare = () => { if (window._lastPng) deliver(window._lastPng, slug(T.name) + '-standings.png', T.name); };

/* ---------- printing ---------- */
function printDoc(title, sub, html) {
  $('#printArea').innerHTML = `<h1>${esc(title)}</h1><h2>${esc(sub)}</h2>${html}<div class="foot">MEIOCG · Project: Duel Synapse · ${esc(new Date().toLocaleString())}</div>`;
  closeSheet(); setTimeout(() => { try { window.print(); } catch (e) { toast('Printing is not available here', { kind: 'bad' }); } }, 150);
}
ACT.printStandings = () => { const L = standList(), cols = tbCols(); printDoc(T.name, standingsCaption(), `<table><thead><tr><th>#</th><th>Player</th><th>Pts</th><th>W-L-D</th>${cols.map(k => `<th>${E.TIEBREAKERS[k].short}</th>`).join('')}</tr></thead><tbody>${L.map(s => `<tr><td>${s.rank}</td><td>${esc(s.name)}${s.dropped ? ' (drop)' : ''}${s.note ? ' · ' + esc(s.note) : ''}</td><td>${s.pts}</td><td>${s.w}-${s.losses}-${s.d}</td>${cols.map(k => `<td>${tbVal(s, k)}</td>`).join('')}</tr>`).join('')}</tbody></table>`); };
ACT.printPairings = d => {
  const r = curRound() || lastRound(); if (!r) return; const st = new Map(liveStandings().map(s => [s.id, s]));
  if (d.by === 'name') {
    const rows = []; r.matches.forEach(m => { if (m.result === 'VOID') return; rows.push({ n: pn(m.a), t: m.b ? m.table : 'BYE', o: m.b ? pn(m.b) : '—', p: st.get(m.a) }); if (m.b) rows.push({ n: pn(m.b), t: m.table, o: pn(m.a), p: st.get(m.b) }); });
    rows.sort((a, b) => a.n.localeCompare(b.n));
    printDoc(T.name, `${roundTitle(r)} pairings — alphabetical`, `<table><thead><tr><th>Player</th><th>Table</th><th>Opponent</th><th>Pts</th></tr></thead><tbody>${rows.map(x => `<tr><td>${esc(x.n)}</td><td><b>${x.t}</b></td><td>${esc(x.o)}</td><td>${x.p ? x.p.pts : ''}</td></tr>`).join('')}</tbody></table>`);
  } else printDoc(T.name, `${roundTitle(r)} pairings — by table`, `<table><thead><tr><th>Table</th><th>Player 1</th><th>Pts</th><th>Player 2</th><th>Pts</th><th>Result</th></tr></thead><tbody>${r.matches.filter(m => m.result !== 'VOID').sort((a, b) => (a.table || 999) - (b.table || 999)).map(m => `<tr><td><b>${m.b ? m.table : 'BYE'}</b></td><td>${esc(pn(m.a))}</td><td>${st.get(m.a) ? st.get(m.a).pts : ''}</td><td>${m.b ? esc(pn(m.b)) : '—'}</td><td>${m.b && st.get(m.b) ? st.get(m.b).pts : ''}</td><td></td></tr>`).join('')}</tbody></table>`);
};
ACT.printSlips = () => { const r = curRound(); if (!r) return; printDoc(T.name, `${roundTitle(r)} — result slips`, r.matches.filter(m => m.b).sort((a, b) => a.table - b.table).map(m => `<div class="slip"><b>${esc(roundTitle(r))} · Table ${m.table}</b><br><br>${esc(pn(m.a))} — Duels won <span class="ln"></span> &nbsp;&nbsp; ${esc(pn(m.b))} — Duels won <span class="ln"></span><br><br>Draws <span class="ln"></span> &nbsp; Winner: ☐ ${esc(pn(m.a))} ☐ ${esc(pn(m.b))} ${T.rules.format.matchDraws ? '☐ Draw' : ''} ☐ Double Loss<br><br>Signatures: <span class="ln" style="width:160px"></span> <span class="ln" style="width:160px"></span></div>`).join('')); };
ACT.printRoster = () => printDoc(T.name, 'Player roster / sign-in', `<table><thead><tr><th>Seed</th><th>Player</th><th>Status</th><th>Signature</th></tr></thead><tbody>${T.players.slice().sort((a, b) => a.seed - b.seed).map(p => `<tr><td>${p.seed}</td><td>${esc(p.name)}</td><td>${p.dropped ? 'Dropped' : 'Active'}</td><td style="width:35%"></td></tr>`).join('')}</tbody></table>`);
ACT.copyPairings = () => { const r = curRound(); if (!r) return; const st = new Map(liveStandings().map(s => [s.id, s])); copyText(`${T.name}\n${roundTitle(r)} pairings\n\n` + r.matches.filter(m => m.result !== 'VOID').sort((a, b) => (a.table || 999) - (b.table || 999)).map(m => m.b ? `Table ${m.table}: ${pn(m.a)} (${st.get(m.a) ? st.get(m.a).pts : 0}) vs ${pn(m.b)} (${st.get(m.b) ? st.get(m.b).pts : 0})` : `BYE: ${pn(m.a)}`).join('\n'), 'Pairings copied'); };

/* ---------- archive ---------- */
ACT.viewArchive = d => {
  const a = ARCH.find(x => x.id === d.id); if (!a) return;
  const fp = safeFinal(a);
  openSheet(a.name, `<div class="row wrap" style="gap:6px"><span class="pill">${esc(a.rules.label)}</span><span class="pill ${a.status === 'complete' ? 'good' : 'warn'}">${a.status === 'complete' ? 'FINISHED' : 'UNFINISHED'}</span><span class="pill">${fmtDay(a.createdAt)}</span></div>
    <div class="card" style="padding:0;margin-top:12px">${fp.slice(0, 64).map(s => `<div class="srow" style="cursor:default"><span class="rank ${s.place <= 3 ? 'r' + s.place : ''}">${s.place}</span><span class="who"><b>${esc(s.name)}${s.note ? ` <span class="pill info">${esc(s.note)}</span>` : ''}</b><small>${s.w}-${s.losses}-${s.d} · OMW ${pct(s.omw)}</small></span><span class="pts"><b>${s.pts}</b></span></div>`).join('') || '<div class="empty">No players</div>'}</div>
    <p class="muted small">${plural(a.rounds.length, 'round')} · ${plural(a.players.length, 'player')}</p>`,
    `<button class="btn danger" data-act="deleteArchive" data-id="${a.id}">${ic('trash', 'sm')}</button><button class="btn" data-act="exportArchive" data-id="${a.id}">${ic('download', 'sm')} Export</button><button class="btn primary" data-act="restoreArchive" data-id="${a.id}">Open</button>`);
};
ACT.exportArchive = d => { const a = ARCH.find(x => x.id === d.id); if (a) deliver(new Blob([JSON.stringify(pack('tournament', { tournament: a }), null, 1)], { type: 'application/json' }), slug(a.name) + '.json'); };
ACT.deleteArchive = async d => { const a = ARCH.find(x => x.id === d.id); if (!a) return; if (!await confirmDo('Delete archived tournament?', `“${a.name}” and all of its results will be permanently removed.`, 'Delete', true)) return; ARCH = ARCH.filter(x => x.id !== d.id); persistArchive(); closeSheet(); renderAll(); toast('Archived tournament deleted'); };
ACT.restoreArchive = async d => {
  const a = ARCH.find(x => x.id === d.id); if (!a) return;
  if (T && T.id === a.id) { closeSheet(); return showTab('home'); }
  if (T && !await confirmDo('Open this tournament?', `The current tournament “${T.name}” will be archived first.`, 'Open')) return;
  if (T) archiveT(T, 'Archived when another tournament was opened');
  T = normalizeT(E.clone(a)); UNDO.length = 0; persist(); closeSheet(); renderAll(); syncTimers(); showTab('home'); toast('Opened “' + a.name + '”');
};

/* ===================== settings ===================== */
ACT.openSettings = () => { const fn = () => renderSettings(); fn(); sheetRefresh = fn; };
function renderSettings() {
  const accents = ['#2f8cff', '#00b8d9', '#7657ff', '#22c55e', '#ff4d6d', '#f59e0b', '#e879f9'];
  const used = Store.size();
  openSheet('Settings', `
    ${T ? `<div class="section-title" style="margin-top:0">Tournament</div><div class="stack">
      <button class="btn block" data-act="openRules">${ic('shield', 'sm')} Rules, scoring & tie-breakers</button>
      <button class="btn block" data-act="renameT">${ic('edit', 'sm')} Rename “${esc(T.name)}”</button>
      ${T.status === 'complete' ? `<button class="btn block" data-act="reopenTournament">${ic('unlock', 'sm')} Reopen tournament</button>` : ''}
      <button class="btn block" data-act="undo" ${UNDO.length ? '' : 'disabled'}>${ic('undo', 'sm')} Undo last change${UNDO.length ? ' · ' + esc(UNDO[UNDO.length - 1].label.slice(0, 40)) : ''}</button></div>` : ''}
    <div class="section-title">Appearance</div>
    <div class="seg"><button class="${PREFS.theme === 'dark' ? 'on' : ''}" data-act="setPref" data-k="theme" data-v="dark">Dark</button><button class="${PREFS.theme === 'light' ? 'on' : ''}" data-act="setPref" data-k="theme" data-v="light">Light</button></div>
    <div class="row between" style="margin-top:12px"><span class="small muted">Accent</span><input type="color" value="${esc(PREFS.accent)}" data-onchange="prefColor" data-k="accent" aria-label="Custom accent colour"></div>
    <div class="swatches" style="margin-top:8px">${accents.map(c => `<button class="swatch ${PREFS.accent === c ? 'on' : ''}" style="background:${c}" data-act="setPref" data-k="accent" data-v="${c}" aria-label="Accent ${c}"></button>`).join('')}</div>
    <div class="row between" style="margin-top:12px"><span class="small muted">Background</span><span class="row"><input type="color" value="${esc(PREFS.bg || (PREFS.theme === 'light' ? '#eaf0f8' : '#050a13'))}" data-onchange="prefColor" data-k="bg" aria-label="Background colour">${PREFS.bg ? `<button class="btn sm ghost" data-act="setPref" data-k="bg" data-v="">Default</button>` : ''}</span></div>
    <label class="f" style="margin-top:12px"><span>Panel opacity · ${PREFS.panel}%</span><input type="range" min="40" max="100" value="${PREFS.panel}" data-oninput="prefRange" data-k="panel"></label>
    <div class="card" style="margin-top:12px">
      <div class="row between"><b class="small">Wallpaper</b><span class="row"><button class="btn sm" data-act="pickWallpaper">${ic('image', 'sm')} Choose</button>${PREFS.wp.on ? `<button class="btn sm danger" data-act="removeWallpaper">Remove</button>` : ''}</span></div>
      ${PREFS.wp.on ? `<label class="f" style="margin-top:10px"><span>Visibility · ${PREFS.wp.strength}%</span><input type="range" min="5" max="100" value="${PREFS.wp.strength}" data-oninput="prefWp" data-k="strength"></label>
      <label class="f" style="margin-top:6px"><span>Blur · ${PREFS.wp.blur}px</span><input type="range" min="0" max="20" value="${PREFS.wp.blur}" data-oninput="prefWp" data-k="blur"></label>
      <div class="seg" style="margin-top:8px">${['top', 'center', 'bottom'].map(p => `<button class="${PREFS.wp.pos === p ? 'on' : ''}" data-act="wpPos" data-v="${p}">${p[0].toUpperCase() + p.slice(1)}</button>`).join('')}</div>` : ''}
    </div>
    <div class="section-title">Round alerts</div>
    <div class="card" style="padding:0 14px">
      ${[['sound', 'Sound'], ['vibrate', 'Vibration'], ['wake', 'Keep screen awake']].map(([k, t]) => `<label class="switch"><span><b>${t}</b></span><span class="toggle"><input type="checkbox" ${PREFS[k] ? 'checked' : ''} data-onchange="prefBool" data-k="${k}"><span></span></span></label>`).join('')}
    </div>
    <div class="section-title">Data & backup</div>
    <div class="btn-grid">
      <button class="btn" data-act="exportT" ${T ? '' : 'disabled'}>${ic('download', 'sm')} Export event</button>
      <button class="btn" data-act="backupAll">${ic('download', 'sm')} Full backup</button>
      <button class="btn" data-act="importFile">${ic('upload', 'sm')} Import file</button>
      <button class="btn" data-act="importPaste">${ic('paste', 'sm')} Paste JSON</button>
      <button class="btn" data-act="copyJSON" ${T ? '' : 'disabled'}>${ic('copy', 'sm')} Copy JSON</button>
      <button class="btn" data-act="restoreAuto">${ic('history', 'sm')} Auto-backup</button>
      <button class="btn full" data-act="runAudit">${ic('shield', 'sm')} Integrity check</button>
    </div>
    <p class="muted small">Storage used: ${(used / 1024).toFixed(0)} KB</p>
    <div class="btn-grid"><button class="btn danger" data-act="clearArchive" ${ARCH.length ? '' : 'disabled'}>Clear archive</button><button class="btn danger" data-act="resetApp">Reset app</button></div>
    ${privacySocialSection()}
    <div class="about-foot"><img class="wordmark" src="${WORDMARK}" alt="MEIOCG"></div>`, '', { refresh: renderSettings, keepScroll: true });
}
ACT.undo = () => { undo(); };

/* ---------- privacy & social ---------- */
const SOCIAL_META = {
  website: { label: 'Website', c: '#2f8cff', svg: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3.2 3 14.8 0 18M12 3c-3 3.2-3 14.8 0 18"/>' },
  facebook: { label: 'Facebook', c: '#1877f2', svg: '<path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8z"/>' },
  youtube: { label: 'YouTube', c: '#ff2a2a', svg: '<rect x="2.5" y="5.5" width="19" height="13" rx="4"/><path d="m10 9 5 3-5 3z"/>' },
  tiktok: { label: 'TikTok', c: '#25f4ee', svg: '<path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5"/><path d="M14 3c.5 2.8 2.4 4.5 5 4.7"/>' },
  instagram: { label: 'Instagram', c: '#e1306c', svg: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r=".6"/>' },
  discord: { label: 'Discord', c: '#5865f2', svg: '<path d="M7 7c3-1.4 7-1.4 10 0l2 9c-1.6 1.3-3.4 2-5 2.3l-1-1.8M7 7 5 16c1.6 1.3 3.4 2 5 2.3l1-1.8"/><circle cx="9.5" cy="12.5" r="1"/><circle cx="14.5" cy="12.5" r="1"/>' },
  x: { label: 'X', c: '#e9f1ff', svg: '<path d="M4 4l16 16M20 4 4 20"/>' },
  email: { label: 'Email', c: '#ffb547', svg: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>' }
};
function linkHref(k) { const v = String(LINKS[k] || '').trim(); if (!v) return ''; if (k === 'email') return 'mailto:' + v.replace(/^mailto:/, ''); return /^https?:\/\//.test(v) ? v : 'https://' + v; }
function privacySocialSection() {
  const socials = Object.keys(SOCIAL_META).filter(k => linkHref(k));
  return `<div class="section-title">Privacy & Social</div>
    <div class="card" style="padding:4px 14px">
      <button class="list-row" data-act="openPrivacy"><span class="lr-ico" style="--c:var(--good)">${ic('shield')}</span><span class="grow"><b>Privacy Policy</b></span>${ic('chev', 'sm')}</button>
      <button class="list-row" data-act="openTerms"><span class="lr-ico" style="--c:var(--accent-2)">${ic('file')}</span><span class="grow"><b>Terms & Disclaimer</b></span>${ic('chev', 'sm')}</button>
      <button class="list-row" data-act="openDataInfo"><span class="lr-ico" style="--c:var(--warn)">${ic('lock')}</span><span class="grow"><b>Your data</b><small>Stored only on this device</small></span>${ic('chev', 'sm')}</button>
      ${linkHref('kodex') ? `<a class="list-row" href="${esc(linkHref('kodex'))}" target="_blank" rel="noopener noreferrer"><span class="lr-ico" style="--c:var(--draw)">${ic('book')}</span><span class="grow"><b>Duel Synapse: KodeX</b><small>Card & rulings app</small></span>${ic('chev', 'sm')}</a>` : ''}
    </div>
    ${socials.length ? `<div class="socials">${socials.map(k => `<a class="social" href="${esc(linkHref(k))}" target="_blank" rel="noopener noreferrer" style="--c:${SOCIAL_META[k].c}" aria-label="${SOCIAL_META[k].label}"><svg class="i" viewBox="0 0 24 24">${SOCIAL_META[k].svg}</svg><span>${SOCIAL_META[k].label}</span></a>`).join('')}</div>` : ''}`;
}
ACT.openPrivacy = () => openSheet('Privacy Policy', `<div class="doc">
  <p class="muted small">Effective ${POLICY_DATE} · MEIOCG · Project: Duel Synapse — Swiss Tournament Manager</p>
  <h4>Summary</h4><p>This app does not collect, sell or share personal data. It has no accounts, no ads, no analytics and no tracking, and it works fully offline.</p>
  <h4>Information you enter</h4><p>Tournament names, player names, notes, results, settings and an optional wallpaper are saved only in this device’s app storage. MEIOCG never receives this information.</p>
  <h4>Player names</h4><p>Organizers enter player names to run events. Only enter names players have agreed to share, and delete them when no longer needed.</p>
  <h4>Exports and sharing</h4><p>Files and images (backups, standings, CSV) are created only when you tap Export, Share, Print or Copy, and go only where you choose to send them.</p>
  <h4>Device permissions</h4><p>The app may use file selection (import and wallpaper), vibration, sound and keep-screen-awake for round alerts. It does not use the camera, microphone, location or contacts.</p>
  <h4>Links to other services</h4><p>Social media and website links open third-party services that have their own privacy policies.</p>
  <h4>Children</h4><p>The app does not knowingly collect information from anyone, including children.</p>
  <h4>Deleting your data</h4><p>Delete individual tournaments from History → Archive, or erase everything with Settings → Reset app. Uninstalling the app also removes all of its data.</p>
  <h4>Changes</h4><p>Updates to this policy will be published with new versions of the app.</p>
  ${linkHref('email') ? `<h4>Contact</h4><p><a href="${esc(linkHref('email'))}">${esc(LINKS.email)}</a></p>` : ''}</div>`);
ACT.openTerms = () => openSheet('Terms & Disclaimer', `<div class="doc">
  <h4>Unofficial tool</h4><p>MEIOCG · Project: Duel Synapse is an independent, fan-made tournament organizer. It is not affiliated with, endorsed or sponsored by Konami. Yu-Gi-Oh! and related names are trademarks of Konami Digital Entertainment.</p>
  <h4>Rules</h4><p>Default settings follow publicly available Konami OCG event regulations (revised 2026-07-21). Official or event-specific rules and the head judge’s rulings always take priority. Organizers are responsible for checking scoring and settings before an event.</p>
  <h4>No warranty</h4><p>The app is provided “as is”. Export backups regularly; MEIOCG is not liable for lost data or event outcomes.</p>
  <h4>Fair use</h4><p>Use the app for organizing and running games. Do not use it to misrepresent official Konami events or results.</p></div>`);
ACT.openDataInfo = () => {
  const n = ARCH.length + (T ? 1 : 0); const players = new Set([...(T ? T.players : []), ...ARCH.flatMap(a => a.players)].map(p => p.name.toLowerCase())).size;
  openSheet('Your data', `<dl class="kv"><dt>Tournaments</dt><dd>${n}</dd><dt>Player names</dt><dd>${players}</dd><dt>Wallpaper</dt><dd>${PREFS.wp.on ? 'Saved' : 'None'}</dd><dt>Storage used</dt><dd>${(Store.size() / 1024).toFixed(0)} KB</dd><dt>App version</dt><dd>${VERSION}</dd><dt>Location</dt><dd>This device only</dd><dt>Sent online</dt><dd>Nothing</dd></dl>`,
    `<button class="btn" data-act="backupAll">${ic('download', 'sm')} Backup</button><button class="btn danger" data-act="resetApp">${ic('trash', 'sm')} Delete all</button>`);
};
ACT.setPref = d => { PREFS[d.k] = d.v; persistPrefs(); applyPrefs(); if (sheetRefresh) sheetRefresh(); };
ON.prefColor = el => { PREFS[el.dataset.k] = el.value; persistPrefs(); applyPrefs(); if (sheetRefresh) sheetRefresh(); };
ON.prefRange = el => { PREFS[el.dataset.k] = +el.value; persistPrefs(); applyPrefs(); const lab = el.closest('label').querySelector('span'); if (lab) lab.textContent = `Panel opacity · ${el.value}%`; };
ON.prefBool = el => { PREFS[el.dataset.k] = el.checked; persistPrefs(); if (el.dataset.k === 'wake') syncTimers(); if (el.dataset.k === 'sound' && el.checked) { unlockAudio(); beep(1); } };
ON.prefWp = el => { PREFS.wp[el.dataset.k] = +el.value; persistPrefs(); applyWallpaperStyle(); const lab = el.closest('label').querySelector('span'); if (lab) lab.textContent = el.dataset.k === 'blur' ? `Blur · ${el.value}px` : `Visibility · ${el.value}%`; };
ACT.wpPos = d => { PREFS.wp.pos = d.v; persistPrefs(); applyWallpaperStyle(); if (sheetRefresh) sheetRefresh(); };
ACT.clearArchive = async () => { if (!await confirmDo('Clear the whole archive?', `${plural(ARCH.length, 'saved tournament')} will be deleted permanently. Export a backup first if you might need them.`, 'Delete all', true)) return; ARCH = []; persistArchive(); renderAll(); toast('Archive cleared'); };
ACT.resetApp = async () => {
  if (!await confirmDo('Reset the app?', 'The current tournament, the archive and all settings on this device will be erased. This cannot be undone.', 'Continue', true)) return;
  const v = await ask({ title: 'Type RESET to confirm', input: { value: '', placeholder: 'RESET' }, ok: 'Erase everything', danger: true });
  if (v !== 'RESET') return toast('Reset cancelled');
  Object.values(K).forEach(k => Store.del(k)); Store.set(LEGACY.migrated, true); try { await IDB.del('wallpaper'); } catch (e) { }
  location.reload();
};
ACT.restoreAuto = async () => {
  const a = Store.get(K.auto, null);
  if (!a || !a.t) return toast('No automatic backup yet');
  if (!await confirmDo('Restore auto-backup?', `Saved ${fmtDate(a.at)}: “${a.t.name}”, ${plural(a.t.rounds.length, 'round')}. The current state can be restored with Undo.`, 'Restore')) return;
  const before = T ? JSON.stringify(T) : null; T = normalizeT(a.t); if (before) UNDO.push({ label: 'Restore auto-backup', state: before }); persist(); closeSheet(); renderAll(); syncTimers(); toast('Auto-backup restored', { undo: !!before });
};
ACT.runAudit = () => {
  const res = E.audit(T); const ok = !res.issues.length;
  openSheet('Integrity check', `<div class="banner ${ok ? 'good' : 'bad'}" style="margin-top:0"><span class="b-ico">${ic(ok ? 'check' : 'alert')}</span><div class="b-body"><b>${ok ? 'All checks passed' : plural(res.issues.length, 'problem') + ' found'}</b><p>${T ? `${plural(T.players.length, 'player')} · ${plural(T.rounds.length, 'round')} · ${T.rounds.reduce((n, r) => n + r.matches.filter(m => m.result).length, 0)} results` : 'No active tournament'}</p></div></div>
    ${res.issues.map(x => `<div class="banner bad"><span class="b-ico">${ic('x')}</span><div class="b-body">${esc(x)}</div></div>`).join('')}
    ${res.warn.map(x => `<div class="banner warn"><span class="b-ico">${ic('info')}</span><div class="b-body">${esc(x)}</div></div>`).join('')}
    `);
};

/* ---------- appearance ---------- */
function applyPrefs() {
  const root = document.documentElement;
  root.dataset.theme = PREFS.theme === 'light' ? 'light' : 'dark';
  root.style.setProperty('--accent', PREFS.accent || '#2f8cff');
  root.style.setProperty('--accent-2', `color-mix(in srgb, ${PREFS.accent || '#2f8cff'} 62%, #ffffff)`);
  root.style.setProperty('--panel', clampN(+PREFS.panel || 90, 40, 100) + '%');
  if (PREFS.bg) { root.style.setProperty('--bg', PREFS.bg); root.style.setProperty('--bg-2', `color-mix(in srgb, ${PREFS.bg} 88%, ${PREFS.theme === 'light' ? '#ffffff' : '#1a2a44'})`); }
  else { root.style.removeProperty('--bg'); root.style.removeProperty('--bg-2'); }
  const meta = $('meta[name="theme-color"]'); if (meta) meta.content = PREFS.bg || (PREFS.theme === 'light' ? '#eaf0f8' : '#050a13');
  applyWallpaperStyle();
}
const IDB = {
  db: null,
  open() { return new Promise((res, rej) => { if (this.db) return res(this.db); if (!window.indexedDB) return rej(new Error('IndexedDB unavailable')); const r = indexedDB.open('meiocg-swiss', 1); r.onupgradeneeded = () => r.result.createObjectStore('kv'); r.onsuccess = () => { this.db = r.result; res(this.db); }; r.onerror = () => rej(r.error); }); },
  async run(mode, fn) { const db = await this.open(); return new Promise((res, rej) => { const tx = db.transaction('kv', mode); const st = tx.objectStore('kv'); const q = fn(st); tx.oncomplete = () => res(q && q.result); tx.onerror = () => rej(tx.error); }); },
  get(k) { return this.run('readonly', s => s.get(k)); }, set(k, v) { return this.run('readwrite', s => s.put(v, k)); }, del(k) { return this.run('readwrite', s => s.delete(k)); }
};
let wpURL = null;
async function loadWallpaper() {
  if (!PREFS.wp.on) { setWp(null); return; }
  try { const b = await IDB.get('wallpaper'); if (b) { setWp(URL.createObjectURL(b)); return; } } catch (e) { }
  const d = Store.get('meiocg.swiss.v3.wpdata', null); setWp(d || null);
}
function setWp(url) { if (wpURL && wpURL.startsWith('blob:')) URL.revokeObjectURL(wpURL); wpURL = url; applyWallpaperStyle(); }
function applyWallpaperStyle() {
  const wp = $('#wp'), sh = $('#wpShade');
  if (!wpURL || !PREFS.wp.on) { wp.classList.remove('on'); wp.style.backgroundImage = 'none'; sh.style.background = 'transparent'; return; }
  wp.style.backgroundImage = `url("${wpURL}")`; wp.style.backgroundPosition = PREFS.wp.pos || 'center';
  wp.style.filter = PREFS.wp.blur ? `blur(${PREFS.wp.blur}px)` : 'none'; wp.style.transform = PREFS.wp.blur ? 'scale(1.06)' : 'none';
  wp.classList.add('on');
  const a = clampN(0.95 - (PREFS.wp.strength / 100) * 0.85, 0.05, 0.95);
  sh.style.background = PREFS.theme === 'light' ? `rgba(234,240,248,${a})` : `rgba(5,10,19,${a})`;
}
ACT.pickWallpaper = () => { const f = $('#fileWallpaper'); f.value = ''; f.click(); };
$('#fileWallpaper').addEventListener('change', e => {
  const file = e.target.files && e.target.files[0]; if (!file) return;
  if (!/^image\//.test(file.type)) return toast('Please choose an image', { kind: 'bad' });
  const img = new Image(); const url = URL.createObjectURL(file);
  img.onload = async () => {
    const max = 1600, s = Math.min(1, max / Math.max(img.naturalWidth, img.naturalHeight));
    const cv = document.createElement('canvas'); cv.width = Math.round(img.naturalWidth * s); cv.height = Math.round(img.naturalHeight * s);
    cv.getContext('2d').drawImage(img, 0, 0, cv.width, cv.height); URL.revokeObjectURL(url);
    const blob = await new Promise(r => cv.toBlob(r, 'image/jpeg', 0.82));
    PREFS.wp.on = true; persistPrefs();
    try { await IDB.set('wallpaper', blob); Store.del('meiocg.swiss.v3.wpdata'); setWp(URL.createObjectURL(blob)); }
    catch (err) { const small = document.createElement('canvas'); const s2 = Math.min(1, 900 / Math.max(cv.width, cv.height)); small.width = cv.width * s2; small.height = cv.height * s2; small.getContext('2d').drawImage(cv, 0, 0, small.width, small.height); const d = small.toDataURL('image/jpeg', 0.6); if (!Store.set('meiocg.swiss.v3.wpdata', d)) toast('Wallpaper applied for this session only (storage full)'); setWp(d); }
    toast('Wallpaper applied', { kind: 'good' }); if (sheetRefresh) sheetRefresh();
  };
  img.onerror = () => toast('That image could not be read', { kind: 'bad' });
  img.src = url;
});
ACT.removeWallpaper = async () => { PREFS.wp.on = false; persistPrefs(); try { await IDB.del('wallpaper'); } catch (e) { } Store.del('meiocg.swiss.v3.wpdata'); setWp(null); toast('Wallpaper removed'); if (sheetRefresh) sheetRefresh(); };

/* ===================== boot ===================== */
window.addEventListener('error', e => { console.error(e.error || e.message); });
window.addEventListener('unhandledrejection', e => { console.error(e.reason); });
window.addEventListener('storage', e => { if (e.key === K.active) { T = normalizeT(Store.get(K.active, null)); renderAll(); syncTimers(); } });
function boot() {
  $('#brandImg').src = EMBLEM; $('#brandWord').src = WORDMARK; $('#favicon').href = EMBLEM;
  loadAll(); applyPrefs(); loadWallpaper();
  let start = PREFS.tab && PREFS.tab !== 'match' ? PREFS.tab : 'home';
  if (!T) start = 'home';
  renderChrome(); showTab(start); syncTimers();
  try { history.replaceState({ ds: 0 }, ''); } catch (e) { }
  window.DS = { E, get T() { return T; }, get ARCH() { return ARCH; }, ACT, renderAll, mutate, undo, VERSION };
}
boot();

})();
</script>
</body>
</html>
