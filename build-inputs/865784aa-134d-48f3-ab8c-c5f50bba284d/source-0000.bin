<!doctype html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#050a13">
<meta name="color-scheme" content="dark light">
<meta name="description" content="MEIOCG Project: Duel Synapse — Swiss Tournament Manager. OCG 2026 rules by default, works for any game, fully offline.">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<title>Swiss Tournament Manager · MEIOCG</title>
<link rel="icon" type="image/png" id="favicon" href="">
<style>
/* ==========================================================================
   MEIOCG · Project: Duel Synapse — Swiss Tournament Manager v3
   ========================================================================== */
:root{
  --accent:#2f8cff; --accent-2:#5cc1ff; --on-accent:#fff;
  --bg:#050a13; --bg-2:#0a1424;
  --surface:#0c1626; --surface-2:#112035; --surface-3:#16284200;
  --line:#1b2b45; --line-2:#26406a;
  --text:#e9f1ff; --muted:#8ca2c3; --faint:#5d7290;
  --good:#2fd08a; --bad:#ff5c74; --warn:#ffb547; --draw:#b892ff;
  --gold:#ffcf4d; --silver:#c9d6ea; --bronze:#e0995e;
  --panel:90%;
  --r:14px; --r-sm:10px;
  --header-h:60px; --nav-h:64px;
  --sat:env(safe-area-inset-top,0px); --sab:env(safe-area-inset-bottom,0px);
  --shadow:0 10px 30px rgba(0,0,0,.28);
  --font:Inter,"Segoe UI",system-ui,-apple-system,Roboto,"Noto Sans JP","Hiragino Sans",sans-serif;
  --mono:"JetBrains Mono","SFMono-Regular",ui-monospace,Menlo,Consolas,monospace;
  color-scheme:dark;
}
:root[data-theme="light"]{
  --bg:#eaf0f8; --bg-2:#f4f7fc; --surface:#ffffff; --surface-2:#f1f5fb;
  --line:#d6e0ee; --line-2:#b8c9e2; --text:#0d1a2d; --muted:#53668a; --faint:#8494ad;
  --shadow:0 8px 24px rgba(20,40,80,.08); color-scheme:light;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;height:100%;background:var(--bg);color:var(--text);font-family:var(--font);font-size:15px;line-height:1.4}
body{overflow:hidden;overscroll-behavior:none;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
button,input,select,textarea{font:inherit;color:inherit}
button{cursor:pointer;touch-action:manipulation}
[hidden]{display:none!important}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
svg.i{width:20px;height:20px;flex:0 0 auto;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;vertical-align:middle}
svg.i.sm{width:16px;height:16px}svg.i.lg{width:24px;height:24px}

/* ---------- backdrop / wallpaper ---------- */
#wp,#wpShade{position:fixed;inset:0;pointer-events:none;z-index:0}
#wp{background-size:cover;background-position:center;opacity:0;transition:opacity .3s}
#wp.on{opacity:1}
.app-bg{position:fixed;inset:0;z-index:0;pointer-events:none;
  background:radial-gradient(1200px 600px at 85% -10%,color-mix(in srgb,var(--accent) 16%,transparent),transparent 60%),
             radial-gradient(900px 500px at -10% 110%,color-mix(in srgb,var(--accent-2) 9%,transparent),transparent 60%),var(--bg)}
:root[data-theme="light"] .app-bg{background:radial-gradient(1000px 500px at 90% -10%,color-mix(in srgb,var(--accent) 12%,transparent),transparent 60%),var(--bg)}

/* ---------- shell ---------- */
.shell{position:fixed;inset:0;display:grid;grid-template-rows:calc(var(--header-h) + var(--sat)) 1fr calc(var(--nav-h) + var(--sab));z-index:1}
.topbar{display:flex;align-items:center;gap:10px;padding:var(--sat) 12px 0;border-bottom:1px solid var(--line);
  background:color-mix(in srgb,var(--bg-2) var(--panel),transparent);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px)}
.brand{display:flex;align-items:center;gap:10px;min-width:0;background:none;border:0;padding:0;text-align:left}
.brand img{width:40px;height:40px;object-fit:contain;filter:drop-shadow(0 0 8px color-mix(in srgb,var(--accent) 45%,transparent))}
.brand .wordmark{display:block;height:20px;width:auto}
.wordmark{filter:drop-shadow(0 0 6px color-mix(in srgb,var(--accent) 35%,transparent))}
:root[data-theme="light"] .wordmark{filter:none}
.identity .id-word{display:block;height:28px;width:auto;margin-bottom:6px}
.identity h1{margin:0;line-height:0}
.id-title{display:block;width:min(100%,250px);height:auto}
.af-title{width:150px;height:auto}
.brand small{display:block;font-size:11px;color:var(--muted);margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:46vw}
.topbar .spacer{flex:1}
.status-chip{display:inline-flex;align-items:center;gap:6px;height:30px;padding:0 10px;border-radius:999px;border:1px solid var(--line-2);font-size:12px;font-weight:800;white-space:nowrap;background:var(--surface-2);font-variant-numeric:tabular-nums}
.status-chip.live{border-color:color-mix(in srgb,var(--good) 55%,transparent);color:var(--good)}
.status-chip.warn{border-color:color-mix(in srgb,var(--warn) 55%,transparent);color:var(--warn)}
.status-chip.bad{border-color:color-mix(in srgb,var(--bad) 55%,transparent);color:var(--bad)}
.icon-btn{width:42px;height:42px;display:grid;place-items:center;border-radius:12px;border:1px solid var(--line);background:var(--surface-2);color:var(--text);padding:0}
.icon-btn:active{transform:scale(.96)}
main#view{overflow-y:auto;overflow-x:hidden;-webkit-overflow-scrolling:touch;overscroll-behavior-y:contain;scroll-behavior:smooth}
.page{max-width:820px;margin:0 auto;padding:14px 14px 28px}
.screen{display:none;animation:fade .18s ease}
.screen.active{display:block}
@keyframes fade{from{opacity:.4;transform:translateY(4px)}to{opacity:1;transform:none}}

.tabbar{display:grid;grid-template-columns:repeat(5,1fr);padding-bottom:var(--sab);border-top:1px solid var(--line);
  background:color-mix(in srgb,var(--bg-2) var(--panel),transparent);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px)}
.tabbar button{border:0;background:none;color:var(--muted);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;font-size:11px;font-weight:700;position:relative;min-height:var(--nav-h)}
.tabbar button svg{width:22px;height:22px}
.tabbar button.active{color:var(--accent-2)}
.tabbar button.active::before{content:"";position:absolute;top:0;left:28%;right:28%;height:3px;border-radius:0 0 3px 3px;background:var(--accent)}
.tabbar .dot{position:absolute;top:10px;right:calc(50% - 18px);width:8px;height:8px;border-radius:50%;background:var(--good);box-shadow:0 0 8px var(--good)}

@media (min-width:980px){
  .shell{grid-template-columns:96px 1fr;grid-template-rows:calc(var(--header-h) + var(--sat)) 1fr}
  .topbar{grid-column:1/-1}
  .tabbar{grid-row:2;grid-column:1;grid-template-columns:1fr;grid-auto-rows:78px;align-content:start;border-top:0;border-right:1px solid var(--line);padding-top:10px}
  .tabbar button.active::before{top:18%;bottom:18%;left:0;right:auto;width:3px;height:auto;border-radius:0 3px 3px 0}
  main#view{grid-row:2;grid-column:2}
}

/* ---------- typography / layout helpers ---------- */
h1,h2,h3,h4{margin:0;line-height:1.2}
.page-head{display:flex;align-items:flex-end;justify-content:space-between;gap:10px;margin:2px 2px 12px}
.page-head h1{font-size:22px;font-weight:850;display:flex;align-items:center;gap:8px}
.page-head p{margin:3px 0 0;color:var(--muted);font-size:13px}
.muted{color:var(--muted)}.faint{color:var(--faint)}.small{font-size:12.5px}.tiny{font-size:11px}
.num{font-variant-numeric:tabular-nums}
.row{display:flex;align-items:center;gap:8px}.row.wrap{flex-wrap:wrap}.row.between{justify-content:space-between}.grow{flex:1;min-width:0}
.stack>*+*{margin-top:10px}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.ellipsis{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
hr.sep{border:0;border-top:1px solid var(--line);margin:14px 0}

/* ---------- cards ---------- */
.card{background:color-mix(in srgb,var(--surface) var(--panel),transparent);border:1px solid var(--line);border-radius:var(--r);padding:14px;box-shadow:var(--shadow);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}
.card+.card,.card+.section-title,.section-title+.card{margin-top:12px}
.card.glow{border-color:color-mix(in srgb,var(--accent) 45%,var(--line));background:linear-gradient(160deg,color-mix(in srgb,var(--accent) 12%,var(--surface)),color-mix(in srgb,var(--surface) var(--panel),transparent) 70%)}
.card-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:10px}
.card-head h3{font-size:15px;font-weight:800;display:flex;align-items:center;gap:8px}
.section-title{font-size:12px;font-weight:800;letter-spacing:1px;text-transform:uppercase;color:var(--muted);margin:18px 4px 8px}

/* ---------- buttons ---------- */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:0 16px;border-radius:12px;border:1px solid var(--line-2);background:var(--surface-2);color:var(--text);font-weight:750;font-size:14px;white-space:nowrap;transition:transform .08s,filter .15s,border-color .15s}
.btn:active{transform:scale(.97)}
.btn:disabled,.btn[aria-disabled="true"]{opacity:.45;pointer-events:none}
.btn.primary{background:linear-gradient(180deg,color-mix(in srgb,var(--accent) 92%,#fff),var(--accent));border-color:var(--accent);color:var(--on-accent);box-shadow:0 8px 20px color-mix(in srgb,var(--accent) 30%,transparent)}
.btn.good{background:color-mix(in srgb,var(--good) 18%,var(--surface-2));border-color:color-mix(in srgb,var(--good) 50%,transparent);color:var(--good)}
.btn.danger{background:color-mix(in srgb,var(--bad) 14%,var(--surface-2));border-color:color-mix(in srgb,var(--bad) 45%,transparent);color:var(--bad)}
.btn.warn{background:color-mix(in srgb,var(--warn) 14%,var(--surface-2));border-color:color-mix(in srgb,var(--warn) 45%,transparent);color:var(--warn)}
.btn.ghost{background:transparent;border-color:transparent;color:var(--muted)}
.btn.sm{min-height:36px;padding:0 12px;font-size:13px;border-radius:10px}
.btn.block{width:100%}
.btn.lg{min-height:56px;font-size:16px;border-radius:14px}
.btn-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.btn-grid .full{grid-column:1/-1}

.cta{display:flex;align-items:center;gap:14px;width:100%;text-align:left;padding:14px 16px;border-radius:16px;border:1px solid var(--accent);color:#fff;
  background:linear-gradient(135deg,color-mix(in srgb,var(--accent) 95%,#fff 5%),color-mix(in srgb,var(--accent) 70%,#000));box-shadow:0 12px 28px color-mix(in srgb,var(--accent) 30%,transparent)}
.cta .cta-ico{width:44px;height:44px;border-radius:12px;background:rgba(255,255,255,.16);display:grid;place-items:center;flex:0 0 auto}
.cta b{display:block;font-size:16px}.cta small{display:block;opacity:.85;font-size:12.5px;margin-top:2px}
.cta .chev{margin-left:auto;opacity:.8}
.cta.alt{background:linear-gradient(135deg,color-mix(in srgb,var(--good) 80%,#fff 0%),color-mix(in srgb,var(--good) 55%,#000));border-color:var(--good)}

.tiles{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:12px}
.tile{display:flex;align-items:flex-start;gap:10px;text-align:left;padding:13px;border-radius:14px;border:1px solid var(--line);background:color-mix(in srgb,var(--surface) var(--panel),transparent);min-height:72px}
.tile .t-ico{width:36px;height:36px;border-radius:10px;display:grid;place-items:center;flex:0 0 auto;background:color-mix(in srgb,var(--c,var(--accent)) 18%,transparent);color:var(--c,var(--accent-2))}
.tile b{display:block;font-size:14px}.tile small{display:block;color:var(--muted);font-size:12px;margin-top:2px}
.tile:active{transform:scale(.98)}

/* ---------- chips / pills ---------- */
.pill{display:inline-flex;align-items:center;gap:5px;height:24px;padding:0 9px;border-radius:999px;font-size:11px;font-weight:850;letter-spacing:.3px;border:1px solid var(--line-2);background:var(--surface-2);color:var(--muted);white-space:nowrap}
.pill.good{color:var(--good);border-color:color-mix(in srgb,var(--good) 40%,transparent);background:color-mix(in srgb,var(--good) 10%,transparent)}
.pill.bad{color:var(--bad);border-color:color-mix(in srgb,var(--bad) 40%,transparent);background:color-mix(in srgb,var(--bad) 10%,transparent)}
.pill.warn{color:var(--warn);border-color:color-mix(in srgb,var(--warn) 40%,transparent);background:color-mix(in srgb,var(--warn) 10%,transparent)}
.pill.info{color:var(--accent-2);border-color:color-mix(in srgb,var(--accent) 45%,transparent);background:color-mix(in srgb,var(--accent) 12%,transparent)}
.pill.draw{color:var(--draw);border-color:color-mix(in srgb,var(--draw) 40%,transparent);background:color-mix(in srgb,var(--draw) 10%,transparent)}
.seg{display:flex;gap:4px;padding:4px;border-radius:12px;background:var(--surface-2);border:1px solid var(--line)}
.seg button{flex:1;min-height:36px;border:0;border-radius:9px;background:none;color:var(--muted);font-weight:750;font-size:13px;white-space:nowrap;padding:0 10px}
.seg button.on{background:var(--accent);color:#fff}

/* ---------- forms ---------- */
label.f{display:block}
label.f>span{display:block;font-size:12px;font-weight:700;color:var(--muted);margin:0 0 6px 2px}
.input,select.input,textarea.input{width:100%;min-height:46px;padding:0 13px;border-radius:12px;border:1px solid var(--line-2);background:var(--bg-2);color:var(--text);outline:none;transition:border-color .15s,box-shadow .15s}
textarea.input{padding:12px 13px;min-height:140px;resize:vertical;line-height:1.5}
.input:focus{border-color:var(--accent);box-shadow:0 0 0 3px color-mix(in srgb,var(--accent) 22%,transparent)}
.input.sm{min-height:38px;border-radius:10px}
.search{position:relative}.search svg{position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--faint)}.search .input{padding-left:40px}
.switch{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 0;border-bottom:1px solid var(--line)}
.switch:last-child{border-bottom:0}
.switch b{display:block;font-size:14px}.switch small{display:block;color:var(--muted);font-size:12px;margin-top:2px}
.toggle{position:relative;width:50px;height:30px;flex:0 0 auto}
.toggle input{position:absolute;opacity:0;inset:0;margin:0;cursor:pointer;z-index:1}
.toggle span{position:absolute;inset:0;border-radius:999px;background:var(--line-2);transition:.2s}
.toggle span::after{content:"";position:absolute;top:3px;left:3px;width:24px;height:24px;border-radius:50%;background:#fff;transition:.2s}
.toggle input:checked+span{background:var(--accent)}
.toggle input:checked+span::after{transform:translateX(20px)}
input[type=range]{width:100%;accent-color:var(--accent)}
input[type=color]{width:46px;height:40px;border:1px solid var(--line-2);border-radius:10px;padding:2px;background:var(--bg-2)}
.stepper{display:flex;align-items:center;border:1px solid var(--line-2);border-radius:12px;overflow:hidden;background:var(--bg-2)}
.stepper button{width:44px;height:44px;border:0;background:var(--surface-2);font-size:20px;font-weight:700}
.stepper input{width:100%;min-width:0;height:44px;border:0;background:none;text-align:center;font-weight:800;outline:none}

/* ---------- home ---------- */
.identity{display:flex;align-items:center;gap:14px;padding:6px 2px 16px}
.identity>img{width:78px;height:78px;object-fit:contain;filter:drop-shadow(0 0 14px color-mix(in srgb,var(--accent) 55%,transparent))}
.identity .k{font-size:12px;font-weight:900;letter-spacing:2.4px;color:var(--accent-2)}
.identity h1{margin:0;line-height:0}
.identity p{margin:0;color:var(--muted);font-size:13px}
.event-name{font-size:19px;font-weight:850;margin:2px 0 4px;word-break:break-word}
.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:12px}
.kpi{padding:10px 8px;border-radius:12px;background:var(--bg-2);border:1px solid var(--line);text-align:center;min-width:0}
.kpi b{display:block;font-size:19px;font-weight:850;font-variant-numeric:tabular-nums}
.kpi span{display:block;font-size:11px;color:var(--muted);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.progress{height:6px;border-radius:999px;background:var(--line);overflow:hidden}
.progress>i{display:block;height:100%;background:linear-gradient(90deg,var(--accent),var(--accent-2));border-radius:inherit;transition:width .3s}

/* ---------- players ---------- */
.lock-banner{display:flex;align-items:center;gap:12px;padding:12px 14px;border-radius:14px;border:1px solid}
.lock-banner.open{border-color:color-mix(in srgb,var(--good) 40%,transparent);background:color-mix(in srgb,var(--good) 8%,transparent)}
.lock-banner.locked{border-color:color-mix(in srgb,var(--accent) 45%,transparent);background:color-mix(in srgb,var(--accent) 10%,transparent)}
.lock-banner .ico{width:40px;height:40px;border-radius:12px;display:grid;place-items:center;flex:0 0 auto}
.lock-banner.open .ico{background:color-mix(in srgb,var(--good) 18%,transparent);color:var(--good)}
.lock-banner.locked .ico{background:color-mix(in srgb,var(--accent) 20%,transparent);color:var(--accent-2)}
.lock-banner b{display:block}.lock-banner small{display:block;color:var(--muted);font-size:12.5px}
.plist{margin-top:10px}
.prow{display:flex;align-items:center;gap:10px;padding:10px 12px;border-bottom:1px solid var(--line);min-height:58px}
.prow:last-child{border-bottom:0}
.prow .seedn{width:26px;text-align:center;color:var(--faint);font-size:13px;font-weight:700;font-variant-numeric:tabular-nums}
.avatar{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;font-weight:850;font-size:14px;flex:0 0 auto;color:#fff;background:hsl(var(--h,215) 55% 38%)}
.prow .pmain{flex:1;min-width:0;background:none;border:0;padding:0;text-align:left}
.prow .pmain b{display:block;font-size:15px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.prow .pmain small{display:block;font-size:12px;color:var(--muted)}
.prow.out .pmain b{color:var(--muted);text-decoration:line-through;text-decoration-thickness:1px}
.prow .acts{display:flex;gap:6px}
.mini-btn{width:36px;height:36px;border-radius:10px;border:1px solid var(--line-2);background:var(--surface-2);display:grid;place-items:center;padding:0;color:var(--text)}
.mini-btn.edit{color:var(--accent-2)}.mini-btn.del{color:var(--bad)}
.add-row{display:flex;gap:8px}
.add-row .input{flex:1}

/* ---------- round / timer ---------- */
.timer-card{text-align:center;padding:16px}
.timer-label{font-size:11px;font-weight:850;letter-spacing:1.6px;color:var(--muted)}
.timer{font-family:var(--mono);font-size:clamp(52px,17vw,84px);font-weight:800;letter-spacing:2px;line-height:1.05;margin:4px 0 2px;font-variant-numeric:tabular-nums}
.timer.warn{color:var(--warn)}.timer.bad{color:var(--bad);animation:pulse 1s infinite}.timer.idle{color:var(--muted)}
@keyframes pulse{50%{opacity:.55}}
.timer-sub{font-size:12.5px;color:var(--muted)}
.timer-ctrls{display:grid;grid-template-columns:1fr 1fr 58px 58px;gap:8px;margin-top:12px}
.banner{display:flex;gap:12px;align-items:flex-start;padding:12px 14px;border-radius:14px;border:1px solid;margin-top:12px}
.banner .b-ico{flex:0 0 auto;margin-top:1px}
.banner b{display:block}.banner p{margin:3px 0 0;font-size:13px;color:var(--muted)}
.banner.warn{border-color:color-mix(in srgb,var(--warn) 45%,transparent);background:color-mix(in srgb,var(--warn) 9%,transparent);color:var(--warn)}
.banner.bad{border-color:color-mix(in srgb,var(--bad) 45%,transparent);background:color-mix(in srgb,var(--bad) 9%,transparent);color:var(--bad)}
.banner.info{border-color:color-mix(in srgb,var(--accent) 40%,transparent);background:color-mix(in srgb,var(--accent) 8%,transparent);color:var(--accent-2)}
.banner.good{border-color:color-mix(in srgb,var(--good) 40%,transparent);background:color-mix(in srgb,var(--good) 8%,transparent);color:var(--good)}
.banner .b-body{flex:1;min-width:0}.banner .b-body .btn{margin-top:10px}
.mlist{display:grid;gap:8px;margin-top:10px}
.mcard{display:grid;grid-template-columns:auto 1fr;gap:10px;align-items:center;width:100%;text-align:left;padding:10px 12px;border-radius:14px;border:1px solid var(--line);background:color-mix(in srgb,var(--surface) var(--panel),transparent);color:var(--text)}
.mcard.done{border-color:color-mix(in srgb,var(--good) 28%,var(--line))}
.mcard.hl{border-color:var(--accent);box-shadow:0 0 0 3px color-mix(in srgb,var(--accent) 22%,transparent)}
.tno{width:46px;height:46px;border-radius:12px;display:grid;place-items:center;text-align:center;background:color-mix(in srgb,var(--accent) 14%,transparent);border:1px solid color-mix(in srgb,var(--accent) 35%,transparent);color:var(--accent-2);line-height:1}
.tno small{display:block;font-size:9px;font-weight:800;letter-spacing:.8px;opacity:.85}
.tno b{display:block;font-size:18px;font-weight:900;margin-top:2px}
.mcard.done .tno{background:color-mix(in srgb,var(--good) 12%,transparent);border-color:color-mix(in srgb,var(--good) 35%,transparent);color:var(--good)}
.vs{display:grid;grid-template-columns:1fr auto 1fr;gap:8px;align-items:center;min-width:0}
.side{min-width:0}
.side b{display:block;font-size:14.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.side small{display:block;font-size:11.5px;color:var(--muted)}
.side.r{text-align:right}
.side.win b{color:var(--good)}.side.lose b{color:var(--muted)}
.score{font-family:var(--mono);font-weight:850;font-size:17px;text-align:center;min-width:50px;font-variant-numeric:tabular-nums}
.score small{display:block;font-family:var(--font);font-size:10px;font-weight:800;letter-spacing:.4px;color:var(--muted)}
.score.dl small{color:var(--bad)}.score.dr small{color:var(--draw)}
.swap-chip{border:1px dashed var(--line-2);border-radius:10px;padding:6px 8px;background:var(--bg-2)}
.swap-chip.sel{border-style:solid;border-color:var(--accent);background:color-mix(in srgb,var(--accent) 18%,transparent)}
.sticky-cta{position:sticky;bottom:0;padding:12px 0 2px;background:linear-gradient(to top,var(--bg) 60%,transparent);margin-top:8px}

/* ---------- standings ---------- */
.srow{display:grid;grid-template-columns:38px 1fr auto;gap:10px;align-items:center;padding:10px 12px;border-bottom:1px solid var(--line);width:100%;text-align:left;background:none;border-left:0;border-right:0;border-top:0;color:var(--text)}
.srow:last-child{border-bottom:0}
.rank{width:34px;height:34px;border-radius:10px;display:grid;place-items:center;font-weight:900;font-size:14px;background:var(--surface-2);border:1px solid var(--line);font-variant-numeric:tabular-nums}
.rank.r1{background:color-mix(in srgb,var(--gold) 22%,transparent);border-color:color-mix(in srgb,var(--gold) 60%,transparent);color:var(--gold)}
.rank.r2{background:color-mix(in srgb,var(--silver) 16%,transparent);border-color:color-mix(in srgb,var(--silver) 50%,transparent);color:var(--silver)}
.rank.r3{background:color-mix(in srgb,var(--bronze) 18%,transparent);border-color:color-mix(in srgb,var(--bronze) 55%,transparent);color:var(--bronze)}
.srow .who{min-width:0}
.srow .who b{display:flex;align-items:center;gap:6px;font-size:15px;min-width:0}
.srow .who b .nm{min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.srow .who b .pill{flex:0 0 auto;height:20px;padding:0 7px;font-size:10px}
.srow .who small{display:block;font-size:11.5px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-variant-numeric:tabular-nums}
.srow .pts{text-align:right}
.srow .pts b{display:block;font-size:19px;font-weight:900;font-variant-numeric:tabular-nums}
.srow .pts small{display:block;font-size:11px;color:var(--muted);font-variant-numeric:tabular-nums}
.thead{display:grid;grid-template-columns:38px 1fr auto;gap:10px;padding:4px 12px 8px;font-size:11px;font-weight:800;letter-spacing:.8px;color:var(--faint);text-transform:uppercase;border-bottom:1px solid var(--line)}
.tb-legend{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}
.bracket{display:flex;gap:12px;overflow-x:auto;padding-bottom:6px}
.bcol{min-width:200px;flex:1}
.bcol h4{font-size:12px;letter-spacing:1px;text-transform:uppercase;color:var(--muted);margin:0 0 8px}
.bm{border:1px solid var(--line);border-radius:12px;overflow:hidden;margin-bottom:10px;background:var(--bg-2)}
.bm div{display:flex;justify-content:space-between;gap:8px;padding:8px 10px;font-size:13.5px}
.bm div+div{border-top:1px solid var(--line)}
.bm .w{color:var(--good);font-weight:800}.bm .l{color:var(--faint)}

/* ---------- history ---------- */
details.rnd{border:1px solid var(--line);border-radius:14px;background:color-mix(in srgb,var(--surface) var(--panel),transparent);overflow:hidden}
details.rnd+details.rnd{margin-top:8px}
details.rnd summary{list-style:none;display:flex;align-items:center;gap:10px;padding:13px 14px;cursor:pointer;font-weight:800}
details.rnd summary::-webkit-details-marker{display:none}
details.rnd summary .chev{margin-left:auto;transition:transform .2s;color:var(--muted)}
details.rnd[open] summary .chev{transform:rotate(90deg)}
.hrow{display:grid;grid-template-columns:34px 1fr auto;gap:10px;align-items:center;padding:9px 14px;border-top:1px solid var(--line);font-size:13.5px}
.hrow .t{color:var(--faint);font-weight:800;font-variant-numeric:tabular-nums}
.hrow .res{font-size:12px;text-align:right}
.arch{display:flex;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid var(--line)}
.arch:last-child{border-bottom:0}
.arch .a-ico{width:42px;height:42px;border-radius:12px;display:grid;place-items:center;background:color-mix(in srgb,var(--gold) 14%,transparent);color:var(--gold);flex:0 0 auto}
.log{font-family:var(--mono);font-size:12px;color:var(--muted);max-height:420px;overflow:auto}
.log div{padding:6px 0;border-bottom:1px dashed var(--line)}

/* ---------- empty ---------- */
.empty{text-align:center;padding:34px 16px;color:var(--muted)}
.empty .e-ico{width:64px;height:64px;margin:0 auto 12px;border-radius:18px;display:grid;place-items:center;background:color-mix(in srgb,var(--accent) 12%,transparent);color:var(--accent-2)}
.empty b{display:block;color:var(--text);font-size:16px;margin-bottom:4px}
.empty .btn{margin-top:14px}

/* ---------- sheet / dialog / toast ---------- */
.layer{position:fixed;inset:0;z-index:50;display:flex;align-items:flex-end;justify-content:center}
.scrim{position:absolute;inset:0;background:rgba(2,6,14,.62);backdrop-filter:blur(2px);animation:fadeIn .2s}
:root[data-theme="light"] .scrim{background:rgba(20,30,50,.35)}
@keyframes fadeIn{from{opacity:0}}
.sheet{position:relative;width:100%;max-width:640px;max-height:calc(100dvh - 24px - var(--sat));display:flex;flex-direction:column;background:var(--surface);border:1px solid var(--line-2);border-bottom:0;border-radius:22px 22px 0 0;box-shadow:0 -20px 60px rgba(0,0,0,.45);animation:up .24s cubic-bezier(.2,.9,.3,1);padding-bottom:var(--sab)}
@keyframes up{from{transform:translateY(40px);opacity:.3}}
.sheet::before{content:"";position:absolute;top:7px;left:50%;width:42px;height:4px;margin-left:-21px;border-radius:4px;background:var(--line-2)}
.sheet-head{display:flex;align-items:center;gap:10px;padding:18px 16px 10px;border-bottom:1px solid var(--line)}
.sheet-head h2{font-size:17px;font-weight:850;flex:1;min-width:0}
.sheet-head p{margin:2px 0 0;font-size:12.5px;color:var(--muted);font-weight:500}
.sheet-body{overflow-y:auto;padding:14px 16px 18px;-webkit-overflow-scrolling:touch;overscroll-behavior:contain}
.sheet-foot{display:flex;gap:8px;padding:12px 16px;border-top:1px solid var(--line)}
.sheet-foot:empty{display:none}
.sheet-foot .btn{flex:1}
@media (min-width:700px){.layer{align-items:center}.sheet{border-radius:20px;border-bottom:1px solid var(--line-2);max-height:88dvh}.sheet::before{display:none}}
#dialog{z-index:70;align-items:center;padding:16px}
.dialog{position:relative;width:100%;max-width:420px;background:var(--surface);border:1px solid var(--line-2);border-radius:18px;padding:18px;box-shadow:0 30px 80px rgba(0,0,0,.5);animation:pop .18s ease}
@keyframes pop{from{transform:scale(.95);opacity:0}}
.dialog h3{font-size:17px;margin-bottom:6px}
.dialog p{margin:0;color:var(--muted);font-size:14px;white-space:pre-line}
.dialog .row{margin-top:16px}.dialog .row .btn{flex:1}
.toasts{position:fixed;left:0;right:0;bottom:calc(var(--nav-h) + var(--sab) + 12px);z-index:90;display:flex;flex-direction:column;align-items:center;gap:8px;pointer-events:none;padding:0 12px}
.toast{pointer-events:auto;display:flex;align-items:center;gap:12px;max-width:520px;padding:11px 12px 11px 16px;border-radius:14px;background:#eef4ff;color:#0a1426;font-weight:700;font-size:14px;box-shadow:0 12px 30px rgba(0,0,0,.35);animation:up .2s}
.toast.bad{background:#ffe3e7;color:#5a0a17}.toast.good{background:#dcfbea;color:#06371f}
.toast button{border:0;background:#0a1426;color:#fff;border-radius:10px;padding:7px 12px;font-weight:800;font-size:13px}
@media (min-width:980px){.toasts{bottom:24px}}

/* ---------- result sheet ---------- */
.vs-head{display:grid;grid-template-columns:1fr auto 1fr;gap:10px;align-items:center;text-align:center;padding:4px 0 12px}
.vs-head b{display:block;font-size:16px;word-break:break-word}
.vs-head small{display:block;color:var(--muted);font-size:12px}
.vs-head .big{font-family:var(--mono);font-size:30px;font-weight:900;font-variant-numeric:tabular-nums}
.verdict{text-align:center;padding:10px;border-radius:12px;background:var(--bg-2);border:1px solid var(--line);font-weight:800;font-size:14px}
.verdict.done{color:var(--good);border-color:color-mix(in srgb,var(--good) 40%,transparent)}
.verdict.dl{color:var(--bad);border-color:color-mix(in srgb,var(--bad) 40%,transparent)}
.verdict.dr{color:var(--draw);border-color:color-mix(in srgb,var(--draw) 40%,transparent)}
.qgrid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.qbtn{min-height:58px;border-radius:12px;border:1px solid var(--line-2);background:var(--surface-2);padding:8px 10px;text-align:center}
.qbtn b{display:block;font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.qbtn small{display:block;font-family:var(--mono);font-size:13px;color:var(--muted);margin-top:2px}
.qbtn.a{border-color:color-mix(in srgb,var(--accent) 45%,transparent)}
.qbtn.b{border-color:color-mix(in srgb,var(--accent-2) 40%,transparent)}
.qbtn.d{border-color:color-mix(in srgb,var(--draw) 45%,transparent);color:var(--draw)}
.qbtn.x{border-color:color-mix(in srgb,var(--bad) 45%,transparent);color:var(--bad)}
.qbtn.full{grid-column:1/-1}
.qbtn.cur{outline:2px solid var(--good);outline-offset:1px}
.duels{display:flex;gap:6px;flex-wrap:wrap}
.duel{flex:1;min-width:84px;padding:8px;border-radius:10px;border:1px solid var(--line);background:var(--bg-2);text-align:center}
.duel small{display:block;font-size:10px;font-weight:800;letter-spacing:.6px;color:var(--faint)}
.duel b{display:block;font-size:13px;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.duel.A b,.duel.B b{color:var(--good)}.duel.D b{color:var(--draw)}.duel.next{border-style:dashed;border-color:var(--accent)}
.steps{counter-reset:s}
.step{position:relative;padding:12px 12px 12px 46px;border:1px solid var(--line);border-radius:12px;background:var(--bg-2);margin-top:8px;width:100%;text-align:left;color:var(--text)}
.step::before{counter-increment:s;content:counter(s);position:absolute;left:12px;top:12px;width:24px;height:24px;border-radius:50%;display:grid;place-items:center;font-size:12px;font-weight:900;background:color-mix(in srgb,var(--accent) 22%,transparent);color:var(--accent-2)}
.step b{display:block}.step small{display:block;color:var(--muted);font-size:12.5px;margin-top:2px}
button.step:active{transform:scale(.99)}
.rule-quote{font-size:12.5px;color:var(--muted);border-left:3px solid var(--accent);padding:6px 10px;margin:10px 0;background:var(--bg-2);border-radius:0 8px 8px 0}

/* ---------- match control ---------- */
.mc-top{display:flex;align-items:center;gap:10px;margin-bottom:10px}
.lp-wrap{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.lp{border:1px solid var(--line);border-radius:16px;padding:12px;text-align:center;background:color-mix(in srgb,var(--surface) var(--panel),transparent);cursor:pointer;transition:border-color .15s,box-shadow .15s;color:var(--text);width:100%}
.lp.on{border-color:var(--accent);box-shadow:0 0 0 3px color-mix(in srgb,var(--accent) 22%,transparent)}
.lp .nm{font-size:13px;font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.lp .val{font-family:var(--mono);font-size:clamp(34px,11vw,52px);font-weight:900;font-variant-numeric:tabular-nums;line-height:1.1;margin:4px 0}
.lp .val.low{color:var(--bad)}
.lp .dw{font-size:11px;color:var(--muted);font-weight:700}
.keypad{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-top:10px}
.keypad button{min-height:50px;border-radius:12px;border:1px solid var(--line);background:var(--surface-2);font-size:18px;font-weight:800}
.keypad .op{background:color-mix(in srgb,var(--accent) 16%,var(--surface-2));color:var(--accent-2)}
.keypad .minus{background:color-mix(in srgb,var(--bad) 16%,var(--surface-2));color:var(--bad)}
.keypad .plus{background:color-mix(in srgb,var(--good) 14%,var(--surface-2));color:var(--good)}
.lp-display{margin-top:10px;font-family:var(--mono);font-size:26px;font-weight:800;text-align:right;padding:8px 14px;border-radius:12px;background:var(--bg-2);border:1px solid var(--line);min-height:48px;font-variant-numeric:tabular-nums}
.chips{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}
.chips{flex-wrap:nowrap}.chips button{flex:1;min-width:0;padding:0 2px;min-height:38px;border-radius:10px;border:1px solid var(--line);background:var(--surface-2);font-weight:800;font-size:13px;font-variant-numeric:tabular-nums}
.chips .neg{color:var(--bad)}.chips .pos{color:var(--good)}
.turnbar{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 12px;border-radius:14px;border:1px solid var(--line);background:var(--bg-2);margin-top:10px}
.turnbar b{font-size:18px;font-variant-numeric:tabular-nums}
.turnbar.extra{border-color:var(--warn);color:var(--warn)}
.lplog{font-family:var(--mono);font-size:12px;color:var(--muted);max-height:120px;overflow:auto;margin-top:8px}
.coin{width:120px;height:120px;margin:10px auto;border-radius:50%;display:grid;place-items:center;font-size:20px;font-weight:900;background:radial-gradient(circle at 35% 30%,#ffe9a6,#d6a531 60%,#9a7016);color:#4a3000;box-shadow:0 10px 30px rgba(0,0,0,.35)}
.coin.spin{animation:spin .6s ease}
@keyframes spin{50%{transform:rotateY(540deg) scale(1.1)}}
.die{width:96px;height:96px;margin:10px auto;border-radius:20px;display:grid;place-items:center;font-size:44px;font-weight:900;background:#f4f7ff;color:#0a1426;box-shadow:0 10px 30px rgba(0,0,0,.35)}
.die.spin{animation:roll .5s ease}
@keyframes roll{50%{transform:rotate(200deg) scale(.9)}}

/* ---------- presets / rules editor ---------- */
.presets{display:grid;gap:8px}
.preset{display:block;width:100%;text-align:left;padding:12px 14px;border-radius:14px;border:1px solid var(--line-2);background:var(--bg-2);color:var(--text)}
.preset.on{border-color:var(--accent);background:color-mix(in srgb,var(--accent) 12%,var(--bg-2));box-shadow:0 0 0 3px color-mix(in srgb,var(--accent) 18%,transparent)}
.preset b{font-size:15px}.preset small{display:block;color:var(--muted);font-size:12.5px;margin-top:4px;line-height:1.45}
.preset .pill{margin-left:8px;vertical-align:2px}
.fields{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.fields .full{grid-column:1/-1}
.tbl{display:grid;gap:6px}
.tbi{display:flex;align-items:center;gap:8px;padding:8px 10px;border:1px solid var(--line);border-radius:12px;background:var(--bg-2)}
.tbi .grow b{display:block;font-size:13.5px}.tbi .grow small{display:block;font-size:11.5px;color:var(--muted)}
.tbi.off{opacity:.5}
.picker{max-height:50dvh;overflow:auto;border:1px solid var(--line);border-radius:12px}
.pick{display:flex;align-items:center;gap:12px;padding:11px 12px;border-bottom:1px solid var(--line)}
.pick:last-child{border-bottom:0}
.pick input{width:20px;height:20px;accent-color:var(--accent)}
.pick b{display:block;font-size:14px}.pick small{display:block;color:var(--muted);font-size:12px}
.swatches{display:flex;gap:8px;flex-wrap:wrap}
.swatch{width:40px;height:40px;border-radius:12px;border:2px solid transparent;padding:0}
.swatch.on{border-color:var(--text);box-shadow:0 0 0 2px var(--accent)}
.img-preview{width:100%;border-radius:12px;border:1px solid var(--line);display:block}
.list-row{display:flex;align-items:center;gap:12px;width:100%;min-height:56px;padding:8px 0;border:0;border-bottom:1px solid var(--line);background:none;color:var(--text);text-align:left;text-decoration:none}
.list-row:last-child{border-bottom:0}
.list-row b{display:block;font-size:14.5px}.list-row small{display:block;color:var(--muted);font-size:12px;margin-top:1px}
.list-row>svg:last-child{color:var(--faint)}
.lr-ico{width:36px;height:36px;border-radius:10px;display:grid;place-items:center;flex:0 0 auto;background:color-mix(in srgb,var(--c) 16%,transparent);color:var(--c)}
.socials{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:10px}
.social{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;min-height:68px;border-radius:14px;border:1px solid var(--line);background:color-mix(in srgb,var(--c) 10%,var(--surface-2));color:var(--c);text-decoration:none;font-size:11px;font-weight:800}
.social span{color:var(--text)}
.doc h4{font-size:14px;margin:16px 0 4px}.doc p{margin:0;font-size:13.5px;line-height:1.55;color:var(--muted)}.doc a{color:var(--accent-2)}
.about-foot{display:flex;flex-direction:column;align-items:center;gap:6px;margin:22px 0 4px;color:var(--faint);font-size:11.5px}
.about-foot .wordmark{height:40px;width:auto;max-width:70%}
.kv{display:grid;grid-template-columns:auto 1fr;gap:6px 14px;font-size:13.5px}
.kv dt{color:var(--muted)}.kv dd{margin:0;font-weight:700;text-align:right}

/* ---------- print ---------- */
#printArea{display:none}
@media print{
  @page{margin:12mm}
  body{overflow:visible;background:#fff!important;color:#000}
  .shell,.app-bg,#wp,#wpShade,.layer,.toasts{display:none!important}
  #printArea{display:block;color:#000;font-family:Arial,Helvetica,sans-serif}
  #printArea h1{font-size:20px;margin:0 0 4px}#printArea h2{font-size:14px;margin:0 0 12px;font-weight:normal;color:#333}
  #printArea table{width:100%;border-collapse:collapse;font-size:12px}
  #printArea th,#printArea td{border:1px solid #999;padding:5px 7px;text-align:left}
  #printArea th{background:#eee}
  #printArea .slip{border:1px dashed #555;padding:10px;margin:0 0 10px;page-break-inside:avoid;font-size:13px}
  #printArea .slip .ln{display:inline-block;border-bottom:1px solid #000;width:60px}
  #printArea .foot{margin-top:10px;font-size:10px;color:#555}
}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
@media (max-width:380px){.kpis{grid-template-columns:repeat(2,1fr)}.timer-ctrls{grid-template-columns:1fr 1fr 50px 50px}.tiles{grid-template-columns:1fr 1fr}.fields{grid-template-columns:1fr}}

</style>
</head>
<body>
<div class="app-bg" aria-hidden="true"></div>
<div id="wp" aria-hidden="true"></div>
<div id="wpShade" aria-hidden="true"></div>

<div class="shell" id="shell">
  <header class="topbar">
    <button class="brand" data-act="tab" data-tab="home" aria-label="MEIOCG home">
      <img id="brandImg" alt="" width="40" height="40">
      <span><img id="brandWord" class="wordmark" alt="MEIOCG" height="20"><small id="brandSub" hidden></small></span>
    </button>
    <div class="spacer"></div>
    <span id="statusChip" class="status-chip" hidden></span>
    <button class="icon-btn" data-act="openSettings" aria-label="Settings"><svg class="i"><use href="#i-gear"/></svg></button>
  </header>

  <main id="view" tabindex="-1">
    <div class="page">
      <section class="screen" id="scr-home" aria-label="Home"></section>
      <section class="screen" id="scr-players" aria-label="Players"></section>
      <section class="screen" id="scr-round" aria-label="Round"></section>
      <section class="screen" id="scr-match" aria-label="Match control"></section>
      <section class="screen" id="scr-standings" aria-label="Standings"></section>
      <section class="screen" id="scr-history" aria-label="History"></section>
    </div>
  </main>

  <nav class="tabbar" id="tabbar" aria-label="Main">
    <button data-act="tab" data-tab="home"><svg class="i"><use href="#i-home"/></svg>Home</button>
    <button data-act="tab" data-tab="players"><svg class="i"><use href="#i-users"/></svg>Players</button>
    <button data-act="tab" data-tab="round"><svg class="i"><use href="#i-swords"/></svg>Round<span class="dot" id="roundDot" hidden></span></button>
    <button data-act="tab" data-tab="standings"><svg class="i"><use href="#i-chart"/></svg>Standings</button>
    <button data-act="tab" data-tab="history"><svg class="i"><use href="#i-history"/></svg>History</button>
  </nav>
</div>

<div id="sheet" class="layer" hidden>
  <div class="scrim" data-act="closeSheet"></div>
  <section class="sheet" role="dialog" aria-modal="true" aria-labelledby="sheetTitle">
    <header class="sheet-head"><div class="grow"><h2 id="sheetTitle"></h2><p id="sheetSub" hidden></p></div><button class="icon-btn" data-act="closeSheet" aria-label="Close"><svg class="i"><use href="#i-x"/></svg></button></header>
    <div class="sheet-body" id="sheetBody"></div>
    <footer class="sheet-foot" id="sheetFoot"></footer>
  </section>
</div>
<div id="dialog" class="layer" hidden>
  <div class="scrim"></div>
  <div class="dialog" role="alertdialog" aria-modal="true" aria-labelledby="dlgTitle"><h3 id="dlgTitle"></h3><p id="dlgMsg"></p><div id="dlgExtra"></div><div class="row" id="dlgBtns"></div></div>
</div>
<div class="toasts" id="toasts" aria-live="polite"></div>
<div id="printArea"></div>
<input type="file" id="fileImport" accept="application/json,.json,text/plain" hidden>
<input type="file" id="fileWallpaper" accept="image/*" hidden>

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <symbol id="i-home" viewBox="0 0 24 24"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h5v-6h4v6h5V9.5"/></symbol>
